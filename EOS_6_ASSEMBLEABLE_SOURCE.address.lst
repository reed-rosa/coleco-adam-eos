  4157                          ;===============================================================
  4158                          ;===============================================================
  4159                          ;===============================================================
  4160                          ;
  4161                          
  4162                          ;GLB    __OPEN_FILE,__CLOSE_FILE,__RESET_FILE
  4163                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  4164                          ;EXT    BUF_START,FMGR_DIR_ENT
  4165                          ;EXT    __QUERY_FILE,MODE_CHECK,READ_BLOCK,WRITE_BLOCK
  4166                          ;EXT    __SET_FILE
  4167                          ;EXT    FILE_NAME_ADDR
  4168                          
  4169                          ;----------------------------------------------------------------
  4170                          ;
  4171                          ; __OPEN_FILE -- Sets up an FCB for the caller to access a file.
  4172                          ;
  4173                          ; CALLING PARAMETERS: device number in A; address of name string
  4174                          ;                     in HL; mode in B.
  4175                          ;
  4176                          ; EXIT PARAMETERS: if no error -- Z = 1; A = file number
  4177                          ;                  if error -- Z = 0; A = error code; B = junk
  4178                          ;
  4179                          ;----------------------------------------------------------------
  4180                          
  4181                          ; NEXT_FCB CHANGED TO O_NEXT_FCB TO PREVENT CONFLICT WITH
  4182                          ; IDENTICAL LABEL ELSEWHERE
  4183                          
  4184                          __OPEN_FILE:
  4185  EA00  fde5                      PUSH    IY;SAVE REGISTERS
  4186  EA02  e5                        PUSH    HL
  4187  EA03  dde5                      PUSH    IX
  4188  EA05  d5                        PUSH    DE
  4189                          
  4190  EA06  f5                        PUSH    AF;SAVE DEVICE NUMBER
  4191  EA07  c5                        PUSH    BC;SAVE MODE
  4192                          
  4193                          ; FIRST, WE HAVE TO LOCATE A FREE FCB.
  4194  EA08  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR);GET POINTER TO FIRST FCB'S HEAD
  4195  EA0C  112300                    LD      DE,FCB_LENGTH
  4196  EA0F  dd19                      ADD     IX,DE; SKIP OVER IT -- BELONGS TO SYSTEM
  4197                          
  4198  EA11  fd2afffd                  LD      IY,(FCB_DATA_ADDR);GET POINTER TO FIRST FCB'S BODY
  4199  EA15  110004                    LD      DE,1024
  4200  EA18  fd19                      ADD     IY,DE; SKIP OVER IT TOO
  4201                          
  4202  EA1A  0601                      LD      B,1;SET FCB NUMBER
  4203                          O_NEXT_FCB:
  4204  EA1C  dd7e18                    LD      A,(IX+FCB_MODE);GET THE MODE BYTE FROM FCB
  4205  EA1F  b7                        OR      A;CHECK IT
  4206  EA20  281c                      JR      Z,GOT_ONE;BRANCH IF THIS ONE IS FREE
  4207                          
  4208  EA22  112300                    LD      DE,FCB_LENGTH;ELSE SKIP OVER IT
  4209  EA25  dd19                      ADD     IX,DE
  4210  EA27  110004                    LD      DE,1024
  4211  EA2A  fd19                      ADD     IY,DE
  4212                          
  4213  EA2C  04                        INC     B;INC THE FCB NUMBER
  4214  EA2D  78                        LD      A,B
  4215  EA2E  fe03                      CP      NUM_FCBS;ARE THERE MORE FCBS TO CHECK?
  4216  EA30  38ea                      JR      C,O_NEXT_FCB;LOOP UNTIL WE'VE SEEN THEM ALL
  4217                          NO_FCBS:
  4218  EA32  c1                        POP     BC;RESTORE MODE
  4219  EA33  f1                        POP     AF
  4220  EA34  d1                        POP     DE
  4221  EA35  dde1                      POP     IX
  4222  EA37  e1                        POP     HL
  4223  EA38  fde1                      POP     IY
  4224                          
  4225  EA3A  3e07                      LD      A,NO_FCB_ERR;SET THE ERROR CODE
  4226  EA3C  b7                        OR      A;SET THE CONDITIONS
  4227  EA3D  c9                        RET
  4228                          
  4229                          GOT_ONE:
  4230  EA3E  fd2208fe                  LD      (BUF_START),IY;SAVE THE FCB BUFFER'S ADDRESS
  4231                          
  4232  EA42  f1                        POP     AF;GET THE MODE
  4233  EA43  dd7718                    LD      (IX+FCB_MODE),A;PUT IT INTO FCB
  4234  EA46  f1                        POP     AF;GET THE DEVICE
  4235  EA47  dd7717                    LD      (IX+FCB_DEVICE),A;PUT IT INTO FCB
  4236                          
  4237  EA4A  c5                        PUSH    BC;SAVE THE FCB NUMBER
  4238                          
  4239  EA4B  e5                        PUSH    HL
  4240  EA4C  d1                        POP     DE; ADDRESS OF NAME STRING
  4241                          
  4242  EA4D  dde5                      PUSH    IX;POINT TO FCB NAME (ASSUME OFFSET = 0)
  4243  EA4F  e1                        POP     HL
  4244  EA50  dd7e17                    LD      A,(IX+FCB_DEVICE);GET DEVICE NUMBER
  4245  EA53  cd1be6                    CALL    __QUERY_FILE;GET THE FILE'S DIR ENTRY
  4246  EA56  c2f8ea                    JP      NZ,OP_ERR;BRANCH IF THERE WAS AN ERROR
  4247                          ;*** SET PARAMS ***
  4248  EA59  cdd9f0                    CALL    MODE_CHECK;SEE IF MODE MATCHES ATTRIBUTES
  4249  EA5C  c2f8ea                    JP      NZ,OP_ERR;BRANCH IF NOT
  4250                          
  4251  EA5F  dd7e13                    LD      A,(IX+FCB_USED_LENGTH);CALC. & SET LAST BLOCK
  4252  EA62  dd860d                    ADD     A,(IX+FCB_FIRST_BLOCK)
  4253  EA65  dd771d                    LD      (IX+FCB_LAST_BLOCK),A
  4254  EA68  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4255  EA6B  dd8e14                    ADC     A,(IX+FCB_USED_LENGTH+1)
  4256  EA6E  dd771e                    LD      (IX+FCB_LAST_BLOCK+1),A
  4257  EA71  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4258  EA74  ce00                      ADC     A,0
  4259  EA76  dd771f                    LD      (IX+FCB_LAST_BLOCK+2),A
  4260  EA79  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4261  EA7C  ce00                      ADC     A,0
  4262  EA7E  dd7720                    LD      (IX+FCB_LAST_BLOCK+3),A
  4263                          
  4264  EA81  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK+0)
  4265  EA84  d601                      SUB     1
  4266  EA86  dd771d                    LD      (IX+FCB_LAST_BLOCK+0),A
  4267                          
  4268  EA89  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4269  EA8C  de00                      SBC     A,0
  4270  EA8E  dd771e                    LD      (IX+FCB_LAST_BLOCK+1),A
  4271                          
  4272  EA91  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4273  EA94  de00                      SBC     A,0
  4274  EA96  dd771f                    LD      (IX+FCB_LAST_BLOCK+2),A
  4275                          
  4276  EA99  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3)
  4277  EA9C  de00                      SBC     A,0
  4278  EA9E  dd7720                    LD      (IX+FCB_LAST_BLOCK+3),A
  4279                          
  4280  EAA1  ed5b08fe                  LD      DE,(BUF_START);INIT BUFFER POINTER
  4281  EAA5  dd7321                    LD      (IX+FCB_POINTER),E
  4282  EAA8  dd7222                    LD      (IX+FCB_POINTER+1),D
  4283                          
  4284  EAAB  dd7e0d                    LD      A,(IX+FCB_FIRST_BLOCK);SET BLOCK TO FIRST_BLOCK
  4285  EAAE  dd7719                    LD      (IX+FCB_BLOCK),A
  4286  EAB1  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4287  EAB4  dd771a                    LD      (IX+FCB_BLOCK+1),A
  4288  EAB7  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4289  EABA  dd771b                    LD      (IX+FCB_BLOCK+2),A
  4290  EABD  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4291  EAC0  dd771c                    LD      (IX+FCB_BLOCK+3),A
  4292                          
  4293  EAC3  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE
  4294  EAC6  e607                      AND     MODE_MODE
  4295  EAC8  fe02                      CP      MODE_WRITE;IS IT WRITE MODE?
  4296  EACA  2827                      JR      Z,OPEN5;JUMP IF SO -- NO PRE-READ NECESSARY
  4297                          
  4298                          READ_TIMEOUT:
  4299                          ;       If FCB_USED_LENGTH = 1 (file size of one block)
  4300  EACC  af                        XOR     A;Load Acc with zero
  4301  EACD  ddbe14                    CP      (IX+FCB_USED_LENGTH+1);High order must be zero
  4302  EAD0  200a                      JR      NZ,NOT_SIZE_1;If not then past bitset
  4303  EAD2  3c                        INC     A;Inc Acc to a 1
  4304  EAD3  ddbe13                    CP      (IX+FCB_USED_LENGTH);Compare with low order
  4305  EAD6  2004                      JR      NZ,NOT_SIZE_1;If not equal then exit
  4306                          
  4307                          ;       Then set last block bit in mode
  4308  EAD8  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE);Set it
  4309                          ;       Endif
  4310                          NOT_SIZE_1:
  4311                          
  4312  EADC  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4313  EADF  2a08fe                    LD      HL,(BUF_START);GET BUFFER ADDRESS
  4314  EAE2  dd5e19                    LD      E,(IX+FCB_BLOCK);GET BLOCK NUMBER
  4315  EAE5  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4316  EAE8  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4317  EAEB  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4318  EAEE  cd7bf1                    CALL    READ_BLOCK;READ THE FIRST BLOCK
  4319                          
  4320  EAF1  2005                      JR      NZ,OP_ERR; IT'S AN ERROR
  4321                          
  4322                          OPEN5:
  4323  EAF3  af                        XOR     A;SHOW NO ERROR
  4324  EAF4  c1                        POP     BC;GET THE FILE NUMBER IN B
  4325  EAF5  78                        LD      A,B
  4326                          
  4327  EAF6  1805                      JR      REST_REGS
  4328                          ;       POP     DE                     ;RESTORE REGISTERS
  4329                          ;       POP     IX
  4330                          ;       POP     HL
  4331                          ;       POP     IY
  4332                          ;       RET
  4333                          
  4334                          OP_ERR:
  4335  EAF8  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED;MAKE THE FCB UNUSED AGAIN
  4336                          
  4337  EAFC  c1                        POP     BC;RESTORE REGISTERS
  4338                          REST_REGS:
  4339  EAFD  d1                        POP     DE
  4340  EAFE  dde1                      POP     IX
  4341  EB00  e1                        POP     HL
  4342  EB01  fde1                      POP     IY
  4343  EB03  c9                        RET
  4344                          
  4345                          ;----------------------------------------------------------------
  4346                          ;
  4347                          ; __CLOSE_FILE -- does the necessary clean-up and marks the FCB
  4348                          ;                 as unused.
  4349                          ;
  4350                          ; ENTRY PARAMETERS -- file number in A.
  4351                          ;
  4352                          ; EXIT PARAMETERS -- if no error -- Z = 1; A = 0
  4353                          ;                   if error -- Z = 0; A = error code
  4354                          ;
  4355                          ;----------------------------------------------------------------
  4356                          
  4357                          __CLOSE_FILE:
  4358  EB04  dde5                      PUSH    IX;SAVE REGISTERS
  4359  EB06  e5                        PUSH    HL
  4360  EB07  d5                        PUSH    DE
  4361  EB08  c5                        PUSH    BC
  4362                          
  4363  EB09  b7                        OR      A;CHECK FILE NUMBER
  4364  EB0A  2850                      JR      Z,C_ERROR;BRANCH IF ZERO
  4365  EB0C  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4366  EB0E  304c                      JR      NC,C_ERROR;BRANCH IF TOO LARGE
  4367                          
  4368  EB10  47                        LD      B,A;PUT IT INTO B
  4369  EB11  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4370  EB15  2afffd                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4371                          CLOSE2:
  4372  EB18  112300                    LD      DE,FCB_LENGTH;SET OFFSET
  4373  EB1B  dd19                      ADD     IX,DE;ADVANCE POINTER TO NEXT FCB
  4374  EB1D  110004                    LD      DE,1024
  4375  EB20  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT BUFFER
  4376  EB21  10f5                      DJNZ    CLOSE2;UNTIL WE GET TO THE ONE WE WANT
  4377                          
  4378  EB23  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE BYTE
  4379  EB26  b7                        OR      A
  4380  EB27  2833                      JR      Z,C_ERROR;BRANCH IF FCB NOT IN USE
  4381                          
  4382  EB29  e640                      AND     MODE_DIRTY;ZERO UNWANTED BITS
  4383  EB2B  2825                      JR      Z,CLOSE3;BRANCH IF BUFFER NOT DIRTY
  4384                          
  4385  EB2D  dd2273fd                  LD      (FILE_NAME_ADDR),IX; POINTER TO FILE NAME IN FCB
  4386                          WRITE_TIMEOUT:
  4387  EB31  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4388  EB34  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4389  EB37  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4390  EB3A  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4391  EB3D  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4392                          ;HL STILL HAS ADDRESS OF BUFFER
  4393  EB40  cde6f1                    CALL    WRITE_BLOCK;FLUSH THE BLOCK TO TAPE
  4394  EB43  2020                      JR      NZ,C_ERROR2;BRANCH IF ERROR
  4395                          
  4396                          CLOSE4:
  4397  EB45  dd7e17                    LD      A,(IX+FCB_DEVICE); GET DEVICE ID
  4398  EB48  dde5                      PUSH    IX
  4399  EB4A  e1                        POP     HL
  4400  EB4B  ed5b73fd                  LD      DE,(FILE_NAME_ADDR)
  4401                          
  4402  EB4F  cd51e6                    CALL    __SET_FILE
  4403                          
  4404                          CLOSE3:
  4405  EB52  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED;MARK THE FCB EMPTY
  4406                          
  4407  EB56  c1                        POP     BC;RESTORE REGISTERS
  4408  EB57  d1                        POP     DE
  4409  EB58  e1                        POP     HL
  4410  EB59  dde1                      POP     IX
  4411  EB5B  c9                        RET
  4412                          C_ERROR:
  4413  EB5C  c1                        POP     BC;RESTORE REGISTERS
  4414  EB5D  d1                        POP     DE
  4415  EB5E  e1                        POP     HL
  4416  EB5F  dde1                      POP     IX
  4417  EB61  3e09                      LD      A,BAD_FNUM_ERR;SET THE ERROR
  4418  EB63  b7                        OR      A;SET THE CONDITIONS
  4419  EB64  c9                        RET
  4420                          C_ERROR2:
  4421  EB65  c1                        POP     BC;RESTORE REGISTERS
  4422  EB66  d1                        POP     DE
  4423  EB67  e1                        POP     HL
  4424  EB68  dde1                      POP     IX
  4425  EB6A  b7                        OR      A;SET CONDITIONS
  4426  EB6B  c9                        RET
  4427                          
  4428                          ;----------------------------------------------------------------
  4429                          ;
  4430                          ; __RESET_FILE -- rewinds the file back to the first byte.
  4431                          ;
  4432                          ; ENTRY PARAMETERS: file number in A
  4433                          ;
  4434                          ; EXIT PARAMETERS: no error -- Z = 1; A = 0
  4435                          ;                  if error -- Z = 0; A = error code
  4436                          ;
  4437                          ;----------------------------------------------------------------
  4438                          
  4439                          __RESET_FILE:
  4440  EB6C  dde5                      PUSH    IX;SAVE REGISTERS
  4441  EB6E  d5                        PUSH    DE
  4442  EB6F  c5                        PUSH    BC
  4443  EB70  e5                        PUSH    HL
  4444                          
  4445  EB71  b7                        OR      A;CHECK FILE NUMBER
  4446  EB72  ca07ec                    JP      Z,R_ERROR;BRANCH IF ZERO
  4447  EB75  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4448  EB77  d207ec                    JP      NC,R_ERROR;BRANCH IF TOO LARGE
  4449                          
  4450  EB7A  47                        LD      B,A;PUT IT INTO B
  4451  EB7B  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4452  EB7F  2afffd                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4453                          RES1:
  4454  EB82  112300                    LD      DE,FCB_LENGTH;SET OFFSET
  4455  EB85  dd19                      ADD     IX,DE;ADVANCE POINTER TO NEXT FCB
  4456  EB87  110004                    LD      DE,1024;SET BUFFER SIZE
  4457  EB8A  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT BUFFER
  4458  EB8B  10f5                      DJNZ    RES1;UNTIL WE GET TO THE ONE WE WANT
  4459                          
  4460  EB8D  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE BYTE
  4461  EB90  b7                        OR      A
  4462  EB91  2874                      JR      Z,R_ERROR;BRANCH IF FCB NOT IN USE
  4463                          
  4464  EB93  e640                      AND     MODE_DIRTY;ZERO UNWANTED BITS
  4465  EB95  2818                      JR      Z,RES2;BRANCH IF BUFFER NOT DIRTY
  4466                          
  4467                          TIMED_OUT:
  4468  EB97  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4469  EB9A  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4470  EB9D  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4471  EBA0  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4472  EBA3  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4473                          ;HL STILL HAS ADDRESS OF BUFFER
  4474  EBA6  cde6f1                    CALL    WRITE_BLOCK;FLUSH THE BLOCK TO TAPE
  4475  EBA9  2065                      JR      NZ,R_ERROR2;BRANCH IF ERROR
  4476                          
  4477                          RESET_BIT:
  4478  EBAB  ddcb18b6                  RES     MODE_DIRTY_BIT,(IX+FCB_MODE);CLEAR THE DIRTY BIT
  4479                          RES2:
  4480  EBAF  ddcb18be                  RES     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); BACK TO FIRST BLOCK
  4481  EBB3  dd7e0d                    LD      A,(IX+FCB_FIRST_BLOCK);SET BLOCK TO FIRST_BLOCK
  4482  EBB6  dd7719                    LD      (IX+FCB_BLOCK),A
  4483  EBB9  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4484  EBBC  dd771a                    LD      (IX+FCB_BLOCK+1),A
  4485  EBBF  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4486  EBC2  dd771b                    LD      (IX+FCB_BLOCK+2),A
  4487  EBC5  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4488  EBC8  dd771c                    LD      (IX+FCB_BLOCK+3),A
  4489                          
  4490  EBCB  dd7521                    LD      (IX+FCB_POINTER+0),L;reset pointer for new (first) block
  4491  EBCE  dd7422                    LD      (IX+FCB_POINTER+1),H
  4492                          
  4493  EBD1  dd7e18                    LD      A,(IX+FCB_MODE);GET THE MODE AGAIN
  4494  EBD4  e607                      AND     MODE_MODE;LOOK AT MODE TYPE ONLY
  4495  EBD6  fe02                      CP      MODE_WRITE;ARE WE WRITING?
  4496  EBD8  2012                      JR      NZ,READ_IT;NOPE, NEED TO PRE-READ
  4497                          
  4498  EBDA  dd361500                  LD      (IX+FCB_LAST_COUNT),0
  4499  EBDE  dd361600                  LD      (IX+FCB_LAST_COUNT+1),0
  4500                          
  4501  EBE2  dd361301                  LD      (IX+FCB_USED_LENGTH),1
  4502  EBE6  dd361400                  LD      (IX+FCB_USED_LENGTH+1),0
  4503                          
  4504  EBEA  1814                      JR      NO_READ
  4505                          
  4506                          READ_IT:
  4507  EBEC  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4508  EBEF  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4509  EBF2  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4510  EBF5  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4511  EBF8  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4512                          ;HL STILL HAS ADDRESS OF BUFFER
  4513  EBFB  cd7bf1                    CALL    READ_BLOCK;READ THE FIRST BLOCK
  4514                          
  4515  EBFE  2010                      JR      NZ,R_ERROR2;BRANCH ON ERROR
  4516                          
  4517                          NO_READ:
  4518  EC00  e1                        POP     HL;RESTORE THE REGISTERS
  4519  EC01  c1                        POP     BC
  4520  EC02  d1                        POP     DE
  4521  EC03  dde1                      POP     IX
  4522  EC05  af                        XOR     A;SHOW NO ERROR
  4523  EC06  c9                        RET
  4524                          
  4525                          R_ERROR:
  4526  EC07  e1                        POP     HL;RESTORE THE REGISTERS
  4527  EC08  c1                        POP     BC
  4528  EC09  d1                        POP     DE
  4529  EC0A  dde1                      POP     IX
  4530  EC0C  3e09                      LD      A,BAD_FNUM_ERR;SHOW THE ERROR
  4531  EC0E  b7                        OR      A;SET CONDITIONS
  4532  EC0F  c9                        RET
  4533                          R_ERROR2:
  4534  EC10  e1                        POP     HL;RESTORE REGISTERS
  4535  EC11  c1                        POP     BC
  4536  EC12  d1                        POP     DE
  4537  EC13  dde1                      POP     IX
  4538  EC15  b7                        OR      A;SET CONDITION
  4539  EC16  c9                        RET
  4540                          ;
  4541                          ;===============================================================
  4542                          ;===============================================================
  4543                          ;===============================================================
  4544                          ;
  4545                          
  4546                          
  4547                          ;Packed some code to allow room for
  4548                          
  4549                          ;GLB    __READ_FILE,__WRITE_FILE
  4550                          ;EXT    BUF_START,BUF_END,USER_BUF,BYTES_REQ,BYTES_TO_GO
  4551                          ;EXT    FNUM
  4552                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  4553                          ;EXT    READ_BLOCK,WRITE_BLOCK
  4554                          ;EXT    MODE_CHECK
  4555                          
  4556                          ;----------------------------------------------------------------
  4557                          ;
  4558                          ; __READ_FILE -- read some data from a file into the user's buffer.
  4559                          ;
  4560                          ; ENTRY PARAMETERS: device number in A; buffer address in HL;
  4561                          ;                   desired number of bytes in BC.
  4562                          ;
  4563                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  4564                          ;                  if errors -- Z = 0; A = error code;
  4565                          ;                  BC = number of bytes transferred
  4566                          ;
  4567                          ;----------------------------------------------------------------
  4568                          
  4569                          ; GET_OUT CHANGED TO R_GET_OUT TO PREVENT CONFLICT WITH
  4570                          ; IDENTICAL LABEL ELSEWHERE
  4571                          
  4572                          __READ_FILE:
  4573  EC17  c5                        PUSH    BC;SAVE REGISTERS
  4574  EC18  d5                        PUSH    DE
  4575  EC19  e5                        PUSH    HL
  4576  EC1A  dde5                      PUSH    IX
  4577                          
  4578  EC1C  2206fe                    LD      (USER_BUF),HL;SAVE USER'S BUFFER ADDRESS
  4579  EC1F  ed4302fe                  LD      (BYTES_REQ),BC;SAVE REQUESTED COUNT
  4580  EC23  3201fe                    LD      (FNUM),A;SAVE FILE NUMBER
  4581  EC26  ed4304fe                  LD      (BYTES_TO_GO),BC;INIT COUNTER (COUNTS DOWN)
  4582                          
  4583  EC2A  b7                        OR      A;CHECK FILE NUMBER
  4584  EC2B  ca7fed                    JP      Z,READ_ERR2;BRANCH IF ZERO
  4585  EC2E  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4586  EC30  d27fed                    JP      NC,READ_ERR2;BRANCH IF TOO LARGE
  4587                          
  4588  EC33  47                        LD      B,A;PUT IT INTO B
  4589  EC34  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4590  EC38  2afffd                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4591                          READ1:
  4592  EC3B  112300                    LD      DE,FCB_LENGTH;ADVANCE POINTER TO NEXT FCB
  4593  EC3E  dd19                      ADD     IX,DE
  4594  EC40  110004                    LD      DE,1024;ADVANCE POINTER TO NEXT BUFFER
  4595  EC43  19                        ADD     HL,DE
  4596  EC44  10f5                      DJNZ    READ1;UNTIL WE GET TO THE ONE WE WANT
  4597                          
  4598  EC46  2208fe                    LD      (BUF_START),HL;SAVE ADDRESS OF MY BUFFER
  4599  EC49  19                        ADD     HL,DE;POINT HL PAST END OF MY BUFFER
  4600  EC4A  220afe                    LD      (BUF_END),HL;SAVE IT TOO
  4601                          
  4602                          ;*** CHECK FOR MODE ***
  4603  EC4D  dde5                      PUSH    IX
  4604  EC4F  e1                        POP     HL
  4605                          
  4606  EC50  cdd9f0                    CALL    MODE_CHECK;SEE IF THE MODE IS OK
  4607  EC53  c281ed                    JP      NZ,READ_ERR1;BRANCH IF NOT
  4608                          
  4609                          READ3:
  4610  EC56  ddcb187e                  BIT     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE);LOOK AT LAST BLOCK BIT
  4611  EC5A  c22bed                    JP      NZ,READ_LAST;BRANCH IF THIS IS THE LAST FILE BLOCK
  4612                          
  4613  EC5D  2a0afe                    LD      HL,(BUF_END);GET END ADDRESS OF BUFFER
  4614  EC60  dd5e21                    LD      E,(IX+FCB_POINTER);GET POINTER INTO BUFFER
  4615  EC63  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4616  EC66  b7                        OR      A
  4617  EC67  ed52                      SBC     HL,DE;CALC. BYTES LEFT IN BUFFER
  4618  EC69  2825                      JR      Z,_O_BYTES_LEFT2
  4619                          
  4620  EC6B  44                        LD      B,H;SAVE BYTES LEFT IN CASE WE NEED IT
  4621  EC6C  4d                        LD      C,L
  4622                          
  4623  EC6D  ed5b04fe                  LD      DE,(BYTES_TO_GO);GET BYTES LEFT TO SEND
  4624  EC71  b7                        OR      A
  4625  EC72  ed52                      SBC     HL,DE;COMPARE TO WHAT WE HAVE
  4626  EC74  d2eaec                    JP      NC,ENOUGH;BRANCH IF WE HAVE ENOUGH DATA HERE
  4627                          
  4628                          ; IF WE FALL THROUGH HERE, WE KNOW WE WILL HAVE TO GET ANOTHER
  4629                          ; BLOCK AFTER THIS ONE.  FIRST, LET'S TRANSFER WHAT WE HAVE.
  4630                          
  4631  EC77  2a04fe                    LD      HL,(BYTES_TO_GO);UPDATE NUMBER OF BYTES TO GO
  4632  EC7A  b7                        OR      A
  4633  EC7B  ed42                      SBC     HL,BC;SUBTRACT NUM OF BYTES WE ARE SENDING HERE
  4634  EC7D  2204fe                    LD      (BYTES_TO_GO),HL
  4635                          
  4636  EC80  dd6e21                    LD      L,(IX+FCB_POINTER);POINT INTO MY BUFFER
  4637  EC83  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4638  EC86  ed5b06fe                  LD      DE,(USER_BUF);POINT INTO THE CALLER'S BUFFER
  4639                          ;BC HAS COUNT FROM ABOVE
  4640  EC8A  edb0                      LDIR;GIVE WHAT WE HAVE
  4641                          
  4642  EC8C  ed5306fe                  LD      (USER_BUF),DE;POINT TO NEXT SPOT
  4643                          
  4644                          _O_BYTES_LEFT2:
  4645  EC90  2a08fe                    LD      HL,(BUF_START);RESET THE POINTER
  4646  EC93  dd7521                    LD      (IX+FCB_POINTER),L
  4647  EC96  dd7422                    LD      (IX+FCB_POINTER+1),H
  4648                          
  4649  EC99  dd3419                    INC     (IX+FCB_BLOCK);INC THE BLOCK NUMBER
  4650  EC9C  200d                      JR      NZ,READ4;BRANCH IF NO CARRY OUT
  4651  EC9E  dd341a                    INC     (IX+FCB_BLOCK+1)
  4652  ECA1  2008                      JR      NZ,READ4
  4653  ECA3  dd341b                    INC     (IX+FCB_BLOCK+2)
  4654  ECA6  2003                      JR      NZ,READ4
  4655  ECA8  dd341c                    INC     (IX+FCB_BLOCK+3)
  4656                          
  4657                          READ4:
  4658                          
  4659  ECAB  dd7e17                    LD      A,(IX+FCB_DEVICE);DEVICE ID
  4660  ECAE  2a08fe                    LD      HL,(BUF_START); GET ADDRESS OF USERS BUFFER
  4661  ECB1  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4662  ECB4  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4663  ECB7  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4664  ECBA  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4665                          
  4666  ECBD  cd7bf1                    CALL    READ_BLOCK; READ THE NEXT BLOCK
  4667                          
  4668  ECC0  c281ed                    JP      NZ,READ_ERR1; BRANCH IF ERROR
  4669                          
  4670                          NOT_TAPE1:
  4671  ECC3  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3); SEE IF THIS IS THE LAST BLOCK
  4672  ECC6  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  4673  ECC9  201c                      JR      NZ,JP_TO_READ3; BRANCH IF NOT
  4674  ECCB  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4675  ECCE  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  4676  ECD1  2014                      JR      NZ,JP_TO_READ3
  4677  ECD3  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4678  ECD6  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  4679  ECD9  200c                      JR      NZ,JP_TO_READ3
  4680  ECDB  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  4681  ECDE  ddbe19                    CP      (IX+FCB_BLOCK)
  4682  ECE1  2004                      JR      NZ,JP_TO_READ3
  4683  ECE3  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); ELSE SET THE LAST BLOCK BIT
  4684                          JP_TO_READ3:
  4685  ECE7  c356ec                    JP      READ3; AND DEAL WITH THE NEXT BLOCK
  4686                          
  4687                          ; ARRIVE HERE IF THIS BLOCK CONTAINS ENOUGH BYTES TO SATISFY
  4688                          ; THIS CALL.
  4689                          
  4690                          ENOUGH:
  4691  ECEA  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3); SEE IF THIS IS THE LAST BLOCK
  4692  ECED  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  4693  ECF0  2018                      JR      NZ,READ_LAST1; BRANCH IF NOT
  4694  ECF2  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4695  ECF5  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  4696  ECF8  2010                      JR      NZ,READ_LAST1
  4697  ECFA  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4698  ECFD  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  4699  ED00  2008                      JR      NZ,READ_LAST1
  4700  ED02  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  4701  ED05  ddbe19                    CP      (IX+FCB_BLOCK)
  4702  ED08  281d                      JR      Z,LAST_BLOCK
  4703                          
  4704                          READ_LAST1:
  4705  ED0A  ed4b04fe                  LD      BC,(BYTES_TO_GO); GET BYTE COUNT TO MOVE
  4706                          
  4707                          
  4708  ED0E  dd6e21                    LD      L,(IX+FCB_POINTER); POINT INTO MY BUFFER
  4709  ED11  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4710  ED14  ed5b06fe                  LD      DE,(USER_BUF); POINT TO THE USER'S BUFFER
  4711  ED18  edb0                      LDIR; MOVE THE DATA
  4712                          
  4713  ED1A  dd7521                    LD      (IX+FCB_POINTER),L; UPDATE MY POINTER
  4714  ED1D  dd7422                    LD      (IX+FCB_POINTER+1),H
  4715                          
  4716                          
  4717  ED20  dde1                      POP     IX; RESTORE REGISTERS
  4718  ED22  e1                        POP     HL
  4719  ED23  d1                        POP     DE
  4720  ED24  c1                        POP     BC
  4721  ED25  af                        XOR     A; SHOW NO ERROR
  4722  ED26  c9                        RET
  4723                          
  4724                          ; ARRIVE HERE IF THIS IS THE LAST BLOCK OF THE FILE.
  4725                          LAST_BLOCK:
  4726  ED27  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE)
  4727                          
  4728                          READ_LAST:
  4729  ED2B  2a08fe                    LD      HL,(BUF_START); POINT TO MY BUFFER
  4730  ED2E  dd5e15                    LD      E,(IX+FCB_LAST_COUNT); GET # BYTES IN IT
  4731  ED31  dd5616                    LD      D,(IX+FCB_LAST_COUNT+1)
  4732  ED34  19                        ADD     HL,DE; CALC ADDR OF LAST BYTE + 1
  4733  ED35  dd5e21                    LD      E,(IX+FCB_POINTER); GET CURRENT POINTER
  4734  ED38  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4735  ED3B  b7                        OR      A; CLEAR CARRY
  4736  ED3C  ed52                      SBC     HL,DE; CALC # BYTES LEFT IN BUFFER
  4737  ED3E  44                        LD      B,H; SAVE IT IN CASE IT'S NEEDED
  4738  ED3F  4d                        LD      C,L
  4739  ED40  282a                      JR      Z,_0_BYTES_LEFT
  4740                          
  4741  ED42  ed5b04fe                  LD      DE,(BYTES_TO_GO); GET REQUESTED COUNT
  4742  ED46  b7                        OR      A; CLEAR CARRY (UGLY Z80)
  4743  ED47  ed52                      SBC     HL,DE; SEE IF WE HAVE ENOUGH BYTES
  4744  ED49  30bf                      JR      NC,READ_LAST1; BRANCH IF SO -- NO SWEAT
  4745                          
  4746  ED4B  2a04fe                    LD      HL,(BYTES_TO_GO); UPDATE NUMBER OF BYTES TO GO
  4747  ED4E  b7                        OR      A
  4748  ED4F  ed42                      SBC     HL,BC; SUBTRACT NUM OF BYTES WE ARE SENDING HERE
  4749  ED51  2204fe                    LD      (BYTES_TO_GO),HL
  4750                          
  4751  ED54  dd6e21                    LD      L,(IX+FCB_POINTER); GET POINTER TO MY BUFFER
  4752  ED57  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4753  ED5A  ed5b06fe                  LD      DE,(USER_BUF); GET POINTER TO USER'S BUFFER
  4754                          ; BC HAS COUNT FROM ABOVE
  4755  ED5E  edb0                      LDIR; MOVE WHAT WE HAVE TO USER
  4756                          
  4757  ED60  2a02fe                    LD      HL,(BYTES_REQ); GET # BYTES REQUESTED
  4758  ED63  ed4b04fe                  LD      BC,(BYTES_TO_GO); GET # BYTES WE DIDN'T DO
  4759  ED67  b7                        OR      A
  4760  ED68  ed42                      SBC     HL,BC; CALC. # OF BYTES WE DID DO
  4761  ED6A  44                        LD      B,H; PUT IT INTO BC
  4762  ED6B  4d                        LD      C,L
  4763                          
  4764                          _0_BYTES_LEFT:
  4765  ED6C  3e0a                      LD      A,EOF_ERR; SHOW AN ERROR
  4766                          R_GET_OUT:
  4767  ED6E  dde1                      POP     IX; RESTORE REGISTERS
  4768  ED70  e1                        POP     HL
  4769  ED71  d1                        POP     DE
  4770  ED72  33                        INC     SP; DISCARD OLD BC
  4771  ED73  33                        INC     SP
  4772                          
  4773  ED74  b7                        OR      A
  4774  ED75  c9                        RET
  4775                          
  4776                          RQ_STAT_ERR:
  4777  ED76  dde1                      POP     IX
  4778  ED78  e1                        POP     HL
  4779  ED79  d1                        POP     DE
  4780  ED7A  c1                        POP     BC
  4781                          
  4782  ED7B  3e15                      LD      A,RQ_TP_STAT_ERR
  4783  ED7D  b7                        OR      A
  4784  ED7E  c9                        RET
  4785                          
  4786                          READ_ERR2:
  4787  ED7F  3e09                      LD      A,BAD_FNUM_ERR
  4788                          
  4789                          READ_ERR1:
  4790  ED81  2a02fe                    LD      HL,(BYTES_REQ); GET # BYTES REQUESTED
  4791  ED84  ed4b04fe                  LD      BC,(BYTES_TO_GO); GET # BYTES WE DIDN'T DO
  4792  ED88  b7                        OR      A
  4793  ED89  ed42                      SBC     HL,BC; CALC. # OF BYTES WE DID DO
  4794  ED8B  44                        LD      B,H; PUT IT INTO BC
  4795  ED8C  4d                        LD      C,L
  4796                          
  4797  ED8D  18df                      JR      R_GET_OUT
  4798                          
  4799                          ;       POP     IX                         ; RESTORE REGISTERS
  4800                          ;       POP     HL
  4801                          ;       POP     DE
  4802                          ;       INC     SP                         ; DISCARD OLD BC
  4803                          ;       INC     SP
  4804                          ;       OR      A                          ; SET CONDITION CODES
  4805                          ;       RET
  4806                          
  4807                          ;READ_ERR2
  4808                          ;       LD      HL,(BYTES_REQ)             ; GET # BYTES REQUESTED
  4809                          ;       LD      BC,(BYTES_TO_GO)           ; GET # BYTES WE DIDN'T DO
  4810                          ;       OR      A
  4811                          ;       SBC     HL,BC                      ; CALC. # OF BYTES WE DID DO
  4812                          ;       LD      B,H                        ; PUT IT INTO BC
  4813                          ;       LD      C,L
  4814                          ;
  4815                          ;       POP     IX                         ; RESTORE REGISTERS
  4816                          ;       POP     HL
  4817                          ;       POP     DE
  4818                          ;       INC     SP                         ; DISCARD OLD BC
  4819                          ;       INC     SP
  4820                          ;       LD      A,BAD_FNUM_ERR             ; SET THE ERROR CODE
  4821                          ;       OR      A                          ; SET CONDITIONS
  4822                          ;       RET
  4823                          
  4824                          ;-----------------------------------------------------------------------
  4825                          ;
  4826                          ; __WRITE_FILE -- write some bytes to a file.
  4827                          ;
  4828                          ; ENTRY PARAMETERS: file number in A; byte count in BC; pointer
  4829                          ;                   to data in HL.
  4830                          ;
  4831                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  4832                          ;                  if errors -- Z = 0; A = error code
  4833                          ;
  4834                          ;-----------------------------------------------------------------------
  4835                          
  4836                          __WRITE_FILE:
  4837  ED8F  c5                        PUSH    BC; SAVE REGISTERS
  4838  ED90  d5                        PUSH    DE
  4839  ED91  e5                        PUSH    HL
  4840  ED92  dde5                      PUSH    IX
  4841                          
  4842  ED94  2206fe                    LD      (USER_BUF),HL; SAVE USER'S BUFFER ADDRESS
  4843  ED97  ed4302fe                  LD      (BYTES_REQ),BC; SAVE REQUESTED COUNT
  4844  ED9B  3201fe                    LD      (FNUM),A; SAVE FILE NUMBER
  4845  ED9E  ed4304fe                  LD      (BYTES_TO_GO),BC; INIT COUNTER (COUNTS DOWN)
  4846                          
  4847  EDA2  b7                        OR      A; CHECK FILE NUMBER
  4848  EDA3  cabcee                    JP      Z,WRITE_ERR2; BRANCH IF ZERO
  4849  EDA6  fe03                      CP      NUM_FCBS; CHECK FOR MAX RANGE
  4850  EDA8  d2bcee                    JP      NC,WRITE_ERR2; BRANCH IF TOO LARGE
  4851                          
  4852  EDAB  47                        LD      B,A; PUT IT INTO B
  4853  EDAC  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR); GET ADDRESS OF 0TH FCB
  4854  EDB0  112300                    LD      DE,FCB_LENGTH; SET OFFSET
  4855                          WRITE1:
  4856  EDB3  dd19                      ADD     IX,DE; ADVANCE POINTER TO NEXT FCB
  4857  EDB5  10fc                      DJNZ    WRITE1; UNTIL WE GET TO THE ONE WE WANT
  4858                          
  4859  EDB7  47                        LD      B,A; POINT HL AT MY BUFFER
  4860  EDB8  110004                    LD      DE,1024
  4861  EDBB  2afffd                    LD      HL,(FCB_DATA_ADDR)
  4862                          WRITE2:
  4863  EDBE  19                        ADD     HL,DE
  4864  EDBF  10fd                      DJNZ    WRITE2
  4865                          
  4866  EDC1  2208fe                    LD      (BUF_START),HL; SAVE ADDRESS OF MY BUFFER
  4867  EDC4  19                        ADD     HL,DE; POINT HL PAST END OF MY BUFFER
  4868  EDC5  220afe                    LD      (BUF_END),HL; SAVE IT TOO
  4869                          
  4870                          ; *** CHECK FOR MODE ***
  4871  EDC8  dde5                      PUSH    IX
  4872  EDCA  e1                        POP     HL
  4873                          
  4874  EDCB  cdd9f0                    CALL    MODE_CHECK
  4875  EDCE  c2beee                    JP      NZ,WRITE_ERR1; JUMP IF WRONG MODE
  4876                          
  4877                          WRITE3:
  4878  EDD1  dd7e14                    LD      A,(IX+FCB_USED_LENGTH+1)
  4879  EDD4  ddbe12                    CP      (IX+FCB_MAX_LENGTH+1)
  4880  EDD7  380c                      JR      C,SET_UP
  4881  EDD9  dd7e13                    LD      A,(IX+FCB_USED_LENGTH+0)
  4882  EDDC  ddbe11                    CP      (IX+FCB_MAX_LENGTH)
  4883  EDDF  3804                      JR      C,SET_UP
  4884                          
  4885  EDE1  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE)
  4886                          SET_UP:
  4887  EDE5  2a0afe                    LD      HL,(BUF_END); GET LAST ADDR + 1 OF BUFFER
  4888  EDE8  dd5e21                    LD      E,(IX+FCB_POINTER); GET CURRENT POINTER
  4889  EDEB  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4890  EDEE  b7                        OR      A; CLEAR CARRY
  4891  EDEF  ed52                      SBC     HL,DE; CALC. ROOM LEFT IN BUFFER
  4892  EDF1  44                        LD      B,H; SAVE IT IN CASE WE NEED IT
  4893  EDF2  4d                        LD      C,L
  4894  EDF3  ed5b04fe                  LD      DE,(BYTES_TO_GO); GET BYTES LEFT TO TRANSFER
  4895  EDF7  b7                        OR      A
  4896  EDF8  ed52                      SBC     HL,DE; SEE IF WE HAVE ROOM FOR IT ALL
  4897  EDFA  d293ee                    JP      NC,ROOM_OK; BRANCH IF YES
  4898                          
  4899                          ; WE FALL THROUGH HERE IF THE NUMBER OF BYTES TO BE WRITTEN
  4900                          ; IS MORE THAN THE SPACE WE HAVE IN THE CURRENT BLOCK.
  4901                          ; FILL THE BLOCK. WRITE IT OUT. THEN DECIDE WHAT TO DO.
  4902                          
  4903  EDFD  78                        LD      A,B; CHECK IF ANY BYTES AVAILABLE
  4904  EDFE  b1                        OR      C
  4905  EDFF  281b                      JR      Z,CHECK_LAST_BLOCK; NOPE. EMPTY BUFFER FIRST
  4906                          
  4907  EE01  2a04fe                    LD      HL,(BYTES_TO_GO); GET THE COUNT
  4908  EE04  b7                        OR      A
  4909  EE05  ed42                      SBC     HL,BC; SUB THE ROOM IN BUFFER TO UPDATE IT
  4910  EE07  2204fe                    LD      (BYTES_TO_GO),HL
  4911                          
  4912  EE0A  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO BUFFER
  4913  EE0D  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4914  EE10  2a06fe                    LD      HL,(USER_BUF); GET POINTER TO USER DATA
  4915                          ; BC STILL HAS COUNT FROM ABOVE
  4916  EE13  edb0                      LDIR; MOVE DATA INTO THE BUFFER
  4917                          
  4918  EE15  2206fe                    LD      (USER_BUF),HL; SAVE WHERE WE LEFT OFF
  4919                          
  4920                          
  4921  EE18  ddcb18f6                  SET     MODE_DIRTY_BIT,(IX+FCB_MODE); SET THE DIRTY BIT
  4922                          
  4923                          CHECK_LAST_BLOCK:
  4924  EE1C  ddcb187e                  BIT     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); CHECK FOR LAST BLOCK
  4925  EE20  2809                      JR      Z,MORE_FILE; JUMP IF THIS ISN'T LAST BLOCK
  4926                          
  4927                          ; IF THIS IS THE LAST BLOCK (AND IT'S NOW FULL) THERE'S NOTHING
  4928                          ; MORE WE CAN DO.  WE LEAVE THE DATA IN PLACE (IT WILL GET
  4929                          ; FLUSHED WHEN THE FILE IS CLOSED) AND REPORT AN EOF ERROR,
  4930                          ; MEANING THAT WE COULDN'T WRITE ALL THE DATA.
  4931                          
  4932  EE22  dde1                      POP     IX; RESTORE REGISTERS
  4933  EE24  e1                        POP     HL
  4934  EE25  d1                        POP     DE
  4935  EE26  c1                        POP     BC
  4936  EE27  3e0a                      LD      A,EOF_ERR; SHOW THE ERROR
  4937  EE29  b7                        OR      A; SET CONDITIONS
  4938  EE2A  c9                        RET
  4939                          
  4940                          ; WE COME HERE IF WE HAVE A FULL BUFFER AND THERE'S MORE
  4941                          ; DATA TO WRITE AND THERE ARE MORE BLOCKS TO THE FILE.
  4942                          
  4943                          MORE_FILE:
  4944  EE2B  dd3413                    INC     (IX+FCB_USED_LENGTH); INCREMENT SECTORS WRITTEN TO
  4945  EE2E  2003                      JR      NZ,MORE_FILE1
  4946  EE30  dd3414                    INC     (IX+FCB_USED_LENGTH+1)
  4947                          MORE_FILE1:
  4948  EE33  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4949  EE36  2a08fe                    LD      HL,(BUF_START); GET BUFFER ADDRESS
  4950  EE39  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4951  EE3C  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4952  EE3F  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4953  EE42  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4954  EE45  cde6f1                    CALL    WRITE_BLOCK; WRITE OUT THE FULL BLOCK
  4955                          
  4956  EE48  c2beee                    JP      NZ,WRITE_ERR1; BRANCH IF ERROR
  4957                          
  4958                          CLEAR_DIRTY_BIT:
  4959  EE4B  ddcb18b6                  RES     MODE_DIRTY_BIT,(IX+FCB_MODE); CLEAR THE DIRTY BIT
  4960  EE4F  2a08fe                    LD      HL,(BUF_START); RESET THE BUFFER POINTER
  4961  EE52  dd7521                    LD      (IX+FCB_POINTER),L
  4962  EE55  dd7422                    LD      (IX+FCB_POINTER+1),H
  4963                          
  4964  EE58  dd361500                  LD      (IX+FCB_LAST_COUNT),0
  4965  EE5C  dd361600                  LD      (IX+FCB_LAST_COUNT+1),0
  4966                          
  4967  EE60  dd3419                    INC     (IX+FCB_BLOCK); INC THE BLOCK NUMBER
  4968  EE63  200d                      JR      NZ,WRITE4; BRANCH IF NO CARRY OUT
  4969  EE65  dd341a                    INC     (IX+FCB_BLOCK+1)
  4970  EE68  2008                      JR      NZ,WRITE4
  4971  EE6A  dd341b                    INC     (IX+FCB_BLOCK+2)
  4972  EE6D  2003                      JR      NZ,WRITE4
  4973  EE6F  dd341c                    INC     (IX+FCB_BLOCK+3)
  4974                          
  4975                          WRITE4:
  4976  EE72  dd7e18                    LD      A,(IX+FCB_MODE); LOOK AT THE MODE BYTE
  4977  EE75  e607                      AND     MODE_MODE; GET RID OF EXTRA BITS
  4978  EE77  fe03                      CP      MODE_UPDATE; DO WE HAVE TO PRE-READ THE NEXT BLOCK?
  4979  EE79  c2d1ed                    JP      NZ,WRITE3; LOOP TO TOP IF NOT
  4980                          
  4981                          WRITE_AGAIN:
  4982  EE7C  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4983  EE7F  2a08fe                    LD      HL,(BUF_START); GET BUFFER ADDRESS
  4984  EE82  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4985  EE85  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4986  EE88  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4987  EE8B  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4988  EE8E  cd7bf1                    CALL    READ_BLOCK; PRE-READ THE NEXT FILE BLOCK
  4989                          
  4990  EE91  202b                      JR      NZ,WRITE_ERR1; BRANCH IF ERROR
  4991                          
  4992                          
  4993                          ; ARRIVE HERE IF THE DATA BEING WRITTEN WILL NOT FILL THE BUFFER.
  4994                          ; EVERYTHING IS VERY EASY -- JUST COPY IT FROM USER'S ADDRESS
  4995                          ; INTO THE BUFFER AND GO AWAY.
  4996                          
  4997                          ROOM_OK:
  4998  EE93  ed4b04fe                  LD      BC,(BYTES_TO_GO); GET THE BYTE COUNT
  4999  EE97  dd6e15                    LD      L,(IX+FCB_LAST_COUNT)
  5000  EE9A  dd6616                    LD      H,(IX+FCB_LAST_COUNT+1)
  5001  EE9D  09                        ADD     HL,BC
  5002  EE9E  dd7515                    LD      (IX+FCB_LAST_COUNT),L
  5003  EEA1  dd7416                    LD      (IX+FCB_LAST_COUNT+1),H
  5004  EEA4  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO BUFFER
  5005  EEA7  dd5622                    LD      D,(IX+FCB_POINTER+1)
  5006  EEAA  2a06fe                    LD      HL,(USER_BUF); GET POINTER TO USER'S DATA
  5007  EEAD  edb0                      LDIR; MOVE THE DATA
  5008                          
  5009  EEAF  dd7321                    LD      (IX+FCB_POINTER),E; UPDATE THE POINTER
  5010  EEB2  dd7222                    LD      (IX+FCB_POINTER+1),D
  5011  EEB5  ddcb18f6                  SET     MODE_DIRTY_BIT,(IX+FCB_MODE); SET THE DIRTY BIT
  5012                          
  5013                          ROOM1_OK:
  5014  EEB9  af                        XOR     A
  5015  EEBA  1803                      JR      PAST_WRITE_ERR
  5016                          WRITE_ERR2:
  5017  EEBC  3e09                      LD      A,BAD_FNUM_ERR
  5018                          WRITE_ERR1:
  5019  EEBE  b7                        OR      A
  5020                          PAST_WRITE_ERR:
  5021  EEBF  dde1                      POP     IX; RESTORE REGISTERS
  5022  EEC1  e1                        POP     HL
  5023  EEC2  d1                        POP     DE
  5024  EEC3  c1                        POP     BC
  5025  EEC4  c9                        RET
  5026                          ;WRITE_ERR1
  5027                          ;       POP     IX                         ; RESTORE REGISTERS
  5028                          ;       POP     HL
  5029                          ;       POP     DE
  5030                          ;       POP     BC
  5031                          ;       OR      A                          ; SET CONDITIONS
  5032                          ;       RET
  5033                          ;WRITE_ERR2
  5034                          ;       POP     IX                         ; RESTORE REGISTERS
  5035                          ;       POP     HL
  5036                          ;       POP     DE
  5037                          ;       POP     BC
  5038                          ;       LD      A,BAD_FNUM_ERR             ; SHOW AN ERROR
  5039                          ;       OR      A                          ; SET CONDITIONS
  5040                          ;       RET
  5041                          
  5042                          ;=======================================================================
  5043                          ;=======================================================================
  5044                          ;=======================================================================
  5045                          ;
  5046                          
  5047                          
  5048                          ;GLB    __SET_DATE,__GET_DATE
  5049                          ;EXT    EOS_YEAR,EOS_MONTH,EOS_DAY
  5050                          
  5051                          
  5052                          ;-----------------------------------------------------------------------
  5053                          ;
  5054                          ; __SET_DATE -- Set the current date.
  5055                          ;
  5056                          ; ENTRY PARAMETERS: B = day (1..31)
  5057                          ;                   C = month (1..12)
  5058                          ;                   D = year (83..99)
  5059                          ;
  5060                          ; EXIT PARAMETERS: none
  5061                          ;
  5062                          ;-----------------------------------------------------------------------
  5063                          
  5064                          __SET_DATE:
  5065  EEC5  f5                        PUSH    AF; SAVE THE CURRENT A
  5066                          
  5067  EEC6  78                        LD      A,B; STORE THE DAY
  5068  EEC7  32e2fd                    LD      (EOS_DAY),A
  5069  EECA  79                        LD      A,C; STORE THE MONTH
  5070  EECB  32e1fd                    LD      (EOS_MONTH),A
  5071  EECE  7a                        LD      A,D; STORE THE YEAR
  5072  EECF  32e0fd                    LD      (EOS_YEAR),A
  5073                          
  5074  EED2  f1                        POP     AF; RESTORE A
  5075  EED3  c9                        RET
  5076                          
  5077                          ;-----------------------------------------------------------------------
  5078                          ;
  5079                          ; __GET_DATE -- Reads the current date.
  5080                          ;
  5081                          ; ENTRY PARAMETERS: none
  5082                          ;
  5083                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  5084                          ;                  B = day
  5085                          ;                  C = month
  5086                          ;                  D = year
  5087                          ;
  5088                          ;                  error (date never set) -- Z = 0; A = error code
  5089                          ;                  B = 0
  5090                          ;                  C = 0
  5091                          ;                  D = 0
  5092                          ;
  5093                          ;-----------------------------------------------------------------------
  5094                          
  5095                          __GET_DATE:
  5096  EED4  3ae2fd                    LD      A,(EOS_DAY)
  5097  EED7  47                        LD      B,A; GET THE DAY
  5098  EED8  3ae1fd                    LD      A,(EOS_MONTH)
  5099  EEDB  4f                        LD      C,A; GET THE MONTH
  5100  EEDC  3ae0fd                    LD      A,(EOS_YEAR)
  5101  EEDF  57                        LD      D,A; GET THE YEAR
  5102                          
  5103  EEE0  b0                        OR      B
  5104  EEE1  b1                        OR      C; CHECK FOR ALL = 0
  5105  EEE2  2802                      JR      Z,GET_ERROR; BRANCH IF ERROR
  5106  EEE4  af                        XOR     A; SHOW NO ERROR
  5107  EEE5  c9                        RET
  5108                          
  5109                          GET_ERROR:
  5110  EEE6  3e04                      LD      A,NO_DATE_ERR; SHOW AN ERROR OCCURRED
  5111  EEE8  b7                        OR      A; CLEAR Z FLAG
  5112  EEE9  c9                        RET
  5113                          ;
  5114                          ;=======================================================================
  5115                          ;=======================================================================
  5116                          ;=======================================================================
  5117                          ;
  5118                          
  5119                          
  5120                          ;
  5121                          ; Rev. 1   07oct515p  RPD  made __DELETE_FILE check for protected file
  5122                          ;
  5123                          
  5124                          ;GLB    __FMGR_INIT,SCAN_FOR_FILE,STRCMP,MODE_CHECK
  5125                          ;GLB    READ_BLOCK,WRITE_BLOCK,BASECMP,__WRITE_BLOCK
  5126                          ;GLB    __MODE_CHECK,__READ_BLOCK,SCAN_FOR_FILE
  5127                          ;EXT    __RD_1_BLOCK,__WR_1_BLOCK,__REQUEST_STATUS
  5128                          ;EXT    __QUERY_FILE,__SET_FILE
  5129                          ;EXT    QUERY_BUFFER,FILENAME_CMPS
  5130                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  5131                          ;EXT    USER_NAME,BUF_START
  5132                          ;EXT    RETRY_COUNT
  5133                          ;EXT    FILE_COUNT,MOD_FILE_COUNT
  5134                          
  5135                          
  5136                          ;-----------------------------------------------------------------------
  5137                          ;
  5138                          ; __FMGR_INIT: sets up everything to start with.
  5139                          ;
  5140                          ; ENTRY PARAMETERS: DE contains address to place FCB buffers.
  5141                          ;                   and HL contains address to place FCB headers.
  5142                          ;
  5143                          ; EXIT PARAMETERS: none.
  5144                          ;
  5145                          ;-----------------------------------------------------------------------
  5146                          
  5147                          __FMGR_INIT:
  5148  EEEA  ed53fffd                  LD      (FCB_DATA_ADDR),DE; SAVE BUFFER ADDRESS
  5149  EEEE  22fdfd                    LD      (FCB_HEAD_ADDR),HL; SAVE HEADER ADDRESS
  5150                          
  5151  EEF1  c5                        PUSH    BC; SAVE REGISTERS
  5152  EEF2  d5                        PUSH    DE
  5153  EEF3  dde5                      PUSH    IX
  5154                          
  5155  EEF5  0603                      LD      B,NUM_FCBS; SET TO # FCBS
  5156  EEF7  112300                    LD      DE,FCB_LENGTH; SET FOR ADDITION
  5157  EEFA  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR); GET ADDR OF 0TH FCB
  5158                          
  5159                          INIT_LOOP:
  5160  EEFE  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED; SHOW THE FCB IS EMPTY
  5161  EF02  dd19                      ADD     IX,DE; ADVANCE POINTER TO NEXT FCB
  5162  EF04  10f8                      DJNZ    INIT_LOOP; LOOP FOR ALL FCBS
  5163                          
  5164  EF06  dde1                      POP     IX; RESTORE REGISTERS
  5165  EF08  d1                        POP     DE
  5166  EF09  c1                        POP     BC
  5167  EF0A  c9                        RET
  5168                          
  5169                          ;-----------------------------------------------------------------------
  5170                          ;
  5171                          ; SCAN_FOR_FILE -- Look in the directory for a file name.
  5172                          ;                  Reads each block of the directory into a buffer
  5173                          ;                  (in the system's FCB) and scans through for a
  5174                          ;                  match with the caller's string.
  5175                          ;
  5176                          ; ENTRY PARAMETERS: address of name string in HL; device # in A
  5177                          ;                   ASSUMES FILENAME_CMP SET UP FOR FILE COMPARES
  5178                          ;                   0 - USE STRCMP .  NOT 0 - USE BASECMP  FOR FILE NAME COMPARISONS
  5179                          ;
  5180                          ; EXIT PARAMETERS: if match found -- Z = 1; A = 0; file's start
  5181                          ;                  block in BCDE; directory block left in buffer.
  5182                          ;                  address of entry left in FCB_POINTER.
  5183                          ;
  5184                          ;                  if no match found -- Z = 0; A = error code;
  5185                          ;                  BCDE = junk; other stuff = junk.
  5186                          ;
  5187                          ;-----------------------------------------------------------------------
  5188                          
  5189                          __SCAN_FOR_FILE:
  5190                          SCAN_FOR_FILE:
  5191  EF0B  e5                        PUSH    HL; SAVE REGISTERS
  5192  EF0C  dde5                      PUSH    IX
  5193  EF0E  fde5                      PUSH    IY
  5194                          
  5195  EF10  2210fe                    LD      (USER_NAME),HL; SAVE USER'S STRING ADDRESS
  5196                          
  5197  EF13  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR); GET ADDRESS OF SYSTEM'S FCB
  5198                          
  5199                          ; First, set up as much of the FCB as we can.
  5200  EF17  dd7717                    LD      (IX+FCB_DEVICE),A; SET THE DEVICE ADDRESS PASSED TO US
  5201                          
  5202  EF1A  dd361901                  LD      (IX+FCB_BLOCK),1; SET BLOCK TO 1
  5203  EF1E  dd361a00                  LD      (IX+FCB_BLOCK+1),0
  5204  EF22  dd361b00                  LD      (IX+FCB_BLOCK+2),0
  5205  EF26  dd361c00                  LD      (IX+FCB_BLOCK+3),0
  5206                          
  5207  EF2A  ed5bfffd                  LD      DE,(FCB_DATA_ADDR); SET BUFFER ADDRESS
  5208  EF2E  dd7321                    LD      (IX+FCB_POINTER),E
  5209  EF31  dd7222                    LD      (IX+FCB_POINTER+1),D
  5210                          
  5211                          RD_TIMEOUT:
  5212  EF34  21d4fd                    LD      HL,FILE_COUNT
  5213  EF37  3600                      LD      (HL),0
  5214                          
  5215  EF39  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  5216  EF3C  2afffd                    LD      HL,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5217  EF3F  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  5218  EF42  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  5219  EF45  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  5220  EF48  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  5221  EF4B  cd7bf1                    CALL    READ_BLOCK; READ FIRST BLOCK OF DIRECTORY
  5222  EF4E  c226f0                    JP      NZ,SCAN_ERROR; BRANCH IF ERROR
  5223                          
  5224                          GET_BUFF_ADDR:
  5225                          
  5226  EF51  e5                        PUSH    HL; GET BUFFER ADDRESS INTO IY TOO
  5227  EF52  fde1                      POP     IY
  5228                          
  5229  EF54  fd7e0c                    LD      A,(IY+VOL_DIRSIZE); GET THE DIRECTORY SIZE
  5230  EF57  e67f                      AND     07FH; ZERO PERM BIT
  5231                          ;       INC     A                           ; ADD 1 'CAUSE WE START IN BLOCK 1
  5232                          ;       DEC     A                           ; SUB 1 'CAUSE OF PICKET FENCE PROBLEM
  5233  EF59  dd771d                    LD      (IX+FCB_LAST_BLOCK),A; SET LAST BLOCK IN FCB
  5234  EF5C  dd361e00                  LD      (IX+FCB_LAST_BLOCK+1),0; (ALL MSBYTES WILL BE 0)
  5235  EF60  dd361f00                  LD      (IX+FCB_LAST_BLOCK+2),0
  5236  EF64  dd362000                  LD      (IX+FCB_LAST_BLOCK+3),0
  5237                          
  5238  EF68  cd35f0                    CALL    CHECK_IF_DIRECTORY; CHECK IF DIRECTORY EXIST
  5239  EF6B  c226f0                    JP      NZ,SCAN_ERROR
  5240                          
  5241  EF6E  dd7e21                    LD      A,(IX+FCB_POINTER); ADVANCE POINTER TO NEXT ENTRY
  5242  EF71  c61a                      ADD     A,DIR_ENT_LENGTH
  5243  EF73  dd7721                    LD      (IX+FCB_POINTER),A
  5244  EF76  dd7e22                    LD      A,(IX+FCB_POINTER+1)
  5245  EF79  ce00                      ADC     A,0
  5246  EF7B  dd7722                    LD      (IX+FCB_POINTER+1),A
  5247                          
  5248  EF7E  21d4fd                    LD      HL,FILE_COUNT
  5249  EF81  34                        INC     (HL)
  5250                          
  5251  EF82  0626                      LD      B,ENT_PER_BLOCK-1; SET DIR ENTRY COUNT FOR FIRST BLOCK
  5252  EF84  184b                      JR      SCAN2; JUMP INTO THE LOOP
  5253                          
  5254                          SCAN1:
  5255  EF86  dd3419                    INC     (IX+FCB_BLOCK); INC THE BLOCK NUMBER
  5256                          ; WE CAN ASSUME THERE'S NO CARRY OUT
  5257                          
  5258                          ; SEE IF THERE IS MORE DIRECTORY: I.E. IS FCB_BLOCK > FCB_LAST_BLOCK?
  5259                          ; IF TRUE. GO TO NO_ENT.
  5260                          
  5261  EF89  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3)
  5262  EF8C  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  5263  EF8F  da2cf0                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5264  EF92  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  5265  EF95  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  5266  EF98  da2cf0                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5267  EF9B  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  5268  EF9E  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  5269  EFA1  da2cf0                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5270  EFA4  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  5271  EFA7  ddbe19                    CP      (IX+FCB_BLOCK)
  5272  EFAA  da2cf0                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5273                          
  5274                          RD_TIMEOUT1:
  5275  EFAD  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  5276  EFB0  2afffd                    LD      HL,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5277  EFB3  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  5278  EFB6  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  5279  EFB9  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  5280  EFBC  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  5281  EFBF  cd7bf1                    CALL    READ_BLOCK; READ THE NEXT BLOCK
  5282  EFC2  c226f0                    JP      NZ,SCAN_ERROR; BRANCH IF ERROR
  5283                          
  5284                          GET_BUFF_ADDR1:
  5285                          
  5286                          
  5287  EFC5  ed5bfffd                  LD      DE,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5288  EFC9  dd7321                    LD      (IX+FCB_POINTER),E; PUT IT INTO THE FCB
  5289  EFCC  dd7222                    LD      (IX+FCB_POINTER+1),D
  5290                          
  5291  EFCF  0627                      LD      B,ENT_PER_BLOCK; SET ENTRY COUNT
  5292                          
  5293                          SCAN2:
  5294  EFD1  21d4fd                    LD      HL,FILE_COUNT
  5295  EFD4  34                        INC     (HL)
  5296                          
  5297  EFD5  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO DE
  5298  EFD8  dd5622                    LD      D,(IX+FCB_POINTER+1)
  5299                          
  5300  EFDB  2e0c                      LD      L,DIR_ATTR; OFFSET (FOR ATTR) INTO DIR ENTRY
  5301  EFDD  2600                      LD      H,0; NOT USED
  5302  EFDF  19                        ADD     HL,DE; SET UP HL TO POINT TO IT
  5303  EFE0  cb46                      BIT     ATTR_HOLE_BIT,(HL); IS IT THE HOLE?
  5304  EFE2  2048                      JR      NZ,NO_ENT; YUP. DON'T BOTHER SEARCHING ANY MORE
  5305  EFE4  cb56                      BIT     ATTR_DEL_BIT,(HL); IS THIS FILE DELETED?
  5306  EFE6  2013                      JR      NZ,FILE_DELETED; YUP. DON'T EVEN BOTHER CHECK FILE NAMES
  5307                          
  5308  EFE8  2a10fe                    LD      HL,(USER_NAME)
  5309                          
  5310  EFEB  3ad8fd                    LD      A,(FILENAME_CMPS)
  5311  EFEE  b7                        OR      A; IS IT ZERO?
  5312  EFEF  2805                      JR      Z,FULL_FILENAME; YUP. COMPARE THE FULL FILE NAME
  5313  EFF1  cd54f0                    CALL    BASECMP; NOPE. COMPARE JUST THE BASE
  5314  EFF4  1803                      JR      ERROR_CHECK
  5315                          FULL_FILENAME:
  5316  EFF6  cd53f0                    CALL    STRCMP; COMPARE THE FULL FILE NAME (BASE PLUS EXTENSION)
  5317                          ERROR_CHECK:
  5318  EFF9  2815                      JR      Z,SCAN3; BRANCH IF YES
  5319                          
  5320                          FILE_DELETED:
  5321  EFFB  dd7e21                    LD      A,(IX+FCB_POINTER); ADVANCE POINTER TO NEXT ENTRY
  5322  EFFE  c61a                      ADD     A,DIR_ENT_LENGTH
  5323  F000  dd7721                    LD      (IX+FCB_POINTER),A
  5324  F003  dd7e22                    LD      A,(IX+FCB_POINTER+1)
  5325  F006  ce00                      ADC     A,0
  5326  F008  dd7722                    LD      (IX+FCB_POINTER+1),A
  5327                          
  5328  F00B  10c4                      DJNZ    SCAN2; LOOP IF MORE ENTRIES TO CHECK IN THIS BLOCK
  5329                          
  5330  F00D  c386ef                    JP      SCAN1; ELSE GET NEXT BLOCK
  5331                          
  5332                          SCAN3:
  5333  F010  d5                        PUSH    DE; GET DIR ENTRY PTR INTO IY
  5334  F011  fde1                      POP     IY
  5335                          
  5336  F013  fd5e0d                    LD      E,(IY+DIR_START_BLOCK+0)
  5337  F016  fd560e                    LD      D,(IY+DIR_START_BLOCK+1)
  5338  F019  fd4e0f                    LD      C,(IY+DIR_START_BLOCK+2)
  5339  F01C  fd4610                    LD      B,(IY+DIR_START_BLOCK+3)
  5340                          
  5341  F01F  fde1                      POP     IY; RESTORE REGISTERS
  5342  F021  dde1                      POP     IX
  5343  F023  e1                        POP     HL
  5344  F024  af                        XOR     A; SHOW NO ERROR
  5345  F025  c9                        RET
  5346                          
  5347                          SCAN_ERROR:
  5348  F026  fde1                      POP     IY; RESTORE REGISTERS
  5349  F028  dde1                      POP     IX
  5350  F02A  e1                        POP     HL
  5351  F02B  c9                        RET
  5352                          
  5353                          NO_ENT:
  5354  F02C  fde1                      POP     IY; RESTORE REGISTERS
  5355  F02E  dde1                      POP     IX
  5356  F030  e1                        POP     HL
  5357  F031  3e05                      LD      A,NO_FILE_ERR
  5358  F033  b7                        OR      A
  5359  F034  c9                        RET
  5360                          
  5361                          
  5362                          

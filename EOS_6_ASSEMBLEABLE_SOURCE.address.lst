  7262                          ;
  7263                          ;External Routines
  7264                          ;
  7265                          ;EXT    WRITE_VRAM       ;OS-7
  7266                          ;EXT    READ_VRAM        ;OS-7
  7267                          ;
  7268                          ;External data structures used
  7269                          ;
  7270                          ;EXT    OLDCHAR_
  7271                          ;EXT    X_MIN
  7272                          ;EXT    X_MAX
  7273                          ;EXT    Y_MIN
  7274                          ;EXT    Y_MAX
  7275                          ;EXT    LINEBUFFER_
  7276                          ;EXT    NUM_LINES
  7277                          ;EXT    NUM_COLUMNS
  7278                          ;EXT    UPPER_LEFT
  7279                          ;EXT    PTRN_NAME_TBL
  7280                          ;EXT    CURSOR
  7281                          
  7282                          
  7283                          ;
  7284                          ;Local Equates
  7285                          ;
  7286                          LF              EQU     0AH
  7287                          FF              EQU     0CH
  7288                          BS              EQU     08H
  7289                          CR              EQU     0DH
  7290                          CLR_TO_EOL      EQU     16H
  7291                          CLR_TO_EOS      EQU     18H; [RECON] OCR 7363: scan value column is <0018>.
  7292                          GOTO_XY_CHAR    EQU     1CH
  7293                          HOME            EQU     80H
  7294                          UP              EQU     0A0H
  7295                          RIGHT           EQU     0A1H
  7296                          DOWN            EQU     0A2H
  7297                          LEFT            EQU     0A3H
  7298                          CURSOR_CHAR     EQU     05FH;Char to emit as cursor
  7299                          BLANKING_CHAR   EQU     020H;Char used when scrolling to fill screen ; [RECON] OCR 7371: scan value column is <0020> (space).
  7300                          CURSOR_X        EQU     CURSOR+1
  7301                          
  7302                          
  7303                          ;
  7304                          ;__CONS_INIT
  7305                          ;
  7306                          ;       Sets up the window sizes for the CONSOLE_OUT routine
  7307                          ;
  7308                          ;Input parameters:
  7309                          ; B - number of columns in the window - 1, 0..31
  7310                          ; C - number of lines in the window - 1, 0..23
  7311                          ; D - Absolute (0 based) X coord of upper left corner of window, 0..31
  7312                          ; E - Absolute (0 based) Y coord of upper left corner of window, 0..23
  7313                          ; HL - Pattern Name Table (PNT) starting address
  7314                          ;
  7315                          ;NOTE- User must initialize the VDP
  7316                          ;
  7317                          ;GLB    __CONS_INIT
  7318                          __CONS_INIT:
  7319  F5DC  04                        INC     B;Adjust for old calling convention
  7320  F5DD  0c                        INC     C
  7321  F5DE  ed439ffe                  LD      (NUM_LINES),BC;Set num lines, cols in window
  7322  F5E2  ed53a1fe                  LD      (UPPER_LEFT),DE;Set upper left corner of window
  7323  F5E6  ed53a5fe                  LD      (CURSOR),DE
  7324  F5EA  22a3fe                    LD      (PTRN_NAME_TBL),HL;Save address of Pattern name table
  7325                          
  7326  F5ED  7a                        LD      A,D;Calc min/max coords of window
  7327  F5EE  327afe                    LD      (X_MIN),A
  7328  F5F1  80                        ADD     A,B
  7329  F5F2  3d                        DEC     A
  7330  F5F3  327bfe                    LD      (X_MAX),A
  7331  F5F6  7b                        LD      A,E
  7332  F5F7  327cfe                    LD      (Y_MIN),A
  7333  F5FA  81                        ADD     A,C
  7334  F5FB  3d                        DEC     A
  7335  F5FC  327dfe                    LD      (Y_MAX),A
  7336                          
  7337  F5FF  3e20                      LD      A,BLANKING_CHAR
  7338  F601  3279fe                    LD      (OLDCHAR_),A
  7339  F604  3e5f                      LD      A,CURSOR_CHAR
  7340  F606  cddaf7                    CALL    PUT_CHAR_ON_SCREEN
  7341                          
  7342  F609  c9                        RET
  7343                          
  7344                          ;
  7345                          ;__CONS_OUT  - This entry point will check special chars such as
  7346                          ;              Carriage Return and performs their normal functions
  7347                          ;              all other, printable, chars are put onto the screen
  7348                          ;
  7349                          ;__CONS_DISP - This entry point will put all chars onto the screen
  7350                          ;              no matter what, no checking is done for control chars
  7351                          ;
  7352                          ;
  7353                          ;Input Parameters:
  7354                          ; A - character to emit
  7355                          ;
  7356                          ; optionally
  7357                          ; E - Y location to goto (must be in window)
  7358                          ; D - X location to goto (must be in window)
  7359                          ;
  7360                          ;
  7361                          ; Saves all registers
  7362                          ;
  7363                          ;GLB    __CONS_OUT
  7364                          ;GLB    __CONS_DISP
  7365                          __CONS_OUT:
  7366  F60A  f5                        PUSH    AF
  7367  F60B  c5                        PUSH    BC
  7368  F60C  e5                        PUSH    HL
  7369  F60D  dde5                      PUSH    IX
  7370  F60F  fde5                      PUSH    IY
  7371  F611  d5                        PUSH    DE;This may contain the X-Y coord of goto xy
  7372                          
  7373  F612  210ef8                    LD      HL,SPECIAL_CHARS
  7374  F615  010c00                    LD      BC,NUM_SPCL_CHARS
  7375  F618  edb1                      CPIR
  7376  F61A  2013                      JR      NZ,NOT_SPECIAL
  7377                          
  7378  F61C  211af8                    LD      HL,SPCL_VECTOR_TBL
  7379  F61F  09                        ADD     HL,BC
  7380  F620  09                        ADD     HL,BC
  7381                          
  7382  F621  47                        LD      B,A;Save char in B
  7383                          
  7384  F622  7e                        LD      A,(HL)
  7385  F623  23                        INC     HL
  7386  F624  66                        LD      H,(HL)
  7387  F625  6f                        LD      L,A
  7388  F626  e9                        JP      (HL);Vector to special char handler
  7389                          
  7390                          __CONS_DISP:
  7391  F627  f5                        PUSH    AF
  7392  F628  c5                        PUSH    BC
  7393  F629  e5                        PUSH    HL
  7394  F62A  dde5                      PUSH    IX
  7395  F62C  fde5                      PUSH    IY
  7396  F62E  d5                        PUSH    DE
  7397                          NOT_SPECIAL:
  7398  F62F  cddaf7                    CALL    PUT_CHAR_ON_SCREEN;Display char where cursor is at
  7399  F632  2aa5fe                    LD      HL,(CURSOR)
  7400  F635  24                        INC     H;Move cursor to right (+1)
  7401  F636  3a7bfe                    LD      A,(X_MAX); but check for going out of
  7402  F639  bc                        CP      H; the window
  7403  F63A  3014                      JR      NC,SAVE_CURSOR;If taken then stayed in window
  7404  F63C  3a7afe                    LD      A,(X_MIN);Went out of window so set X
  7405  F63F  67                        LD      H,A; to left edge
  7406  F640  2c                        INC     L; and move down one line
  7407  F641  3a7dfe                    LD      A,(Y_MAX); but check to see if still
  7408  F644  bd                        CP      L; in the window
  7409  F645  3009                      JR      NC,SAVE_CURSOR
  7410  F647  2d                        DEC     L; Put back into window
  7411  F648  e5                        PUSH    HL
  7412  F649  cdedf7                    CALL    GET_CHAR_UNDER_CURSOR
  7413  F64C  cd94f7                    CALL    SCROLL_UP
  7414  F64F  e1                        POP     HL
  7415                          
  7416  F650  22a5fe            SAVE_CURSOR: LD      (CURSOR),HL
  7417  F653  cdf0f7            NEW_CURSOR: CALL    GET_CHAR_UNDER
  7418                          PUT_CURSOR_ON:
  7419  F656  3e5f                      LD      A,CURSOR_CHAR
  7420  F658  cddaf7                    CALL    PUT_CHAR_ON_SCREEN
  7421                          
  7422  F65B  d1                EXIT: POP     DE
  7423  F65C  fde1                      POP     IY
  7424  F65E  dde1                      POP     IX
  7425  F660  e1                        POP     HL
  7426  F661  c1                        POP     BC
  7427  F662  f1                        POP     AF
  7428  F663  c9                        RET
  7429                          
  7430                          ;
  7431                          ;Special Character Handlers
  7432                          ;
  7433                          
  7434                          ; RETURN_WITH_ERASE - moves cursor to right edge of window on current line
  7435                          ;                     after clearing to end of line
  7436                          ;
  7437                          RETURN_WITH_ERASE:
  7438                          ;         CALL    ERASE_THIS_LINE ; [RECON] OCR 7510 is commented in the scan.
  7439  F664  cdd7f7            RETURN: CALL    PUT_OLD_ON_SCREEN;Display char cursor was hiding
  7440  F667  3a7afe                    LD      A,(X_MIN)
  7441  F66A  32a6fe                    LD      (CURSOR_X),A
  7442  F66D  2aa5fe                    LD      HL,(CURSOR)
  7443  F670  c353f6                    JP      NEW_CURSOR
  7444                          
  7445                          ;
  7446                          ; MOVE_UP - Moves the cursor up if not at top of window
  7447                          ;
  7448                          MOVE_UP:
  7449  F673  2aa5fe                    LD      HL,(CURSOR)
  7450  F676  3a7cfe                    LD      A,(Y_MIN)
  7451  F679  bd                        CP      L
  7452  F67A  28df                      JR      Z,EXIT;Forget request
  7453  F67C  2d                        DEC     L;Move up
  7454                          
  7455  F67D  cdd7f7            RESTORE_OLD: CALL    PUT_OLD_ON_SCREEN;Display char cursor was hiding
  7456  F680  c350f6                    JP      SAVE_CURSOR;Display cursor in new spot
  7457                          
  7458                          ;
  7459                          ; MOVE_DOWN - Moves the cursor down if will stay in window, except
  7460                          ;             if used by linefeed when the screen is scrolled
  7461                          ;
  7462                          MOVE_DOWN:
  7463                          
  7464  F683  2aa5fe                    LD      HL,(CURSOR)
  7465  F686  3a7dfe                    LD      A,(Y_MAX);See if at bottom of window
  7466  F689  bd                        CP      L
  7467  F68A  2804                      JR      Z,SCROLL_POSSIBLE
  7468  F68C  2c                        INC     L;Move down
  7469  F68D  c37df6                    JP      RESTORE_OLD
  7470                          ;
  7471  F690  3e0a              SCROLL_POSSIBLE: LD      A,LF;See if linefeed, and if it is
  7472  F692  b8                        CP      B; then scroll up. else leave
  7473  F693  20c6                      JR      NZ,EXIT; cursor and screen as is
  7474  F695  cd94f7                    CALL    SCROLL_UP
  7475  F698  2aa5fe                    LD      HL,(CURSOR)
  7476  F69B  c353f6                    JP      NEW_CURSOR
  7477                          
  7478                          ;
  7479                          ; MOVE_RIGHT - Moves the cursor to the right, and if at window's
  7480                          ;              edge will move down a line to the left edge, unless
  7481                          ;              at the lower right corner of the window in which case
  7482                          ;              nothing is down
  7483                          ;
  7484                          MOVE_RIGHT:
  7485  F69E  2aa5fe                    LD      HL,(CURSOR)
  7486  F6A1  3a7bfe                    LD      A,(X_MAX)
  7487  F6A4  bc                        CP      H
  7488  F6A5  2804                      JR      Z,TRY_MOVE_DOWN
  7489  F6A7  24                        INC     H;Move to right
  7490  F6A8  c37df6                    JP      RESTORE_OLD
  7491                          ;
  7492  F6AB  3a7dfe            TRY_MOVE_DOWN: LD      A,(Y_MAX)
  7493  F6AE  bd                        CP      L
  7494  F6AF  28aa                      JR      Z,EXIT;At bottom of window so abort
  7495  F6B1  2c                        INC     L
  7496  F6B2  3a7afe                    LD      A,(X_MIN)
  7497  F6B5  67                        LD      H,A
  7498  F6B6  c37df6                    JP      RESTORE_OLD
  7499                          
  7500                          ;
  7501                          ; MOVE_LEFT - Moves the cursor to the left and if at left edge of
  7502                          ;             window will move up a line an to right edge if not
  7503                          ;             at upper left corner of window
  7504                          ;
  7505  F6B9  2aa5fe            MOVE_LEFT: LD      HL,(CURSOR)
  7506  F6BC  3a7afe                    LD      A,(X_MIN)
  7507  F6BF  bc                        CP      H
  7508  F6C0  2804                      JR      Z,TRY_SCROLL_UP
  7509  F6C2  25                        DEC     H;Move to left
  7510  F6C3  c37df6                    JP      RESTORE_OLD
  7511                          ;
  7512  F6C6  3a7cfe            TRY_SCROLL_UP: LD      A,(Y_MIN)
  7513  F6C9  bd                        CP      L
  7514  F6CA  288f                      JR      Z,EXIT;Abort if at upper left corner
  7515  F6CC  2d                        DEC     L
  7516  F6CD  3a7bfe                    LD      A,(X_MAX)
  7517  F6D0  67                        LD      H,A
  7518  F6D1  c37df6                    JP      RESTORE_OLD
  7519                          
  7520                          ;
  7521                          ; MOVE_HOME - Moves cursor to the upper left corner of the window
  7522                          ;
  7523                          
  7524                          ; FORM_FEED - Clears the screen and puts the cursor at the upper left
  7525                          ;             corner of the window
  7526                          FORM_FEED:
  7527  F6D4  3a9ffe                    LD      A,(NUM_LINES)
  7528  F6D7  47                        LD      B,A
  7529  F6D8  2aa1fe                    LD      HL,(UPPER_LEFT)
  7530                          
  7531  F6DB  cd4cf7                    CALL    BLANK_SCREEN
  7532                          
  7533  F6DE  3e20                      LD      A,BLANKING_CHAR
  7534  F6E0  3279fe                    LD      (OLDCHAR_),A
  7535                          
  7536  F6E3  cdd7f7            MOVE_HOME: CALL    PUT_OLD_ON_SCREEN;Needed only for MOVE_HOME not FORM_FEED
  7537  F6E6  2aa1fe                    LD      HL,(UPPER_LEFT)
  7538  F6E9  c350f6                    JP      SAVE_CURSOR
  7539                          
  7540                          ;
  7541                          ; ERASE_TO_EOL - From cursor position fills rest of line
  7542                          ;                with BLANKING_CHAR, to end of window only
  7543                          ;                Will blank char under cursor always.
  7544                          ;
  7545                          ERASE_TO_EOL:
  7546  F6EC  cd66f7                    CALL    ERASE_THIS_LINE
  7547  F6EF  c356f6                    JP      PUT_CURSOR_ON
  7548                          
  7549                          ;
  7550                          ; ERASE_TO_EOS - Will erase the screen (window) from the current
  7551                          ;                cursor position to the end of the window. The
  7552                          ;                cursor position is also blanked.
  7553                          ;
  7554                          ;
  7555                          ERASE_TO_EOS:
  7556  F6F2  cd66f7                    CALL    ERASE_THIS_LINE;Erase to end of current line
  7557  F6F5  2aa5fe                    LD      HL,(CURSOR)
  7558  F6F8  2c                        INC     L;Move down
  7559  F6F9  3a7cfe                    LD      A,(Y_MIN)
  7560  F6FC  4f                        LD      C,A
  7561  F6FD  3a9ffe                    LD      A,(NUM_LINES)
  7562  F700  81                        ADD     A,C
  7563  F701  95                        SUB     L;Number of lines left to blank
  7564  F702  ca56f6                    JP      Z,PUT_CURSOR_ON
  7565  F705  47                        LD      B,A
  7566  F706  3a7afe                    LD      A,(X_MIN)
  7567  F709  67                        LD      H,A
  7568  F70A  cd4cf7                    CALL    BLANK_SCREEN
  7569  F70D  c356f6                    JP      PUT_CURSOR_ON
  7570                          
  7571                          ;
  7572                          ; GOTO_XY - Puts cursor to desired X-Y coord if in window
  7573                          ;
  7574                          ;Input Parameters:
  7575                          ; D - X location
  7576                          ; E - Y location
  7577                          ;
  7578                          GOTO_XY:
  7579  F710  3a7afe                    LD      A,(X_MIN)
  7580  F713  ba                        CP      D
  7581  F714  2803                      JR      Z,CHK_X_WITH_MAX
  7582  F716  d25bf6                    JP      NC,EXIT
  7583  F719  3a7bfe            CHK_X_WITH_MAX: LD      A,(X_MAX)
  7584  F71C  ba                        CP      D
  7585  F71D  2803                      JR      Z,CHK_Y_COORD
  7586  F71F  da5bf6                    JP      C,EXIT
  7587  F722  3a7cfe            CHK_Y_COORD: LD      A,(Y_MIN)
  7588  F725  bb                        CP      E
  7589  F726  2803                      JR      Z,CHK_Y_WITH_MAX
  7590  F728  d25bf6                    JP      NC,EXIT
  7591  F72B  3a7dfe            CHK_Y_WITH_MAX: LD      A,(Y_MAX)
  7592  F72E  bb                        CP      E
  7593  F72F  2803                      JR      Z,SET_CURSOR
  7594  F731  da5bf6                    JP      C,EXIT
  7595  F734  eb                SET_CURSOR: EX      DE,HL
  7596  F735  c37df6                    JP      RESTORE_OLD
  7597                          
  7598                          ;
  7599                          ;Internal Subroutines
  7600                          ;
  7601                          
  7602                          ; Subroutine
  7603                          ; BLANK_PORTION - Fills LINEBUFFER_ with number of chars in B
  7604                          ;                 from where HL points
  7605                          ;
  7606                          ; Input Parameters:
  7607                          ; HL - Pointer into LINEBUFFER
  7608                          ; B  - Number of the BLANKING_CHAR's to stuff in
  7609                          ;
  7610                          ; A is destroyed
  7611                          ;
  7612                          BLANK_PORTION:
  7613  F738  e5                        PUSH    HL
  7614  F739  c5                        PUSH    BC
  7615  F73A  1807                      JR      BLANK_REST
  7616                          
  7617                          ;
  7618                          ; Subroutine
  7619                          ; BLANKS        - Fills LINEBUFFER_ with 32 BLANKING_CHAR's
  7620                          ;
  7621                          ; A is destroyed
  7622                          ;
  7623                          BLANKS:
  7624  F73C  e5                        PUSH    HL
  7625  F73D  c5                        PUSH    BC
  7626  F73E  217efe                    LD      HL,LINEBUFFER_
  7627  F741  0620                      LD      B,32
  7628  F743  3e20              BLANK_REST: LD      A,BLANKING_CHAR
  7629  F745  77                BLANK_FILL: LD      (HL),A
  7630  F746  23                        INC     HL
  7631  F747  10fc                      DJNZ    BLANK_FILL
  7632  F749  c1                        POP     BC
  7633  F74A  e1                        POP     HL
  7634  F74B  c9                        RET
  7635                          
  7636                          ;
  7637                          ; Subroutine
  7638                          ; BLANK_SCREEN  - Will blank a given number of lines on the screen
  7639                          ;
  7640                          ; Input Parameters:
  7641                          ; B  - Number of lines to blank
  7642                          ; HL - Absolute X-Y coords of start position of 1st line to blank
  7643                          ;
  7644                          ; Destroys C, A, DE
  7645                          ; User must reset cursor
  7646                          ;
  7647                          BLANK_SCREEN:
  7648  F74C  cd3cf7                    CALL    BLANKS;Fill buffer with BLANKING_CHAR
  7649  F74F  3aa0fe                    LD      A,(NUM_COLUMNS)
  7650  F752  4f                        LD      C,A
  7651                          
  7652  F753  c5                BLNK_SCRN_LOOP: PUSH    BC
  7653  F754  e5                        PUSH    HL;Save X-Y coord of line
  7654  F755  cdfcf7                    CALL    CONVERT_XY
  7655  F758  0600                      LD      B,00H;C has number of bytes to read
  7656  F75A  217efe                    LD      HL,LINEBUFFER_
  7657  F75D  cd1afd                    CALL    WRITE_VRAM
  7658  F760  e1                        POP     HL
  7659  F761  2c                        INC     L;To next line below
  7660  F762  c1                        POP     BC
  7661  F763  10ee                      DJNZ    BLNK_SCRN_LOOP
  7662  F765  c9                        RET
  7663                          
  7664                          ;
  7665                          ; Subroutine
  7666                          ; ERASE_THIS_LINE - This routine will erase the current line
  7667                          ;                   from the cursor position to the right edge
  7668                          ;                   of the window, the char under the cursor is
  7669                          ;                   also blanked.
  7670                          ;
  7671                          ;Input Parameters:
  7672                          ; None
  7673                          ;
  7674                          ; Destroys all registers
  7675                          ; Sets OLDCHAR_ to BLANKING_CHAR
  7676                          ;
  7677                          ERASE_THIS_LINE:
  7678  F766  cd79f7                    CALL    READ_FROM_CURSOR_TO_EOL
  7679  F769  e5                        PUSH    HL
  7680  F76A  c5                        PUSH    BC
  7681  F76B  41                        LD      B,C
  7682  F76C  cd38f7                    CALL    BLANK_PORTION
  7683  F76F  c1                        POP     BC
  7684  F770  e1                        POP     HL
  7685                          
  7686  F771  3e20                      LD      A,BLANKING_CHAR
  7687  F773  3279fe                    LD      (OLDCHAR_),A
  7688                          
  7689  F776  c31afd                    JP      WRITE_VRAM;Write line with blanks, return thru WRITE_VRAM
  7690                          
  7691                          ;
  7692                          ;Subroutine
  7693                          ;READ_FROM_CURSOR_TO_EOL - reads the line on screen from the
  7694                          ;                          cursor position to the right edge of the
  7695                          ;                          screen
  7696                          ;
  7697                          ;Input Parameters:
  7698                          ; None
  7699                          ;
  7700                          ;Returns:
  7701                          ; BC - number of chars read
  7702                          ; HL - address of LINEBUFFER_
  7703                          ; DE - VRAM address of place cursor is
  7704                          ;
  7705                          READ_FROM_CURSOR_TO_EOL:
  7706  F779  2aa5fe                    LD      HL,(CURSOR)
  7707  F77C  3a7bfe                    LD      A,(X_MAX)
  7708  F77F  3c                        INC     A;Calc # chars to read
  7709  F780  94                        SUB     H
  7710  F781  4f                        LD      C,A
  7711  F782  cdfcf7                    CALL    CONVERT_XY
  7712  F785  217efe                    LD      HL,LINEBUFFER_
  7713  F788  0600                      LD      B,00H
  7714  F78A  c5                        PUSH    BC
  7715  F78B  e5                        PUSH    HL
  7716  F78C  d5                        PUSH    DE
  7717  F78D  cd1dfd                    CALL    READ_VRAM
  7718  F790  d1                        POP     DE
  7719  F791  e1                        POP     HL
  7720  F792  c1                        POP     BC
  7721  F793  c9                        RET
  7722                          ;:
  7723                          ;:
  7724                          ;:Subroutine
  7725                          ;: SCROLL_UP     - Scrolls the entire window up 1 line and puts a line
  7726                          ;:                 of BLANKING_CHAR's on the last line
  7727                          ;:
  7728                          ;:   Caller must restore cursor to screen
  7729                          ;:
  7730                          SCROLL_UP:
  7731  F794  cdd7f7                            CALL    PUT_OLD_ON_SCREEN
  7732  F797  2aa1fe                            LD      HL,(UPPER_LEFT)
  7733  F79A  e5                                PUSH    HL
  7734  F79B  cdfcf7                            CALL    CONVERT_XY
  7735  F79E  e1                                POP     HL
  7736  F79F  3a9ffe                            LD      A,(NUM_LINES)
  7737  F7A2  47                                LD      B,A
  7738  F7A3  05                                DEC     B
  7739                          ;:
  7740  F7A4  c5                SCROLL_LOOP: PUSH    BC;Save number of remaining lines
  7741  F7A5  d5                                PUSH    DE;Save next write location
  7742  F7A6  2c                                INC     L;Point to next line below
  7743  F7A7  e5                                PUSH    HL
  7744  F7A8  cdfcf7                            CALL    CONVERT_XY
  7745  F7AB  d5                                PUSH    DE;Save address of this read
  7746  F7AC  3aa0fe                            LD      A,(NUM_COLUMNS)
  7747  F7AF  4f                                LD      C,A
  7748  F7B0  0600                              LD      B,00H
  7749  F7B2  c5                                PUSH    BC;Save number of chars in line
  7750  F7B3  217efe                            LD      HL,LINEBUFFER_
  7751  F7B6  cd1dfd                            CALL    READ_VRAM
  7752  F7B9  c1                                POP     BC;Get number of bytes that were read
  7753  F7BA  d1                                POP     DE;Get address of last read
  7754  F7BB  e1                                POP     HL;Get X-Y coords
  7755  F7BC  e3                                EX      (SP),HL;Swap prev read address with X-Y coords
  7756  F7BD  eb                                EX      DE,HL;Swap last read with previous address
  7757  F7BE  e5                                PUSH    HL;  and save previous
  7758  F7BF  217efe                            LD      HL,LINEBUFFER_
  7759  F7C2  cd1afd                            CALL    WRITE_VRAM;Write line one line up
  7760  F7C5  d1                                POP     DE;Get address of next write
  7761  F7C6  e1                                POP     HL;Get starting X-Y of last read
  7762  F7C7  c1                                POP     BC
  7763  F7C8  10da                              DJNZ    SCROLL_LOOP
  7764                          ;:
  7765  F7CA  cd3cf7                            CALL    BLANKS
  7766  F7CD  217efe                            LD      HL,LINEBUFFER_; [RECON] Identifier repair: scan operand and active RAM symbol include the trailing underscore.
  7767  F7D0  3aa0fe                            LD      A,(NUM_COLUMNS)
  7768  F7D3  4f                                LD      C,A;B is 0 from DJNZ
  7769  F7D4  c31afd                            JP      WRITE_VRAM;Return thru WRITE_VRAM
  7770                          
  7771                          ;:
  7772                          ;: Subroutines
  7773                          ;: PUT_OLD_ON_SCREEN  - This entry point puts the char that the
  7774                          ;:                      cursor was on back onto the screen
  7775                          ;:
  7776                          ;: PUT_CHAR_ON_SCREEN - This entry point will put the char in A
  7777                          ;:                      onto the screen where the cursor currently is
  7778                          ;:
  7779                          ;:
  7780                          PUT_OLD_ON_SCREEN:
  7781  F7D7  3a79fe                            LD      A,(OLDCHAR_)
  7782                          ;:
  7783                          PUT_CHAR_ON_SCREEN:
  7784  F7DA  e5                                PUSH    HL
  7785  F7DB  2aa5fe                            LD      HL,(CURSOR);Get location to put char
  7786  F7DE  cdfcf7                            CALL    CONVERT_XY;Convert to a VRAM address
  7787  F7E1  217efe                            LD      HL,LINEBUFFER_
  7788  F7E4  77                                LD      (HL),A
  7789  F7E5  010100                            LD      BC,0001H
  7790  F7E8  cd1afd                            CALL    WRITE_VRAM
  7791  F7EB  e1                                POP     HL
  7792  F7EC  c9                                RET
  7793                          ;:
  7794                          ;:
  7795                          ;: Subroutine
  7796                          ;: GET_CHAR_UNDER_CURSOR - This entry loads HL from CURSOR before
  7797                          ;:                         falling into GET_CHAR_UNDER
  7798                          ;:
  7799                          ;: GET_CHAR_UNDER - Reads the char where the cursor will go
  7800                          ;:                  and saves it in the variable OLDCHAR_
  7801                          ;:
  7802                          ;:Input Parameters:
  7803                          ;: HL - Cursor position
  7804                          ;:
  7805                          ;: Destroys - HL, BC, DE, A
  7806                          ;:
  7807                          GET_CHAR_UNDER_CURSOR:
  7808  F7ED  2aa5fe                            LD      HL,(CURSOR)
  7809                          ;:
  7810                          GET_CHAR_UNDER:
  7811  F7F0  cdfcf7                            CALL    CONVERT_XY
  7812  F7F3  010100                            LD      BC,0001H
  7813  F7F6  2179fe                            LD      HL,OLDCHAR_
  7814  F7F9  c31dfd                            JP      READ_VRAM;Return thru READ_VRAM
  7815                          
  7816                          ;:
  7817                          ;: Subroutine
  7818                          ;:
  7819                          ;: CONVERT_XY - Converts X-Y coordinates on the screen to a
  7820                          ;:              VRAM address for that char position
  7821                          ;:              Calculates ((( Y * 32) + X ) + base of pattern name table
  7822                          ;:              to yield the absolute address in VRAM of the char
  7823                          ;:
  7824                          ;:Input Parameters:
  7825                          ;: H - X coord
  7826                          ;: L - Y coord
  7827                          ;:
  7828                          Returns:
  7829                          ;: DE - VRAM address
  7830                          ;: HL - Address of Pattern Name Table (side effect)
  7831                          ;: No Others are altered
  7832                          ;:
  7833                          CONVERT_XY:
  7834  F7FC  5c                                LD      E,H;Save X coord
  7835  F7FD  2600                              LD      H,00H
  7836  F7FF  29                                ADD     HL,HL;Calc Y coord * 32
  7837  F800  29                                ADD     HL,HL
  7838  F801  29                                ADD     HL,HL
  7839  F802  29                                ADD     HL,HL
  7840  F803  29                                ADD     HL,HL
  7841  F804  1600                              LD      D,00H
  7842  F806  19                                ADD     HL,DE;Add in X coord
  7843  F807  ed5ba3fe                          LD      DE,(PTRN_NAME_TBL)
  7844  F80B  19                                ADD     HL,DE
  7845  F80C  eb                                EX      DE,HL
  7846  F80D  c9                                RET
  7847                          
  7848                          ;:
  7849                          ;: This is a table of chars that perform some function rather
  7850                          ;: than being printed out to the screen as is. There is a
  7851                          ;: jump table that is associated with this table, but NOTE that
  7852                          ;: it has its entrys in reverse order of this table. It would
  7853                          ;: be best to add to the end of this table and to the beginning
  7854                          ;: of the jump table.
  7855                          ;:
  7856                          SPECIAL_CHARS:
  7857  F80E  08                                DEFB    BS
  7858  F80F  0d                                DEFB    CR
  7859  F810  0a                                DEFB    LF
  7860  F811  0c                                DEFB    FF
  7861  F812  80                                DEFB    HOME
  7862  F813  16                                DEFB    CLR_TO_EOL
  7863  F814  18                                DEFB    CLR_TO_EOS
  7864  F815  1c                                DEFB    GOTO_XY_CHAR
  7865  F816  a0                                DEFB    UP
  7866  F817  a2                                DEFB    DOWN
  7867  F818  a3                                DEFB    LEFT
  7868  F819  a1                                DEFB    RIGHT
  7869                          ;:
  7870                          NUM_SPCL_CHARS EQU $-SPECIAL_CHARS
  7871                          ;:
  7872                          
  7873                          ;:
  7874                          ;:NOTE - This table is in the reverse order of the chars so
  7875                          ;:       any additions to the end of the chars goes at the top
  7876                          ;:       of this table
  7877                          ;:
  7878                          SPCL_VECTOR_TBL:
  7879  F81A  9ef6                              DEFW    MOVE_RIGHT
  7880  F81C  b9f6                              DEFW    MOVE_LEFT
  7881  F81E  83f6                              DEFW    MOVE_DOWN
  7882  F820  73f6                              DEFW    MOVE_UP
  7883  F822  10f7                              DEFW    GOTO_XY
  7884  F824  f2f6                              DEFW    ERASE_TO_EOS
  7885  F826  ecf6                              DEFW    ERASE_TO_EOL
  7886  F828  e3f6                              DEFW    MOVE_HOME
  7887  F82A  d4f6                              DEFW    FORM_FEED
  7888  F82C  83f6                              DEFW    MOVE_DOWN
  7889  F82E  64f6                              DEFW    RETURN
  7890  F830  b9f6                              DEFW    MOVE_LEFT
  7891                          ;:
  7892                          ;:
  7893                          ;: CODE FROM HERE TO END OF CONS_OUT WAS INSERTED AFTER THE
  7894                          ;: REV. 06 ROM WAS BURNED AND HAS BEEN COMMENTED OUT TO MAINTAIN
  7895                          ;: COMPATIBILITY WITH THAT ROM.
  7896                          ;:
  7897                          ;               END
  7898                          ;       SKIP
  7899                          ;;
  7900                          ;; RETURN_CURSOR  -  Will return the current cursor position
  7901                          ;;                   to the caller.  It is in absolute screen
  7902                          ;;                   coordinates (0 based).
  7903                          ;;
  7904                          ;;Input Parameters:
  7905                          ;; None
  7906                          ;;
  7907                          ;;Returns:
  7908                          ;; D - X coord of cursor, absolute based on upper left of screen not window
  7909                          ;; E - Y coord of cursor
  7910                          ;;
  7911                          ;               GLB     RETURN_CURSOR
  7912                          ;RETURN_CURSOR:
  7913                          ;               LD      DE,(CURSOR)
  7914                          ;               RET
  7915                          ;       SKIP
  7916                          ;;
  7917                          ;; RETURN_RELATIVE_CURSOR - Returns the current cursor position relative
  7918                          ;;                          to the window.  0,0 will be returned for the
  7919                          ;;                          upper left corner of the window.
  7920                          ;;
  7921                          ;;Input Parameters:
  7922                          ;; NONE
  7923                          ;;
  7924                          ;;Returns:
  7925                          ;; D - X cursor position relative to window
  7926                          ;; E - Y cursor position relative to window
  7927                          ;;
  7928                          ;; Destroys A
  7929                          ;;
  7930                          ;
  7931                          ;               GLB     RETURN_RELATIVE_CURSOR
  7932                          ;
  7933                          ;RETURN_RELATIVE_CURSOR:
  7934                          ;               LD      DE,(CURSOR)     ;get absolute position
  7935                          ;               LD      A,(X_MIN)
  7936                          ;               NEG
  7937                          ;               ADD     A,D
  7938                          ;               LD      D,A
  7939                          ;               LD      A,(Y_MIN)
  7940                          ;               NEG
  7941                          ;               ADD     A,E
  7942                          ;               LD      E,A
  7943                          ;               RET
  7944                          ;;
  7945                          ;;=====================================================================
  7946                          ;;=====================================================================
  7947                          ;;=====================================================================
  7948                          ;;

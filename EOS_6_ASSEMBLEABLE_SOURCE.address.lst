   974                          ; local equates
   975                          ;
   976                          LOC_IN_ALPHA    EQU     0102H;pointer to ascii gens in rev 28+ alpha
   977                          ; Offsets into a volume descriptor (the first entry in the directory).
   978                          VOL_NAME        EQU     0;LOGICAL VOLUME NAME
   979                          VOL_DIRSIZE     EQU     12;*** 7 BITS ONLY *** # BLOCKS IN DIRECTORY
   980                          VOL_ATTR        EQU     12;*** TOP BIT ONLY *** SET FOR DELETE PROTECTION
   981                          VOL_DIR_CHECK   EQU     13; CONTAINS 4 UNIQUE BYTES FOR DIRECTORY EXISTENCE VERIFICATION
   982                          VOL_SIZE        EQU     17;VOLUME SIZE (IN BLOCKS) (4 BYTES)
   983                          VOL_YEAR        EQU     23;CREATION DATE -- YEAR
   984                          VOL_MONTH       EQU     24;                MONTH
   985                          VOL_DAY         EQU     25;                & DAY
   986                          VOL_DES_LENGTH  EQU     26
   987                          
   988                          ; Offsets into a directory entry.
   989                          DIR_NAME        EQU     0;FILE NAME
   990                          DIR_ATTR        EQU     12;FILE ATTRIBUTE BYTE
   991                          DIR_START_BLOCK EQU     13;STARTING BLOCK #
   992                          DIR_MAX_LENGTH  EQU     17;TOTAL # BLOCKS ALLOCATED
   993                          DIR_USED_LENGTH EQU     19;# OF BLOCKS USED (FULL + 1 PARTIAL)
   994                          DIR_LAST_COUNT  EQU     21;NUMBER OF BYTES IN LAST PARTIAL BLOCK
   995                          DIR_YEAR        EQU     23;CREATION DATE -- YEAR
   996                          DIR_MONTH      EQU     24;                MONTH
   997                          DIR_DAY        EQU     25;                & DAY
   998                          DIR_ENT_LENGTH: DEFL    26
   999                          
  1000                          ENT_PER_BLOCK  EQU     1024/26;NUMBER OF ENTRIES PER DIR BLOCK
  1001                          
  1002                          ; Offsets into an FCB header.
  1003                          
  1004                          ; Copy of DIR entry
  1005                          
  1006                          FCB_NAME        EQU     0;FILE NAME
  1007                          FCB_ATTR        EQU     12;FILE ATTRIBUTE BYTE
  1008                          FCB_START_BLOCK EQU     13;STARTING BLOCK #
  1009                          FCB_FIRST_BLOCK EQU     FCB_START_BLOCK
  1010                          FCB_MAX_LENGTH  EQU     17;TOTAL # BLOCKS ALLOCATED
  1011                          FCB_USED_LENGTH EQU     19;# OF BLOCKS USED (FULL + 1 PARTIAL)
  1012                          FCB_LAST_COUNT  EQU     21;NUMBER OF BYTES IN LAST PARTIAL BLOCK
  1013                          
  1014                          FCB_STORED_BYTES EQU    FCB_LAST_COUNT+1; NUMBER OF BYTES STORED ON DEVICE
  1015                          ; ... THE UPPER HALF OF THIS FCB EQU LIST
  1016                          
  1017                          FCB_DEVICE      EQU     26-3;NUMBER OF DEVICE CONTAINING FILE
  1018                          FCB_MODE        EQU     27-3;FILE MODE (UNUSED, READ, WRITE,APPEND)
  1019                          FCB_BLOCK       EQU     28-3;BLOCK NUMBER CURRENTLY IN BUFFER
  1020                          FCB_LAST_BLOCK  EQU     32-3;LAST BLOCK NUMBER IN FILE
  1021                          FCB_POINTER     EQU     36-3;POINTER INTO BLOCK BUFFER
  1022                          FCB_LENGTH      EQU     38-3
  1023                          
  1024                          ; Possible FCB modes.
  1025                          ;
  1026                          ; PROTECTED MODE EQUATES
  1027                          ;
  1028                          MODE_UNUSED     EQU     0;MANY PEOPLE ASSUME THIS IS ZERO!
  1029                          MODE_READ       EQU     MODE_UNUSED+1
  1030                          MODE_WRITE      EQU     MODE_READ+1
  1031                          MODE_UPDATE     EQU     MODE_WRITE+1
  1032                          MODE_EXEC       EQU     MODE_UPDATE+1
  1033                          MODE_MAX        EQU     MODE_EXEC+0
  1034                          ;
  1035                          ; duplicate historical definition: MODE_REMAINDER_BIT EQU   5           ; INDICATES TO ALLOCATE REST OF TAPE ; [RECON] Assembler dialect: active copy emitted in modern header.
  1036                          ; duplicate historical definition: MODE_DIRTY_BIT     EQU   6           ; TEST BIT 6 ; [RECON] Assembler dialect: active copy emitted in modern header.
  1037                          MODE_DIRTY         EQU   01000000B; INDICATES MODIFIED BUFFER
  1038                          ; duplicate historical definition: MODE_LAST_BLOCK_BIT EQU  7           ; TEST BIT 7 ; [RECON] Assembler dialect: active copy emitted in modern header.
  1039                          MODE_LAST          EQU   10000000B; INDICATES LAST BLOCK OF FILE
  1040                          MODE_MODE          EQU   00000111B; BITS TO STORE MODES
  1041                          
  1042                          ; File attribute bits.
  1043                          ATTR_PERMANENT    EQU   10000000B
  1044                          ATTR_WRITE_PROT   EQU   01000000B
  1045                          ATTR_READ_PROT    EQU   00100000B
  1046                          ATTR_USER         EQU   00010000B
  1047                          ATTR_SYSTEM       EQU   00001000B
  1048                          ATTR_DELETED      EQU   00000100B
  1049                          ; duplicate historical definition: ATTR_DEL_BIT      EQU   2 ; [RECON] Assembler dialect: active copy emitted in modern header.
  1050                          ATTR_EXECUTE      EQU   00000010B
  1051                          ; duplicate historical definition: ATTR_HOLE_BIT     EQU   0 ; [RECON] Assembler dialect: active copy emitted in modern header.
  1052                          ATTR_HOLE         EQU   00000001B
  1053                          
  1054                          ; System-wide file name length.
  1055                          NAME_LENGTH       EQU   12
  1056                          
  1057                          ; Numbers of things we have.
  1058                          NUM_FCBS          EQU   3;1 FOR THE SYSTEM, 2 FOR THE USER
  1059                          DCB_NOT_FOUND    EQU     1; THERE WAS NO DCB FOR THE DEVICE REQUESTED.
  1060                          DCB_BUSY         EQU     2; DCB IS BUSY
  1061                          DCB_IDLE_ERR     EQU     3; DCB IS IDLE
  1062                          
  1063                          NO_DATE_ERR      EQU     4
  1064                          NO_FILE_ERR      EQU     5
  1065                          FILE_EXISTS_ERR  EQU     6
  1066                          NO_FCB_ERR       EQU     7
  1067                          MATCH_ERR        EQU     8
  1068                          BAD_FNUM_ERR     EQU     9
  1069                          EOF_ERR          EQU     10
  1070                          TOO_BIG_ERR      EQU     11
  1071                          FULL_DIR_ERR     EQU     12
  1072                          FULL_TAPE_ERR    EQU     13
  1073                          FILE_NM_ERR      EQU     14;DLS(8/28/83)
  1074                          RENAME_ERR       EQU     15;DLS(8/30/83)
  1075                          DELETE_ERR       EQU     16;DLS(8/30/83)
  1076                          RANGE_ERR        EQU     17;DLS(8/31/83)
  1077                          
  1078                          CANT_SYNC1       EQU     18
  1079                          CANT_SYNC2       EQU     19
  1080                          PRT_ERR          EQU     20
  1081                          
  1082                          RQ_TP_STAT_ERR   EQU     21; [RECON] OCR 1088: restore printed symbol RQ_TP_STAT_ERR.
  1083                          DEVICE_DEPD_ERR  EQU     22
  1084                          PROG_NON_EXIST   EQU     23; PROGRAM DOES NOT CURRENTLY EXIST
  1085                          NO_DIR_ERR       EQU     24; NO DIRECTORY ON TAPE
  1086                          ;THESE OUR EQUATES THAT ARE USED BY THE EOS PROGRAMS TO REFERENCE
  1087                          ;PCB AND DCB INFORMATION
  1088                          
  1089                          
  1090                          ;PCB EQUATES
  1091                          
  1092                          P_COM_STAT      EQU     0; THIS IS THE COMMAND/STATUS BYTE
  1093                          
  1094                          P_REL_ADDR      EQU     1; THIS IS THE RELOCATION ADDRESS
  1095                          P_REL_ADDR_LO   EQU     P_REL_ADDR+0
  1096                          P_REL_ADDR_HI   EQU     P_REL_ADDR+1
  1097                          
  1098                          P_NUM_DCBS      EQU     3; THIS IS THE NUMBER OF DCBS DEFINED
  1099                          
  1100                          
  1101                          P_SIZE: DEFL    4; THE NUMBER OF BYTES IN THE PCB
  1102                          
  1103                          
  1104                          
  1105                          ;DCB EQUATES
  1106                          
  1107                          D_COM_STAT      EQU     0; THE COMMAND STATUS BYTE
  1108                          
  1109                          D_BUF_ADR       EQU     1; ADDRESS OF THE DATA BUFFER
  1110                          D_BUF_ADR_LO    EQU     D_BUF_ADR+0
  1111                          D_BUF_ADR_HI    EQU     D_BUF_ADR+1
  1112                          
  1113                          D_BUF_LEN       EQU     3; THE LENGTH OF THE DATA BUFFER
  1114                          D_BUF_LEN_LO    EQU     D_BUF_LEN+0
  1115                          D_BUF_LEN_HI    EQU     D_BUF_LEN+1
  1116                          
  1117                          D_SECT_NUM      EQU     5; THE BLOCK DEVICE SECTOR NUMBER
  1118                          
  1119                          D_SEC_DEV_ID    EQU     9; SECONDARY DEVICE ID
  1120                          
  1121                          D_RET_COUNT     EQU     14; THE NUMBER OF TIMES A COMMAND WILL
  1122                          ; BE RETRIED.
  1123                          D_RET_COUNT_LO  EQU     D_RET_COUNT+0
  1124                          D_RET_COUNT_HI  EQU     D_RET_COUNT+1
  1125                          
  1126                          D_DEV_ADDR      EQU     16; THE DEVICE ADDRESS (ID)
  1127                          
  1128                          D_MAX_MSG_LEN   EQU     17; THE MAX LENGTH OF A DATA STRING
  1129                          ; FOR THE DEVICE
  1130                          D_MAX_MSG_LN_LO EQU     D_MAX_MSG_LEN+0
  1131                          D_MAX_MSG_LN_HI EQU     D_MAX_MSG_LEN+1
  1132                          
  1133                          D_DEV_TYPE      EQU     19; THE DEVICE TYPE, BLOCKED OR CHARACTER
  1134                          
  1135                          D_STATUS_FLAGS  EQU     20; DEVICE DEPENDENT STATUS FLAGS
  1136                          
  1137                          D_SIZE: DEFL    21; THE NUMBER OF BYTES IN THE DCB
  1138                          
  1139                          
  1140                          
  1141                          ;DEVICE ID'S FOR THE KEYBOARD, PRINTER, AND TAPE DRIVE
  1142                          
  1143                          KEYBOARD_ID     EQU     1; KYBD ID
  1144                          PRINTER_ID      EQU     2; PRINTER ID
  1145                          TAPE_ID         EQU     8; TAPE DRIVE ID
  1146                          
  1147                          ERROR_RETRY     EQU     2; MAX RETRYS ON ERRORS, READ_BLOCK AND WRITE_BLOCK
  1148                          
  1149                          MAX_DEV_ADDR    EQU     15; HIGEST POSSIBLE DEVICE ADDRESS
  1150                          ; ON NETWORK
  1151                          
  1152                          
  1153                          ;PCB COMMAND EQUATES
  1154                          
  1155                          
  1156                          PCB_IDLE        EQU     0; THIS IS AN IDLE STATE
  1157                          
  1158                          PCB_SYNC1       EQU     1; SYNC BYTE 1
  1159                          PCB_SYNC1_ACK   EQU     PCB_SYNC1+80H
  1160                          
  1161                          PCB_SYNC2       EQU     2; SYNC BYTE 2
  1162                          PCB_SYNC2_ACK   EQU     PCB_SYNC2+80H
  1163                          
  1164                          PCB_SNA         EQU     3; SET NEW PCB ADDRESS
  1165                          PCB_SNA_ACK     EQU     PCB_SNA+80H
  1166                          
  1167                          PCB_RESET       EQU     4; RESET ALL NODES
  1168                          PCB_RESET_ACK   EQU     PCB_RESET+80H
  1169                          
  1170                          PCB_WAIT        EQU     5
  1171                          PCB_WAIT_ACK    EQU     PCB_WAIT+80H
  1172                          
  1173                          
  1174                          
  1175                          ;DCB COMMAND EQUATES
  1176                          
  1177                          DCB_IDLE        EQU     00
  1178                          DCB_STATUS      EQU     01; REQUEST STATUS
  1179                          DCB_RESET       EQU     02; RESET NODE
  1180                          DCB_WR          EQU     03; WRITE DATA TO DEVICE
  1181                          DCB_RD          EQU     04; READ DATA FROM DEVICE
  1182                          
  1183                          
  1184                          
  1185                          INIT_PCB_ADDR   EQU     0FEC0H; INITIAL ADDRESS OF THE PCB
  1186                          
  1187                          FCB_S           EQU     0D390H; FCB HEADER AREA
  1188                          THREE1K_BLKS    EQU     0D400H; 3K FCB DATA AREA
  1189                          
  1190                          
  1191                          ;GENERAL USAGE EQUATES FOR USE WITH DCB INFO
  1192                          
  1193                          ; duplicate historical definition: CMND_COMPLETE_BIT EQU   7       ; THIS IS THE BIT THAT INDICATES THE ; [RECON] Assembler dialect: active copy emitted in modern header.
  1194                          ; COMMAND HAS BEEN PROCESSED.
  1195                          CMND_FIN_STATUS EQU     80H; THIS IS THE STATUS OF A COMMAND
  1196                          ; THAT COMPLETED WITH NO ERRORS
  1197                          KBD_NAK         EQU     8CH; INDICATES NO KEY READY
  1198                          
  1199                          PR_NAK          EQU     86H; INDICATES THE PRINTER IS BUSY ; [RECON] OCR 1207: scan value column is <0086>.
  1200                          
  1201                          ETX             EQU     03H; END OF DATA STRING INDICATOR
  1202                          
  1203                          TIMEOUT         EQU     9BH; DEVICE TIMED OUT

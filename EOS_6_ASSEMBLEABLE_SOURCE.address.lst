  6230                          ;     __INIT_TP_DIR INITIALIZES THE TAPE DIRECTORY
  6231                          ;
  6232                          ;     INPUT:  A       DEVICE ID
  6233                          ;                     LOW NIBBLE - DEVICE ADDRESS
  6234                          ;                     HI NIBBLE  - SECONDARY DEVICE ID
  6235                          ;
  6236                          ;             C       NUMBER OF SECTORS IN DIRECTORY
  6237                          ;             DE      NUMBER OF SECTORS ON DEVICE
  6238                          ;
  6239                          ;             HL      POINTER TO ASCII ETX TERMINATED STRING
  6240                          ;                     ( VOLUME ID) (SHOULD BE BLANK-PADDED IF
  6241                          ;                     LESS THAN 12 CHARACTERS)
  6242                          ;     OUTPUT:
  6243                          ;             CONDITION FLAGS
  6244                          ;             Z       NO ERROR
  6245                          ;             NZ      ERROR
  6246                          ;                     A = ERROR CODE
  6247                          ;
  6248                          ;***************************************************************
  6249                          
  6250                          ;GLB    __INIT_TAPE_DIR
  6251                          ;GLB    HOLE_FILE_NAME
  6252                          ;GLB    DIRECTORY_CHECK
  6253                          
  6254                          ;EXT    SECTOR_NO
  6255                          ;EXT    DEVICE_ID
  6256                          ;EXT    FCB_DATA_ADDR
  6257                          ;EXT    SECTORS_TO_INIT
  6258                          ;EXT    WRITE_BLOCK
  6259                          
  6260                          __INIT_TAPE_DIR:
  6261                          
  6262  F323  fde5                      PUSH    IY
  6263  F325  c5                        PUSH    BC
  6264  F326  d5                        PUSH    DE
  6265  F327  e5                        PUSH    HL
  6266                          
  6267  F328  3272fd                    LD      (DEVICE_ID),A; SAVE THE DEVICE ID
  6268                          
  6269  F32B  79                        LD      A,C
  6270  F32C  3286fd                    LD      (SECTORS_TO_INIT),A; NO OF SECTORS TO INITIALIZE
  6271                          
  6272  F32F  e5                        PUSH    HL
  6273                          
  6274  F330  cdaff3                    CALL    ZERO_OUT_BUFFER; ZERO OUT THE 1K BUFFER
  6275                          
  6276  F333  21daf3                    LD      HL,INITIAL_DIRECTORY; POINTER TO INITIAL SETUP
  6277  F336  ed5bfffd                  LD      DE,(FCB_DATA_ADDR); ADDRESS OF 1K BUFFER
  6278  F33A  016800                    LD      BC,DIR_ENT_LENGTH*3+VOL_DES_LENGTH; # BYTES TO MOVE INTO BUFFER ; [RECON] OCR 6348: scan bytes are 01 68 00.
  6279  F33D  edb0                      LDIR
  6280                          
  6281  F33F  e1                        POP     HL; GET ADDR OF ETX TERMINATED ASCII STRING
  6282                          
  6283  F340  ed5bfffd                  LD      DE,(FCB_DATA_ADDR); GET ADDRESS OF 1K BUFFER
  6284  F344  060c                      LD      B,12; MAX OF 12 BYTES IN STRING
  6285                          
  6286                          LOAD_DIR:
  6287  F346  7e                        LD      A,(HL); GET ASCII CHAR OF VOLUME ID
  6288  F347  fe03                      CP      ETX; IS IT ETX?
  6289                          
  6290  F349  2808                      JR      Z,ITS_AN_ETX; YUP
  6291                          
  6292  F34B  12                        LD      (DE),A; NOPE,PUT IN THE 1K BUFFER
  6293                          
  6294  F34C  23                        INC     HL
  6295  F34D  13                        INC     DE
  6296                          
  6297  F34E  10f6                      DJNZ    LOAD_DIR
  6298                          
  6299  F350  3e03                      LD      A,ETX
  6300  F352  1b                        DEC     DE
  6301                          
  6302                          ITS_AN_ETX:
  6303  F353  12                        LD      (DE),A; ETX TERMINATED DIRECTORY NAME
  6304  F354  fd2afffd                  LD      IY,(FCB_DATA_ADDR); POINTER TO 1K BUFFER
  6305                          
  6306  F358  3a86fd                    LD      A,(SECTORS_TO_INIT); GET THE NO OF SECTORS TO INITIALIZE
  6307  F35B  f680                      OR      080H; SET HI BIT
  6308  F35D  fd770c                    LD      (IY+VOL_DIRSIZE),A; SAVE IN FIRST BYTE OF BUFFER
  6309                          
  6310  F360  e1                        POP     HL
  6311  F361  d1                        POP     DE
  6312  F362  c1                        POP     BC
  6313                          
  6314  F363  c5                        PUSH    BC
  6315  F364  d5                        PUSH    DE
  6316  F365  e5                        PUSH    HL
  6317                          
  6318  F366  fd7311                    LD      (IY+VOL_SIZE+0),E
  6319  F369  fd7212                    LD      (IY+VOL_SIZE+1),D
  6320                          
  6321  F36C  d5                        PUSH    DE; GET TO FIRST DIR ENTRY
  6322  F36D  114e00                    LD      DE,VOL_DES_LENGTH+DIR_ENT_LENGTH*2; POINT TO FIRST FILE ENTRY ; [RECON] OCR 6392: scan bytes are 11 4E 00.
  6323  F370  fd19                      ADD     IY,DE
  6324  F372  d1                        POP     DE
  6325                          
  6326  F373  fd71f7                    LD      (IY+DIR_MAX_LENGTH-DIR_ENT_LENGTH),C; BLOCKS ALLOCATED FOR DIRECTORY
  6327  F376  fd71f9                    LD      (IY+DIR_USED_LENGTH-DIR_ENT_LENGTH),C; MAKE USED BLOCKS AS LARGE AS POSSIBLE
  6328                          
  6329  F379  0c                        INC     C; FIRST "FILE" STARTS AFTER
  6330  F37A  fd710d                    LD      (IY+DIR_START_BLOCK),C; LAST SECTOR OF DIR
  6331                          
  6332  F37D  0600                      LD      B,0; WANT BC = # SECTORS USED
  6333                          ; (# DIR SECT + 1 TO COVER
  6334                          ; SECT 0)
  6335                          
  6336  F37F  eb                        EX      DE,HL; HL = # SECTORS ON DEVICE
  6337  F380  b7                        OR      A; CLEAR CARRY
  6338  F381  ed42                      SBC     HL,BC; HL = # SECTORS LEFT FOR FILES ?????
  6339                          
  6340  F383  fd7511                    LD      (IY+DIR_MAX_LENGTH+0),L
  6341  F386  fd7412                    LD      (IY+DIR_MAX_LENGTH+1),H
  6342                          
  6343  F389  3e01                      LD      A,1; FIRST SECTOR
  6344  F38B  3287fd                    LD      (SECTOR_NO),A
  6345                          
  6346  F38E  cdc5f3                    CALL    WRITE_1_BLOCK; WRITE BLOCK TO TAPE
  6347                          
  6348  F391  2016                      JR      NZ,WE_GOT_ERRORS; CAME BACK WITH ERROR
  6349                          
  6350  F393  3a86fd                    LD      A,(SECTORS_TO_INIT); GET NO OF SECTORS TO INITIALIZE
  6351                          
  6352  F396  47                        LD      B,A
  6353  F397  05                        DEC     B; ONE LESS BECAUSE ONE WAS JUST INITIALIZED
  6354                          
  6355  F398  280e                      JR      Z,NO_SECTORS_TO_INIT; WAS ONLY ONE TO INIT
  6356                          
  6357  F39A  cdaff3                    CALL    ZERO_OUT_BUFFER; CLEAR 1K BUFFER
  6358                          
  6359                          SECT_INIT_LOOP:
  6360  F39D  2187fd                    LD      HL,SECTOR_NO; SECTOR NO.
  6361  F3A0  34                        INC     (HL); NEXT SECTOR
  6362                          
  6363  F3A1  cdc5f3                    CALL    WRITE_1_BLOCK; WRITE BLOCK OF ZEROS OUT
  6364  F3A4  2003                      JR      NZ,WE_GOT_ERRORS; GOT A ERROR IN WRITE
  6365                          
  6366  F3A6  10f5                      DJNZ    SECT_INIT_LOOP
  6367                          
  6368                          NO_SECTORS_TO_INIT:
  6369                          
  6370  F3A8  af                        XOR     A; ZERO CONDITION
  6371                          
  6372                          WE_GOT_ERRORS:
  6373                          
  6374  F3A9  e1                        POP     HL
  6375  F3AA  d1                        POP     DE
  6376  F3AB  c1                        POP     BC
  6377  F3AC  fde1                      POP     IY
  6378                          
  6379  F3AE  c9                        RET
  6380                          
  6381                          
  6382                          
  6383                          ZERO_OUT_BUFFER:
  6384                          
  6385  F3AF  c5                        PUSH    BC
  6386  F3B0  d5                        PUSH    DE
  6387  F3B1  e5                        PUSH    HL
  6388                          
  6389  F3B2  2afffd                    LD      HL,(FCB_DATA_ADDR); POINTER TO 1K BUFFER
  6390  F3B5  ed5bfffd                  LD      DE,(FCB_DATA_ADDR)
  6391  F3B9  13                        INC     DE
  6392  F3BA  01ff03                    LD      BC,1023
  6393                          
  6394  F3BD  3600                      LD      (HL),0; ZERO IT OUT
  6395                          
  6396  F3BF  edb0                      LDIR
  6397                          
  6398  F3C1  e1                        POP     HL
  6399  F3C2  d1                        POP     DE
  6400  F3C3  c1                        POP     BC
  6401                          
  6402  F3C4  c9                        RET
  6403                          
  6404                          
  6405                          WRITE_1_BLOCK:
  6406  F3C5  c5                        PUSH    BC
  6407                          
  6408  F3C6  2afffd                    LD      HL,(FCB_DATA_ADDR); ADDRESS OF 1K BUFFER
  6409  F3C9  3a87fd                    LD      A,(SECTOR_NO); GET SECTOR NUMBER
  6410  F3CC  5f                        LD      E,A
  6411  F3CD  1600                      LD      D,0
  6412  F3CF  010000                    LD      BC,0
  6413                          
  6414  F3D2  3a72fd                    LD      A,(DEVICE_ID)
  6415                          
  6416  F3D5  cde6f1                    CALL    WRITE_BLOCK; WRITE IT OUT
  6417                          
  6418  F3D8  c1                        POP     BC

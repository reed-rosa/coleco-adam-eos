  4012                          ; STILL TRYING TO CALC THE NEW START ADDR
  4013                          ;
  4014  E941  2a1afe                    LD      HL,(NEW_HOLE_SIZE)
  4015  E944  fd7511                    LD      (IY+DIR_MAX_LENGTH),L; BLOCKS LEFT ON TAPE
  4016  E947  fd7412                    LD      (IY+DIR_MAX_LENGTH+1),H
  4017                          
  4018  E94A  3a16fe                    LD      A,(NEW_HOLE_START)
  4019  E94D  fd770d                    LD      (IY+DIR_START_BLOCK),A
  4020  E950  3a17fe                    LD      A,(NEW_HOLE_START+1)
  4021  E953  fd770e                    LD      (IY+DIR_START_BLOCK+1),A
  4022  E956  3a18fe                    LD      A,(NEW_HOLE_START+2)
  4023  E959  fd770f                    LD      (IY+DIR_START_BLOCK+2),A
  4024  E95C  3a19fe                    LD      A,(NEW_HOLE_START+3)
  4025  E95F  fd7710                    LD      (IY+DIR_START_BLOCK+3),A
  4026                          
  4027  E962  fd360c01                  LD      (IY+DIR_ATTR),ATTR_HOLE; SET HOLE UP
  4028                          
  4029  E966  fde5                      PUSH    IY
  4030  E968  d1                        POP     DE
  4031                          
  4032  E969  2128f4                    LD      HL,HOLE_FILE_NAME
  4033  E96C  010c00                    LD      BC,12
  4034  E96F  edb0                      LDIR
  4035                          
  4036                          TIME_TO_WRITE:
  4037  E971  dd7e17                    LD      A,(IX+FCB_DEVICE);GET PARAMETERS FROM FCB
  4038  E974  2a08fe                    LD      HL,(BUF_START)
  4039  E977  dd5e19                    LD      E,(IX+FCB_BLOCK)
  4040  E97A  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4041  E97D  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4042  E980  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4043  E983  cde6f1                    CALL    WRITE_BLOCK;WRITE THE BLOCK OUT
  4044                          
  4045  E986  2001                      JR      NZ,MAKE_ERROR; IT'S A BOO BOO!!
  4046  E988  af                        XOR     A;SHOW NO ERROR
  4047                          
  4048                          LETS_GET_OUT:
  4049                          MAKE_ERROR:
  4050                          ;RESTORE THE REGISTERS
  4051  E989  b7                        OR      A
  4052  E98A  c1                        POP     BC
  4053  E98B  d1                        POP     DE
  4054  E98C  e1                        POP     HL
  4055  E98D  dde1                      POP     IX
  4056  E98F  fde1                      POP     IY
  4057  E991  c9                        RET
  4058                          
  4059                          TOO_BIG:

  5364                          ;***************************************************************
  5365                          ;***************************************************************
  5366                          ;
  5367                          ;     CHECK_IF_DIRECTORY VERIFIES THE EXISTENCE OF A DIRECTORY
  5368                          ;             ON THE MEDIA IN THE DEVICE
  5369                          ;
  5370                          ;     INPUT:   IY  -  POINTS TO THE VOLUME ENTRY (FIRST ENTRY INTO THE DIRECTORY)
  5371                          ;
  5372                          ;     OUTPUT:  CONDITION FLAGS
  5373                          ;             Z  - DIRECTORY EXISTS
  5374                          ;             NZ - NO DIRECTORY
  5375                          ;                  A = ERROR CODE
  5376                          ;
  5377                          ;
  5378                          ;             ALL REGISTERS PRESERVED EXCEPT AF
  5379                          ;
  5380                          ;***************************************************************
  5381                          ;***************************************************************
  5382                          
  5383                          ;GLB    CHECK_IF_DIRECTORY
  5384                          ;EXT    DIRECTORY_CHECK
  5385                          
  5386                          CHECK_IF_DIRECTORY:
  5387  F035  fde5                      PUSH    IY
  5388  F037  c5                        PUSH    BC
  5389  F038  e5                        PUSH    HL
  5390                          
  5391  F039  21e7f3                    LD      HL,DIRECTORY_CHECK; 4 UNIQUE BYTES PLACE IN VOLUME ENTRY
  5392                          ; AT CREATION TIME (BYTES DEFINED IN EOS_MKDIR)
  5393                          
  5394  F03C  0604                      LD      B,4; COMPARE 4 BYTES
  5395                          NEXT_CHECK:
  5396  F03E  7e                        LD      A,(HL); GET THE FIRST UNIQUE BYTE
  5397  F03F  fdbe0d                    CP      (IY+VOL_DIR_CHECK); SAME AS ON TAPE?
  5398  F042  200b                      JR      NZ,NOT_DIR; NOPE
  5399                          
  5400  F044  23                        INC     HL; YUP, CHECK NEXT BYTE
  5401  F045  fd23                      INC     IY
  5402  F047  10f5                      DJNZ    NEXT_CHECK
  5403                          
  5404  F049  af                        XOR     A; DIRECTORY EXISTS
  5405                          
  5406                          GET_OUT_HERE:
  5407  F04A  e1                        POP     HL
  5408  F04B  c1                        POP     BC
  5409  F04C  fde1                      POP     IY
  5410                          
  5411  F04E  c9                        RET
  5412                          
  5413                          NOT_DIR:
  5414  F04F  3e18                      LD      A,NO_DIR_ERR
  5415  F051  18f7                      JR      GET_OUT_HERE
  5416                          
  5417                          ;---------------------------------------------------------------
  5418                          ;
  5419                          ; STRCMP -- compare two strings (file names).
  5420                          ;
  5421                          ; ENTRY PARAMETERS: address of name string in HL; address of
  5422                          ;                   name within dir entry in DE. NOTE: string
  5423                          ;                   pointed to by HL must be terminated with ETX.
  5424                          ;                   Maximum of NAME_LENGTH characters are compared.
  5425                          ;
  5426                          ; EXIT PARAMETERS:  Z = 1; A = 0 if match or
  5427                          ;                   Z = 0; A = error code if no match.
  5428                          ;
  5429                          ;---------------------------------------------------------------
  5430                          
  5431                          BASECMP: EQU     $+1; EXECUTES SCF (37H) - COMPARE ONLY THE BASE
  5432                          ; OF THE FILE NAME
  5433                          STRCMP:; "AND" INSTRUCTION CLEARS CARRY - COMPARE BASE &
  5434  F053  e637                      AND     037H; EXTENSION
  5435  F055  e5                        PUSH    HL; PRESERVE REG'S
  5436  F056  d5                        PUSH    DE
  5437  F057  c5                        PUSH    BC
  5438  F058  f5                        PUSH    AF; SAVE CARRY FLAGGING EXECUTED ABOVE
  5439                          
  5440  F059  060c                      LD      B,NAME_LENGTH; INIT MAX COUNT
  5441                          NEXT_CHAR:
  5442  F05B  7e                        LD      A,(HL); GET CHAR FROM STRING
  5443  F05C  fe03                      CP      ETX; HAVE WE REACHED END OF STRING?
  5444  F05E  2817                      JR      Z,EOS; BRANCH IF YES
  5445  F060  1a                        LD      A,(DE); GET CHAR FROM DIR ENTRY
  5446  F061  be                        CP      (HL); COMPARE TO STRING
  5447  F062  2007                      JR      NZ,MATCHLESS; BRANCH IF DIFFERENT
  5448  F064  23                        INC     HL; ELSE INC. POINTERS
  5449  F065  13                        INC     DE
  5450  F066  10f3                      DJNZ    NEXT_CHAR; LOOP IF MORE CHARS TO LOOK AT
  5451  F068  c1                        POP     BC; POP AF INTO BC
  5452  F069  1812                      JR      MATCH; ALL 12 MATCH IF WE GET HERE!
  5453                          MATCHLESS:
  5454  F06B  f1                        POP     AF; COMPARE BASE OR BASE&EXTENSION
  5455  F06C  3014                      JR      NC,NO_MATCH; NEEDED TO COMPARE THE WHOLE FILE NAME
  5456                          ; ONLY COMPARE THE BASE
  5457  F06E  23                        INC     HL; POINT TO NEXT CHAR OF NAME STRING
  5458  F06F  13                        INC     DE; AND DIR ENTRY NAME
  5459  F070  7e                        LD      A,(HL)
  5460  F071  fe03                      CP      ETX; IS IT ETX?
  5461  F073  200d                      JR      NZ,NO_MATCH; NOPE, DOES NOT MATCH
  5462  F075  1801                      JR      AROUND_POP
  5463                          
  5464                          EOS:
  5465  F077  c1                        POP     BC; AF INTO BC TO PRESERVE AF
  5466                          AROUND_POP:
  5467  F078  1a                        LD      A,(DE); LOOK AT CHAR IN DIR ENTRY
  5468                          ; DLS(8/29/83) CHANGED SPACE TO ETX.
  5469  F079  fe03                      CP      ETX; END OF FILE NAME?
  5470  F07B  2005                      JR      NZ,NO_MATCH; BRANCH IF NOT
  5471                          MATCH:
  5472  F07D  c1                        POP     BC; RESTORE REG'S
  5473  F07E  d1                        POP     DE
  5474  F07F  e1                        POP     HL
  5475  F080  af                        XOR     A; SHOW THE MATCH
  5476  F081  c9                        RET
  5477                          NO_MATCH:
  5478  F082  c1                        POP     BC; RESTORE REG'S
  5479  F083  d1                        POP     DE
  5480  F084  e1                        POP     HL
  5481  F085  3e08                      LD      A,MATCH_ERR
  5482  F087  b7                        OR      A
  5483  F088  c9                        RET; RETURN WITH NZ CONDITION
  5484                          
  5485                          
  5486                          ;***************************************************************
  5487                          ;
  5488                          ;
  5489                          ; THIS ROUTINE CHECKS TO SEE IF THE FILENAME (POINTED TO BY HL)
  5490                          ; IS ALREADY OPEN AND EXIST IN THE FCB
  5491                          ;
  5492                          ;             INPUT:   HL        POINTER TO FILENAME (ETX TERMINATED)
  5493                          ;
  5494                          ;             OUTPUT:  CONDITION FLAGS
  5495                          ;                      NZ        NOT IN FCB (NOT OPENED)
  5496                          ;                                A = ERROR CODE
  5497                          ;                                HL = ORIGINAL POINTER TO FILENAME
  5498                          ;                      Z         IN FCB
  5499                          ;                                A = FILE NUMBER
  5500                          ;                                B = MODE
  5501                          ;                                HL = POINTER TO START OF FCB
  5502                          ;
  5503                          ;***************************************************************
  5504                          ;
  5505                          ; GET_OUT                  U_GET_OUT
  5506                          ; NEXT_FCB CHANGED TO U_NEXT_FCB TO PREVENT CONFLICT WITH
  5507                          ; IDENTICAL LABEL ELSEWHERE
  5508                          
  5509                          ;GLB    __CHECK_FCB
  5510                          ;EXT    FILE_NUMBR
  5511                          
  5512                          __CHECK_FCB:
  5513  F089  dde5                      PUSH    IX
  5514  F08B  d5                        PUSH    DE
  5515                          ;       PUSH    BC
  5516  F08C  e5                        PUSH    HL
  5517                          
  5518  F08D  2afdfd                    LD      HL,(FCB_HEAD_ADDR)
  5519  F090  af                        XOR     A; ZERO OUT A
  5520                          U_NEXT_FCB:
  5521  F091  3c                        INC     A; CONTAINS THE FILE NUMBER
  5522  F092  32d7fd                    LD      (FILE_NUMBR),A; (THE POSITION ON THE TAPE)
  5523                          
  5524  F095  112300                    LD      DE,FCB_LENGTH; NUMBER OF BYTES IN EACH FCB
  5525  F098  19                        ADD     HL,DE; POINT TO NEXT FCB ENTRY
  5526                          
  5527  F099  e5                        PUSH    HL
  5528  F09A  dde1                      POP     IX; IX POINTS TO START OF FCB
  5529                          
  5530  F09C  dd7e18                    LD      A,(IX+FCB_MODE); GET MODE
  5531  F09F  e607                      AND     MODE_MODE
  5532  F0A1  fe00                      CP      0; IT IS UNUSED?
  5533                          
  5534  F0A3  2812                      JR      Z,END_FCB; YUP, LOOK AT NEXT FCB
  5535  F0A5  eb                        EX      DE,HL; DE = POINTER TO FCB NAME STRING
  5536  F0A6  e1                        POP     HL
  5537  F0A7  e5                        PUSH    HL; HL = POINTER TO FILENAME TO SEARCH FOR
  5538                          
  5539                          
  5540  F0A8  d5                        PUSH    DE; DE = POINTER TO FCB FILE NAME
  5541                          
  5542  F0A9  010c00                    LD      BC,NAME_LENGTH; NO. OF CHARACTERS IN NAME
  5543                          ; HL = FILE NAME STRING
  5544                          NEXT_CHAR1:
  5545  F0AC  1a                        LD      A,(DE); DE = FCB FILE NAME
  5546  F0AD  fe03                      CP      ETX; IS IT ETX?
  5547                          
  5548  F0AF  2813                      JR      Z,ITS_ETX1; YUP
  5549                          
  5550  F0B1  eda1                      CPI; DO CHARS MATCH ((HL) = A)?
  5551                          
  5552  F0B3  13                        INC     DE
  5553  F0B4  28f6                      JR      Z,NEXT_CHAR1; YUP,CHECK NEXT CHAR OF FILE NAME
  5554                          
  5555  F0B6  e1                        POP     HL; pointer to FCB
  5556                          END_FCB:
  5557  F0B7  3ad7fd                    LD      A,(FILE_NUMBR); ARE WE AT 2ND FILE(FCB)?
  5558  F0BA  fe02                      CP      NUM_FCBS-1; NO. OF FCB'S - SYSTEM FCB
  5559                          
  5560  F0BC  20d3                      JR      NZ,U_NEXT_FCB; NOPE, NOT YET,
  5561                          
  5562                          NO_MATCH1:
  5563  F0BE  e1                        POP     HL; HL = ORIGINAL POINTER TO FILE NAME
  5564                          
  5565  F0BF  3e05                      LD      A,NO_FILE_ERR; NO MATCH FOUND
  5566  F0C1  b7                        OR      A
  5567  F0C2  1811                      JR      GET_OUT_ERR
  5568                          
  5569                          ITS_ETX1:
  5570  F0C4  7e                        LD      A,(HL); GET ASCII CHAR
  5571  F0C5  fe03                      CP      ETX; IS IT ETX?
  5572  F0C7  e1                        POP     HL; *pointer to FCB
  5573  F0C8  20f4                      JR      NZ,NO_MATCH1; NOPE
  5574                          
  5575                          ;       PUSH    HL                       ; copy pointer to FCB so can index to mode
  5576                          ;       POP     IX
  5577                          
  5578  F0CA  dd7e18                    LD      A,(IX+FCB_MODE); GET MODE THIS FILE WAS ORIGINALLY
  5579  F0CD  e607                      AND     MODE_MODE; OPENED FOR AND MASK OFF FLAG BITS
  5580  F0CF  47                        LD      B,A; PASS IT BACK IN B
  5581                          
  5582  F0D0  af                        XOR     A; INDICATE Z CONDITION
  5583  F0D1  3ad7fd                    LD      A,(FILE_NUMBR); GET FILE NUMBER
  5584                          
  5585                          U_GET_OUT:
  5586  F0D4  d1                        POP     DE; *Clear off pointer to name
  5587                          ;       POP     BC
  5588                          GET_OUT_ERR:
  5589  F0D5  d1                        POP     DE
  5590  F0D6  dde1                      POP     IX
  5591                          
  5592  F0D8  c9                        RET
  5593                          
  5594                          
  5595                          ;---------------------------------------------------------------
  5596                          ;
  5597                          ; MODE_CHECK: sees if an attribute byte matches a permission request.
  5598                          ;
  5599                          ; ENTRY PARAMETERS: IX- FCB POINTER
  5600                          ;                   HL- DIR ENTRY
  5601                          ; EXIT PARAMETERS:   Z=1=OK
  5602                          ;                    Z=0=NO WAY
  5603                          ;                    A=TRASH
  5604                          ;                    IX AND HL PRESERVED
  5605                          ; DLS(8/30/83)
  5606                          ;---------------------------------------------------------------
  5607                          
  5608                          ; OK CHANGED TO U_OK TO PREVENT CONFLICT WITH IDENTICAL
  5609                          ;LABEL ELSEWHERE
  5610                          
  5611                          ;MODE_CHECK:
  5612                          __MODE_CHECK:; [RECON] OCR 5675-5676 prints two coincident labels; exported implementation label restored.
  5613                          MODE_CHECK: ; [RECON] Preserved coincident historical local label from OCR 5675-5676.
  5614                          
  5615  F0D9  fde5                      PUSH    IY; SAVE REG IY
  5616  F0DB  e5                        PUSH    HL; SAVE DIR ENTRY
  5617  F0DC  dd7e18                    LD      A,(IX+FCB_MODE); GET THE MODE THE USER PASSED IN
  5618                          ;
  5619                          ; RANGE CHECK THIS REQUEST
  5620                          ;
  5621  F0DF  e607                      AND     MODE_MODE; AND OFF TEST BITS
  5622  F0E1  fe00                      CP      0; MAKE SURE HE'S IN RANGE
  5623  F0E3  281f                      JR      Z,RANGE_NONO
  5624  F0E5  fe05                      CP      MODE_MAX+1
  5625  F0E7  301b                      JR      NC,RANGE_NONO
  5626                          ;
  5627  F0E9  210af1                    LD      HL,ATTRIB_TBL; INDEX INTO THE MASK TABLE
  5628  F0EC  85                        ADD     A,L
  5629  F0ED  6f                        LD      L,A
  5630  F0EE  3001                      JR      NC,ADJUST
  5631  F0F0  24                        INC     H
  5632                          ADJUST:
  5633  F0F1  fde1                      POP     IY; GET THE DIR ENTRY POINTER INTO IY
  5634  F0F3  fde5                      PUSH    IY
  5635  F0F5  fd7e0c                    LD      A,(IY+DIR_ATTR); GRAB HIS ATTRIBUTE BYTE
  5636  F0F8  a6                        AND     (HL); COMPARE IT TO THE USER'S REQUEST
  5637  F0F9  2005                      JR      NZ,PROTECT_FAULT
  5638                          U_OK:
  5639  F0FB  e1                        POP     HL
  5640  F0FC  fde1                      POP     IY
  5641  F0FE  af                        XOR     A; INDICATE ALL IS WELL
  5642  F0FF  c9                        RET
  5643                          PROTECT_FAULT:
  5644  F100  3e14                      LD      A,PRT_ERR
  5645  F102  1802                      JR      PROTECT
  5646                          RANGE_NONO:
  5647  F104  3e11                      LD      A,RANGE_ERR
  5648                          PROTECT:
  5649  F106  e1                        POP     HL
  5650  F107  fde1                      POP     IY
  5651  F109  b7                        OR      A; INDICATE ERROR
  5652  F10A  c9                        RET
  5653                          ATTRIB_TBL     EQU     $-1
  5654  F10B  20                        DEFB    ATTR_READ_PROT
  5655  F10C  40                        DEFB    ATTR_WRITE_PROT
  5656  F10D  80                        DEFB    ATTR_PERMANENT
  5657  F10E  02                        DEFB    ATTR_EXECUTE
  5658                          
  5659                          
  5660                          
  5661                          ;***************************************************************
  5662                          ;******************** EOS_RENAME_FILE ***************************
  5663                          ;
  5664                          ; ON ENTRY:   A  = DEVICE NUMBER (8=TAPE1)
  5665                          ;             DE = POINTER TO OLD FILENAME
  5666                          ;             HL = POINTER TO NEW FILENAME
  5667                          ;
  5668                          ; ON EXIT:    Z = 1, FILE RENAMED.  A = 0
  5669                          ;             Z = 0, FILE NOT RENAMED. A = ERROR CODE
  5670                          ;
  5671                          
  5672                          ;GLB    __RENAME_FILE
  5673                          
  5674                          __RENAME_FILE:
  5675  F10F  c5                        PUSH    BC
  5676  F110  f5                        PUSH    AF; AF = DEVICE ID
  5677  F111  d5                        PUSH    DE; DE = POINTER TO OLD FILENAME
  5678  F112  e5                        PUSH    HL; HL = POINTER TO NEW FILENAME
  5679  F113  eb                        EX      DE,HL; FIRST CHECK IF A FILE EXIST W/NEW FILE NAME
  5680  F114  21a0fd                    LD      HL,QUERY_BUFFER
  5681  F117  cd1be6                    CALL    __QUERY_FILE
  5682  F11A  282c                      JR      Z,NOT_RENAMED; YUP, THE NEW FILE NAME ALREADY EXISTS
  5683  F11C  e1                        POP     HL
  5684  F11D  d1                        POP     DE
  5685  F11E  f1                        POP     AF
  5686  F11F  f5                        PUSH    AF
  5687  F120  d5                        PUSH    DE
  5688  F121  e5                        PUSH    HL
  5689                          
  5690  F122  21a0fd                    LD      HL,QUERY_BUFFER
  5691  F125  cd1be6                    CALL    __QUERY_FILE; NOW CHECK IF OLD FILE EXISTS
  5692  F128  201e                      JR      NZ,NOT_RENAMED; NOPE
  5693  F12A  11a0fd                    LD      DE,QUERY_BUFFER; DE = DESTINATION
  5694  F12D  e1                        POP     HL; HL = PTR TO NEW FILENAME
  5695  F12E  e5                        PUSH    HL
  5696  F12F  010c00                    LD      BC,12; NUMBER OF BYTES TO REPLACE
  5697  F132  edb0                      LDIR
  5698  F134  e1                        POP     HL
  5699  F135  d1                        POP     DE; DE = POINTER TO OLD FILENAME
  5700  F136  f1                        POP     AF; A = DEVICE ID
  5701  F137  f5                        PUSH    AF
  5702  F138  d5                        PUSH    DE; RESTORE STACK
  5703  F139  e5                        PUSH    HL
  5704  F13A  21a0fd                    LD      HL,QUERY_BUFFER
  5705  F13D  cd51e6                    CALL    __SET_FILE; CHANGE FILENAME
  5706  F140  2006                      JR      NZ,NOT_RENAMED
  5707  F142  af                        XOR     A; GOOD RETURN
  5708  F143  e1                        POP     HL
  5709  F144  d1                        POP     DE
  5710  F145  c1                        POP     BC; REALLY AF BUT NEED TO PRESERVE FLAGS FOR RET
  5711  F146  c1                        POP     BC
  5712  F147  c9                        RET
  5713                          NOT_RENAMED:
  5714                          ;         LD      A,RENAME_ERR             ; ERROR RETURN ; [RECON] OCR 5778 is commented; production preserves the error already in A.
  5715  F148  b7                        OR      A
  5716  F149  e1                        POP     HL
  5717  F14A  d1                        POP     DE
  5718  F14B  c1                        POP     BC; REALLY AF BUT NEED TO PRESERVE ERR MSG.
  5719  F14C  c1                        POP     BC
  5720  F14D  c9                        RET
  5721                          
  5722                          
  5723                          ;
  5724                          ;***************************************************************
  5725                          ;******************** EOS_DELETE_FILE ***************************
  5726                          ;
  5727                          ; ON ENTRY:   A  = DEVICE NUMBER (8=TAPE1)
  5728                          ;             HL = POINTER TO FILENAME
  5729                          ;
  5730                          ; ON EXIT:    Z = 1, FILE DELETED. A = 0
  5731                          ;             Z = 0, FILE NOT DELETED. A = ERROR CODE
  5732                          ;
  5733                          
  5734                          ;GLB    __DELETE_FILE
  5735                          
  5736                          __DELETE_FILE:
  5737  F14E  d5                        PUSH    DE
  5738  F14F  e5                        PUSH    HL; HL = POINTER TO FILENAME
  5739  F150  f5                        PUSH    AF; A = DEVICE ID
  5740  F151  eb                        EX      DE,HL; DE = POINTER TO FILENAME
  5741  F152  21a0fd                    LD      HL,QUERY_BUFFER; HL = POINTER TO BUFFER
  5742  F155  cd1be6                    CALL    __QUERY_FILE
  5743  F158  201d                      JR      NZ,OTHER_ERR
  5744  F15A  3aacfd                    LD      A,(QUERY_BUFFER+FCB_ATTR); GET ATTRIBUTE BYTE
  5745  F15D  cb7f                      BIT     7,A; see if permanent protected
  5746  F15F  2013                      JR      NZ,NOT_DELETED
  5747  F161  f604                      OR      ATTR_DELETED; SET "DELETED" BIT
  5748  F163  32acfd                    LD      (QUERY_BUFFER+FCB_ATTR),A
  5749  F166  f1                        POP     AF; DEVICE ID
  5750  F167  d1                        POP     DE; GET FILENAME POINTER
  5751  F168  d5                        PUSH    DE
  5752  F169  f5                        PUSH    AF
  5753  F16A  cd51e6                    CALL    __SET_FILE
  5754  F16D  2008                      JR      NZ,OTHER_ERR
  5755  F16F  af                        XOR     A; GOOD RETURN
  5756  F170  e1                        POP     HL; REALLY AF BUT PRESERVE NEW AF
  5757  F171  e1                        POP     HL
  5758  F172  d1                        POP     DE
  5759  F173  c9                        RET
  5760                          NOT_DELETED:
  5761  F174  3e10                      LD      A,DELETE_ERR; ERROR RETURN
  5762  F176  b7                        OR      A
  5763                          OTHER_ERR:
  5764  F177  e1                        POP     HL; REALLY AF BUT PRESERVE ERR CONDITION
  5765  F178  e1                        POP     HL
  5766  F179  d1                        POP     DE
  5767  F17A  c9                        RET
  5768                          
  5769                          
  5770                          ;***************************************************************
  5771                          ;***************************************************************
  5772                          ;
  5773                          ;
  5774                          ;     READ_BLOCK:
  5775                          ;             1)  READS 1 BLOCK OFF OF SPECIFIED DEVICE
  5776                          ;             2)  REQUESTS FOR THE STATUS
  5777                          ;             3)  AND SENDS ANOTHER READ TO THE DEVICE
  5778                          ;
  5779                          ;     INPUT:  SAME AS FOR __RD_1_BLOCK
  5780                          ;             A       DEVICE ID
  5781                          ;                     LOW NIBBLE - DEVICE ADDRESS
  5782                          ;                     HI NIBBLE  - SECONDARY DEVICE ID
  5783                          ;
  5784                          ;             HL      DESTINATION IN RAM
  5785                          ;
  5786                          ;             REGISTER PAIR  BC DE
  5787                          ;                            SECTOR NUMBER ON DEVICE
  5788                          ;
  5789                          ;
  5790                          ;     OUTPUT: CONDITION FLAGS
  5791                          ;                     Z:  NO ERRORS
  5792                          ;                    NZ:  ERROR OCCURED
  5793                          ;                         A - ERROR CODE
  5794                          ;
  5795                          ;     ALL REGISTERS ARE PRESERVED EXCEPT FOR AF
  5796                          ;
  5797                          ;***************************************************************
  5798                          ;***************************************************************
  5799                          
  5800                          __READ_BLOCK:
  5801                          READ_BLOCK:
  5802  F17B  c5                        PUSH    BC
  5803  F17C  d5                        PUSH    DE
  5804  F17D  e5                        PUSH    HL
  5805  F17E  dde5                      PUSH    IX
  5806  F180  fde5                      PUSH    IY
  5807  F182  f5                        PUSH    AF
  5808                          
  5809  F183  3e02                      LD      A,ERROR_RETRY; RETRY COUNT FOR ERRORS
  5810  F185  32d6fd                    LD      (RETRY_COUNT),A
  5811                          READ_LOOP:
  5812  F188  f1                        POP     AF; GET DEVICE ID BACK IN A
  5813  F189  f5                        PUSH    AF
  5814                          
  5815  F18A  cd9efa                    CALL    __RD_1_BLOCK
  5816                          
  5817  F18D  280e                      JR      Z,NO_READ_ERRORS; READ WENT OK
  5818                          
  5819  F18F  fe9b                      CP      TIMEOUT; WAS IT A TIMEOUT?
  5820                          
  5821  F191  280a                      JR      Z,NO_READ_ERRORS; YUP,
  5822                          
  5823  F193  e5                        PUSH    HL
  5824  F194  21d6fd                    LD      HL,RETRY_COUNT
  5825  F197  35                        DEC     (HL); DEC THE NO OF RETRY'S LEFT
  5826  F198  e1                        POP     HL
  5827  F199  283f                      JR      Z,READ_ERROR; NO RETRY'S LEFT
  5828  F19B  18eb                      JR      READ_LOOP; TRY AGAIN
  5829                          
  5830                          NO_READ_ERRORS:
  5831  F19D  0602                      LD      B,ERROR_RETRY; NUMBER OF TIMES TO RETRY
  5832                          
  5833                          RETRY_FOR_ERRORS:
  5834  F19F  f1                        POP     AF; RESTORE DEVICE ID
  5835  F1A0  f5                        PUSH    AF
  5836                          
  5837  F1A1  cd73f4                    CALL    __REQUEST_STATUS; GET STATUS
  5838                          
  5839  F1A4  2808                      JR      Z,READ_COMMAND_COMPLETED; READ ALL DONE
  5840                          
  5841  F1A6  fe9b                      CP      TIMEOUT; WAS IT A TIMEOUT?
  5842  F1A8  28f5                      JR      Z,RETRY_FOR_ERRORS; NOT A REAL ERROR, DON'T NEED TO DEC COUNTER ; [RECON] Identifier repair: branch targets printed label RETRY_FOR_ERRORS at OCR 5899.
  5843                          
  5844  F1AA  10f3                      DJNZ    RETRY_FOR_ERRORS; IT'S A REAL ERROR, TRY AGAIN ; [RECON] Identifier repair: branch targets printed label RETRY_FOR_ERRORS at OCR 5899.
  5845                          
  5846  F1AC  182c                      JR      READ_ERROR; CAN'T GET STATUS, GET OUT
  5847                          
  5848                          READ_COMMAND_COMPLETED:
  5849  F1AE  f1                        POP     AF; RESTORE DEVICE ID
  5850  F1AF  f5                        PUSH    AF
  5851                          
  5852  F1B0  cd25f2                    CALL    GET_STATUS_FLAG; GET THE STATUS FOR THE PROPER
  5853                          ; DEVICE IN THE A REGISTER
  5854                          
  5855  F1B3  fe00                      CP      0; ANY ERRORS WITH DRIVE?
  5856                          
  5857  F1B5  2023                      JR      NZ,READ_ERROR; YUP
  5858                          
  5859  F1B7  3e02                      LD      A,ERROR_RETRY
  5860  F1B9  32d6fd                    LD      (RETRY_COUNT),A
  5861                          
  5862  F1BC  f1                        POP     AF
  5863  F1BD  fde1                      POP     IY
  5864  F1BF  dde1                      POP     IX
  5865  F1C1  e1                        POP     HL
  5866  F1C2  d1                        POP     DE
  5867  F1C3  c1                        POP     BC
  5868  F1C4  c5                        PUSH    BC
  5869                          _2ND_READ:
  5870  F1C5  f5                        PUSH    AF
  5871                          
  5872  F1C6  cd9efa                    CALL    __RD_1_BLOCK; SEND ANOTHER READ COMMAND
  5873  F1C9  280c                      JR      Z,NO_ERRORS
  5874  F1CB  e5                        PUSH    HL
  5875  F1CC  21d6fd                    LD      HL,RETRY_COUNT
  5876  F1CF  35                        DEC     (HL); THE NO OF RETRY'S
  5877  F1D0  e1                        POP     HL
  5878  F1D1  2803                      JR      Z,RETRY_LIMIT_REACHED; NO RETRY'S LEFT ; [RECON] Uncertain listing/ROM discrepancy: bytes 28 03 target local cleanup at $F1D6.
  5879  F1D3  f1                        POP     AF
  5880                          
  5881  F1D4  18ef                      JR      _2ND_READ; GO TRY AGAIN
  5882                          
  5883                          RETRY_LIMIT_REACHED: ; [RECON] ROM branch at $F1D0 targets this cleanup at $F1D6; printed target is unresolved.
  5884  F1D6  b7                        OR      A; NZ CONDITION
  5885                          NO_ERRORS:
  5886  F1D7  c1                        POP     BC
  5887  F1D8  c1                        POP     BC
  5888                          
  5889  F1D9  c9                        RET
  5890                          
  5891                          READ_ERROR:
  5892  F1DA  fde1                      POP     IY; POP AF INTO IY TO PRESERVE FLAGS
  5893  F1DC  fde1                      POP     IY
  5894  F1DE  dde1                      POP     IX
  5895  F1E0  e1                        POP     HL
  5896  F1E1  d1                        POP     DE
  5897  F1E2  c1                        POP     BC
  5898                          
  5899  F1E3  3e16                      LD      A,DEVICE_DEPD_ERR; INDICATE ERROR, LET APPL. HANDLE IT
  5900                          
  5901  F1E5  c9                        RET
  5902                          
  5903                          
  5904                          
  5905                          ;***************************************************************
  5906                          ;***************************************************************
  5907                          ;
  5908                          ;
  5909                          ;     WRITE_BLOCK:
  5910                          ;             1)  WRITES A BLOCK OUT TO TAPE
  5911                          ;             2)  AND CHECKS STATUS AFTER WRITE IS COMPLETED
  5912                          ;
  5913                          ;     INPUT:  SAME AS FOR __WR_1_BLOCK
  5914                          ;
  5915                          ;             A       DEVICE ID
  5916                          ;                     LOW NIBBLE - DEVICE ADDRESS
  5917                          ;                     HI NIBBLE  - SECONDARY DEVICE ID
  5918                          ;
  5919                          ;             HL      SOURCE ADDRESS OF BUFFER
  5920                          ;
  5921                          ;             REGISTER PAIR  BC DE
  5922                          ;                            SECTOR NUMBER ON DEVICE
  5923                          ;
  5924                          ;
  5925                          ;     OUTPUT: CONDITION FLAGS
  5926                          ;                     Z:  NO ERRORS
  5927                          ;                    NZ:  ERRORS OCCURED
  5928                          ;                         A - ERROR CODE
  5929                          ;
  5930                          ;     ALL REGISTERS PRESERVED EXCEPT FOR AF
  5931                          ;
  5932                          ;***************************************************************
  5933                          ;***************************************************************
  5934                          
  5935                          
  5936                          
  5937                          __WRITE_BLOCK:
  5938                          WRITE_BLOCK:
  5939  F1E6  c5                        PUSH    BC
  5940  F1E7  fde5                      PUSH    IY
  5941  F1E9  f5                        PUSH    AF
  5942                          
  5943  F1EA  3e02                      LD      A,ERROR_RETRY
  5944  F1EC  32d6fd                    LD      (RETRY_COUNT),A
  5945                          TRY_WRITE_AGAIN:
  5946  F1EF  f1                        POP     AF
  5947  F1F0  f5                        PUSH    AF
  5948                          
  5949  F1F1  cdb2fa                    CALL    __WR_1_BLOCK
  5950                          
  5951  F1F4  280e                      JR      Z,NO_WRITE_ERRORS; NO ERRORS
  5952                          
  5953  F1F6  fe9b                      CP      TIMEOUT
  5954                          
  5955  F1F8  280a                      JR      Z,NO_WRITE_ERRORS; ERROR OCCURED IN TRANSMISSION
  5956                          
  5957  F1FA  e5                        PUSH    HL
  5958  F1FB  21d6fd                    LD      HL,RETRY_COUNT
  5959  F1FE  35                        DEC     (HL)
  5960  F1FF  e1                        POP     HL
  5961  F200  281c                      JR      Z,WRITE_ERROR
  5962                          
  5963  F202  18eb                      JR      TRY_WRITE_AGAIN
  5964                          
  5965                          NO_WRITE_ERRORS:
  5966                          
  5967  F204  0602                      LD      B,ERROR_RETRY; MAX NO OF RETRIES
  5968                          
  5969                          RETRY_WRITE:
  5970  F206  f1                        POP     AF; RESTORE DEVICE ID
  5971  F207  f5                        PUSH    AF
  5972                          
  5973  F208  cd73f4                    CALL    __REQUEST_STATUS
  5974                          
  5975  F20B  2808                      JR      Z,WRITE_COMMAND_COMPLETE; STATUS BACK
  5976                          
  5977  F20D  fe9b                      CP      TIMEOUT; CHECK FOR TIMEOUT
  5978                          
  5979  F20F  28f5                      JR      Z,RETRY_WRITE; TIMEOUT. NOT A 'REAL' ERROR
  5980                          
  5981  F211  10f3                      DJNZ    RETRY_WRITE; REAL ERROR, TRY AGAIN
  5982                          
  5983  F213  1809                      JR      WRITE_ERROR; DONE RETRYING, IT'S AN ERROR
  5984                          
  5985                          WRITE_COMMAND_COMPLETE:
  5986  F215  f1                        POP     AF; RESTORE DEVICE ID
  5987  F216  f5                        PUSH    AF
  5988                          
  5989  F217  cd25f2                    CALL    GET_STATUS_FLAG; GET STATUS FOR SPECIFIED DEVICE
  5990                          
  5991  F21A  fe00                      CP      0; WRITE OK?
  5992  F21C  2802                      JR      Z,WRITE_OK; YUP
  5993                          
  5994                          WRITE_ERROR:
  5995  F21E  3e16                      LD      A,DEVICE_DEPD_ERR
  5996                          
  5997                          WRITE_OK:
  5998  F220  c1                        POP     BC; REALLY AF, BUT PRESERVE CURRENT FLAGS
  5999  F221  fde1                      POP     IY
  6000  F223  c1                        POP     BC
  6001                          
  6002                          
  6003  F224  c9                        RET
  6004                          
  6005                          
  6006                          
  6007                          GET_STATUS_FLAG:
  6008                          
  6009  F225  cb3f                      SRL     A; GET SECONDARY DEVICE ID (HI NIBBLE)
  6010  F227  cb3f                      SRL     A
  6011  F229  cb3f                      SRL     A
  6012  F22B  cb3f                      SRL     A
  6013                          
  6014  F22D  fe00                      CP      0; WAS IT UNIT 0?
  6015                          
  6016  F22F  fd7e14                    LD      A,(IY+D_STATUS_FLAGS); BY THE WAY, GET THE STATUS
  6017                          
  6018  F232  2004                      JR      NZ,UNIT1; NOPE, UNIT 1
  6019                          
  6020  F234  e60f                      AND     0FH; MASK OUT STATUS OF UNIT 1
  6021                          
  6022  F236  1808                      JR      CHECK_STATUS
  6023                          
  6024                          UNIT1:
  6025  F238  cb3f                      SRL     A
  6026  F23A  cb3f                      SRL     A
  6027  F23C  cb3f                      SRL     A
  6028  F23E  cb3f                      SRL     A
  6029                          
  6030                          CHECK_STATUS:; RETURN WITH THE STATUS NIBBLE IN A
  6031                          
  6032  F240  c9                        RET
  6033                          
  6034                          ;***************************************************************
  6035                          ;***************************************************************
  6036                          ;
  6037                          ;
  6038                          ;     TRIM_FILE RELEASES THE UNUSED BLOCKS IN THE SPECIFIED FILE
  6039                          ;
  6040                          ; NOTE:  IF FILE BEING TRIMMED IS THE LAST FILE, THE UNUSED BLOCKS ARE
  6041                          ;        ALLOCATED AS PART OF THE REMAINING AVAILABLE BLOCKS (RETURNED
  6042                          ;        TO THE HOLE).
  6043                          ;
  6044                          ;     INPUT:  A       DEVICE ID
  6045                          ;             DE      POINTER TO FILE NAME STRING
  6046                          ;
  6047                          ;     OUTPUT:
  6048                          ;             CONDITION FLAGS
  6049                          ;             Z:      NO ERRORS
  6050                          ;             NZ:     ERRORS
  6051                          ;                     A - ERROR CODE
  6052                          ;
  6053                          ;***************************************************************
  6054                          ;***************************************************************
  6055                          
  6056                          ;GLB    __TRIM_FILE
  6057                          
  6058                          ;EXT    FCB_BUFFER
  6059                          ;EXT    NEW_HOLE_SIZE
  6060                          ;EXT    HOLE_FILE_NAME
  6061                          
  6062                          __TRIM_FILE:
  6063                          
  6064  F241  e5                        PUSH    HL
  6065  F242  dde5                      PUSH    IX
  6066  F244  fde5                      PUSH    IY
  6067  F246  d5                        PUSH    DE
  6068  F247  f5                        PUSH    AF
  6069                          
  6070  F248  21bafd                    LD      HL,FCB_BUFFER
  6071                          
  6072  F24B  cd1be6                    CALL    __QUERY_FILE; FIND FILE IN DIRECTORY
  6073                          
  6074  F24E  c21af3                    JP      NZ,ERROR; HAD TROUBLE FINDING IT
  6075                          
  6076  F251  dd21bafd                  LD      IX,FCB_BUFFER; POINT TO THE BUFFER
  6077                          
  6078  F255  dd5e13                    LD      E,(IX+FCB_USED_LENGTH)
  6079  F258  dd5614                    LD      D,(IX+FCB_USED_LENGTH+1); GET THE NO OF USED BLOCKS
  6080                          
  6081  F25B  dd6e11                    LD      L,(IX+FCB_MAX_LENGTH)
  6082  F25E  dd6612                    LD      H,(IX+FCB_MAX_LENGTH+1); GET THE NO ALLOCATED
  6083                          
  6084  F261  b7                        OR      A
  6085  F262  ed52                      SBC     HL,DE; FIND OUT HOW MANY EMPTY
  6086                          
  6087  F264  7c                        LD      A,H
  6088  F265  b5                        OR      L
  6089                          
  6090  F266  ca11f3                    JP      Z,NO_TRIM; ALL USED
  6091                          
  6092  F269  221afe                    LD      (NEW_HOLE_SIZE),HL; SAVE THE NUMBER OF EMPTY BLOCKS
  6093  F26C  dd7311                    LD      (IX+FCB_MAX_LENGTH),E; ALLOCATED = USED,  NOW
  6094  F26F  dd7212                    LD      (IX+FCB_MAX_LENGTH+1),D
  6095                          
  6096  F272  3ad4fd                    LD      A,(FILE_COUNT); FILE ENTRY POSITION IN DIRECTORY
  6097  F275  0627                      LD      B,ENT_PER_BLOCK
  6098                          TRY_AGAIN:
  6099  F277  90                        SUB     B; IS IT THE LAST ENTRY IN THIS BLOCK
  6100  F278  2824                      JR      Z,LAST_ENTRY; YUP
  6101  F27A  30fb                      JR      NC,TRY_AGAIN; NOPE, MUST BE IN NEXT BLOCK
  6102                          
  6103                          NOT_LAST_ENTRY:
  6104  F27C  dd2afdfd                  LD      IX,(FCB_HEAD_ADDR); GET START OF FCB'S
  6105  F280  dd5e21                    LD      E,(IX+FCB_POINTER); GET ADDRESS OF THE MODIFIED FCB
  6106  F283  dd5622                    LD      D,(IX+FCB_POINTER+1)
  6107  F286  d5                        PUSH    DE
  6108                          
  6109  F287  011a00                    LD      BC,DIR_ENT_LENGTH; OFFSET TO NEXT DIR ENTRY'S ATTR BYTE
  6110  F28A  c5                        PUSH    BC
  6111                          
  6112  F28B  21bafd                    LD      HL,FCB_BUFFER
  6113  F28E  edb0                      LDIR
  6114                          
  6115  F290  d1                        POP     DE
  6116  F291  e1                        POP     HL
  6117                          
  6118  F292  19                        ADD     HL,DE; POINT TO ATTR BYTE
  6119                          
  6120  F293  e5                        PUSH    HL
  6121  F294  fde1                      POP     IY
  6122                          
  6123  F296  fdcb0c46                  BIT     ATTR_HOLE_BIT,(IY+DIR_ATTR); IS IT A HOLE?
  6124  F29A  285e                      JR      Z,NOT_HOLE; NOPE
  6125                          
  6126  F29C  183c                      JR      ITS_HOLE
  6127                          
  6128                          
  6129                          LAST_ENTRY:
  6130  F29E  3ad4fd                    LD      A,(FILE_COUNT)
  6131  F2A1  32d5fd                    LD      (MOD_FILE_COUNT),A; SAVE IT
  6132                          
  6133  F2A4  f1                        POP     AF
  6134  F2A5  d1                        POP     DE
  6135                          
  6136  F2A6  d5                        PUSH    DE
  6137  F2A7  f5                        PUSH    AF
  6138                          
  6139  F2A8  21bafd                    LD      HL,FCB_BUFFER
  6140                          
  6141  F2AB  cd51e6                    CALL    __SET_FILE; PUT CHANGED DIRECTORY AWAY
  6142                          
  6143  F2AE  206a                      JR      NZ,ERROR
  6144                          
  6145  F2B0  f1                        POP     AF
  6146  F2B1  d1                        POP     DE
  6147                          
  6148  F2B2  1128f4                    LD      DE,HOLE_FILE_NAME; NAME OF HOLE
  6149                          
  6150  F2B5  d5                        PUSH    DE
  6151  F2B6  f5                        PUSH    AF; SAVE DEVICE ID
  6152                          
  6153  F2B7  21bafd                    LD      HL,FCB_BUFFER

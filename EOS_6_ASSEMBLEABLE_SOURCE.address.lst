  7951                          ; NAME ^Rev 07 - rfj^
  7952                          
  7953                          ; Do_EOS_START MACRO                  ;Header Rev. 4
  7954                          ;                 .GOTO   Ede_EOS_START
  7955                          
  7956                          ; Project:        EOS, 83-101
  7957                          
  7958                          ; ;&k1S                                      ;&k0S
  7959                          ; ;&k1S                                      ;&k0S
  7960                          ; ;&k1S  EOS_START              DLS          ;&k0S
  7961                          ; ;&k1S                                      ;&k0S
  7962                          ; ;&k1S                                      ;&k0S
  7963                          
  7964                          ;             Rev History
  7965                          ;             Rev.  Date        Name        Change
  7966                          ;              7    24Oct1951   rfj         Changed value for REV_NUM to 06
  7967                          ;              6    13Oct1045a  RPD         added init of REV_NUM
  7968                          ;              5    10Oct1005a  RPD         took out memory bank switch logic for GOTO_WP
  7969                          ;              4    25sept1000a RPD         reworked for new boot from tape logic
  7970                          ;              3    24sept1110a RPD         moved clear ram logic
  7971                          ;              2    23sept1255p RPD         moved FCB's and added calls A_uOS routines
  7972                          ;              1    03SEP1445   DLS         MORE CODE
  7973                          ;              0    02SEP0630   DLS         CODE
  7974                          
  7975                          ; Ede_EOS_START MEND
  7976                          
  7977                          ;**********************************************************************
  7978                          ;                                                                     *
  7979                          ;  MODULE NAME:                                                       *
  7980                          ;                                                                     *
  7981                          ;    EOS_START                                                        *
  7982                          ;                                                                     *
  7983                          ;  INPUTS:                                                            *
  7984                          ;                                                                     *
  7985                          ;    NONE                                                             *
  7986                          ;                                                                     *
  7987                          ;  FUNCTION(S):                                                       *
  7988                          ;      0. SET STACK.                                                   *
  7989                          ;      1. TO BANK SELECT OS7 AND 24K RAM.                              *
  7990                          ;      2. CALL INIT_EOS TO ALLOW THE 1) THE Z80/6801 SYNCH_UP,         *
  7991                          ;         POLL FOR NET DEVICES AND ESTABLISH DCB'S.                   *
  7992                          ;      3. CHECK FOR THE PRESENCE OF A TAPE. IF PRESENT THEN            *
  7993                          ;         LOAD IN A COLD_START LOADER AND EXECUTE FROM THERE.          *
  7994                          ;      4. IF NO TAPE, THEN BRING UP THE ROM RESIDENT WORD              *
  7995                          ;         PROCESSOR BY JUMPING TO OS7.                                  *
  7996                          ;                                                                     *
  7997                          ;  OUTPUTS:                                                           *
  7998                          ;                                                                     *
  7999                          ;    DEVICE ADDR _ REG B                                               *
  8000                          ;                                                                     *
  8001                          ;  CALLS:                                                             *
  8002                          ;                                                                     *
  8003                          ;    EOS_INIT                                                         *
  8004                          ;    EOS_QUERY_DEVICE                                                 *
  8005                          ;    EOS_READ_BLOCK                                                    *
  8006                          ;                                                                     *
  8007                          ;  CALLED BY:                                                         *
  8008                          ;                                                                     *
  8009                          ;    INVOKED BY EOS_BOOT                                               *
  8010                          ;                                                                     *
  8011                          ;  NOTES:                                                             *
  8012                          ;                                                                     *
  8013                          ;    NONE.                                                            *
  8014                          ;                                                                     *
  8015                          ;**********************************************************************
  8016                          
  8017                          
  8018                          ;:
  8019                          ;: external routines used
  8020                          ;:
  8021                          ;EXT    _FIND_DCB
  8022                          ;EXT    _REQUEST_STATUS
  8023                          ;EXT    _HARD_INIT
  8024                          ;EXT    _RD_1_BLOCK
  8025                          ;EXT    _FMGR_INIT
  8026                          ;EXT    _GOTO_WP
  8027                          ;EXT    FILL_VRAM
  8028                          ;EXT    TURN_OFF_SOUND
  8029                          ;EXT    SWITCH_MEM
  8030                          ;EXT    PORT_COLLECTION
  8031                          ;:
  8032                          ;: external data structures used
  8033                          ;:
  8034                          ;EXT    REV_NUM
  8035                          ;EXT    CLEAR_RAM_START
  8036                          ;EXT    CLEAR_RAM_SIZE
  8037                          ;EXT    EOS_STACK
  8038                          ;EXT    DEFAULT_BT_DEV
  8039                          ;EXT    MEM_CNFGO1 ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8040                          ;EXT    MEM_CNFGO3 ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8041                          ;:
  8042                          ;: local equates
  8043                          ;:
  8044                          EOS_REV         EQU     005H;current EOS revision number
  8045                          ;--NOTE-- this is actually rev.
  8046                          ;06 but to match the production ROM
  8047                          ;which was labeled rev. 05 we fudge
  8048                          ;just a bit (two bits actually)
  8049                          
  8050                          COLD_START_ADDR EQU     0C800H
  8051                          DSK4            EQU     4
  8052                          DSK5            EQU     5
  8053                          ONE_BLOCK       EQU     1
  8054                          BLOCK_ZERO      EQU     0
  8055                          
  8056                          
  8057                          ;GLB    _EOS_START
  8058                          __EOS_START:; [RECON] OCR 8129 exports __EOS_START; scan loses underscores in the label image.
  8059  F832  3158fe                            LD      SP,EOS_STACK; SET THE STACK
  8060                          
  8061  F835  014701                            LD      BC,CLEAR_RAM_SIZE; clear EOS ram
  8062  F838  1161fd                            LD      DE,CLEAR_RAM_START+1
  8063  F83B  2160fd                            LD      HL,CLEAR_RAM_START
  8064  F83E  af                                XOR     A
  8065  F83F  77                                LD      (HL),A
  8066  F840  edb0                              LDIR
  8067                          
  8068  F842  3e05                              LD      A,EOS_REV; init REV_NUM
  8069  F844  3260fd                            LD      (REV_NUM),A
  8070                          
  8071  F847  cd11fd                            CALL    PORT_COLLECTION; collect the port addresses from OS7
  8072                          
  8073  F84A  cd53fd                            CALL    TURN_OFF_SOUND; KILL SOUNDS
  8074                          
  8075  F84D  3e00                              LD      A,0; CLEAR VRAM
  8076  F84F  210000                            LD      HL,0
  8077  F852  110040                            LD      DE,16*1024
  8078  F855  cd26fd                            CALL    FILL_VRAM
  8079                          
  8080  F858  3a18fc                            LD      A,(MEM_CNFGO1);get the data for configuration 1 (64K RAM) ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8081  F85B  cd14fd                            CALL    SWITCH_MEM;select this configuration
  8082                          ;:
  8083                          ;: EOS_INIT WILL PERFORM THE 6801/Z80 SYNCH_UP, PERFORM A ROLL_CALL
  8084                          ;: POLL ON THE NET, AND ESTABLISH THE DCB'S
  8085                          ;:
  8086  F85E  cdf6f8                            CALL    __HARD_INIT; [RECON] OCR 8158 bytes CD F6 F8 call the implementation directly.
  8087                          ;:
  8088                          ;: setup the FCB's
  8089                          
  8090  F861  1100d4                            LD      DE,THREE1K_BLKS; START ADDRESS OF THREE 1K BLOCKS
  8091  F864  2190d3                            LD      HL,FCB_S; START ADDRESS OF 3 FCB BLOCKS
  8092  F867  cdeaee                            CALL    __FMGR_INIT; TELL THE FILE MANAGER ; [RECON] OCR 8164 bytes CD EA EE call the implementation directly.
  8093                          
  8094                          ;:
  8095                          ;:     CHECK FOR BOOT LOADER IN ANY MASS STORAGE DEVICE
  8096                          ;:
  8097  F86A  3e08                              LD      A,TAPE_ID;set the default boot device to tape
  8098  F86C  326ffd                            LD      (DEFAULT_BT_DEV),A
  8099                          
  8100  F86F  3e04                              LD      A,DSK4;check for DISK 4 device active
  8101  F871  cd73f4                            CALL    __REQUEST_STATUS; [RECON] OCR 8173 bytes CD 73 F4 call the implementation directly.
  8102  F874  2010                              JR      NZ,CHK_D5
  8103                          
  8104  F876  3e04                              LD      A,DSK4
  8105  F878  cd46f4                            CALL    __FIND_DCB; [RECON] OCR 8177 bytes CD 46 F4 call the implementation directly.
  8106  F87B  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8107  F87E  e60f                              AND     0FH
  8108  F880  fe03                              CP      3
  8109  F882  3e04                              LD      A,DSK4
  8110  F884  3842                              JR      C,DEV1_OK
  8111                          
  8112  F886  3e05              CHK_D5: LD      A,DSK5;check for DISK 5 device active
  8113  F888  cd73f4                            CALL    __REQUEST_STATUS; [RECON] OCR 8185 bytes CD 73 F4 call the implementation directly.
  8114  F88B  2010                              JR      NZ,CHK_TAPE
  8115                          
  8116  F88D  3e05                              LD      A,DSK5
  8117  F88F  cd46f4                            CALL    __FIND_DCB; [RECON] OCR 8189 bytes CD 46 F4 call the implementation directly.
  8118  F892  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8119  F895  e60f                              AND     0FH
  8120  F897  fe03                              CP      3
  8121  F899  3e05                              LD      A,DSK5
  8122  F89B  382b                              JR      C,DEV1_OK
  8123                          CHK_TAPE:
  8124  F89D  3e08                              LD      A,TAPE_ID;check if TAPE device active
  8125  F89F  cd73f4                            CALL    __REQUEST_STATUS; [RECON] OCR 8197 bytes CD 73 F4 call the implementation directly.
  8126  F8A2  201e                              JR      NZ,CALL_WP
  8127                          
  8128  F8A4  3e08                              LD      A,TAPE_ID
  8129  F8A6  cd46f4                            CALL    __FIND_DCB; [RECON] OCR 8201 bytes CD 46 F4 call the implementation directly.
  8130  F8A9  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8131  F8AC  f5                                PUSH    AF
  8132  F8AD  e60f                              AND     0FH
  8133  F8AF  fe03                              CP      3
  8134  F8B1  3812                              JR      C,DEV0_OK
  8135                          
  8136  F8B3  f1                                POP     AF
  8137  F8B4  cb3f                              SRL     A
  8138  F8B6  cb3f                              SRL     A
  8139  F8B8  cb3f                              SRL     A
  8140  F8BA  cb3f                              SRL     A
  8141  F8BC  fe03                              CP      3
  8142  F8BE  3e18                              LD      A,TAPE_ID+10H
  8143  F8C0  3806                              JR      C,DEV1_OK
  8144                          
  8145                          CALL_WP:;devices disk 4, 5 and tape are not active
  8146                          ;                 LD      A,(MEM_CNFGO3)          ;get the data for configuration 3 (8K OS7 and 56K RAM) ; [RECON] OCR 8218 is commented in the scan.
  8147                          ;                 CALL    SWITCH_MEM              ;select this configuration ; [RECON] OCR 8219 is commented in the scan.
  8148  F8C2  c3e7fc                            JP      _GOTO_WP;default to ALPHA
  8149                          DEV0_OK:
  8150  F8C5  f1                                POP     AF
  8151  F8C6  3e08                              LD      A,TAPE_ID
  8152                          DEV1_OK:
  8153  F8C8  326ffd                            LD      (DEFAULT_BT_DEV),A
  8154                          READ_AGAIN:
  8155  F8CB  2100c8                            LD      HL,COLD_START_ADDR
  8156  F8CE  010000                            LD      BC,0
  8157  F8D1  3a6ffd                            LD      A,(DEFAULT_BT_DEV)
  8158  F8D4  110000                            LD      DE,BLOCK_ZERO
  8159  F8D7  cd9efa                            CALL    __RD_1_BLOCK; [RECON] OCR 8231 bytes CD 9E FA call the implementation directly.
  8160  F8DA  caeff8                            JP      Z,GO_TO_TAPECODE
  8161  F8DD  4f                                LD      C,A
  8162  F8DE  3a6ffd                            LD      A,(DEFAULT_BT_DEV)
  8163  F8E1  e60f                              AND     0FH
  8164  F8E3  fe08                              CP      TAPE_ID
  8165  F8E5  20e4                              JR      NZ,READ_AGAIN
  8166  F8E7  79                                LD      A,C
  8167  F8E8  fe9b                              CP      TIMEOUT
  8168  F8EA  28df                              JR      Z,READ_AGAIN
  8169  F8EC  c3c2f8                            JP      CALL_WP
  8170                          GO_TO_TAPECODE:
  8171                          
  8172  F8EF  3a6ffd                            LD      A,(DEFAULT_BT_DEV)
  8173  F8F2  47                                LD      B,A
  8174  F8F3  c300c8                            JP      COLD_START_ADDR
  8175                          ;:

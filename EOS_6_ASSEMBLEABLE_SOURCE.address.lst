  4069  E99A  3e0c                      LD      A,FULL_DIR_ERR
  4070  E99C  18eb                      JR      MAKE_ERROR
  4071                          
  4072                          TAPE_FULL:
  4073  E99E  3e0d                      LD      A,FULL_TAPE_ERR
  4074  E9A0  18e7                      JR      MAKE_ERROR
  4075                          ;
  4076                          ;
  4077                          ; SUBROUTINE NAME: GET FILE NAME LENGTH
  4078                          ;
  4079                          ;   ENTRY: HL- POINTS TO TEXT STRING
  4080                          ;   EXIT:  Z=1=FOUND AND PROPER SIZE (1-12)
  4081                          ;          BC=BYTE COUNT
  4082                          ;          A=TRASHED
  4083                          ;
  4084                          ;          Z=0=ERROR
  4085                          ;          BC=TRASH
  4086                          ;          A=FILE_NAME_TOO_LONG
  4087                          ; DLS(8/28/83)
  4088                          ;
  4089                          GET_FILE_NM_LEN:
  4090  E9A2  e5                        PUSH    HL;SAVE THE POINTER TO FILE NAME
  4091  E9A3  060c                      LD      B,12;SCAN UP TO 12 BYTE
  4092  E9A5  0e01                      LD      C,1;SET COUNT TO 1
  4093                          SRCH_LOOP:
  4094  E9A7  7e                        LD      A,(HL);GET FN()
  4095  E9A8  fe03                      CP      03;ETX
  4096  E9AA  2809                      JR      Z,GOT_IT
  4097                          ;
  4098  E9AC  0c                        INC     C
  4099  E9AD  23                        INC     HL;ADVANCE POINTER TO FILE NAME STRING
  4100  E9AE  10f7                      DJNZ    SRCH_LOOP
  4101                          ;
  4102                          ERR_GFN:
  4103  E9B0  3e0e                      LD      A,FILE_NM_ERR
  4104  E9B2  b7                        OR      A;SHOW ERROR
  4105  E9B3  e1                        POP     HL
  4106  E9B4  c9                        RET
  4107                          ;
  4108                          GOT_IT:
  4109  E9B5  79                        LD      A,C
  4110  E9B6  fe01                      CP      1;ETX ALONE IS NOT VALID
  4111  E9B8  28f6                      JR      Z,ERR_GFN
  4112  E9BA  0600                      LD      B,0
  4113  E9BC  af                        XOR     A;SHOW OK
  4114  E9BD  e1                        POP     HL
  4115  E9BE  c9                        RET
  4116                          
  4117                          
  4118                          
  4119                          LOAD_NEW_ENTRY_INFO:
  4120  E9BF  fde5                      PUSH    IY;GET NAME ADDRESS INTO DE
  4121  E9C1  d1                        POP     DE
  4122                          
  4123  E9C2  2a10fe                    LD      HL,(USER_NAME);GET USER'S STRING ADDRESS
  4124                          ;
  4125  E9C5  cda2e9                    CALL    GET_FILE_NM_LEN; DLS(8/28/83)
  4126  E9C8  c2ffe9                    JP      NZ,MAKE_ERR_1
  4127                          ;
  4128  E9CB  edb0                      LDIR;COPY USER'S NAME INTO DIR ENTRY
  4129                          
  4130  E9CD  3e10                      LD      A,ATTR_USER;SET THE DEFAULT ATTRIBUTE
  4131  E9CF  fd770c                    LD      (IY+DIR_ATTR),A
  4132                          
  4133  E9D2  ed4b0cfe                  LD      BC,(BLOCKS_REQ);GET NEW FILE'S MAX SIZE
  4134  E9D6  fd7111                    LD      (IY+DIR_MAX_LENGTH),C;PUT INTO DIR
  4135  E9D9  fd7012                    LD      (IY+DIR_MAX_LENGTH+1),B
  4136                          
  4137                          
  4138  E9DC  fd361301                  LD      (IY+DIR_USED_LENGTH),1;INIT COUNT OF BLOCKS USED
  4139  E9E0  fd361400                  LD      (IY+DIR_USED_LENGTH+1),0
  4140                          
  4141  E9E4  fd361500                  LD      (IY+DIR_LAST_COUNT),0;INIT BYTECOUNT IN LAST BLOCK
  4142  E9E8  fd361600                  LD      (IY+DIR_LAST_COUNT+1),0
  4143                          
  4144  E9EC  3ae0fd                    LD      A,(EOS_YEAR);INSERT THE DATE
  4145  E9EF  fd7717                    LD      (IY+DIR_YEAR),A
  4146  E9F2  3ae1fd                    LD      A,(EOS_MONTH)
  4147  E9F5  fd7718                    LD      (IY+DIR_MONTH),A
  4148  E9F8  3ae2fd                    LD      A,(EOS_DAY)
  4149  E9FB  fd7719                    LD      (IY+DIR_DAY),A
  4150                          
  4151  E9FE  af                        XOR     A
  4152                          
  4153                          MAKE_ERR_1:
  4154  E9FF  c9                        RET
  4155                          

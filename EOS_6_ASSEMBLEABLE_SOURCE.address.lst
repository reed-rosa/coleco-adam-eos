  6466                          ; NAME "REV 1 - RPD"
  6467                          ;
  6468                          ;       RETURN ERROR CODES UNTIL THESE ROUTINES ARE WRITTEN
  6469                          ;
  6470                          ;       10/12/83  VSB
  6471                          ;       10/14/83  RPD changed __EOS_4 to __CV_A
  6472                          ;
  6473                          
  6474                          ;GLB    __POSIT_FILE,__EOS_1,__EOS_2,__EOS_3,__CV_A
  6475                          __POSIT_FILE:
  6476                          __EOS_1:
  6477                          __EOS_2:
  6478                          __EOS_3:
  6479                          __CV_A:
  6480  F442  3e17                      LD      A,PROG_NON_EXIST; SIGNIFY PROGRAM DOES NOT EXIST
  6481  F444  b7                        OR      A; NZ CONDITION
  6482  F445  c9                        RET
  6483                          ;
  6484                          ;================================================================
  6485                          ;================================================================
  6486                          ;================================================================
  6487                          ;
  6488                          
  6489                          
  6490                          ;REV 0  (V/D 8/24/83)
  6491                          
  6492                          
  6493                          ;****************************************************************
  6494                          ; THIS ROUTINE WILL FIND THE DCB FOR THE DEVICE DESIRED
  6495                          ;
  6496                          ;       INPUT:  A ==> POINTS TO THE DEVICE ID
  6497                          ;       OUTPUT:
  6498                          ;               CONDITION FLAG:
  6499                          ;                       Z : NO ERRORS
  6500                          ;                           IY ==> POINTS TO THE START OF THE DEVICE DCB
  6501                          ;                       NZ: ERROR OCCURED
  6502                          ;                           IY ==> IS DESTROYED
  6503                          ;
  6504                          ;****************************************************************
  6505                          
  6506                          
  6507                          ;GLB    __GET_DCB_ADDR
  6508                                  GLOBAL  __FIND_DCB
  6509                          ;EXT    CURRENT_PCB
  6510                          
  6511                          __GET_DCB_ADDR:
  6512                          __FIND_DCB:
  6513  F446  c5                        PUSH    BC
  6514  F447  d5                        PUSH    DE
  6515                          
  6516  F448  4f                        LD      C,A; SAVE THE DEVICE ID
  6517  F449  fd2a70fd                  LD      IY,(CURRENT_PCB); GET THE START ADDRESS OF PCB
  6518  F44D  fd4603                    LD      B,(IY+P_NUM_DCBS); GET THE NUMBER OF DCB'S
  6519  F450  af                        XOR     A
  6520  F451  b8                        CP      B; ARE THERE ZERO DCBS?
  6521  F452  2819                      JR      Z,DCB_NO_FIND; YES
  6522                          ; NO
  6523  F454  110400                    LD      DE,P_SIZE; GET THE SIZE OF THE PCB
  6524  F457  fd19                      ADD     IY,DE; ADD TO IY TO GET TO THE START OF THE DCB
  6525  F459  111500                    LD      DE,D_SIZE; GET THE DCB SIZE
  6526  F45C  79                        LD      A,C; RELOAD THE DEVICE ID
  6527  F45D  e60f                      AND     0FH; AND OF THE HIGH BITS TO GET ONLY
  6528                          ; THE DEVICE ID
  6529                          
  6530                          DCB_LOOP:
  6531  F45F  fdbe10                    CP      (IY+D_DEV_ADDR); IS THIS THE CORRECT DEVICE DCB?
  6532  F462  2806                      JR      Z,FOUND_IT; YES
  6533                          ; NO
  6534  F464  fd19                      ADD     IY,DE; GET TO THE NEXT DCB AND CHECK IT
  6535  F466  10f7                      DJNZ    DCB_LOOP; GO CHECK THEM ALL UNTIL ONE IS FOUND
  6536                          
  6537  F468  1803                      JR      DCB_NO_FIND
  6538                          
  6539                          
  6540                          FOUND_IT:
  6541  F46A  79                        LD      A,C; RESTORE A TO ITS ORIGINAL STATE
  6542  F46B  1803                      JR      FINISHED
  6543                          
  6544                          DCB_NO_FIND:
  6545  F46D  3e01                      LD      A,DCB_NOT_FOUND
  6546  F46F  b7                        OR      A
  6547                          
  6548                          FINISHED:
  6549  F470  d1                        POP     DE
  6550  F471  c1                        POP     BC
  6551                          
  6552  F472  c9                        RET
  6553                          
  6554                          
  6555                          
  6556                          
  6557                          ;****************************************************************
  6558                          ; THIS ROUTINE WILL INITIATE A STATUS REQUEST COMMAND, AND WILL RETURN
  6559                          ; THE RESULT OF THE COMMAND.
  6560                          ;       INPUT:  A ==> DEVICE ID
  6561                          ;       OUTPUT: CONDITION BITS
  6562                          ;               Z :     NO ERRORS
  6563                          ;                       IY CONTAINS START ADDRESS OF DCB
  6564                          ;               NZ:     ERROR OCCURED
  6565                          ;                       A ==> ERROR CODE
  6566                          ;                       IY IS DESTROYED (MAY BE ADDRESS OF DCB
  6567                          ;                       UNDER CERTAIN ERROR CONDITIONS)
  6568                          ;
  6569                          ;****************************************************************
  6570                          
  6571                          ;GLB    __REQUEST_STATUS
  6572                          
  6573                          
  6574                          __REQUEST_STATUS:
  6575  F473  cd46f4                    CALL    __FIND_DCB; GET THE CORRECT DEVICE DCB
  6576                          
  6577  F476  200f                      JR      NZ,END_R_S
  6578                          
  6579  F478  fd360001                  LD      (IY+D_COM_STAT),DCB_STATUS; SEND THE COMMAND TO REQUEST
  6580                          ; A STATUS
  6581                          
  6582                          REQUEST_LOOP:
  6583  F47C  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); HAS THE COMMAND COMPLETED?
  6584  F480  28fa                      JR      Z,REQUEST_LOOP; NO LOOP TILL IT DOES
  6585                          
  6586  F482  fd7e00                    LD      A,(IY+D_COM_STAT); CHECK THE STATUS
  6587  F485  fe80                      CP      CMND_FIN_STATUS; DID IT FINISH WITH NO ERRORS?
  6588                          ; IF ZERO EVERYTHING IS OK
  6589                          ; IF NZ THERE WAS AN ERROR
  6590                          
  6591                          END_R_S:
  6592  F487  c9                        RET
  6593                          
  6594                          
  6595                          
  6596                          
  6597                          ;GLB    __RD_DEV_DEP_STAT
  6598                          
  6599                          __RD_DEV_DEP_STAT:
  6600  F488  fde5                      PUSH    IY; SAVE THIS REGISTER
  6601  F48A  cd46f4                    CALL    __FIND_DCB; GET THE CORRECT DEVICE DCB
  6602                          
  6603  F48D  2004                      JR      NZ,END_R_D_D_S
  6604                          
  6605  F48F  af                        XOR     A; NO ERROR
  6606                          
  6607  F490  fd7e14                    LD      A,(IY+D_STATUS_FLAGS); READ DEVICE-DEPENDENT STATUS FLAGS
  6608                          
  6609                          END_R_D_D_S:
  6610  F493  fde1                      POP     IY; RESTORE THE REGISTER
  6611  F495  c9                        RET
  6612                          
  6613                          
  6614                          ;****************************************************************
  6615                          ; THIS ROUTINE WILL CHECK AND SEE IF THE DEVICE DCB IS CURRENTLY ACTIVE.
  6616                          ; IF IT IS THEN A NZ CONDITION WILL BE SENT BACK TO THE CALLING PROGRAM
  6617                          ;       INPUT:  IY ===> POINTS TO START OF DEVICE DCB
  6618                          ;       OUTPUT: CONDITION FLAGS
  6619                          ;               Z :     DCB IS INACTIVE, IN OTHERWORDS IT IS AVAILABLE
  6620                          ;                       A ===> IS PRESERVED
  6621                          ;               NZ:     DCB IS ACTIVE
  6622                          ;                       A ===> ERROR CODE
  6623                          ;
  6624                          ;****************************************************************
  6625                          
  6626                          ; OK CHANGED TO G_OK TO PREVENT CONFLICT WITH IDENTICAL
  6627                          ; LABEL ELSEWHERE
  6628                          
  6629                          ;GLB    CHK_IF_INACTIVE
  6630                          
  6631                          CHK_IF_INACTIVE:
  6632  F496  c5                        PUSH    BC
  6633                          
  6634  F497  4f                        LD      C,A; PRESERVE A
  6635  F498  fd7e00                    LD      A,(IY+D_COM_STAT); IS THE DCB AVAILABLE?
  6636  F49B  fe00                      CP      DCB_IDLE
  6637  F49D  2806                      JR      Z,G_OK; YES IT IS INACTIVE
  6638                          ; NO IT IS NOT
  6639  F49F  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); HAS THE COMMAND BEEN
  6640                          ; PROCESSED
  6641  F4A3  2804                      JR      Z,DEVICE_BUSY; NO, THE DEVICE IS STILL BUSY
  6642                          ; YES, THE DCB IS AVAILABLE
  6643                          G_OK:
  6644  F4A5  af                        XOR     A; INSURE ZERO CONDITION
  6645  F4A6  79                        LD      A,C; RESTORE A
  6646  F4A7  1803                      JR      DONE
  6647                          
  6648                          DEVICE_BUSY:
  6649  F4A9  3c                        INC     A; INSURE A NON_ZERO CONDITION FOR FLAG
  6650  F4AA  3e02                      LD      A,DCB_BUSY; SEND BACK THE ERROR CODE
  6651                          
  6652                          DONE:
  6653  F4AC  c1                        POP     BC
  6654  F4AD  c9                        RET
  6655                          
  6656                          
  6657                          
  6658                          
  6659                          ;****************************************************************
  6660                          ;
  6661                          ;       CHK_FOR_IDLE CHECKS IF THE REQUESTED DEVICE IS IDLE
  6662                          ;       SENDING BACK AN ERROR CODE
  6663                          ;
  6664                          ;       INPUT:  IY       POINTER TO THE DCB
  6665                          ;
  6666                          ;       OUTPUT: CONDITION FLAGS
  6667                          ;               Z        DEVICE NOT IDLE
  6668                          ;               NZ       DEVICE IDLE
  6669                          ;
  6670                          ;****************************************************************
  6671                          
  6672                          
  6673                          ;GLB    CHK_IF_IDLE
  6674                          
  6675                          CHK_IF_IDLE:
  6676                          
  6677  F4AE  fd7e00                    LD      A,(IY+D_COM_STAT); GET STATUS BYTE
  6678                          
  6679  F4B1  b7                        OR      A; IS IT IDLE(ZERO)?
  6680  F4B2  2004                      JR      NZ,NOT_IDLE; NOPE
  6681                          
  6682  F4B4  3e03                      LD      A,DCB_IDLE_ERR; ERROR CODE FOR DEVICE IDLE
  6683                          
  6684  F4B6  b7                        OR      A; CREATE NZ CONDITION
  6685                          
  6686  F4B7  c9                        RET
  6687                          
  6688                          NOT_IDLE:
  6689  F4B8  af                        XOR     A; CLEAR ZERO FLAG
  6690                          
  6691  F4B9  c9                        RET
  6692                          ;
  6693                          ;================================================================
  6694                          ;================================================================
  6695                          ;================================================================
  6696                          ;
  6697                          
  6698                          
  6699                          ;REV 0                  (V/D  8-24-83)
  6700                          
  6701                          ;****************************************************************
  6702                          ; THIS ROUTINE WILL READ A CHARACTER FROM THE KEYBOARD
  6703                          ;
  6704                          ;       INPUT:  NOTHING
  6705                          ;       OUTPUT: CONDITION FLAGS
  6706                          ;               Z :     NO ERRORS
  6707                          ;                       A ===> CONTAINS THE KEY READ
  6708                          ;               NZ:     ERROR OCCURED
  6709                          ;                       A ===> ERROR CODE
  6710                          ;
  6711                          ;
  6712                          ;****************************************************************
  6713                          
  6714                                  GLOBAL  __RD_KBD
  6715                          ;EXT    KEYBOARD_BUFFER
  6716                          ;EXT    __RD_CH_DEV
  6717                          
  6718                          __RD_KBD:
  6719  F4BA  c5                        PUSH    BC
  6720  F4BB  d5                        PUSH    DE
  6721                          
  6722                          RD_KBD_LOOP:
  6723                          
  6724  F4BC  cdd0f4                    CALL    __START_RD_KBD
  6725                          
  6726  F4BF  2007                      JR      NZ,ERROR_OCCURED
  6727                          
  6728  F4C1  4f                        LD      C,A; PRESERVE THE DEVICE ID
  6729                          
  6730                          WAITING:
  6731  F4C2  79                        LD      A,C; RESTOR THE DEVICE ID
  6732                          ; BC IS SAVED IN ALL CALLED MODULES
  6733  F4C3  cde0f4                    CALL    __END_RD_KBD
  6734                          
  6735  F4C6  30fa                      JR      NC,WAITING; THE OPERATION HAS NOT COMPLETED YET
  6736                          ; AT THIS POINT WE EITHER HAVE THE
  6737                          ; KEY OR AN ERROR CODE IN A
  6738                          ERROR_OCCURED:
  6739  F4C8  d1                        POP     DE
  6740  F4C9  c1                        POP     BC
  6741                          
  6742  F4CA  c9                        RET
  6743                          
  6744                          
  6745                          ;****************************************************************
  6746                          ; THIS ROUTINE WILL REQUEST A STATUS ON THE KEYBOARD
  6747                          ;       INPUT:  NOTHING
  6748                          ;       OUTPUT: CONDITION FLAG
  6749                          ;               Z :     NO ERRORS
  6750                          ;               NZ:     ERROR OCCURED
  6751                          ;                       A ===> ERROR CODE
  6752                          ;
  6753                          ;****************************************************************
  6754                          
  6755                                  GLOBAL  __REQ_KBD_STAT
  6756                          
  6757                          ;EXT    __REQUEST_STATUS
  6758                          
  6759                          __REQ_KBD_STAT:
  6760  F4CB  3e01                      LD      A,KEYBOARD_ID; WANT STATUS ON THE KEYBOARD
  6761  F4CD  c373f4                    JP      __REQUEST_STATUS
  6762                          
  6763                          
  6764                          ;****************************************************************
  6765                          ; THIS ROUTINE WILL START A READ DATA COMMNAD ON THE KEYBOARD
  6766                          ;       INPUT:  NOTHING
  6767                          ;       OUTPUT: CONDITION FLAGS
  6768                          ;               Z :     NO ERROR
  6769                          ;               NZ:     ERROR OCCURED
  6770                          ;                       A ===> ERROR CODE
  6771                          ;****************************************************************
  6772                          
  6773                          ;GLB    __START_RD_KBD
  6774                          
  6775                          ;EXT    __START_RD_CH_DEV
  6776                          
  6777                          __START_RD_KBD:
  6778  F4D0  c5                        PUSH    BC
  6779  F4D1  d5                        PUSH    DE
  6780                          
  6781                          STRT_RD_KBD_LOOP:
  6782  F4D2  3e01                      LD      A,KEYBOARD_ID
  6783  F4D4  1175fd                    LD      DE,KEYBOARD_BUFFER; DESTINATION OF WHERE TO PLACE KEY
  6784  F4D7  010100                    LD      BC,1; GET 1 CHARACTER
  6785  F4DA  cd86fb                    CALL    __START_RD_CH_DEV; GO INITIATE THE COMMAND
  6786                          
  6787  F4DD  d1                        POP     DE
  6788  F4DE  c1                        POP     BC
  6789                          
  6790  F4DF  c9                        RET
  6791                          
  6792                          
  6793                          ;****************************************************************
  6794                          ; THIS ROUTINE WILL CHECK THE RESULT OF A COMMAND THAT WAS SENT.  IF THE
  6795                          ; RESULT IS A NAK THEN THE ROUTINE WILL ISSUE A NEW READ COMMAND.
  6796                          ;       INPUT:  NOTHING
  6797                          ;       OUTPUT: CONDITION FLAG
  6798                          ;               C :     COMMAND HAS FINISHED
  6799                          ;               NC:     COMMAND HAS NOT BEEN FINISHED
  6800                          ;               Z :     NO ERROR OCCURED
  6801                          ;               NZ:     ERROR OCCURED
  6802                          ;                       A ===> ERROR CODE
  6803                          ;****************************************************************
  6804                          
  6805                          ;GLB    __END_RD_KBD
  6806                          ;EXT    __END_RD_CH_DEV
  6807                          
  6808                          __END_RD_KBD:
  6809  F4E0  3e01                      LD      A,KEYBOARD_ID; SEND THIS PARM TO __EN_RD_CH_DEV
  6810  F4E2  cda5fb                    CALL    __END_RD_CH_DEV; CHECK THE RESULT
  6811                          
  6812  F4E5  3014                      JR      NC,ROUTINE_DONE; CARRY FLAG IS CLEARED, CMND IS NOT COMPLETE
  6813                          ; THE COMMAND IS COMPLETE
  6814  F4E7  280c                      JR      Z,HAVE_THE_KEY; ROUTINE COMPLETED WITH NO ERRORS,
  6815                          ; CARRY FLAG IS SET, ZERO CONDITION
  6816                          ; THERE WAS AN ERROR
  6817  F4E9  fe8c                      CP      KBD_NAK; WAS THE ERROR A NAK?
  6818  F4EB  2005                      JR      NZ,NO_NAK; NO, GO SET C FLAG TO SHOW COMMAND COMPLETED
  6819                          ; YES, TRY THE COMMAND AGAIN
  6820  F4ED  cdd0f4                    CALL    __START_RD_KBD
  6821  F4F0  2808                      JR      Z,SHOW_COMPLETE
  6822                          ; THERE WAS AN ERROR IN THE COMMAND RETRY
  6823                          ; SET THE CARRY FLAG TO SHOW THAT THE
  6824                          ; OPERATION COMPLETED. THE FLAG
  6825                          ; CONDITION WILL BE NON-ZERO TO
  6826                          ; INDICATE AN ERROR OCCURED. A CONTAINS
  6827                          ; THE ERROR CODE
  6828                          NO_NAK:
  6829  F4F2  37                        SCF
  6830  F4F3  1806                      JR      ROUTINE_DONE
  6831                          
  6832                          HAVE_THE_KEY:
  6833  F4F5  3a75fd                    LD      A,(KEYBOARD_BUFFER); PUT THE KEY IN THE KEYBOARD BUFFER
  6834  F4F8  1801                      JR      ROUTINE_DONE
  6835                          
  6836                          SHOW_COMPLETE:
  6837  F4FA  b7                        OR      A; CLEAR CARRY FLAG BECAUSE THE RETRY WAS STARTED
  6838                          ; WITH NO PROBLEMS. THE COMMAND IS NOT COMPLETE
  6839                          ROUTINE_DONE:
  6840  F4FB  c9                        RET
  6841                          ;
  6842                          ;================================================================
  6843                          ;================================================================
  6844                          ;================================================================
  6845                          ;
  6846                          
  6847                          
  6848                          
  6849                          ;REV 1                  (V/D  8-24-83)
  6850                          ;****************************************************************
  6851                          ; PRINT_CHAR ALLOWS THE CALLER TO PRINT ONE CHARACTER
  6852                          ;       INPUT:  A ===> CHARACTER TO BE PRINTED
  6853                          ;       OUTPUT: CONDITION FLAGS
  6854                          ;               Z :     NO ERROR
  6855                          ;               NZ:     ERROR OCCURED
  6856                          ;                       A ===> ERROR CODE
  6857                          ;
  6858                          ;****************************************************************
  6859                          
  6860                          ;GLOBAL __PR_CH
  6861                          ;EXT    PRINT_BUFFER
  6862                          ;EXT    CHK_IF_INACTIVE
  6863                          
  6864                          __PR_CH:
  6865  F4FC  c5                        PUSH    BC
  6866  F4FD  d5                        PUSH    DE
  6867  F4FE  e5                        PUSH    HL
  6868  F4FF  fde5                      PUSH    IY
  6869                          
  6870  F501  3276fd                    LD      (PRINT_BUFFER),A
  6871  F504  3e03                      LD      A,ETX; TERMINATE STRIN W/ETX
  6872  F506  3277fd                    LD      (PRINT_BUFFER+1),A
  6873  F509  2176fd                    LD      HL,PRINT_BUFFER; ADDRESS OF PRINT BUFFER
  6874                          
  6875  F50C  cd15f5                    CALL    __PR_BUFF
  6876                          
  6877  F50F  fde1                      POP     IY
  6878  F511  e1                        POP     HL
  6879  F512  d1                        POP     DE
  6880  F513  c1                        POP     BC
  6881                          
  6882  F514  c9                        RET
  6883                          
  6884                          
  6885                          ;****************************************************************
  6886                          ; PRINT_BUFFER ALLOWS THE CALLER TO PRINT AN ASCII ETX-TERMINATED STRING
  6887                          ;       INPUT:  HL ===> ADDRESS OF ETX-TERMINATED STRING
  6888                          ;       OUTPUT: CONDITION FLAGS
  6889                          ;               Z :     NO ERROR
  6890                          ;               NZ:     ERROR OCCURED
  6891                          ;                       A ===> ERROR CODE
  6892                          ;
  6893                          ;****************************************************************
  6894                          
  6895                                  GLOBAL  __PR_BUFF
  6896                          
  6897                          ;EXT    __FIND_DCB,__WR_CH_DEV
  6898                          
  6899                          __PR_BUFF:
  6900  F515  c5                        PUSH    BC
  6901  F516  d5                        PUSH    DE
  6902  F517  e5                        PUSH    HL
  6903  F518  fde5                      PUSH    IY
  6904                          
  6905                          PR_BUFF2:
  6906  F51A  3e02                      LD      A,PRINTER_ID; WANT THE PRINTERS DCB
  6907  F51C  cd46f4                    CALL    __FIND_DCB; GET THE DEVICE'S DCB
  6908                          
  6909  F51F  2037                      JR      NZ,END_PRINT_ROUTINE; THERE WAS A PROBLEM FINDING THE DCB
  6910                          
  6911  F521  cd96f4                    CALL    CHK_IF_INACTIVE
  6912  F524  2032                      JR      NZ,PRTR_DCB_ACTIVE
  6913                          
  6914                          CHECK_FOR_ETX:
  6915  F526  010000                    LD      BC,0; CHARACTER COUNT
  6916  F529  5d                        LD      E,L; SAVE THE STRING
  6917  F52A  54                        LD      D,H; DE=HL= PTR TO UNPRINTED STRING
  6918                          
  6919                          GET_NEXT_ASCII:
  6920  F52B  3e03                      LD      A,ETX
  6921  F52D  be                        CP      (HL); IS IT AN ETX?
  6922  F52E  2818                      JR      Z,ITS_ETX; YES
  6923                          
  6924                          ; NO
  6925  F530  23                        INC     HL; POINT TO NEXT CHARACTER
  6926  F531  0c                        INC     C; INC COUNT
  6927  F532  79                        LD      A,C; HAVE WE LOOKED AT 16 BYTES?
  6928  F533  fe10                      CP      16
  6929  F535  20f4                      JR      NZ,GET_NEXT_ASCII; YES
  6930                          ;                                           DE = PTR TO UNPRINTED STRING, DE=PTR TO UNPRNTED+16
  6931  F537  eb                        EX      DE,HL; HL = PTR TO UNPRINTED STRING, DE=PTR TO UNPRNTED+16
  6932                          
  6933                          WRITE_COMMAND_AGAIN:
  6934                          
  6935  F538  3e02                      LD      A,PRINTER_ID
  6936  F53A  cd75fb                    CALL    __WR_CH_DEV
  6937                          
  6938  F53D  2806                      JR      Z,WRITE_DONE; WRITE COMPLETED WITH NO ERRORS
  6939                          
  6940  F53F  fe86                      CP      PR_NAK; IT A NAK?
  6941  F541  2015                      JR      NZ,PRINT_CMND_FAILED; AN ERROR
  6942                          
  6943  F543  18f3                      JR      WRITE_COMMAND_AGAIN; SEND ANOTHER WRITE COMMAND
  6944                          
  6945                          WRITE_DONE:
  6946  F545  eb                        EX      DE,HL; DE = PTR TO UNPRINTED STRNG, HL=PTR TO UNPRNTED+16
  6947  F546  18de                      JR      CHECK_FOR_ETX; GO CHECK THE NEXT CHARACTER
  6948                          
  6949                          
  6950                          ITS_ETX:
  6951  F548  eb                        EX      DE,HL
  6952  F549  af                        XOR     A; ZERO OUT A
  6953  F54A  b9                        CP      C; WAS THE FIRST CHARACTER CHECKED
  6954                          ; AN ETX?
  6955  F54B  280b                      JR      Z,END_PRINT_ROUTINE; YUP, DON'T BOTHER PRINTING IT
  6956                          
  6957                          SEND_ANOTHER_WRITE:
  6958  F54D  3e02                      LD      A,PRINTER_ID; WILL WRITE TO THE PRINTER
  6959  F54F  cd75fb                    CALL    __WR_CH_DEV; WRITE CHARACTERS
  6960                          
  6961  F552  2804                      JR      Z,COMMAND_FINISHED_SUCCESSFULLY; ALL DONE
  6962                          
  6963  F554  fe86                      CP      PR_NAK; DO WE HAVE A NAK?
  6964  F556  28f5                      JR      Z,SEND_ANOTHER_WRITE; YUP
  6965                          
  6966                          ; NOPE, MUST BE AN ERROR
  6967                          
  6968                          
  6969                          COMMAND_FINISHED_SUCCESSFULLY:
  6970                          PRINT_CMND_FAILED:
  6971                          PRNT_CMND_FAILED:
  6972                          PRTR_DCB_ACTIVE:
  6973                          END_PRINT_ROUTINE:
  6974  F558  fde1                      POP     IY
  6975  F55A  e1                        POP     HL
  6976  F55B  d1                        POP     DE
  6977  F55C  c1                        POP     BC; ON ERROR, ZERO FLAG SET AND A
  6978                          ; CONTAINS THE ERROR CODE
  6979  F55D  c9                        RET
  6980                          
  6981                          
  6982                          ;****************************************************************
  6983                          ;
  6984                          ; __SETUP_PR_BUFF SETS UP PRINT_BUFFER AND THE HL REGISTER AND
  6985                          ; CALLS __START_PR_BUFF
  6986                          ;       INPUT:  A = ASCII CHARACTER
  6987                          ;       OUTPUT: CONDITION FLAGS
  6988                          ;               Z:      NO ERROR
  6989                          ;               NZ:     ERROR OCCURED
  6990                          ;                       A = ERROR CODE
  6991                          ;
  6992                          ;****************************************************************
  6993                          
  6994                          ;GLB    __SETUP_PR_BUFF
  6995                          
  6996                          __SETUP_PR_BUFF:
  6997  F55E  3276fd                    LD      (PRINT_BUFFER),A
  6998  F561  3e03                      LD      A,ETX
  6999  F563  3277fd                    LD      (PRINT_BUFFER+1),A
  7000                          
  7001  F566  2176fd                    LD      HL,PRINT_BUFFER
  7002                          
  7003  F569  cd80f5                    CALL    __START_PR_BUFF
  7004                          
  7005  F56C  c9                        RET
  7006                          
  7007                          
  7008                          
  7009                          
  7010                          ;****************************************************************
  7011                          ;
  7012                          ; __START_PR_CH SETS UP PRINT_BUFFER AND THE HL REGISTER AND
  7013                          ; CALLS __START_PR_BUFF
  7014                          ;       INPUT:  A = ASCII CHARACTER
  7015                          ;       OUTPUT: CONDITION FLAGS
  7016                          ;               Z:      NO ERROR
  7017                          ;               NZ:     ERROR OCCURED
  7018                          ;                       A = ERROR CODE
  7019                          ;
  7020                          ;****************************************************************
  7021                          
  7022                          ;GLB    __START_PR_CH
  7023                          
  7024                          __START_PR_CH:
  7025  F56D  3276fd                    LD      (PRINT_BUFFER),A
  7026  F570  3e03                      LD      A,ETX
  7027  F572  3277fd                    LD      (PRINT_BUFFER+1),A
  7028                          
  7029  F575  2176fd                    LD      HL,PRINT_BUFFER
  7030                          
  7031  F578  cd80f5                    CALL    __START_PR_BUFF
  7032                          
  7033  F57B  c9                        RET
  7034                          
  7035                          
  7036                          
  7037                          
  7038                          ;****************************************************************
  7039                          ;
  7040                          ;       __END_PR_CH    CALLS __END_PR_BUFF TO CHECK THE DCB STATUS BYTE AND
  7041                          ;       RETURNS THE RESULT TO THE CALLER
  7042                          ;
  7043                          ;       INPUT:  NONE
  7044                          ;
  7045                          ;       OUTPUT: CONDITION FLAGS
  7046                          ;               C:      COMMAND COMPLETED
  7047                          ;               NC:     COMMAND NOT COMPLETED
  7048                          ;               Z:      NO ERRORS OCCURED
  7049                          ;               NZ:     ERRORS
  7050                          ;                       A = ERROR CODE
  7051                          ;
  7052                          ;       ALL     REGISTERS ARE PRESERVED
  7053                          ;
  7054                          ;****************************************************************
  7055                          
  7056                          ;GLB    __END_PR_CH
  7057                          __END_PR_CH:
  7058  F57C  cdb8f5                    CALL    __END_PR_BUFF
  7059                          
  7060  F57F  c9                        RET
  7061                          
  7062                          
  7063                          
  7064                          ;***************************************************************
  7065                          ; __START_PR_BUFF ALLOWS THE CALLER TO PRINT AN ASCII ETX-TERMINATED STRING
  7066                          ;        INPUT:   HL ==>  ADDRESS OF ETX-TERMINATED STRING
  7067                          ;        OUTPUT:  CONDITION FLAGS
  7068                          ;                 Z :    NO ERROR
  7069                          ;                 NZ:    ERROR OCCURED
  7070                          ;                        A ==>  ERROR CODE
  7071                          ;
  7072                          ;***************************************************************
  7073                          
  7074                          ;GLB    __START_PR_BUFF
  7075                          
  7076                          ;EXT    __START_WR_CH_DEV
  7077                          
  7078                          __START_PR_BUFF:
  7079  F580  c5                        PUSH    BC
  7080  F581  d5                        PUSH    DE
  7081  F582  e5                        PUSH    HL
  7082  F583  fde5                      PUSH    IY
  7083                          
  7084  F585  3e02                      LD      A,PRINTER_ID; WANT THE PRINTERS DCB
  7085  F587  cd46f4                    CALL    __FIND_DCB; GET THE DEVICE'S DCB
  7086                          
  7087  F58A  2026                      JR      NZ,NO_DCB_FOUND1; THERE WAS A PROBLEM FINDING THE DCB
  7088                          
  7089  F58C  cd96f4                    CALL    CHK_IF_INACTIVE
  7090  F58F  20c7                      JR      NZ,PRTR_DCB_ACTIVE; [RECON] Identifier repair: scan's trailing mark is not part of the label.
  7091                          
  7092  F591  010000                    LD      BC,0; CHARACTER COUNT
  7093  F594  5d                        LD      E,L; SAVE THE STRING
  7094  F595  54                        LD      D,H; DE=HL= PTR TO UNPRINTED STRING
  7095                          
  7096                          GET_NEXT_ASCII2:
  7097  F596  3e03                      LD      A,ETX
  7098  F598  be                        CP      (HL); IS IT AN ETX?
  7099  F599  280f                      JR      Z,ITS_ETX2; YES
  7100                          
  7101                          ; NO
  7102  F59B  23                        INC     HL; POINT TO NEXT CHARACTER
  7103  F59C  0c                        INC     C; INC COUNT
  7104  F59D  79                        LD      A,C; HAVE WE LOOKED AT 16 BYTES?
  7105  F59E  fe10                      CP      16
  7106  F5A0  20f4                      JR      NZ,GET_NEXT_ASCII2; YES
  7107                          ;                                       DE = PTR TO UNPRINTED STRNG, DE=PTR TO UNPRNTED+16
  7108  F5A2  eb                        EX      DE,HL; HL = PTR TO UNPRINTED STRNG, DE=PTR TO UNPRNTED+16
  7109  F5A3  3e02                      LD      A,PRINTER_ID
  7110  F5A5  cdc2fb                    CALL    __START_WR_CH_DEV
  7111                          
  7112  F5A8  1808                      JR      WRITE_CMND_SENT
  7113                          
  7114                          ITS_ETX2:
  7115  F5AA  eb                        EX      DE,HL
  7116  F5AB  af                        XOR     A; ZERO OUT A
  7117  F5AC  b9                        CP      C; WAS THE FIRST CHARACTER CHECKED
  7118                          ; AN ETX?
  7119                          
  7120  F5AD  3e02                      LD      A,PRINTER_ID; WILL WRITE TO THE PRINTER
  7121  F5AF  c4c2fb                    CALL    NZ,__START_WR_CH_DEV; NOPE, WRITE CHARACTER
  7122                          ; IS PASSED BACK TO CALLER
  7123                          NO_DCB_FOUND1:
  7124                          WRITE_CMND_SENT:
  7125                          
  7126  F5B2  fde1                      POP     IY
  7127  F5B4  e1                        POP     HL
  7128  F5B5  d1                        POP     DE
  7129  F5B6  c1                        POP     BC
  7130                          
  7131  F5B7  c9                        RET
  7132                          
  7133                          
  7134                          
  7135                          
  7136                          ;***************************************************************
  7137                          ;
  7138                          ; __END_PR_BUFF CHECKS THE DCB COMM/STATUS BYTE AND RETURNS THE RESULT
  7139                          ; OF THE CHECK
  7140                          ;
  7141                          ;        INPUT:   NONE
  7142                          ;
  7143                          ;        OUTPUT:  CONDITION FLAGS
  7144                          ;                 C:     COMMAND COMPLETED
  7145                          ;                 NC:    COMMAND NOT COMPLETED
  7146                          ;                 Z:     NO ERRORS OCCURED
  7147                          ;                 NZ:    ERRORS
  7148                          ;                        A = ERROR CODE
  7149                          ;
  7150                          ;        ALL      REGISTERS ARE PRESERVED
  7151                          ;
  7152                          ;***************************************************************
  7153                          
  7154                          ;GLB    __END_PR_BUFF
  7155                          ;EXT    __END_WR_CH_DEV
  7156                          
  7157                          __END_PR_BUFF:
  7158                          
  7159  F5B8  fde5                      PUSH    IY
  7160                          
  7161  F5BA  3e02                      LD      A,PRINTER_ID
  7162  F5BC  cd46f4                    CALL    __FIND_DCB
  7163  F5BF  cde1fb                    CALL    __END_WR_CH_DEV; CHECK STATUS BYTE
  7164                          
  7165  F5C2  300b                      JR      NC,CMND_NOT_PROCESSED; COMMAND NOT COMPLETED
  7166                          
  7167  F5C4  2809                      JR      Z,FINISHED_WO_ERROR; COMMAND COMPLETED, NO ERROR
  7168                          
  7169  F5C6  fe86                      CP      PR_NAK; WAS IT A NAK?
  7170                          
  7171  F5C8  2005                      JR      NZ,NOT_PR_NAK; NOPE, MUST BE AN ERROR
  7172                          
  7173  F5CA  fd360003                  LD      (IY+D_COM_STAT),DCB_WR; SEND ANOTHER WRITE COMMAND
  7174                          
  7175  F5CE  b7                        OR      A; CLEAR CARRY TO INDICATE COMMAND
  7176                          ; HAS NOT BEEN FINISHED
  7177                          
  7178                          NOT_PR_NAK:
  7179                          CMND_NOT_PROCESSED:
  7180                          FINISHED_WO_ERROR:
  7181                          
  7182  F5CF  fde1                      POP     IY
  7183                          
  7184  F5D1  c9                        RET
  7185                          
  7186                          
  7187                          ;***************************************************************
  7188                          ; THIS ROUTINE REQUESTS THE STATUS ON THE PRINTER
  7189                          ;        INPUT:   NONE
  7190                          ;        OUTPUT:
  7191                          ;                 CONDITION FLAGS
  7192                          ;                 Z :     NO ERROR
  7193                          ;                 NZ:     ERROR OCCURRED
  7194                          ;                         A ===>  ERROR CODE
  7195                          ;
  7196                          ;***************************************************************
  7197                                  GLOBAL  __REQ_PR_STAT
  7198                          
  7199                          ;EXT    __REQUEST_STATUS
  7200                          
  7201                          __REQ_PR_STAT:
  7202  F5D2  3e02                      LD      A,PRINTER_ID
  7203  F5D4  c373f4                    JP      __REQUEST_STATUS
  7204                          ;

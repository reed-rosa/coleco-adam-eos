  7020                          ;****************************************************************
  7021                          
  7022                          ;GLB    __START_PR_CH
  7023                          
  7024                          __START_PR_CH:
  7025  156d  321600                    LD      (PRINT_BUFFER),A
  7026  1570  3e03                      LD      A,ETX
  7027  1572  321700                    LD      (PRINT_BUFFER+1),A
  7028                          
  7029  1575  211600                    LD      HL,PRINT_BUFFER

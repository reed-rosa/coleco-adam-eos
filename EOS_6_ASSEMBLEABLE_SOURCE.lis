  6489                          
  6490                          ;REV 0  (V/D 8/24/83)
  6491                          
  6492                          
  6493                          ;****************************************************************
  6494                          ; THIS ROUTINE WILL FIND THE DCB FOR THE DEVICE DESIRED
  6495                          ;
  6496                          ;       INPUT:  A ==> POINTS TO THE DEVICE ID
  6497                          ;       OUTPUT:
  6498                          ;               CONDITION FLAG:
  6499                          ;                       Z : NO ERRORS
  6500                          ;                           IY ==> POINTS TO THE START OF THE DEVICE DCB
  6501                          ;                       NZ: ERROR OCCURED
  6502                          ;                           IY ==> IS DESTROYED
  6503                          ;
  6504                          ;****************************************************************
  6505                          
  6506                          
  6507                          ;GLB    __GET_DCB_ADDR
  6508                                  GLOBAL  __FIND_DCB
  6509                          ;EXT    CURRENT_PCB
  6510                          
  6511                          __GET_DCB_ADDR:
  6512                          __FIND_DCB:
  6513  1446  c5                        PUSH    BC
  6514  1447  d5                        PUSH    DE
  6515                          
  6516  1448  4f                        LD      C,A; SAVE THE DEVICE ID
  6517  1449  fd2a1000                  LD      IY,(CURRENT_PCB); GET THE START ADDRESS OF PCB
  6518  144d  fd4603                    LD      B,(IY+P_NUM_DCBS); GET THE NUMBER OF DCB'S
  6519  1450  af                        XOR     A
  6520  1451  b8                        CP      B; ARE THERE ZERO DCBS?
  6521  1452  2819                      JR      Z,DCB_NO_FIND; YES
  6522                          ; NO
  6523  1454  110400                    LD      DE,P_SIZE; GET THE SIZE OF THE PCB
  6524  1457  fd19                      ADD     IY,DE; ADD TO IY TO GET TO THE START OF THE DCB
  6525  1459  111500                    LD      DE,D_SIZE; GET THE DCB SIZE
  6526  145c  79                        LD      A,C; RELOAD THE DEVICE ID
  6527  145d  e60f                      AND     0FH; AND OF THE HIGH BITS TO GET ONLY
  6528                          ; THE DEVICE ID
  6529                          
  6530                          DCB_LOOP:
  6531  145f  fdbe10                    CP      (IY+D_DEV_ADDR); IS THIS THE CORRECT DEVICE DCB?
  6532  1462  2806                      JR      Z,FOUND_IT; YES
  6533                          ; NO
  6534  1464  fd19                      ADD     IY,DE; GET TO THE NEXT DCB AND CHECK IT
  6535  1466  10f7                      DJNZ    DCB_LOOP; GO CHECK THEM ALL UNTIL ONE IS FOUND
  6536                          
  6537  1468  1803                      JR      DCB_NO_FIND
  6538                          
  6539                          
  6540                          FOUND_IT:
  6541  146a  79                        LD      A,C; RESTORE A TO ITS ORIGINAL STATE
  6542  146b  1803                      JR      FINISHED
  6543                          
  6544                          DCB_NO_FIND:
  6545  146d  3e01                      LD      A,DCB_NOT_FOUND
  6546  146f  b7                        OR      A
  6547                          
  6548                          FINISHED:
  6549  1470  d1                        POP     DE
  6550  1471  c1                        POP     BC
  6551                          
  6552  1472  c9                        RET
  6553                          
  6554                          
  6555                          
  6556                          
  6557                          ;****************************************************************
  6558                          ; THIS ROUTINE WILL INITIATE A STATUS REQUEST COMMAND, AND WILL RETURN
  6559                          ; THE RESULT OF THE COMMAND.
  6560                          ;       INPUT:  A ==> DEVICE ID
  6561                          ;       OUTPUT: CONDITION BITS
  6562                          ;               Z :     NO ERRORS
  6563                          ;                       IY CONTAINS START ADDRESS OF DCB
  6564                          ;               NZ:     ERROR OCCURED
  6565                          ;                       A ==> ERROR CODE
  6566                          ;                       IY IS DESTROYED (MAY BE ADDRESS OF DCB
  6567                          ;                       UNDER CERTAIN ERROR CONDITIONS)
  6568                          ;
  6569                          ;****************************************************************
  6570                          
  6571                          ;GLB    __REQUEST_STATUS
  6572                          
  6573                          
  6574                          __REQUEST_STATUS:
  6575  1473  cd4614                    CALL    __FIND_DCB; GET THE CORRECT DEVICE DCB
  6576                          
  6577  1476  200f                      JR      NZ,END_R_S
  6578                          
  6579  1478  fd360001                  LD      (IY+D_COM_STAT),DCB_STATUS; SEND THE COMMAND TO REQUEST
  6580                          ; A STATUS
  6581                          
  6582                          REQUEST_LOOP:
  6583  147c  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); HAS THE COMMAND COMPLETED?
  6584  1480  28fa                      JR      Z,REQUEST_LOOP; NO LOOP TILL IT DOES
  6585                          
  6586  1482  fd7e00                    LD      A,(IY+D_COM_STAT); CHECK THE STATUS
  6587  1485  fe80                      CP      CMND_FIN_STATUS; DID IT FINISH WITH NO ERRORS?
  6588                          ; IF ZERO EVERYTHING IS OK
  6589                          ; IF NZ THERE WAS AN ERROR
  6590                          
  6591                          END_R_S:
  6592  1487  c9                        RET
  6593                          
  6594                          
  6595                          
  6596                          
  6597                          ;GLB    __RD_DEV_DEP_STAT
  6598                          
  6599                          __RD_DEV_DEP_STAT:
  6600  1488  fde5                      PUSH    IY; SAVE THIS REGISTER
  6601  148a  cd4614                    CALL    __FIND_DCB; GET THE CORRECT DEVICE DCB
  6602                          
  6603  148d  2004                      JR      NZ,END_R_D_D_S
  6604                          
  6605  148f  af                        XOR     A; NO ERROR
  6606                          
  6607  1490  fd7e14                    LD      A,(IY+D_STATUS_FLAGS); READ DEVICE-DEPENDENT STATUS FLAGS
  6608                          
  6609                          END_R_D_D_S:
  6610  1493  fde1                      POP     IY; RESTORE THE REGISTER
  6611  1495  c9                        RET
  6612                          
  6613                          
  6614                          ;****************************************************************
  6615                          ; THIS ROUTINE WILL CHECK AND SEE IF THE DEVICE DCB IS CURRENTLY ACTIVE.
  6616                          ; IF IT IS THEN A NZ CONDITION WILL BE SENT BACK TO THE CALLING PROGRAM
  6617                          ;       INPUT:  IY ===> POINTS TO START OF DEVICE DCB
  6618                          ;       OUTPUT: CONDITION FLAGS
  6619                          ;               Z :     DCB IS INACTIVE, IN OTHERWORDS IT IS AVAILABLE
  6620                          ;                       A ===> IS PRESERVED
  6621                          ;               NZ:     DCB IS ACTIVE
  6622                          ;                       A ===> ERROR CODE
  6623                          ;
  6624                          ;****************************************************************
  6625                          
  6626                          ; OK CHANGED TO G_OK TO PREVENT CONFLICT WITH IDENTICAL
  6627                          ; LABEL ELSEWHERE
  6628                          
  6629                          ;GLB    CHK_IF_INACTIVE
  6630                          
  6631                          CHK_IF_INACTIVE:
  6632  1496  c5                        PUSH    BC
  6633                          
  6634  1497  4f                        LD      C,A; PRESERVE A
  6635  1498  fd7e00                    LD      A,(IY+D_COM_STAT); IS THE DCB AVAILABLE?
  6636  149b  fe00                      CP      DCB_IDLE
  6637  149d  2806                      JR      Z,G_OK; YES IT IS INACTIVE
  6638                          ; NO IT IS NOT
  6639  149f  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); HAS THE COMMAND BEEN
  6640                          ; PROCESSED
  6641  14a3  2804                      JR      Z,DEVICE_BUSY; NO, THE DEVICE IS STILL BUSY
  6642                          ; YES, THE DCB IS AVAILABLE
  6643                          G_OK:
  6644  14a5  af                        XOR     A; INSURE ZERO CONDITION
  6645  14a6  79                        LD      A,C; RESTORE A
  6646  14a7  1803                      JR      DONE
  6647                          
  6648                          DEVICE_BUSY:
  6649  14a9  3c                        INC     A; INSURE A NON_ZERO CONDITION FOR FLAG
  6650  14aa  3e02                      LD      A,DCB_BUSY; SEND BACK THE ERROR CODE
  6651                          
  6652                          DONE:
  6653  14ac  c1                        POP     BC
  6654  14ad  c9                        RET
  6655                          
  6656                          
  6657                          
  6658                          
  6659                          ;****************************************************************
  6660                          ;
  6661                          ;       CHK_FOR_IDLE CHECKS IF THE REQUESTED DEVICE IS IDLE
  6662                          ;       SENDING BACK AN ERROR CODE
  6663                          ;
  6664                          ;       INPUT:  IY       POINTER TO THE DCB
  6665                          ;
  6666                          ;       OUTPUT: CONDITION FLAGS
  6667                          ;               Z        DEVICE NOT IDLE
  6668                          ;               NZ       DEVICE IDLE
  6669                          ;
  6670                          ;****************************************************************
  6671                          
  6672                          
  6673                          ;GLB    CHK_IF_IDLE
  6674                          
  6675                          CHK_IF_IDLE:
  6676                          
  6677  14ae  fd7e00                    LD      A,(IY+D_COM_STAT); GET STATUS BYTE
  6678                          
  6679  14b1  b7                        OR      A; IS IT IDLE(ZERO)?
  6680  14b2  2004                      JR      NZ,NOT_IDLE; NOPE
  6681                          
  6682  14b4  3e03                      LD      A,DCB_IDLE_ERR; ERROR CODE FOR DEVICE IDLE
  6683                          
  6684  14b6  b7                        OR      A; CREATE NZ CONDITION
  6685                          
  6686  14b7  c9                        RET
  6687                          
  6688                          NOT_IDLE:
  6689  14b8  af                        XOR     A; CLEAR ZERO FLAG
  6690                          
  6691  14b9  c9                        RET
  6692                          ;
  6693                          ;================================================================
  6694                          ;================================================================
  6695                          ;================================================================
  6696                          ;
  6697                          
  6698                          
  6699                          ;REV 0                  (V/D  8-24-83)
  6700                          
  6701                          ;****************************************************************
  6702                          ; THIS ROUTINE WILL READ A CHARACTER FROM THE KEYBOARD
  6703                          ;
  6704                          ;       INPUT:  NOTHING
  6705                          ;       OUTPUT: CONDITION FLAGS
  6706                          ;               Z :     NO ERRORS
  6707                          ;                       A ===> CONTAINS THE KEY READ
  6708                          ;               NZ:     ERROR OCCURED
  6709                          ;                       A ===> ERROR CODE
  6710                          ;
  6711                          ;
  6712                          ;****************************************************************
  6713                          
  6714                                  GLOBAL  __RD_KBD
  6715                          ;EXT    KEYBOARD_BUFFER
  6716                          ;EXT    __RD_CH_DEV
  6717                          
  6718                          __RD_KBD:
  6719  14ba  c5                        PUSH    BC
  6720  14bb  d5                        PUSH    DE
  6721                          
  6722                          RD_KBD_LOOP:
  6723                          
  6724  14bc  cdd014                    CALL    __START_RD_KBD
  6725                          
  6726  14bf  2007                      JR      NZ,ERROR_OCCURED
  6727                          
  6728  14c1  4f                        LD      C,A; PRESERVE THE DEVICE ID
  6729                          
  6730                          WAITING:
  6731  14c2  79                        LD      A,C; RESTOR THE DEVICE ID
  6732                          ; BC IS SAVED IN ALL CALLED MODULES
  6733  14c3  cde014                    CALL    __END_RD_KBD
  6734                          
  6735  14c6  30fa                      JR      NC,WAITING; THE OPERATION HAS NOT COMPLETED YET
  6736                          ; AT THIS POINT WE EITHER HAVE THE
  6737                          ; KEY OR AN ERROR CODE IN A
  6738                          ERROR_OCCURED:
  6739  14c8  d1                        POP     DE
  6740  14c9  c1                        POP     BC
  6741                          
  6742  14ca  c9                        RET
  6743                          
  6744                          
  6745                          ;****************************************************************
  6746                          ; THIS ROUTINE WILL REQUEST A STATUS ON THE KEYBOARD
  6747                          ;       INPUT:  NOTHING
  6748                          ;       OUTPUT: CONDITION FLAG
  6749                          ;               Z :     NO ERRORS
  6750                          ;               NZ:     ERROR OCCURED
  6751                          ;                       A ===> ERROR CODE
  6752                          ;
  6753                          ;****************************************************************
  6754                          
  6755                                  GLOBAL  __REQ_KBD_STAT
  6756                          
  6757                          ;EXT    __REQUEST_STATUS
  6758                          
  6759                          __REQ_KBD_STAT:
  6760  14cb  3e01                      LD      A,KEYBOARD_ID; WANT STATUS ON THE KEYBOARD
  6761  14cd  c37314                    JP      __REQUEST_STATUS
  6762                          
  6763                          
  6764                          ;****************************************************************
  6765                          ; THIS ROUTINE WILL START A READ DATA COMMNAD ON THE KEYBOARD
  6766                          ;       INPUT:  NOTHING
  6767                          ;       OUTPUT: CONDITION FLAGS
  6768                          ;               Z :     NO ERROR
  6769                          ;               NZ:     ERROR OCCURED
  6770                          ;                       A ===> ERROR CODE
  6771                          ;****************************************************************
  6772                          
  6773                          ;GLB    __START_RD_KBD
  6774                          
  6775                          ;EXT    __START_RD_CH_DEV
  6776                          
  6777                          __START_RD_KBD:
  6778  14d0  c5                        PUSH    BC
  6779  14d1  d5                        PUSH    DE
  6780                          
  6781                          STRT_RD_KBD_LOOP:
  6782  14d2  3e01                      LD      A,KEYBOARD_ID
  6783  14d4  111500                    LD      DE,KEYBOARD_BUFFER; DESTINATION OF WHERE TO PLACE KEY
  6784  14d7  010100                    LD      BC,1; GET 1 CHARACTER
  6785  14da  cd861b                    CALL    __START_RD_CH_DEV; GO INITIATE THE COMMAND
  6786                          
  6787  14dd  d1                        POP     DE
  6788  14de  c1                        POP     BC
  6789                          
  6790  14df  c9                        RET
  6791                          
  6792                          
  6793                          ;****************************************************************
  6794                          ; THIS ROUTINE WILL CHECK THE RESULT OF A COMMAND THAT WAS SENT.  IF THE
  6795                          ; RESULT IS A NAK THEN THE ROUTINE WILL ISSUE A NEW READ COMMAND.
  6796                          ;       INPUT:  NOTHING
  6797                          ;       OUTPUT: CONDITION FLAG
  6798                          ;               C :     COMMAND HAS FINISHED
  6799                          ;               NC:     COMMAND HAS NOT BEEN FINISHED
  6800                          ;               Z :     NO ERROR OCCURED
  6801                          ;               NZ:     ERROR OCCURED
  6802                          ;                       A ===> ERROR CODE
  6803                          ;****************************************************************
  6804                          
  6805                          ;GLB    __END_RD_KBD
  6806                          ;EXT    __END_RD_CH_DEV
  6807                          
  6808                          __END_RD_KBD:
  6809  14e0  3e01                      LD      A,KEYBOARD_ID; SEND THIS PARM TO __EN_RD_CH_DEV
  6810  14e2  cda51b                    CALL    __END_RD_CH_DEV; CHECK THE RESULT
  6811                          
  6812  14e5  3014                      JR      NC,ROUTINE_DONE; CARRY FLAG IS CLEARED, CMND IS NOT COMPLETE
  6813                          ; THE COMMAND IS COMPLETE
  6814  14e7  280c                      JR      Z,HAVE_THE_KEY; ROUTINE COMPLETED WITH NO ERRORS,
  6815                          ; CARRY FLAG IS SET, ZERO CONDITION
  6816                          ; THERE WAS AN ERROR
  6817  14e9  fe8c                      CP      KBD_NAK; WAS THE ERROR A NAK?
  6818  14eb  2005                      JR      NZ,NO_NAK; NO, GO SET C FLAG TO SHOW COMMAND COMPLETED
  6819                          ; YES, TRY THE COMMAND AGAIN
  6820  14ed  cdd014                    CALL    __START_RD_KBD
  6821  14f0  2808                      JR      Z,SHOW_COMPLETE
  6822                          ; THERE WAS AN ERROR IN THE COMMAND RETRY
  6823                          ; SET THE CARRY FLAG TO SHOW THAT THE
  6824                          ; OPERATION COMPLETED. THE FLAG
  6825                          ; CONDITION WILL BE NON-ZERO TO
  6826                          ; INDICATE AN ERROR OCCURED. A CONTAINS
  6827                          ; THE ERROR CODE
  6828                          NO_NAK:
  6829  14f2  37                        SCF
  6830  14f3  1806                      JR      ROUTINE_DONE
  6831                          
  6832                          HAVE_THE_KEY:
  6833  14f5  3a1500                    LD      A,(KEYBOARD_BUFFER); PUT THE KEY IN THE KEYBOARD BUFFER
  6834  14f8  1801                      JR      ROUTINE_DONE
  6835                          
  6836                          SHOW_COMPLETE:
  6837  14fa  b7                        OR      A; CLEAR CARRY FLAG BECAUSE THE RETRY WAS STARTED
  6838                          ; WITH NO PROBLEMS. THE COMMAND IS NOT COMPLETE
  6839                          ROUTINE_DONE:
  6840  14fb  c9                        RET
  6841                          ;
  6842                          ;================================================================
  6843                          ;================================================================
  6844                          ;================================================================
  6845                          ;
  6846                          
  6847                          
  6848                          
  6849                          ;REV 1                  (V/D  8-24-83)
  6850                          ;****************************************************************
  6851                          ; PRINT_CHAR ALLOWS THE CALLER TO PRINT ONE CHARACTER
  6852                          ;       INPUT:  A ===> CHARACTER TO BE PRINTED
  6853                          ;       OUTPUT: CONDITION FLAGS
  6854                          ;               Z :     NO ERROR
  6855                          ;               NZ:     ERROR OCCURED
  6856                          ;                       A ===> ERROR CODE
  6857                          ;
  6858                          ;****************************************************************
  6859                          
  6860                          ;GLOBAL __PR_CH
  6861                          ;EXT    PRINT_BUFFER
  6862                          ;EXT    CHK_IF_INACTIVE
  6863                          
  6864                          __PR_CH:
  6865  14fc  c5                        PUSH    BC
  6866  14fd  d5                        PUSH    DE
  6867  14fe  e5                        PUSH    HL
  6868  14ff  fde5                      PUSH    IY
  6869                          
  6870  1501  321600                    LD      (PRINT_BUFFER),A
  6871  1504  3e03                      LD      A,ETX; TERMINATE STRIN W/ETX
  6872  1506  321700                    LD      (PRINT_BUFFER+1),A
  6873  1509  211600                    LD      HL,PRINT_BUFFER; ADDRESS OF PRINT BUFFER
  6874                          
  6875  150c  cd1515                    CALL    __PR_BUFF
  6876                          
  6877  150f  fde1                      POP     IY
  6878  1511  e1                        POP     HL
  6879  1512  d1                        POP     DE
  6880  1513  c1                        POP     BC
  6881                          
  6882  1514  c9                        RET
  6883                          
  6884                          
  6885                          ;****************************************************************
  6886                          ; PRINT_BUFFER ALLOWS THE CALLER TO PRINT AN ASCII ETX-TERMINATED STRING
  6887                          ;       INPUT:  HL ===> ADDRESS OF ETX-TERMINATED STRING
  6888                          ;       OUTPUT: CONDITION FLAGS
  6889                          ;               Z :     NO ERROR
  6890                          ;               NZ:     ERROR OCCURED
  6891                          ;                       A ===> ERROR CODE
  6892                          ;
  6893                          ;****************************************************************
  6894                          
  6895                                  GLOBAL  __PR_BUFF
  6896                          
  6897                          ;EXT    __FIND_DCB,__WR_CH_DEV
  6898                          
  6899                          __PR_BUFF:
  6900  1515  c5                        PUSH    BC
  6901  1516  d5                        PUSH    DE
  6902  1517  e5                        PUSH    HL
  6903  1518  fde5                      PUSH    IY
  6904                          
  6905                          PR_BUFF2:
  6906  151a  3e02                      LD      A,PRINTER_ID; WANT THE PRINTERS DCB
  6907  151c  cd4614                    CALL    __FIND_DCB; GET THE DEVICE'S DCB
  6908                          
  6909  151f  2037                      JR      NZ,END_PRINT_ROUTINE; THERE WAS A PROBLEM FINDING THE DCB
  6910                          
  6911  1521  cd9614                    CALL    CHK_IF_INACTIVE
  6912  1524  2032                      JR      NZ,PRTR_DCB_ACTIVE
  6913                          
  6914                          CHECK_FOR_ETX:
  6915  1526  010000                    LD      BC,0; CHARACTER COUNT
  6916  1529  5d                        LD      E,L; SAVE THE STRING
  6917  152a  54                        LD      D,H; DE=HL= PTR TO UNPRINTED STRING
  6918                          
  6919                          GET_NEXT_ASCII:
  6920  152b  3e03                      LD      A,ETX
  6921  152d  be                        CP      (HL); IS IT AN ETX?
  6922  152e  2818                      JR      Z,ITS_ETX; YES
  6923                          
  6924                          ; NO
  6925  1530  23                        INC     HL; POINT TO NEXT CHARACTER
  6926  1531  0c                        INC     C; INC COUNT
  6927  1532  79                        LD      A,C; HAVE WE LOOKED AT 16 BYTES?
  6928  1533  fe10                      CP      16
  6929  1535  20f4                      JR      NZ,GET_NEXT_ASCII; YES
  6930                          ;                                           DE = PTR TO UNPRINTED STRING, DE=PTR TO UNPRNTED+16
  6931  1537  eb                        EX      DE,HL; HL = PTR TO UNPRINTED STRING, DE=PTR TO UNPRNTED+16
  6932                          
  6933                          WRITE_COMMAND_AGAIN:
  6934                          
  6935  1538  3e02                      LD      A,PRINTER_ID
  6936  153a  cd751b                    CALL    __WR_CH_DEV
  6937                          
  6938  153d  2806                      JR      Z,WRITE_DONE; WRITE COMPLETED WITH NO ERRORS
  6939                          
  6940  153f  fe86                      CP      PR_NAK; IT A NAK?
  6941  1541  2015                      JR      NZ,PRINT_CMND_FAILED; AN ERROR
  6942                          
  6943  1543  18f3                      JR      WRITE_COMMAND_AGAIN; SEND ANOTHER WRITE COMMAND
  6944                          
  6945                          WRITE_DONE:
  6946  1545  eb                        EX      DE,HL; DE = PTR TO UNPRINTED STRNG, HL=PTR TO UNPRNTED+16
  6947  1546  18de                      JR      CHECK_FOR_ETX; GO CHECK THE NEXT CHARACTER
  6948                          
  6949                          
  6950                          ITS_ETX:
  6951  1548  eb                        EX      DE,HL
  6952  1549  af                        XOR     A; ZERO OUT A
  6953  154a  b9                        CP      C; WAS THE FIRST CHARACTER CHECKED
  6954                          ; AN ETX?
  6955  154b  280b                      JR      Z,END_PRINT_ROUTINE; YUP, DON'T BOTHER PRINTING IT
  6956                          
  6957                          SEND_ANOTHER_WRITE:
  6958  154d  3e02                      LD      A,PRINTER_ID; WILL WRITE TO THE PRINTER
  6959  154f  cd751b                    CALL    __WR_CH_DEV; WRITE CHARACTERS
  6960                          
  6961  1552  2804                      JR      Z,COMMAND_FINISHED_SUCCESSFULLY; ALL DONE
  6962                          
  6963  1554  fe86                      CP      PR_NAK; DO WE HAVE A NAK?
  6964  1556  28f5                      JR      Z,SEND_ANOTHER_WRITE; YUP
  6965                          
  6966                          ; NOPE, MUST BE AN ERROR
  6967                          
  6968                          
  6969                          COMMAND_FINISHED_SUCCESSFULLY:
  6970                          PRINT_CMND_FAILED:
  6971                          PRNT_CMND_FAILED:
  6972                          PRTR_DCB_ACTIVE:
  6973                          END_PRINT_ROUTINE:
  6974  1558  fde1                      POP     IY
  6975  155a  e1                        POP     HL
  6976  155b  d1                        POP     DE
  6977  155c  c1                        POP     BC; ON ERROR, ZERO FLAG SET AND A
  6978                          ; CONTAINS THE ERROR CODE
  6979  155d  c9                        RET
  6980                          
  6981                          
  6982                          ;****************************************************************
  6983                          ;
  6984                          ; __SETUP_PR_BUFF SETS UP PRINT_BUFFER AND THE HL REGISTER AND
  6985                          ; CALLS __START_PR_BUFF
  6986                          ;       INPUT:  A = ASCII CHARACTER

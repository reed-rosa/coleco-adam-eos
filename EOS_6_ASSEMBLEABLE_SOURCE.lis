  6428  13eb  0000                      DEFB    0,0
  6429  13ed  0000                      DEFB    0,0
  6430  13ef  0000                      DEFB    0,0
  6431  13f1  000000                    DEFB    0,0,0
  6432                          
  6433  13f4  424f4f5403202020          DEFB    "BOOT",ETX,"       "
              20202020          
  6434  1400  88                        DEFB    ATTR_PERMANENT | ATTR_SYSTEM; [RECON] Identifier repair: OCR definition at 1051 is ATTR_SYSTEM.
  6435  1401  00000000                  DEFB    0,0,0,0
  6436  1405  0100                      DEFW    1

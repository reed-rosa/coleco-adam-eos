  6992                          ;****************************************************************
  6993                          
  6994                          ;GLB    __SETUP_PR_BUFF
  6995                          
  6996                          __SETUP_PR_BUFF:
  6997  155e  321600                    LD      (PRINT_BUFFER),A
  6998  1561  3e03                      LD      A,ETX

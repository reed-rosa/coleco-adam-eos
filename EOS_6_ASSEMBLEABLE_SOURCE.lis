  1222                          
  1223                          
  1224                          ;         Rev History
  1225                          ;         Rev.  Date        Name        Change
  1226                          ;         7     08oct1545   jkl         make __LOAD_ASCII load chars from 0 to 7F
  1227                          ;         6     08oct0003   rfj         fixed 100H bug with Bob Greenberg's
  1228                          ;                                     algorithm
  1229                          ;         5     07oct1708   rfj         __EFXOVER changed to __EFFECT_OVER
  1230                          ;         4     05oct10:40  rfj         Decoder now saves Acc before getting
  1231                          ;                                     interrupt data
  1232                          ;                                     Removed excess documentation on Put/Load Ascii
  1233                          ;                                     Commented out all unreferenced symbols with ;***
  1234                          ;                                     Renamed WR_SPR_NM_TBL to WR_SPR_ATTRIBUTE
  1235                          ;                                     globalized __UPDATE_SPINNER
  1236                          ;                                     new address for the ASCII table referenced
  1237                          ;         3     28sept1317  rfj         Multy changes after personal review
  1238                          ;                                     but not approved
  1239                          ;         2     25sept900a  RPD         made ram external
  1240                          ;         1     24sept1250p RPD         addition of more routines & new port accessing
  1241                          ;         0     24aug430p   RPD         Initial creation date (READ & WRITE VRAM)
  1242                          
  1243                          ; A_uOS_00 stands for ADAM micro Operating System version 0. This file
  1244                          ; contains a scaled down model of COLECOVISION OS 7. Primary routines from
  1245                          ; OS 7 are duplicated for ADAM application programs use. The functional areas
  1246                          ; that are supported by these routines are the VDP, the controllers, the sound
  1247                          ; chip, memory bank switch, port collection.
  1248                          
  1249                          
  1250                          ; ;***************************************************************
  1251                          
  1252                          ; [RECON assembler] Named section preserves OCR block order for z80asm.
  1253                                  SECTION code
  1254                                  ORG     EOS_CODE
  1255                          
  1256                          ;***************************************************************
  1257                          
  1258                          ; Name:          WRITE_VRAM
  1259                          ;
  1260                          ; Function:      Writes to VRAM the contents of the data in a buffer area.
  1261                          ;
  1262                          ; Entry:         BC - number of bytes to be written
  1263                          ;                DE - starting VRAM address to be written to
  1264                          ;                HL - address of buffer containing the data
  1265                          ;
  1266                          ; Exit:          None.
  1267                          ;
  1268                          ; Registers used: AF, BC, DE, HL
  1269                          ;
  1270                          ; Size:          ROM - 28 bytes
  1271                          ;                RAM - 0 bytes
  1272                          ;
  1273                          ; Comments:      This version of WRITE_VRAM is provided for EOS operation.
  1274                          ;                NOTE: The 100H bug found in OS 7 has been corrected.
  1275                          ;
  1276                          ; Comparison:    left out pascal entry point
  1277                          ;                code compacted
  1278                          ;                100H bug fixed
  1279                          ;                edited for documentation
  1280                          ;                reference port table
  1281                          
  1282                          __WRITE_VRAM:
  1283  0000  c5                        PUSH    BC;BC has the number of bytes to xfer
  1284  0001  eb                        EX      DE,HL;HL<--vram addr,DE<--source address
  1285  0002  cde901                    CALL    SET_WRITE;pump the vram addr to the vdp
  1286  0005  69                        LD      L,C;save C (the data_port_addr)
  1287  0006  c1                        POP     BC;restore the xfer count
  1288  0007  eb                        EX      DE,HL;HL<--source address,port in E
  1289  0008  79                        LD      A,C;Save low order of count in A
  1290  0009  4b                        LD      C,E; And get the port into C
  1291  000a  50                        LD      D,B;Get HI order count in D
  1292                          ; to free up B for low order count
  1293  000b  14                        INC     D;Increment HI count to cover
  1294                          ; for 0 in DEC D after low loop
  1295  000c  47                        LD      B,A;Put low order in B for OUTI
  1296  000d  b7                        OR      A;Check if low order is zero the first time
  1297  000e  2806                      JR      Z,OUT_DEC_HI_BYTE;If so then decrement HI count before low loop
  1298                          OUTPUT_LOOP:
  1299  0010  eda3                      OUTI;DATA_PORT = buffer_data  write the data to the VDP
  1300                          ;for OUTI: (C) <- (HL), B = B - 1 and HL = HL + 1
  1301  0012  00                        NOP;Delay for slow VDP
  1302  0013  00                        NOP
  1303  0014  20fa                      JR      NZ,OUTPUT_LOOP;until byte count low (B reg) = 0
  1304                          OUT_DEC_HI_BYTE:
  1305  0016  15                        DEC     D;byte count high = byte count high - 1
  1306  0017  20f7                      JR      NZ,OUTPUT_LOOP;until byte count high (A reg) = 0
  1307  0019  c9                        RET
  1308                          ;
  1309                          ; Name:          READ_VRAM
  1310                          ;
  1311                          ; Function:      Reads from VRAM and puts the read data into a buffer area.
  1312                          ;
  1313                          ; Entry:         BC - number of bytes to be read
  1314                          ;                DE - starting VRAM address to be read from
  1315                          ;                HL - address of buffer to receive the read data
  1316                          ;
  1317                          ; Exit:          None.
  1318                          ;
  1319                          ; Registers used: AF, BC, DE, HL
  1320                          ;
  1321                          ; Size:          ROM - 22 bytes
  1322                          ;                RAM - 0 bytes
  1323                          ;
  1324                          ; Comments:      This version of READ_VRAM is provided for stand alone operation.
  1325                          ;                NOTE: The 100H bug found in OS 7 has been corrected.
  1326                          ;
  1327                          ; Comparison:    left out pascal entry point
  1328                          ;                code compacted
  1329                          ;                100H bug fixed
  1330                          ;                edited for documentation
  1331                          ;
  1332                          __READ_VRAM:
  1333  001a  c5                        PUSH    BC;BC has the number of bytes to xfer
  1334  001b  eb                        EX      DE,HL;HL<--vram addr,DE<--source address
  1335  001c  cde701                    CALL    SET_READ;pump the vram addr to the vdp
  1336  001f  69                        LD      L,C;save C (the data_port_addr)
  1337  0020  c1                        POP     BC;restore the xfer count
  1338  0021  eb                        EX      DE,HL;HL<--source address,port in E
  1339  0022  79                        LD      A,C;Save low order of count in A
  1340  0023  4b                        LD      C,E; And get the port into C
  1341  0024  50                        LD      D,B;Get HI order count in D
  1342                          ; to free up B for low order count
  1343  0025  14                        INC     D;Increment HI count to cover
  1344                          ; for 0 in DEC D after low loop
  1345  0026  47                        LD      B,A;Put low order in B for OUTI
  1346  0027  b7                        OR      A;Check if low order is zero the first time
  1347  0028  2806                      JR      Z,IN_DEC_HI_BYTE;If so then decrement HI count before low loop
  1348                          INPUT_LOOP:
  1349  002a  eda2                      INI;DATA PORT = buffer data  read the data from to the VDP
  1350                          ;for INI: (C) <-- (HL), B = B - 1 and HL = HL + 1
  1351  002c  00                        NOP;delay for slow VDP
  1352  002d  00                        NOP
  1353  002e  20fa                      JR      NZ,INPUT_LOOP;until byte count low (B reg) = 0
  1354                          IN_DEC_HI_BYTE:
  1355  0030  15                        DEC     D;byte count high = byte count high - 1
  1356  0031  20f7                      JR      NZ,INPUT_LOOP;until byte count high (A reg) = 0
  1357  0033  c9                        RET
  1358                          ;
  1359                          ; Name:          WRITE_REGISTER
  1360                          ;
  1361                          ; Function:      Writes a data byte value to a desired VDP register
  1362                          ;
  1363                          ; Entry:         B - register number to write to
  1364                          ;                C - data byte value to be written
  1365                          ;
  1366                          ; Exit:          If register number = 0 or 1, the respective byte
  1367                          ;                of the VDP_MODE_WORD is updated.
  1368                          ;
  1369                          ; Registers used: A,BC,E
  1370                          ;
  1371                          ; Size:          ROM - 27 bytes
  1372                          ;                RAM - 0 bytes
  1373                          ;
  1374                          ; Comments:      This version of WRITE_REGISTER is provided for stand alone operation.
  1375                          ;
  1376                          ; Comparison:    left out pascal entry point
  1377                          ;                code compacted
  1378                          ;                edited for documentation
  1379                          ;
  1380                          __WRITE_REGISTER:
  1381  0034  59                        LD      E,C;Move data to E register
  1382  0035  3a2a00                    LD      A,(VDP_CTRL_PORT);Get the control port value
  1383  0038  4f                        LD      C,A;Put in C
  1384  0039  ed59                      OUT     (C),E;Output data value.
  1385  003b  78                        LD      A,B;Get port # in A
  1386  003c  f680                      OR      80H;Set high bit for ???????
  1387  003e  ed79                      OUT     (C),A;Out to VDP
  1388  0040  78                        LD      A,B;Get back port value
  1389  0041  b7                        OR      A;Check for zero
  1390  0042  7b                        LD      A,E;Put data in accumulator
  1391                          
  1392  0043  2004                      JR      NZ,CHK_REG_1;If not zero then see if register 1
  1393  0045  320100                    LD      (VDP_MODE_WORD),A;If register zero was written to then
  1394                          ; save data in VDP_MODE_WORD
  1395  0048  c9                        RET;Exit
  1396                          
  1397                          CHK_REG_1:
  1398  0049  05                        DEC     B;Check for register 1 in B
  1399  004a  c0                        RET     NZ;If not then return
  1400  004b  320200                    LD      (VDP_MODE_WORD+1),A;If so then store data in VDP_MODE_WORD+1
  1401  004e  c9                        RET;Exit
  1402                          
  1403                          ;
  1404                          ; Name:          READ_REGISTER
  1405                          ;
  1406                          ; Function:      Reads a data byte value from the Colecovision CTRL_PORT.
  1407                          ;
  1408                          ; Entry:         None.
  1409                          ;
  1410                          ; Exit:          A - data byte value read in
  1411                          ;
  1412                          ; Registers used: A,C
  1413                          ;
  1414                          ; Size:          ROM - 3 bytes
  1415                          ;                RAM - 0 bytes
  1416                          ;
  1417                          ; Comments:      This version of READ_REGISTER is provided for stand alone operation.
  1418                          ;                This routine does a direct access to the COLECOVISION I/O ports.
  1419                          ;
  1420                          ; Comparison:    edited for documentation
  1421                          ;
  1422                          __READ_REGISTER:
  1423  004f  3a2a00                    LD      A,(VDP_CTRL_PORT)
  1424  0052  4f                        LD      C,A
  1425  0053  ed78                      IN      A,(C);get the data from CTRL_PORT
  1426  0055  320300                    LD      (VDP_STATUS_BYTE),A;save a copy of VDP status data
  1427  0058  c9                        RET
  1428                          
  1429                          ;
  1430                          ; Name:          FILL_VRAM
  1431                          ;
  1432                          ; Function:      Fill a VRAM memory buffer with a constant byte value.
  1433                          ;
  1434                          ; Entry:         A  - constant byte value to be written
  1435                          ;                DE - number of bytes in the VRAM memory buffer
  1436                          ;                HL - starting VRAM address to be written to
  1437                          ;
  1438                          ; Exit:          None.
  1439                          ;
  1440                          ; Registers used: AF, C, DE
  1441                          ;
  1442                          ; Size:          ROM - 18 bytes
  1443                          ;                RAM - 0 bytes
  1444                          ;
  1445                          ; Comments:      This version of FILL_VRAM is provided for stand alone operation.
  1446                          ;                This routine does a direct access to the COLECOVISION I/O ports.
  1447                          ;
  1448                          ; Comparison:    edited for documentation
  1449                          ;                uneeded call to READ_REGISTER taken out
  1450                          ;
  1451                          ;
  1452                          __FILL_VRAM:
  1453  0059  f5                        PUSH    AF;Save the data to fill with
  1454  005a  cde901                    CALL    SET_WRITE;Sets the ctrl port data and
  1455  005d  e1                        POP     HL;popping AF into HL to restore the fill data
  1456                          FILL:;repeat
  1457                          ; get back a copy of the saved constant
  1458  005e  ed61                      OUT     (C),H; write the constant out to the VRAM buffer
  1459  0060  1b                        DEC     DE; byte count = byte count - 1
  1460  0061  7a                        LD      A,D;until byte count = 0
  1461  0062  b3                        OR      E
  1462  0063  20f9                      JR      NZ,FILL
  1463  0065  c9                        RET;all done
  1464                          ;
  1465                          ;
  1466                          ; Name:          INIT_TABLE
  1467                          ;
  1468                          ; Function:      INIT_TABLE initializes the addresses of the VRAM tables.
  1469                          ;                The passed address is converted to the correct format needed
  1470                          ;                to setup the VDP address registers. The following table codes
  1471                          ;                are use to indentify which table address is being setup:
  1472                          ;
  1473                          ;                    0 - SPRITE ATTRIBUTE TABLE  (SAT)
  1474                          ;                    1 - SPRITE GENERATOR TABLE  (SGT)
  1475                          ;                    2 - PATTERN NAME TABLE      (PNT)
  1476                          ;                    3 - PATTERN GENERATOR TABLE (PGT)
  1477                          ;                    4 - PATTERN COLOR TABLE     (PCT)
  1478                          ;
  1479                          ; Entry:         A  - table code (see above)
  1480                          ;                HL - table address
  1481                          ;
  1482                          ; Exit:          None.
  1483                          ;
  1484                          ; Registers used: AF, BC, HL, IX, IY
  1485                          ;
  1486                          ; Size:          ROM - 99 bytes
  1487                          ;                RAM - 0 bytes
  1488                          ;
  1489                          ; Comments:      This version of INIT_TABLE is provided for stand alone operation.
  1490                          ;
  1491                          ; Comparison:    left out pascal entry point
  1492                          ;                code compacted
  1493                          ;                edited for documentation
  1494                          ;
  1495                          __INIT_TABLE:
  1496                          
  1497  0066  4f                        LD      C,A;BC = index into VRAM_ADDR_TABLE  table code
  1498  0067  0600                      LD      B,0
  1499  0069  dd210400                  LD      IX,VRAM_ADDR_TABLE;point to start of VRAM_ADDR_TABLE
  1500  006d  dd09                      ADD     IX,BC;add in the index
  1501  006f  dd09                      ADD     IX,BC
  1502  0071  dd7500                    LD      (IX+0),L;save the address
  1503  0074  dd7401                    LD      (IX+1),H
  1504                          ;CHECK VDP GRAPHICS MODE
  1505  0077  3a0100                    LD      A,(VDP_MODE_WORD);if VDP_MODE_WORD bit 1  mode bit 3 = 1
  1506  007a  cb4f                      BIT     1,A
  1507  007c  2827                      JR      Z,INIT_TABLE80
  1508                          ; its graphics mode 2, look for PGT or PCT first
  1509  007e  79                        LD      A,C; get the table code
  1510  007f  fe03                      CP      3; if table code = PGT
  1511  0081  2806                      JR      Z,CASE_OF_GEN; then setup PGT address
  1512  0083  fe04                      CP      4; if table code = PCT
  1513  0085  2810                      JR      Z,CASE_OF_COLOR; then setup PCT address
  1514  0087  181c                      JR      INIT_TABLE80; else not a special case, use normal setup
  1515                          ;
  1516                          ; special case: graphics mode 2, address of PGT
  1517                          ;
  1518                          CASE_OF_GEN:
  1519  0089  0604                      LD      B,4;register number = PGT base address register
  1520  008b  7d                        LD      A,L;if PGT address = 0000H
  1521  008c  b4                        OR      H
  1522  008d  2004                      JR      NZ,CASE_OF_GEN10
  1523  008f  0e03                      LD      C,3; data byte value for address 0000H
  1524  0091  1828                      JR      INIT_TABLE90
  1525                          CASE_OF_GEN10:;else  PGT address <> 0000H
  1526  0093  0e07                      LD      C,7; data byte value for address 2000H
  1527  0095  1824                      JR      INIT_TABLE90;endif
  1528                          ;
  1529                          ; special case: graphics mode 2, address of PCT
  1530                          ;
  1531                          CASE_OF_COLOR:
  1532  0097  0603                      LD      B,3;register number = PCT base address register
  1533  0099  7d                        LD      A,L;if PCT address = 0000H
  1534  009a  b4                        OR      H
  1535  009b  2004                      JR      NZ,CASE_OF_CLR10
  1536  009d  0e7f                      LD      C,7FH; data byte value for address 0000H
  1537  009f  181a                      JR      INIT_TABLE90
  1538                          CASE_OF_CLR10:;else  PCT address <> 0000H
  1539  00a1  0eff                      LD      C,0FFH; data byte value for address 2000H
  1540  00a3  1816                      JR      INIT_TABLE90;endif
  1541                          ;
  1542                          ; not a special case (i.e. not mode 2, PGT or PCT)
  1543                          ;
  1544                          INIT_TABLE80:;base address = table address / factor
  1545  00a5  fd21bf00                  LD      IY,BASE_FACTORS;point to start of the the factor table
  1546  00a9  fd09                      ADD     IY,BC;Index into the table by the table code
  1547  00ab  fd09                      ADD     IY,BC
  1548  00ad  fd7e00                    LD      A,(IY+0);get the shift count
  1549  00b0  fd4601                    LD      B,(IY+1);get the register number
  1550                          DIVIDE:
  1551  00b3  cb3c                      SRL     H;shift hi-byte
  1552  00b5  cb1d                      RR      L;shift lo-byte
  1553  00b7  3d                        DEC     A;shift count = shift count - 1
  1554  00b8  20f9                      JR      NZ,DIVIDE
  1555  00ba  4d                        LD      C,L;get the data byte value
  1556                          INIT_TABLE90:
  1557  00bb  cdf000                    CALL    WRITE_REGISTER;setup the base register
  1558  00be  c9                        RET
  1559                          ;
  1560                          ; base factor table. used to calculate base addresses
  1561                          ;
  1562                          BASE_FACTORS:
  1563  00bf  07                        DEFB    7;table code 0 base factor
  1564  00c0  05                        DEFB    5;register 5, SAT base address
  1565  00c1  0b                        DEFB    11;table code 1 base factor
  1566  00c2  06                        DEFB    6;register 6, SGT base address
  1567  00c3  0a                        DEFB    10;table code 2 base factor
  1568  00c4  02                        DEFB    2;register 2, PNT base address
  1569  00c5  0b                        DEFB    11;table code 3 base factor
  1570  00c6  04                        DEFB    4;register 4, PGT base address
  1571  00c7  06                        DEFB    6;table code 4 base factor
  1572  00c8  03                        DEFB    3;register 3, PCT base address
  1573                          ;
  1574                          ; Name:          PUT_VRAM
  1575                          ;
  1576                          ; Function:      Gets a block of data from a user buffer and puts it into VRAM.
  1577                          ;                The following table codes are used to identify which VRAM table
  1578                          ;                is being referenced:
  1579                          ;
  1580                          ;                    0 - SPRITE ATTRIBUTE TABLE  (SAT)
  1581                          ;                    1 - SPRITE GENERATOR TABLE  (SGT)
  1582                          ;                    2 - PATTERN NAME TABLE      (PNT)
  1583                          ;                    3 - PATTERN GENERATOR TABLE (PGT)
  1584                          ;                    4 - PATTERN COLOR TABLE     (PCT)
  1585                          ;
  1586                          ; Entry:         A  - table code (see above)
  1587                          ;                DE - starting index into the table
  1588                          ;                HL - address of user buffer
  1589                          ;                IY - block size (or byte count)
  1590                          ;
  1591                          ; Exit:          None.
  1592                          ;
  1593                          ; Registers used: AF, DE, HL, IY
  1594                          ;
  1595                          ; Routines used: SET_COUNT
  1596                          ;
  1597                          ; Size:          ROM - 0 bytes
  1598                          ;                RAM - 0 bytes
  1599                          ;
  1600                          ; Comments:      This version of PUT_VRAM is provided for stand alone operation.
  1601                          ;
  1602                          ; Comparison:    left out pascal entry point
  1603                          ;                took out the mux sprites capability
  1604                          ;                code compacted
  1605                          ;                edited for documentation
  1606                          ;
  1607                          __PUT_VRAM:
  1608  00c9  cdd500                    CALL    SET_COUNT;setup the actual byte count and the absolute VRAM address
  1609                          ;       CALL    WRITE_VRAM                  ;VRAM data = user buffer
  1610                          ;       RET
  1611  00cc  c3ea00                    JP      WRITE_VRAM
  1612                          ;
  1613                          ; Name:          GET_VRAM
  1614                          ;
  1615                          ; Function:      Gets a block of data from VRAM and stores it into a user buffer.
  1616                          ;                The following table codes are used to identify which VRAM table
  1617                          ;                is being referenced:
  1618                          ;
  1619                          ;                    0 - SPRITE ATTRIBUTE TABLE  (SAT)
  1620                          ;                    1 - SPRITE GENERATOR TABLE  (SGT)
  1621                          ;                    2 - PATTERN NAME TABLE      (PNT)
  1622                          ;                    3 - PATTERN GENERATOR TABLE (PGT)
  1623                          ;                    4 - PATTERN COLOR TABEL     (PCT)
  1624                          ;
  1625                          ; Entry:         A  - table code (see above)
  1626                          ;                DE - starting index into the table
  1627                          ;                HL - address of user buffer
  1628                          ;                IY - block size (or byte count)
  1629                          ;
  1630                          ; Exit:          None.
  1631                          ;
  1632                          ; Registers used: AF, DE, HL, IY
  1633                          ;
  1634                          ; Routines used: SET_COUNT
  1635                          ;
  1636                          ; Size:          ROM - 0 bytes
  1637                          ;                RAM - 0 bytes
  1638                          ;
  1639                          ; Comments:      This version of GET_VRAM is provided for stand alone operation.
  1640                          ;
  1641                          ; Comparison:    left out pascal entry point
  1642                          ;                code compacted
  1643                          ;                edited for documentation
  1644                          ;
  1645                          __GET_VRAM:
  1646  00cf  cdd500                    CALL    SET_COUNT;setup the actual byte count and the absolute VRAM address
  1647                          ;       CALL    READ_VRAM                   ;user buffer = VRAM data
  1648                          ;       RET
  1649  00d2  c3ed00                    JP      READ_VRAM
  1650                          ;
  1651                          ; CALLED BY PUT_VRAM_ AND GET_VRAM_
  1652                          ;
  1653                          ; SETS BYTE COUNT AND INDEX FOR WRITES TO AND READS FROM VRAM.
  1654                          ;
  1655                          ; TABLE          BYTES/ITEM
  1656                          ; SPRITE_NAME    4
  1657                          ; SPRITE_GEN     8
  1658                          ; PATTERN_NAME   1
  1659                          ; PATTERN_GEN    8
  1660                          ; COLOR (MODE 1) 1
  1661                          ; COLOR (MODE 2) 8
  1662                          ;
  1663                          SET_COUNT:
  1664  00d5  fde5                      PUSH    IY;Save count on stack
  1665  00d7  4f                        LD      C,A;Get table code #
  1666  00d8  fe04                      CP      4;See if color table
  1667  00da  2008                      JR      NZ,NOT_COLOR_TBL_ACCESS;If not then check for name table
  1668                          ;Color Table
  1669  00dc  3a0100                    LD      A,(VDP_MODE_WORD);Get mode word to check graphics type
  1670  00df  e602                      AND     02H;Bit 1 indicates mode 1 or 2
  1671  00e1  2814                      JR      Z,ADD_TO_BASE;If mode 1 then start index is not modified
  1672  00e3  79                        LD      A,C;Get table code back
  1673                          ;Fall through to multiply by 8 for mode 2.
  1674                          NOT_COLOR_TBL_ACCESS:
  1675  00e4  fe02                      CP      2;Check for Name table
  1676  00e6  280f                      JR      Z,ADD_TO_BASE;If so then don't modify start index
  1677                          ;At this point the table code is:
  1678                          ; Sprite attribute table, Sprite gen table,
  1679                          ; Pattern gen table, or Color table in Mode 2
  1680                          
  1681  00e8  eb                        EX      DE,HL;Get count in HL
  1682  00e9  29                        ADD     HL,HL;*2
  1683                          
  1684  00ea  29                        ADD     HL,HL;*4
  1685  00eb  b7                        OR      A;Check for Sprite attr table
  1686  00ec  2801                      JR      Z,HAVE_CNT;If so then index*4 is complete
  1687  00ee  29                        ADD     HL,HL;If not then index*8 is required
  1688                          ; this is for the pattern gen table,
  1689                          ; sprite gen table, or color gen table
  1690                          ; in mode 2.
  1691                          HAVE_CNT:
  1692  00ef  eb                        EX      DE,HL;Put updated index in DE
  1693  00f0  e3                        EX      (SP),HL;Get count off stack
  1694                          ;Put address of RAM buffer on stack
  1695                          
  1696                          ;Now modify the count for:
  1697                          ; Sprite attribute table, Sprite gen table,
  1698                          ; Pattern gen table, or Color table in Mode 2
  1699  00f1  29                        ADD     HL,HL
  1700  00f2  29                        ADD     HL,HL
  1701  00f3  2801                      JR      Z,HAVE_CNT2;If Sprite attr table then *4 is enough
  1702                          ; (the zero flag is still set from earlier)
  1703  00f5  29                        ADD     HL,HL;Count *8 for remaining tables
  1704                          HAVE_CNT2:
  1705  00f6  e3                        EX      (SP),HL;Save updated count on stack
  1706                          ;Restore RAM buffer off stack
  1707                          ADD_TO_BASE:
  1708  00f7  79                        LD      A,C;Get table code back
  1709  00f8  010400                    LD      BC,VRAM_ADDR_TABLE;Get top of address table
  1710  00fb  e5                        PUSH    HL;Save RAM buffer on stack
  1711  00fc  2600                      LD      H,00H;Put table code into HL
  1712  00fe  6f                        LD      L,A
  1713  00ff  29                        ADD     HL,HL;*2 to offset for addresses in table
  1714  0100  09                        ADD     HL,BC;Add to top of table
  1715  0101  7e                        LD      A,(HL);Low byte of VRAM table address
  1716  0102  23                        INC     HL
  1717  0103  66                        LD      H,(HL);High byte of VRAM table address
  1718  0104  6f                        LD      L,A
  1719  0105  19                        ADD     HL,DE;Add offset from start of table
  1720  0106  eb                        EX      DE,HL;Absolute VRAM address in DE
  1721  0107  e1                        POP     HL;Restore RAM buffer address
  1722  0108  c1                        POP     BC;Restore Count into BC
  1723                          ;Registers are now ready for
  1724                          ; a call to the basic READ/WRITE VRAM routines
  1725  0109  c9                        RET;Exit
  1726                          ;*************** CALC_OFFSET ***************************************
  1727                          ;
  1728                          ;DESCRIPTION:   THIS ROUTINE CALCULATES THE PROPER OFFSET INTO THE NAME TABLE
  1729                          ;               FOR THE PATTERN POSITION GIVEN BY X_PAT_POS, Y_PAT_POS. THE
  1730                          ;               FORMULA USED IS: OFFSET = 32*Y_PAT_POS + X_PAT_POS
  1731                          ;
  1732                          ;INPUT:         D = Y_PAT_POS
  1733                          ;               E = X_PAT_POS
  1734                          ;
  1735                          ;OUTPUT:        DE = OFFSET
  1736                          ;
  1737                          ;********************************************************************
  1738                          ;
  1739                          __CALC_OFFSET:
  1740  010a  e5                        PUSH    HL;Save HL
  1741  010b  cb7a                      BIT     7,D;If Y_PAT_POS is minus
  1742  010d  2804                      JR      Z,ELSE_11
  1743  010f  26ff                      LD      H,0FFH; extend negative sign
  1744  0111  1802                      JR      END_IF_11
  1745                          ELSE_11:;else
  1746  0113  2600                      LD      H,0; extend positive sign
  1747                          END_IF_11:;endif
  1748                          
  1749  0115  6a                        LD      L,D;OFFSET = 32*Y_PAT_POS + X_PAT_POS
  1750  0116  29                        ADD     HL,HL;HL=2*Y_PAT_POS
  1751  0117  29                        ADD     HL,HL; 4* "
  1752  0118  29                        ADD     HL,HL; 8* "
  1753  0119  29                        ADD     HL,HL; 16* "
  1754  011a  29                        ADD     HL,HL; 32* "
  1755                          
  1756  011b  cb7b                      BIT     7,E;If X_PAT_POS is minus
  1757  011d  2804                      JR      Z,ELSE_12
  1758  011f  16ff                      LD      D,0FFH; extend negative sign
  1759  0121  1802                      JR      END_IF_12
  1760                          ELSE_12:;else
  1761  0123  1600                      LD      D,0; extend positive sign
  1762                          END_IF_12:;endif
  1763                          
  1764  0125  19                        ADD     HL,DE;HL=32*Y_PAT_POS + X_PAT_POS
  1765  0126  eb                        EX      DE,HL
  1766  0127  e1                        POP     HL;restore HL intact
  1767  0128  c9                        RET
  1768                          ;******************* PX_TO_PTRN_POS *******************************
  1769                          ;DESCRIPTION:   DIVIDES REG DE BY 8. IF SIGNED RESULT > 127 THEN E := MAX SIGNED
  1770                          ;               POSITIVE NUMBER. IF RESULT < -128, THEN E := MIN NEGATIVE NUM
  1771                          ;INPUT:         DE = 16 BIT SIGNED NUMBER
  1772                          ;OUTPUT:        DE/8 < -128        E = -128
  1773                          ;              -128 <= DE/8 <= +127        E = DE/8
  1774                          ;              +127 < DE/8        E = +127
  1775                          ;********************************************************************
  1776                          ;
  1777                          __PX_TO_PTRN_POS:
  1778                          
  1779  0129  e5                        PUSH    HL;HL USED TO TEST MAGNITUDE
  1780                          ;
  1781  012a  c5                        PUSH    BC;B WILL BE USED AS A COUNTER IN THE DIVIDE
  1782  012b  0603                      LD      B,3
  1783                          PX_2_P_P_1:;(THIS IS THE START OF THE DIVIDE LOOP)
  1784  012d  cb2a                      SRA     D;16 BIT SHIFT LEFT
  1785  012f  cb1b                      RR      E
  1786  0131  10fa                      DJNZ    PX_2_P_P_1;DIVIDE BY 8 LOOP
  1787  0133  c1                        POP     BC;RESTORE BC TO OLD VALUE
  1788                          ;
  1789  0134  2180ff                    LD      HL,0FF80H;SET HL TO -128
  1790  0137  cb7a                      BIT     7,D;IS RESULT OF DIVIDE NEGATIVE?
  1791  0139  2006                      JR      NZ,NEGTV
  1792                          ;
  1793  013b  19                        ADD     HL,DE;IF DE-128 < 0 (Fnc) RETURN
  1794  013c  e1                        POP     HL;same as (IF DE<=127 RETURN)
  1795  013d  d0                        RET     NC
  1796  013e  1e7f                      LD      E,7FH;IF > 128, THEN E := MAX SIGNED + NUM.
  1797  0140  c9                        RET
  1798                          ;
  1799  0141  2600              NEGTV: LD      H,00H;SET HL TO 128
  1800                          ;
  1801  0143  19                        ADD     HL,DE;IF DE+128 >= 0 RETURN
  1802  0144  e1                        POP     HL;same as (IF DE>=-128 RETURN)
  1803  0145  d8                        RET     C
  1804  0146  1e80                      LD      E,80H;IF < -128, THE E := MIN SIGNED - NUM.
  1805  0148  c9                        RET
  1806                          DEL            EQU     7FH;ASCII code for it
  1807                          ;ASCII_GEN      EQU     LOC_IN_ALPHA            ;1st byte of generator for NUL
  1808                          ;
  1809                          ;__LOAD_ASCII
  1810                          ;
  1811                          ;   Loads the ASCII character generators into VRAM at the
  1812                          ;   current pattern generator table (NOTE - INIT_TABLE must
  1813                          ;   have been called prior to this). Only the characters
  1814                          ;   from the space to the DEL (20h to 7Fh) are loaded.
  1815                          ;
  1816                          ;Input Parameters:
  1817                          ;   NONE
  1818                          ;
  1819                          ;Returns:
  1820                          ;   A, BC, HL, DE are destroyed
  1821                          ;
  1822                          ;   Falls into __PUT_ASCII
  1823                          ;
  1824                          __LOAD_ASCII:
  1825                          ;LD     HL,(PATTRNGENTBL)            ;get base of current generator table
  1826  0149  ed5b0a00                  LD      DE,(PATTRNGENTBL);get base of current generator table
  1827                          ;LD     DE,00H+8                     ;Offset into it where SPACE will be
  1828                          ;ADD    HL,DE
  1829                          ;EX     DE,HL                        ;leave VRAM address in DE
  1830  014d  210000                    LD      HL,00H;want to start with the null
  1831  0150  018000                    LD      BC,DEL-00H+1;load the entire ASCII set (0..7F) ; [RECON] Assembler dialect: parentheses are arithmetic grouping in the HP source.
  1832                          ;
  1833                          ; fall thru to PUT_ASCII
  1834                          ;
  1835                          ;
  1836                          ; __PUT_ASCII
  1837                          ;
  1838                          ;   Copys a specified number of ASCII character generators into VRAM.
  1839                          ;   Swaps to ROM that contains the generators then swaps back, keeps
  1840                          ;   track of callers stack and uses a local stack that is known to
  1841                          ;   be in RAM when the ROM is swapped in.
  1842                          ;
  1843                          ;Input Parameters:
  1844                          ;   HL - Character to 1st load (generally in range 0..FFH)
  1845                          ;   BC - Number of characters to load (Not the number of bytes)
  1846                          ;   DE - Address in VRAM to load the 1st generator
  1847                          ;
  1848                          ;   A, BC, HL, DE, IX  are destroyed
  1849                          ;
  1850                          ;   Calls WRITE_VRAM
  1851                          ;         SWITCH_MEM
  1852                          ;
  1853                          __PUT_ASCII:
  1854  0153  29                        ADD     HL,HL;multiply char to start loading by 8
  1855  0154  29                        ADD     HL,HL;so can use it as an offset into the
  1856  0155  29                        ADD     HL,HL;ASCII generator
  1857  0156  c5                        PUSH    BC;save number of chars desired
  1858                          ;LD     BC,ASCII_GEN
  1859                          ;LD     BC,(LOC_IN_ALPHA)
  1860                          ;ADD    HL,BC                       ;now HL points to the 1st generator desired
  1861  0157  e3                        EX      (SP),HL;get number of chars desired
  1862  0158  29                        ADD     HL,HL;and multiply by 8
  1863  0159  29                        ADD     HL,HL; since each generator is 8 bytes
  1864  015a  29                        ADD     HL,HL; long
  1865  015b  e3                        EX      (SP),HL;get back pointer into ASCII generators
  1866  015c  c1                        POP     BC;get number of chars times 8
  1867                          
  1868  015d  dd210000                  LD      IX,0000H; to use to save callers SP
  1869  0161  dd39                      ADD     IX,SP
  1870  0163  310e01                    LD      SP,TEMP_STACK;set stack into known RAM
  1871  0166  dde5                      PUSH    IX;save callers SP
  1872                          
  1873  0168  3a0e00                    LD      A,(CUR_BANK);remember which bank setting we
  1874  016b  f5                        PUSH    AF; are in
  1875  016c  3a1800                    LD      A,(MEM_CNFGOO);get value to let us get at the ALPHA roms
  1876                          
  1877  016f  c5                        PUSH    BC;count would get destroyed by SWITCH_MEM
  1878  0170  cde400                    CALL    SWITCH_MEM
  1879  0173  c1                        POP     BC
  1880                          
  1881  0174  d5                        PUSH    DE
  1882  0175  ed5b0201                  LD      DE,(LOC_IN_ALPHA)
  1883  0179  19                        ADD     HL,DE
  1884  017a  d1                        POP     DE
  1885                          
  1886  017b  cdea00                    CALL    WRITE_VRAM
  1887                          
  1888  017e  f1                        POP     AF;get back callers mem configuration
  1889  017f  cde400                    CALL    SWITCH_MEM
  1890                          
  1891  0182  e1                        POP     HL;get callers SP
  1892  0183  f9                        LD      SP,HL;and restore it
  1893  0184  c9                        RET; and back to caller
  1894                          ;
  1895                          ;   Switch_mem: memory bank switching routine
  1896                          ;
  1897                          ;   Inputs:
  1898                          ;       A = Appropriate input from SWITCH_TABLE
  1899                          ;
  1900                          ;       Example:
  1901                          ;   Switch Table Offset   Memory configuration
  1902                          ;   ---------------------------------------------------------------
  1903                          ;
  1904                          ;       0 -             Boot ROM and Alpha Roms
  1905                          ;       1 -             Intrinsic RAM (0000H thru 7FFFH)
  1906                          ;       2 -             Expansion memory (0000H thru 7FFFH)
  1907                          ;       3 -             OS_7 and intrinsic RAM (2000H thru 7FFFH)
  1908                          ;       4
  1909                          ;       .
  1910                          ;       D
  1911                          ;       E
  1912                          ;       F
  1913                          ;
  1914                          ;   ***Note: The values in the table are subject to change in future
  1915                          ;            releases of ADAM hardware.
  1916                          ;
  1917                          ;   For an example of the use of SWITCH_MEM see PORT_COLLECTION below.
  1918                          ;
  1919                          ;
  1920                          ;   Outputs:
  1921                          ;       CUR_BANK, a defined memory location will contain
  1922                          ;       the updated input parameter for applications and
  1923                          ;       EOS routines which need to determine which
  1924                          ;       memory space is currently active.
  1925                          ;
  1926                          __SWITCH_MEM:
  1927  0185  47                        LD      B,A;SAVE THE PORT DATA TO WRITE
  1928  0186  3a2800                    LD      A,(MEM_SWITCH_PORT);GET THE PORT NUMBER
  1929  0189  4f                        LD      C,A
  1930  018a  ed41                      OUT     (C),B;SWITCH MEMORY BANKS
  1931  018c  78                        LD      A,B
  1932  018d  320e00                    LD      (CUR_BANK),A;REMEMBER WHAT WAS SWITCHED TO.
  1933  0190  c9                        RET
  1934                          ;
  1935                          ;   Port collection must be called during initialization
  1936                          ;   It switches to OS7 ROM grabs the ports and switches back
  1937                          ;
  1938                          
  1939                          __PORT_COLLECTION:
  1940  0191  3a0e00                    LD      A,(CUR_BANK);GET THE CURRENT BANK
  1941  0194  f5                        PUSH    AF
  1942                          ;
  1943  0195  3a1b00                    LD      A,(MEM_CNFGO3);SWAP IN THE OS
  1944  0198  cde400                    CALL    SWITCH_MEM
  1945  019b  212a00                    LD      HL,PORT_TABLE+2;HL POINTS TO THE PORT TABLE
  1946                          ;
  1947  019e  3a431d                    LD      A,(01D43H);VDP CONTROL PORT
  1948  01a1  77                        LD      (HL),A
  1949  01a2  23                        INC     HL
  1950                          ;
  1951  01a3  3a471d                    LD      A,(01D47H);VDP DATA PORT
  1952  01a6  77                        LD      (HL),A
  1953  01a7  23                        INC     HL
  1954                          ;
  1955  01a8  3a4b11                    LD      A,(0114BH);CONTROLLER 0 ; [RECON] OCR 1981: scan bytes are 3A 4B 11.
  1956  01ab  77                        LD      (HL),A
  1957  01ac  23                        INC     HL
  1958                          ;
  1959  01ad  3a5111                    LD      A,(01151H);CONTROLLER 1
  1960  01b0  77                        LD      (HL),A
  1961  01b1  23                        INC     HL
  1962                          ;
  1963  01b2  3a5711                    LD      A,(01157H);CONTROLLER STROBE SET
  1964  01b5  77                        LD      (HL),A
  1965  01b6  23                        INC     HL
  1966                          ;
  1967  01b7  3a6811                    LD      A,(01168H);CONTROLLER STROBE RESET
  1968  01ba  77                        LD      (HL),A
  1969  01bb  23                        INC     HL
  1970                          ;
  1971  01bc  3a8e01                    LD      A,(0018EH);SOUND PORT
  1972  01bf  77                        LD      (HL),A
  1973  01c0  f1                        POP     AF
  1974  01c1  cde400                    CALL    SWITCH_MEM
  1975  01c4  c9                        RET
  1976                          ;
  1977                          ; Name:          WR_SPR_ATTRIBUTE
  1978                          ;
  1979                          ; Function:      Transfers the local copy of the sprite attribute table
  1980                          ;                to VRAM. WR_SPR_ATTRIBUTE will also reorder the
  1981                          ;                sprite table to reduce 5th sprite priority problems.
  1982                          ;
  1983                          ; Entry:         DE - address of Local Sprite Table
  1984                          ;                HL - address of Priority table
  1985                          ;                A  - number of sprites to be transfered (length of Local Sprite
  1986                          ;                     table divided by 4)
  1987                          ; Exit:          None.
  1988                          ;
  1989                          ; Registers used: AF, BC, DE, HL,
  1990                          ;
  1991                          ; Data structures accessed:
  1992                          ;                VRAM_ADDR_TABLE (SPRITEATTRTBL) for the starting address
  1993                          ;                of the sprite attribute table in VRAM.
  1994                          ;
  1995                          ;                PORT_PTR_TABLE (CTRL_PORT_PTR, DATA_PORT_PTR) for
  1996                          ;                VDP port access.
  1997                          ;
  1998                          ;                Local Sprite Table - User defined memory image of
  1999                          ;                the sprite attribute table
  2000                          ;
  2001                          ;                Priority Table - User defined sprite priority list
  2002                          ;                for the transfer of the sprite attributes
  2003                          ;
  2004                          ; Size:          ROM - xx bytes
  2005                          ;                RAM - xx bytes
  2006                          ;
  2007                          ; Comments:
  2008                          ;
  2009                          ; Comparison:    left out pascal entry point
  2010                          ;                added register parameters in place of defined memory pointers
  2011                          ;                code compacted
  2012                          ;                edited for documentation
  2013                          ;
  2014                          __WR_SPR_ATTRIBUTE:
  2015                          ;Initialize VDP address pointer
  2016  01c5  f5                        PUSH    AF
  2017  01c6  e5                        PUSH    HL
  2018  01c7  2a0400                    LD      HL,(SPRITEATTRTBL)
  2019  01ca  cde901                    CALL    SET_WRITE
  2020  01cd  e1                        POP     HL
  2021  01ce  f1                        POP     AF
  2022  01cf  47                        LD      B,A
  2023                          ;B = Sprite Count
  2024                          ;C = port address
  2025                          ;DE = address of Local Sprite Attribute Table
  2026                          ;HL = address of Priority table
  2027                          ;VDP is initialized to appropriate address
  2028                          LOOP_EVERY_SPRITE:
  2029                          
  2030                          ;               Index to sprite with the next highest priority
  2031                          
  2032  01d0  7e                        LD      A,(HL);Get current sprite as defined by the priority table
  2033  01d1  87                        ADD     A,A;*2 multiply by an attribute entry (4)
  2034  01d2  87                        ADD     A,A;*4
  2035                          
  2036  01d3  23                        INC     HL;Index to next location in priority table
  2037  01d4  e5                        PUSH    HL;Save for next sprite
  2038                          
  2039  01d5  6f                        LD      L,A;Offset into the Local Sprite Table by the current priority
  2040  01d6  2600                      LD      H,0
  2041  01d8  19                        ADD     HL,DE
  2042                          
  2043                          
  2044  01d9  78                        LD      A,B;Save sprite count in Acc.
  2045  01da  0604                      LD      B,4;Set count for write to VRAM
  2046                          ;C has port address
  2047                          ;HL has the pointer to a sprite's attributes
  2048                          LOOP_EVERY_BYTE:
  2049  01dc  eda3                      OUTI;Output a byte
  2050  01de  00                        NOP;Wait for VDP to catch up (worst case)
  2051  01df  00                        NOP
  2052  01e0  20fa                      JR      NZ,LOOP_EVERY_BYTE
  2053                          
  2054  01e2  47                        LD      B,A;Restore sprite count to B register
  2055  01e3  e1                        POP     HL;Restore index into the priority table
  2056  01e4  10ea                      DJNZ    LOOP_EVERY_SPRITE; If more sprites left then loop back
  2057                          
  2058  01e6  c9                        RET;Else exit
  2059                          ;
  2060                          ; Name:          SET_READ / SET_WRITE
  2061                          ;
  2062                          ; Function:      Initiates the VDP for reads or writes.
  2063                          ;
  2064                          ; Entry:         HL - VRAM address to start read / writes
  2065                          ;
  2066                          ; Exit:          C register contains the VDP_DATA_PORT value
  2067                          ;                HL remains unchanged
  2068                          ;
  2069                          ; Registers used: AF, BC, HL,
  2070                          ;
  2071                          ; Data structures accessed:
  2072                          ;
  2073                          ;                PORT_TABLE (CTRL_PORT_PTR, DATA_PORT_PTR) for
  2074                          ;                VDP port access.
  2075                          ;
  2076                          ; Size:          ROM - xx bytes
  2077                          ;                RAM - xx bytes
  2078                          ;
  2079                          ; Comments:
  2080                          ;
  2081                          ; Comparison:
  2082                          ;
  2083                          SET_READ:
  2084  01e7  af                        XOR     A;Clear accumulator for later OR which
  2085                          ; determines a read or write
  2086                          
  2087  01e8  c2                        DEFB    0C2H;This is the beginning of a JP NZ which
  2088                          ; will never be true but leaves the
  2089                          ; accumulator intact over the next
  2090                          ; two bytes ( the LD A,40H is decoded
  2091                          ; as the last two bytes of the jump
  2092                          SET_WRITE:
  2093  01e9  3e40                      LD      A,40H;Set bit to tell VDP that write is requested
  2094                          
  2095  01eb  ed4b2a00                  LD      BC,(VDP_CTRL_PORT);Get BOTH port addresses
  2096  01ef  ed69                      OUT     (C),L;Output low 8 bits of address
  2097  01f1  b4                        OR      H;OR read/write bit (Bit 6) into the high 8 bytes
  2098  01f2  ed79                      OUT     (C),A;Output result
  2099  01f4  48                        LD      C,B;Put DATA_PORT value into the C register
  2100                          
  2101  01f5  c9                        RET;Exit to caller
  2102                          ;CONTROLLER SOFTWARE
  2103                          ;
  2104                          ;*********************DATA******************************
  2105                          ;
  2106                          ;  DECODER TABLE FOR THE KEYBOARD
  2107                          
  2108                          ;
  2109                          DEC_KBD_TBL:
  2110  01f6  0f                        DEFB    KBD_NULL; NULL ENTRY
  2111  01f7  06                        DEFB    6; '6'
  2112  01f8  01                        DEFB    1; '1'
  2113  01f9  03                        DEFB    3; '3'
  2114  01fa  09                        DEFB    9; '9'
  2115  01fb  00                        DEFB    0; '0'
  2116  01fc  0a                        DEFB    10; '*'
  2117  01fd  0c                        DEFB    12; Purple Action Controller key (third one down)
  2118  01fe  02                        DEFB    2; '2'
  2119  01ff  0b                        DEFB    11; '#'
  2120  0200  07                        DEFB    7; '7'
  2121  0201  0d                        DEFB    13; Blue Action Controller key (fourth (or last) one down
  2122  0202  05                        DEFB    5; '5'
  2123  0203  04                        DEFB    4; '4'
  2124  0204  08                        DEFB    8; '8'
  2125  0205  0f                        DEFB    KBD_NULL; NULL ENTRY
  2126                          
  2127                          KBD_NULL       EQU     0FH
  2128                          KBD_MASK       EQU     0FH;MASK FOR INPUT DATA BYTE
  2129                          FIRE_MASK      EQU     40H
  2130                          ARM_MASK       EQU     40H
  2131                          JOY_MASK       EQU     0FH
  2132                          
  2133                          ;
  2134                          ;__DECODER
  2135                          ;        Will read all the data, from both segments, for a given controller
  2136                          ;        All data is returned in registers
  2137                          ;        Segment 0 data is returned the same as with OS-7
  2138                          ;
  2139                          ;        NOTE - some operations are done in an odd order so that a certain
  2140                          ;        number of cycles (T states) pass between port addressing.
  2141                          ;        Turns off interrupts if they were on at entry time for
  2142                          ;        195 T states (approx. 54.5 micro secs), the interupts
  2143                          ;        are reenabled after this time if they were on before.
  2144                          ;
  2145                          ;        Callers  -  The input parameters are different than OS-7 and
  2146                          ;                    both segments are returned so only one call is required
  2147                          ;                    for all the data from a given controller.
  2148                          ;                    The values returned are the same for segment 0 (H, L, E)
  2149                          ;                    but segment 1 values are returned in B and D.
  2150                          ;
  2151                          ;Stack Usage:
  2152                          ; Uses 2 words (pushes only)
  2153                          ;
  2154                          ;Input Parameters:
  2155                          ; A  - controller number, 0 or 1
  2156                          ;
  2157                          ;Returns:
  2158                          ; H  - fire button data
  2159                          ; L  - joystick data
  2160                          ; B  - arm button data
  2161                          ; C  - raw data for segment 0, (joystick, fire)
  2162                          ; D  - keyboard data
  2163                          ; E  - spinner count data
  2164                          ; A  - raw data for segment 1, (keyboard, arm, super controller buttons)
  2165                          ;
  2166                          ; SPIN_SWx_CT  - reset to 0 after read
  2167                          ;
  2168                          ; strobe port left in the reset condition
  2169                          ;
  2170                          ;Date:
  2171                          ; 9/24/83   11:14   JKL
  2172                          ;
  2173                          __DECODER:
  2174  0206  4f                        LD      C,A;Save controller #
  2175  0207  ed57                      LD      A,I;get current state of interupts, on/off, into P/V flag
  2176  0209  f5                        PUSH    AF;and save for later so can turn them back on if needed
  2177  020a  f3                        DI ; [RECON] OCR address gap at 2209 and ROM byte F3 restore DI at $E20A.
  2178  020b  79                        LD      A,C;Restore controller #
  2179  020c  ed4b2e00                  LD      BC,(STROBE_SET_PORT);C<--SET PORT, B<--RST PORT
  2180  0210  ed79                      OUT     (C),A;STROBE TO SEGMENT 1 (SET)
  2181  0212  50                        LD      D,B;SAVE RESET PORT
  2182  0213  21f800                    LD      HL,SPIN_SW0_CT;point at spinner count for controller 0
  2183  0216  ed4b2c00                  LD      BC,(CONTROLLER_0_PORT);C<--PORT_0, B<--PORT_1
  2184  021a  b7                        OR      A;A contains controller number
  2185  021b  2002                      JR      NZ,GOT_CORRECT_CONTROLLER_IN_C
  2186  021d  23                        INC     HL;Point to spinner for ctrlr 1
  2187  021e  48                        LD      C,B;C--PORT_1
  2188                          
  2189                          GOT_CORRECT_CONTROLLER_IN_C:
  2190  021f  af                        XOR     A
  2191  0220  5e                        LD      E,(HL);HAVE SPIN SWITCH COUNT
  2192  0221  77                        LD      (HL),A;RESET COUNT
  2193  0222  42                        LD      B,D;B<--RST PORT
  2194  0223  ed78                      IN      A,(C);READ DATA FROM SEG 1
  2195  0225  2f                        CPL
  2196                          ;
  2197  0226  2600                      LD      H,0
  2198  0228  6f                        LD      L,A;HL<--offset into DEC_KBD_TBL
  2199  0229  79                        LD      A,C;swap RST_PORT/DATA_PORT
  2200  022a  48                        LD      C,B
  2201  022b  ed79                      OUT     (C),A;STOBE TO SEG_0 (reset)
  2202  022d  4f                        LD      C,A;C<--DATA PORT
  2203  022e  f1                        POP     AF;get back entry state of interupt reg
  2204  022f  e23302                    JP      PO,LEAVE_THEM_OFF
  2205  0232  fb                        EI;turn interupts back on only if they were on entry
  2206                          LEAVE_THEM_OFF:
  2207  0233  7d                        LD      A,L;restore raw data segment 1 ; [RECON] OCR 2238: scan bytes are 7D and mnemonic is LD A,L.
  2208  0234  f5                        PUSH    AF
  2209  0235  e640                      AND     ARM_MASK;Test sleeve
  2210  0237  47                        LD      B,A;HAVE ARM DATA    (in B)
  2211  0238  7d                        LD      A,L
  2212  0239  e60f                      AND     KBD_MASK;isolate KBD data
  2213  023b  6f                        LD      L,A
  2214  023c  d5                        PUSH    DE;Save spin switch count on stack (reg E)
  2215  023d  11f601                    LD      DE,DEC_KBD_TBL;Get top of keypad decoder table
  2216  0240  19                        ADD     HL,DE;point to DEC_KBD_TBL entry
  2217  0241  d1                        POP     DE;Restore Spinner count (reg E)
  2218  0242  56                        LD      D,(HL);HAVE KEYBOARD DATA
  2219  0243  ed78                      IN      A,(C);segment 0 data
  2220  0245  2f                        CPL
  2221                          ;
  2222  0246  f5                        PUSH    AF;save raw data
  2223  0247  6f                        LD      L,A
  2224  0248  e640                      AND     FIRE_MASK;isolate fire data
  2225  024a  67                        LD      H,A;HAVE FIRE_DATA
  2226  024b  7d                        LD      A,L
  2227  024c  e60f                      AND     JOY_MASK;isolate joystick data
  2228  024e  6f                        LD      L,A;HAVE JOY DATA
  2229  024f  f1                        POP     AF;get back raw data for seg 0
  2230  0250  4f                        LD      C,A;C = raw data segment 0
  2231  0251  f1                        POP     AF
  2232  0252  c9                        RET;A = raw data segment 1
  2233                          ;
  2234                          ;__POLLER
  2235                          ;
  2236                          ;   Used to fill a table of values for the 2 controllers
  2237                          ;   Does some debouncing if called twice in succession
  2238                          ;
  2239                          ;   NOTE - Does not return at bottom of code, return is in middle
  2240                          ;          interupts will be off for a while when call to DECODE is performed
  2241                          ;
  2242                          ;   Callers - This has different input parameters than OS-7 and
  2243                          ;             the controller map is ordered differently.
  2244                          ;
  2245                          ;
  2246                          ;Stack Usage:
  2247                          ; will use 4 words (2 pushes, 2 call)
  2248                          ;
  2249                          ;Calls:
  2250                          ;   __DECODER
  2251                          ;   DEBOUNCE
  2252                          ;   READ_N_DEBOUNCE  (a routine that is nested in __POLLER)
  2253                          ;
  2254                          ;Input Parameters:
  2255                          ;  IX - pointer to 1st byte of users controller map (10 bytes)
  2256                          ;  A  - controller enabled and spinner enable
  2257                          ;       bit 0 - set if want controller 0 enabled
  2258                          ;       bit 1 - set if want controller 1 enabled
  2259                          ;       bit 7 - set if want spinner enabled for controllers which are enabled
  2260                          ;
  2261                          ;Returns:
  2262                          ;
  2263                          ;  Data in users controller map is like this off of entry IX value
  2264                          ;             IX+0  - joystick 0
  2265                          ;             IX+1  - fire 0
  2266                          ;             IX+2  - arm 0
  2267                          ;             IX+3  - keyboard 0
  2268                          ;             IX+4  - spinner count 0
  2269                          ;             IX+5  - joystick 1
  2270                          ;             IX+6  - fire 1
  2271                          ;             IX+7  - arm 1
  2272                          ;             IX+8  - keyboard 1
  2273                          ;             IX+9  - spinner count 1
  2274                          ;
  2275                          ;  IX - points to 1 byte past users data table of highest enabled controller
  2276                          ;
  2277                          
  2278                          ;  all but IY - destroyed
  2279                          ;
  2280                          ;Date:
  2281                          ;  9/24/83   11:14   JKL
  2282                          ;
  2283                          
  2284                          CONTROLLER_0_MASK      EQU     01H
  2285                          CONTROLLER_1_BIT       EQU     1
  2286                          SPINNER_ENABLE_BIT     EQU     7
  2287                          __POLLER:
  2288  0253  21fa00                    LD      HL,PERSONAL_DEBOUNCE_TABLE;point to controller 0 debounce buffer
  2289  0256  4f                        LD      C,A;save enabled controller input
  2290  0257  e601                      AND     CONTROLLER_0_MASK;see if controller 0 is enabled
  2291  0259  2823                      JR      Z,NOT_CONTROLLER_0;If not then check to see if controller 1 is
  2292  025b  3d                        DEC     A;to 0 for parameter to __DECODER
  2293  025c  cd6402                    CALL    READ_N_DEBOUNCE;get the data and debounce it
  2294  025f  cb49                      BIT     CONTROLLER_1_BIT,C;see if controller 1 is active
  2295  0261  c8                        RET     Z;return if not
  2296                          POLL_CONTROLLER_1:;get data for controller 1
  2297  0262  3e01                      LD      A,01H
  2298                          READ_N_DEBOUNCE:
  2299  0264  c5                        PUSH    BC;save input parameter
  2300  0265  e5                        PUSH    HL;save debounce buffer ptr
  2301  0266  cd0602                    CALL    __DECODER
  2302  0269  4c                        LD      C,H;copy over raw data
  2303  026a  7d                        LD      A,L; with fire and joystick data
  2304  026b  e1                        POP     HL;get pointer to debounce buffer
  2305  026c  cd8b02                    CALL    DEBOUNCE;debounce the data (on second call)
  2306  026f  c1                        POP     BC;get back input parameter
  2307  0270  cb79                      BIT     SPINNER_ENABLE_BIT,C;see if spinners are enabled
  2308  0272  2807                      JR      Z,NEXT_IX
  2309  0274  7b                        LD      A,E;if so add
  2310  0275  dd8600                    ADD     A,(IX+0); new data to that in
  2311  0278  dd7700                    LD      (IX+0),A; users buffer
  2312                          NEXT_IX:
  2313  027b  dd23                      INC     IX;point to next users buffer
  2314  027d  c9                        RET
  2315                          NOT_CONTROLLER_0: ; [RECON] OCR address flow places the missing branch label at $E27E.
  2316  027e  cb49                      BIT     CONTROLLER_1_BIT,C;see if controller 1 is enabled
  2317  0280  c8                        RET     Z;return if not
  2318  0281  110400                    LD      DE,0004H
  2319  0284  19                        ADD     HL,DE;point to next debounce buffer
  2320  0285  13                        INC     DE
  2321  0286  dd19                      ADD     IX,DE;point to next user buffer
  2322  0288  c36202                    JP      POLL_CONTROLLER_1
  2323                          ;
  2324                          ;DEBOUNCE
  2325                          ;        This will check for equal data on two passes, and if
  2326                          ;        the data is the same then the users buffer is updated.
  2327                          ;
  2328                          ;        This is done by check for equal data, if the data is
  2329                          ;        different on each call then the data on this call is
  2330                          ;        stored so that the next call can use this new data.
  2331                          ;        If the data is equal then the data is stored with the
  2332                          ;        hi bit (bit 7) set so that the next call will yield
  2333                          ;        different data (If there could never be a match on the
  2334                          ;        next call).
  2335                          ;
  2336                          ;Stack Usage:
  2337                          ; 1 word (subroutine call)
  2338                          ;
  2339                          ;Input Parameters:
  2340                          ;   HL - Pointer to debounce buffer
  2341                          ;   IX - Pointer to users controller map
  2342                          ;   A  - joystick data
  2343                          ;   B  - arm data
  2344                          ;   C  - fire data
  2345                          ;   D  - keyboard data
  2346                          ;
  2347                          ;Returns:
  2348                          ;   HL - Pointing to next buffer (entry value + 4)
  2349                          ;   IX - Pointing to next data area (entry value + 4)
  2350                          ;   A is changed
  2351                          ;   No others are modified
  2352                          ;
  2353                          ; Calls self as a nested subroutine CHECK
  2354                          ;
  2355                          ;Date:
  2356                          ; 9/24/83   11:14   JKL
  2357                          ;
  2358                          ;
  2359                          DEBOUNCE:
  2360  028b  cd9702                    CALL    CHECK;debounce joystick data
  2361  028e  79                        LD      A,C;debounce fire data
  2362  028f  cd9702                    CALL    CHECK
  2363  0292  78                        LD      A,B;debounce arm data
  2364  0293  cd9702                    CALL    CHECK
  2365  0296  7a                        LD      A,D;debounce keyboard data
  2366                          ;fall thru to check (return implied)
  2367                          CHECK:
  2368  0297  be                        CP      (HL);see if data was the same as last time
  2369  0298  2005                      JR      NZ,NOT_SAME
  2370  029a  dd7700                    LD      (IX+0),A ; [RECON] OCR address gap at 2404 and ROM bytes DD 77 00 restore the store at $E29A.
  2371  029d  f680                      OR      80H;set hi_order bit if same, so not equal on next call
  2372                          
  2373                          NOT_SAME:
  2374  029f  77                        LD      (HL),A;update local debounce buffer
  2375  02a0  dd23                      INC     IX;point to next buffer location
  2376  02a2  23                        INC     HL; in debounce buffer as well
  2377  02a3  c9                        RET
  2378                          ;
  2379                          ;Update_Spinner - Controller spin switch interrupt service routine
  2380                          ;
  2381                          ; This routine processes the spinner switch interrupt and updates
  2382                          ; the data needed by both DECODER and POLLER
  2383                          ;
  2384                          ; Ram area used: Updates SPIN_SW0_CNT and SPIN_SW1_CNT
  2385                          ;
  2386                          ; The spinner switch maskable interrupt is RST 38H
  2387                          ;
  2388                          ; Destroys AF, BC, HL
  2389                          ;
  2390                          DIR_MASK       EQU     00100000B;bit 5 tells us the direction
  2391                          INT_BIT        EQU     4;bit that tells which spinner interrupted
  2392                          
  2393                          __UPDATE_SPINNER:
  2394  02a4  ed4b2c00                  LD      BC,(CONTROLLER_0_PORT);Get port values for both controllers
  2395  02a8  ed78                      IN      A,(C);Input data from controller 0
  2396  02aa  21f800                    LD      HL,SPIN_SW0_CT;Point to spinner update data
  2397  02ad  cb67                      BIT     INT_BIT,A;Was this the controller that interrupted ?
  2398  02af  2007                      JR      NZ,GET_CONTROLLER_1;If not then check controller 1
  2399  02b1  e620                      AND     DIR_MASK;Check direction bit
  2400  02b3  2002                      JR      NZ,INCREMENT_0_DIRECTION;If set then increment direction
  2401  02b5  35                        DEC     (HL);Else decrement direction
  2402  02b6  35                        DEC     (HL);Decrement once more to fall through increment
  2403                          
  2404                          INCREMENT_0_DIRECTION:
  2405  02b7  34                        INC     (HL);Increment direction
  2406                          
  2407                          GET_CONTROLLER_1:
  2408  02b8  48                        LD      C,B;Get controller 1 port into C
  2409  02b9  ed78                      IN      A,(C);Get controller 1 data
  2410  02bb  23                        INC     HL;Point HL to controller 1 update area
  2411  02bc  cb67                      BIT     INT_BIT,A;Is this the controller that interrupted me?
  2412  02be  c0                        RET     NZ;Return if not. Also don't assume
  2413                          ; either controller if no bit is set
  2414  02bf  e620                      AND     DIR_MASK;Check direction bit
  2415  02c1  2002                      JR      NZ,INCREMENT_1_DIRECTION;If set then go increment direction
  2416  02c3  35                        DEC     (HL);Else decrement direction
  2417  02c4  c9                        RET;Then return
  2418                          
  2419                          INCREMENT_1_DIRECTION:
  2420  02c5  34                        INC     (HL);Increment direction
  2421  02c6  c9                        RET;Exit
  2422                          
  2423                          ;********************************************************************
  2424                          ;
  2425                          ;                         NOTES TO SOUND PROGRAMMERS
  2426                          ;
  2427                          ; The only differences between the OS7 version and this ADAM version
  2428                          ; are transparent to the game programmer and important to the
  2429                          ; sound programmer. Formerly CALL'S to PLAY_SONGS and SND_MANAGER
  2430                          ; were necessary to update the sounds. Now a CALL to SOUNDS runs
  2431                          ; the same code. Formerly CALL'S to LEAVE_EFFECT and EFXOVER were
  2432                          ; needed to end a SPECIAL_EFFECT. Now EFFECT_OVER runs the same code.
  2433                          ; Independent CALL'S to PLAY_SONGS, SND_MANAGER, LEAVE_EFFECT and
  2434                          ; EFXOVER do not run in this module as before!!!!!
  2435                          ;
  2436                          ;********************************************************************
  2437                          ;
  2438                          ;        Operating system sound routine EQUATES
  2439                          
  2440                          OFF             EQU     0FH;Off, no sound
  2441                          
  2442                          ;        Special byte 0 codes
  2443                          
  2444                          INACTIVE        EQU     0FFH
  2445                          ;*** SEFFECT    EQU     62
  2446                          ENOSDATA        EQU     0
  2447                          
  2448                          ;        Offsets within an SxDATA song data area
  2449                          
  2450                          ;*** CH         EQU     0
  2451                          ;*** SONGNO     EQU     0
  2452                          ;*** NEXTNOTEPTR EQU    1
  2453                          FREQ            EQU     3
  2454                          ATN             EQU     4
  2455                          CTRL            EQU     4
  2456                          NLEN            EQU     5
  2457                          ;*** FPS        EQU     6
  2458                          FPSV            EQU     6
  2459                          FSTEP           EQU     7
  2460                          ;*** ALEN       EQU     8
  2461                          ASTEP           EQU     8
  2462                          ;*** APS        EQU     9
  2463                          APSV            EQU     9
  2464                          
  2465                          ;        song end codes
  2466                          
  2467                          ;*** CH0END     EQU     00010000B
  2468                          ;*** CH1END     EQU     01010000B
  2469                          ;*** CH2END     EQU     10010000B
  2470                          ;*** CH3END     EQU     11010000B
  2471                          ;*** CH0REP     EQU     00011000B
  2472                          ;*** CH1REP     EQU     01011000B
  2473                          ;*** CH2REP     EQU     10011000B
  2474                          ;*** CH3REP     EQU     11011000B
  2475                          
  2476                          ;        channel numbers, B7 -B6
  2477                          
  2478                          ;*** CH0        EQU     0
  2479                          ;*** CH1        EQU     01000000B
  2480                          ;*** CH2        EQU     10000000B
  2481                          ;*** CH3        EQU     11000000B
  2482                          
  2483                          
  2484                          ;*****************************
  2485                          ;*        FREQ_SWEEP         *
  2486                          ;*****************************
  2487                          
  2488                          ;See Users' Manual for description
  2489                          ;RET Z SET:  if note over
  2490                          ;RET Z RESET: if sweep in progress or note not over
  2491                          
  2492                          FREQ_SWEEP:
  2493                          
  2494                          ;        * if freq not swept, dec NLEN and RET [setting Z flag]
  2495                          
  2496  02c7  dd7e07                    LD      A,(IX+FSTEP);check  for no sweep code
  2497  02ca  b7                        OR      A;SET Z flag if FSTEP = 0
  2498  02cb  2009                      JR      NZ,L20;if PSW is zero note not to be swept
  2499  02cd  dd7e05                    LD      A,(IX+NLEN);dec NLEN and
  2500  02d0  3d                        DEC     A;SET Z flag if NLEN = 0
  2501  02d1  c8                        RET     Z;leave if note over with Z flag SET
  2502  02d2  dd7705                    LD      (IX+NLEN),A;store decremented NLEN
  2503  02d5  c9                        RET;RET with Z flag RESET [note not over]
  2504                          
  2505                          ;        ENDIF
  2506                          
  2507                          ;        * sweep going, so dec FPSV
  2508                          
  2509                          L20:
  2510  02d6  dde5                      PUSH    IX;point HL to FPSV
  2511  02d8  e1                        POP     HL
  2512  02d9  110600                    LD      DE,FPSV
  2513  02dc  19                        ADD     HL,DE
  2514  02dd  cd5503                    CALL    LOCL_DECLSN;dec FPSV
  2515                          ;****   JR      NZ,L21                     ;if PSW is zero FPSV has timed out
  2516  02e0  c0                        RET     NZ;Added uOS
  2517                          
  2518                          ;        * dec NLEN and leave if sweep is over
  2519                          
  2520  02e1  cd6903                    CALL    LOCL_MSNTOLSN;reload FPSV from FPS
  2521  02e4  2b                        DEC     HL;point to NLEN (# steps in the sweep)
  2522  02e5  7e                        LD      A,(HL);dec NLEN and
  2523  02e6  3d                        DEC     A;SET Z flag if NLEN = 0
  2524  02e7  c8                        RET     Z;leave if sweep over with Z flag SET
  2525                          
  2526                          ;        * sweep not over, so add FSTEP to FREQ
  2527                          
  2528  02e8  77                        LD      (HL),A;store decremented NLEN
  2529  02e9  2b                        DEC     HL;point HL
  2530  02ea  2b                        DEC     HL;to FREQ
  2531  02eb  dd7e07                    LD      A,(IX+FSTEP);A = FSTEP (two's complement step size)
  2532  02ee  cd7403                    CALL    LOC_ADD816;FREQ = FREQ + FSTEP
  2533  02f1  23                        INC     HL;point HL to hi FREQ
  2534  02f2  cb96                      RES     2,(HL);RESET B2 in hi FREQ in case add caused > 10 bit FREQ
  2535  02f4  f6ff                      OR      0FFH;RESET Z flag. sweep not over yet
  2536                          
  2537                          ;        ENDIF
  2538                          ;*** L21
  2539  02f6  c9                        RET
  2540                          ;        END FREQSWE
  2541                          
  2542                          ;*****************************
  2543                          ;*        ATN_SWEEP          *
  2544                          ;*****************************
  2545                          
  2546                          ;See User's Manual for description
  2547                          ;RET Z SET:  if byte 8 is 0 [means sweep is over, or note was never swept]
  2548                          ;RET Z RESET: if sweep in progress
  2549                          
  2550                          ATN_SWEEP:
  2551                          
  2552                          ;        * RET with Z SET if byte 8 = 00
  2553                          
  2554  02f7  dd7e08                    LD      A,(IX+8);check byte 8 for no sweep code
  2555  02fa  b7                        OR      A;Z is set if byte 8 = 0
  2556  02fb  c8                        RET     Z;leave if Z set, sweep not going
  2557                          
  2558                          ;        * sweep going, so dec APSV
  2559                          
  2560  02fc  dde5                      PUSH    IX;point HL to APSV
  2561  02fe  e1                        POP     HL
  2562  02ff  110900                    LD      DE,APSV
  2563  0302  19                        ADD     HL,DE
  2564  0303  cd5503                    CALL    LOCL_DECLSN;dec APSV (LSN of byte 9)
  2565                          ;****   JR      NZ,L22                     ;if PSW is zero APSV has timed out
  2566  0306  c0                        RET     NZ;Added uOS
  2567                          
  2568                          ;        * dec ALEN to see if sweep over
  2569                          
  2570  0307  cd6903                    CALL    LOCL_MSNTOLSN;reload APSV from APS
  2571  030a  2b                        DEC     HL;point to ALEN (# of steps in the sweep)
  2572  030b  cd5503                    CALL    LOCL_DECLSN;dec ALEN (LSN byte 8)
  2573  030e  2815                      JR      Z,L23;if PSW is non-zero sweep not over yet
  2574                          
  2575                          ;        * add ASTEP to ATN
  2576                          
  2577  0310  7e                        LD      A,(HL);MSN A = ASTEP
  2578  0311  e6f0                      AND     0F0H;mask LSN
  2579  0313  5f                        LD      E,A;E = ASTEP   0
  2580  0314  2b                        DEC     HL;point HL to ATN
  2581  0315  2b                        DEC     HL
  2582  0316  2b                        DEC     HL
  2583  0317  2b                        DEC     HL
  2584  0318  7e                        LD      A,(HL);MSN A = ATN
  2585  0319  e6f0                      AND     0F0H;A = ATN     0
  2586  031b  83                        ADD     A,E;MSN A = (ASTEP + ATN)   0
  2587  031c  5f                        LD      E,A;E = (ASTEP + ATN)       0
  2588  031d  7e                        LD      A,(HL);A = ATN freq or CTRL
  2589  031e  e60f                      AND     0FH;mask old ATN A = 0 freq or CTRL
  2590  0320  b3                        OR      E;OR in new ATN
  2591  0321  77                        LD      (HL),A;store updated value back into song data area
  2592  0322  f6ff                      OR      0FFH;RESET Z flag. sweep not over yet
  2593                          ;****   JR      L22
  2594  0324  c9                        RET;Added uOS
  2595                          
  2596                          ;        ELSE   Z flag is SET: sweep over
  2597                          
  2598                          L23:
  2599  0325  3600                      LD      (HL),0;set byte 8 to 0 to indicate end sweep
  2600                          
  2601                          ;        ENDIF
  2602                          ;        ENDIF
  2603                          
  2604                          ;*** L22
  2605  0327  c9                        RET
  2606                          
  2607                          ;        END ATNSWEE
  2608                          
  2609                          
  2610                          ;*****************************
  2611                          ;*        UPAINCTRL          *
  2612                          ;*****************************
  2613                          
  2614                          ;Perform single byte update of the snd chip noise control register or any
  2615                          ;attenuation register. IX is passed pointing to byte 0 of a song data area, MSN
  2616                          ;register C = formatted channel attenuation code.
  2617                          
  2618                          UPAINCTRL:
  2619  0328  dd7e04                    LD      A,(IX+4);MSN A = ATN. LSN may be CTRL data
  2620  032b  cb61                      BIT     4,C;test for ATN
  2621                          ;If PSW is non-zero ATN is to be sent,
  2622                          ; move it to the LSN
  2623  032d  2804                      JR      Z,L24
  2624  032f  0f                        RRCA;swap nibbles
  2625  0330  0f                        RRCA
  2626  0331  0f                        RRCA
  2627  0332  0f                        RRCA;LSN A = ATN
  2628                          
  2629                          ;        ENDIF
  2630                          
  2631                          L24:
  2632  0333  e60f                      AND     0FH;mask MSN
  2633  0335  b1                        OR      C;A = formatted register#  ATN or CTRL
  2634                          ;****   CALL    OUT_TO_SOUND_PORT           ;output ATN or CTRL data
  2635                          ;****   RET
  2636  0336  c30d06                    JP      OUT_TO_SOUND_PORT;output ATN or CTRL data
  2637                          
  2638                          
  2639                          ;*****************************
  2640                          ;*        UPFREQ             *
  2641                          ;*****************************
  2642                          
  2643                          ;Perform double byte update of a sound chip frequency register.  IX is passed
  2644                          ;pointing to byte0 of a song data area. MSN register D = formatted channel
  2645                          ;frequency code.
  2646                          
  2647                          UPFREQ:
  2648  0339  dd7e03                    LD      A,(IX+FREQ);A = F2 F3 F4 F5 F6 F7 F8 F9
  2649  033c  e60f                      AND     0FH;A = 0  0  0  0  F6 F7 F8 F9
  2650  033e  b2                        OR      D;A = formatted reg#  F6 F7 F8 F9
  2651  033f  cd0d06                    CALL    OUT_TO_SOUND_PORT;output first freq byte
  2652  0342  dd7e03                    LD      A,(IX+FREQ);A = F2 F3 F4 F5 F6 F7 F8 F9 again
  2653  0345  e6f0                      AND     0F0H;A = F2 F3 F4 F5 0  0  0  0
  2654  0347  57                        LD      D,A;save in D
  2655  0348  dd7e04                    LD      A,(IX+FREQ+1);LSN A = 0  0  F0 F1
  2656  034b  e60f                      AND     0FH;A = 0  0  0  0  0  0  F0 F1
  2657  034d  b2                        OR      D;A = F2 F3 F4 F5 0  0  F0 F1
  2658  034e  0f                        RRCA;swap nibbles
  2659  034f  0f                        RRCA
  2660  0350  0f                        RRCA
  2661  0351  0f                        RRCA;A = 0  0  F0 F1 F2 F3 F4 F5
  2662                          ;****   CALL    OUT_TO_SOUND_PORT           ;output 2nd (most significant) freq byte
  2663                          ;****   RET
  2664  0352  c30d06                    JP      OUT_TO_SOUND_PORT;output 2nd (most significant) freq byte
  2665                          
  2666                          
  2667                          ;*****************************
  2668                          ;*        LOCL_DECLSN        *
  2669                          ;*****************************
  2670                          
  2671                          ;Without affecting the MSN, decrement the LSN of the byte pointed to by HL.
  2672                          ;HL remains the same.
  2673                          ;RET with Z flag set if dec LSN results in 0, reset otherwise.
  2674                          ;RET with C flag set if dec LSN results in -1, reset otherwise.
  2675                          
  2676                          __DECLSN:
  2677                          LOCL_DECLSN:
  2678  0355  af                        XOR     A
  2679  0356  ed67                      RRD;A = 0    LSN (HL)
  2680  0358  d601                      SUB     1;Z flag set if dec to 0. C flag if dec to -1
  2681  035a  f5                        PUSH    AF;save Z and C flags
  2682  035b  ed6f                      RLD;(HL) = old MSN    new LSN
  2683  035d  f1                        POP     AF;restore Z and C flags. A = 0    new LSN
  2684  035e  c9                        RET
  2685                          
  2686                          
  2687                          ;*****************************
  2688                          ;*        LOCL_DECMSN        *
  2689                          ;*****************************
  2690                          
  2691                          ;Without affecting the LSN, decrement the MSN of the byte pointed to by HL.
  2692                          ;HL remains the same.
  2693                          ;RET with Z flag set if dec MSN results in 0, reset otherwise.
  2694                          ;RET with C flag set if dec MSN results in -1, reset otherwise.
  2695                          
  2696                          __DECMSN:
  2697                          LOCL_DECMSN:
  2698  035f  af                        XOR     A
  2699  0360  ed6f                      RLD;A = 0    MSN (HL)
  2700  0362  d601                      SUB     1;Z flag set if dec to 0, C flag set if dec -1
  2701  0364  f5                        PUSH    AF;save Z and C flags
  2702  0365  ed67                      RRD;(HL) = new MSN    old LSN
  2703  0367  f1                        POP     AF;restore Z and C flags, A = 0    new MSN
  2704  0368  c9                        RET
  2705                          
  2706                          
  2707                          ;*****************************
  2708                          ;*        LOCL_MSNTOLSN      *
  2709                          ;*****************************
  2710                          
  2711                          ;Copy MSN of the byte pointed to by HL to the LSN of that byte.  HL remains
  2712                          ;the same.
  2713                          
  2714                          __MSNTOLSN:
  2715                          LOCL_MSNTOLSN:
  2716  0369  7e                        LD      A,(HL);A = MSN   LSN to be changed
  2717  036a  e6f0                      AND     0F0H;A = MSN   0
  2718  036c  47                        LD      B,A;save in B
  2719  036d  0f                        RRCA;swap nibbles
  2720  036e  0f                        RRCA
  2721  036f  0f                        RRCA
  2722  0370  0f                        RRCA;A = 0     MSN
  2723  0371  b0                        OR      B;A = MSN   MSN
  2724  0372  77                        LD      (HL),A;(HL) = MSN   MSN
  2725  0373  c9                        RET
  2726                          
  2727                          
  2728                          ;*****************************
  2729                          ;*        LOC_ADD816         *
  2730                          ;*****************************
  2731                          
  2732                          ;Adds 8 bit two's complement signed value passed in A to the 16 bit location
  2733                          ;pointed to by HL.
  2734                          
  2735                          __ADD816:
  2736                          LOC_ADD816:
  2737  0374  0600                      LD      B,0;set B for positive value in A
  2738  0376  cb7f                      BIT     7,A;if A is positive
  2739  0378  2801                      JR      Z,POS;skip
  2740                          ;****   LD      B,0FFH                      ;A is neg: extend sign bit thru B
  2741  037a  05                        DEC     B;Added uOS
  2742                          POS:
  2743  037b  86                        ADD     A,(HL);do 8 bit add [and set Carry]
  2744  037c  77                        LD      (HL),A;store result into LSB 16 bit number
  2745  037d  23                        INC     HL;put MSB
  2746  037e  7e                        LD      A,(HL);into A
  2747  037f  88                        ADC     A,B;A = MSB + Carry + B [B is 0 or FF]
  2748  0380  77                        LD      (HL),A;store result into MSB
  2749  0381  2b                        DEC     HL;re-point HL to LSB 16 bit number
  2750  0382  c9                        RET
  2751                          
  2752                          
  2753                          ;*****************************
  2754                          ;*        PT_IX_TO_SxDATA    *
  2755                          ;*****************************
  2756                          
  2757                          ;SONGNO passed in B.
  2758                          ;Point IX to byte 0 in SONGNO's song data area.
  2759                          ;RET with both DE and IX pointing to SxDATA,
  2760                          ;HL pointing to MSB SxDATA entry in LST_OF_SND_ADDRS.
  2761                          
  2762                          PT_IX_TO_SxDATA:
  2763                          
  2764                          ;        * IX & DE := addr of byte 0 in SONGNO's song  data area.
  2765                          ;          HL pointing to MSB SxDATA entry in LST_OF_SND_ADDRS.
  2766                          
  2767  0383  2a0e01                    LD      HL,(PTR_TO_LST_OF_SND_ADDRS);point HL to start LST_OF_SND_ADDRS
  2768  0386  2b                        DEC     HL;init HL for addition
  2769  0387  2b                        DEC     HL
  2770  0388  48                        LD      C,B;form 4 * SONGNO in C
  2771  0389  0600                      LD      B,0
  2772  038b  cb01                      RLC     C
  2773  038d  cb01                      RLC     C
  2774  038f  09                        ADD     HL,BC;HL pts to SxDATA's entry in LST_OF_SND_ADDRS
  2775  0390  5e                        LD      E,(HL);move addr SxDATA to IX thru DE
  2776  0391  23                        INC     HL
  2777  0392  56                        LD      D,(HL)
  2778  0393  d5                        PUSH    DE
  2779  0394  dde1                      POP     IX
  2780  0396  c9                        RET
  2781                          
  2782                          
  2783                          ;*****************************
  2784                          ;*        AREA_SONG_IS       *
  2785                          ;*****************************
  2786                          
  2787                          ;The address of byte 0 of a song data area is passed in IX.  The song number of
  2788                          ;the song using that area is returned in A (0FFH if inactive).  If a special
  2789                          ;effect was using that area, 62 is returned in A and HL is returned with the
  2790                          ;address of the special sound effect routine.
  2791                          
  2792                          AREA_SONG_IS:
  2793  0397  dd7e00                    LD      A,(IX+0);A := CH#   SONGNO or 62, or A := FF
  2794  039a  feff                      CP      0FFH
  2795  039c  c8                        RET     Z;leave with A = FF if area inactive
  2796  039d  e63f                      AND     00111111B;mask CH#
  2797  039f  fe3e                      CP      62
  2798  03a1  c0                        RET     NZ;leave with A = SONGNO if not a special effect (62)
  2799                          
  2800                          ;        special effect. so set HL to addr effect, stored in bytes 1&2
  2801                          
  2802  03a2  dde5                      PUSH    IX;point HL to byte 1
  2803  03a4  e1                        POP     HL
  2804  03a5  23                        INC     HL
  2805  03a6  5e                        LD      E,(HL);save LSB effect addr in E
  2806  03a7  23                        INC     HL;HL to byte 2
  2807  03a8  56                        LD      D,(HL);save MSB effect addr in D
  2808  03a9  eb                        EX      DE,HL;HL := addr special effect
  2809  03aa  c9                        RET
  2810                          
  2811                          ;        END UTIL
  2812                          
  2813                          
  2814                          ;*****************************
  2815                          ;*        INIT_SOUND         *
  2816                          ;*****************************
  2817                          
  2818                          ;See Users' Manual for description; includes ENTRY POINT ALL_OFF
  2819                          ;addr LST_OF_SND_ADDRS passed in HL
  2820                          ;n = # of song data areas to init, passed in B
  2821                          
  2822                          ;        *** Sound chip register code EQUATES ***
  2823                          
  2824                          ;        Tone generator frequency and attenuation formatted register codes
  2825                          
  2826                          SR1FRQ          EQU     10000000B;BIT7 = 1, BIT6-4 = TONE GEN 1 FREQ CODE
  2827                          SR1ATN          EQU     10010000B;BIT7 = 1, BIT6-4 = TONE GEN 1 ATN CODE
  2828                          SR2FRQ          EQU     10100000B;BIT7 = 1, BIT6-4 = TONE GEN 2 FREQ CODE
  2829                          SR2ATN          EQU     10110000B;BIT7 = 1, BIT6-4 = TONE GEN 2 ATN CODE
  2830                          SR3FRQ          EQU     11000000B;BIT7 = 1, BIT6-4 = TONE GEN 3 FREQ CODE
  2831                          SR3ATN          EQU     11010000B;BIT7 = 1, BIT6-4 = TONE GEN 1 ATN CODE
  2832                          
  2833                          ;        Noise generator control and attenuation formatted register codes
  2834                          
  2835                          SRNCTL          EQU     11100000B;BIT7 = 1, BIT6-4 = NOISE GEN CONTROL CODE
  2836                          SRNATN          EQU     11110000B;BIT7 = 1, BIT6-4 = NOISE GEN ATN CODE
  2837                          
  2838                          __SOUND_INIT:
  2839                          ;*** INIT_SOUND
  2840                          
  2841                          ;        * initialize PTR_TO_LST_OF_SND_ADDRS with value passed in HL
  2842                          
  2843  03ab  220e01                    LD      (PTR_TO_LST_OF_SND_ADDRS),HL
  2844                          
  2845                          ;        * store inactive code at byte 0 of each of the n data areas (B = n)
  2846                          
  2847  03ae  23                        INC     HL;pt HL to song 1 data area entry in LST_OF_SND_ADDRS
  2848  03af  23                        INC     HL
  2849  03b0  5e                        LD      E,(HL);pt DE to byte 0 in first song data area
  2850  03b1  23                        INC     HL
  2851  03b2  56                        LD      D,(HL)
  2852  03b3  eb                        EX      DE,HL;pt HL to byte 0 in first song data area
  2853  03b4  110a00                    LD      DE,10;set DE for 10 byte increment
  2854  03b7  3eff                      LD      A,0FFH;Added uOS
  2855                          B1:
  2856  03b9  77                        LD      (HL),A;deactivate area  *** Added uOS
  2857  03ba  19                        ADD     HL,DE;pt HL to byte 0 next area (10 bytes away)
  2858  03bb  10fc                      DJNZ    B1;do this for the n (passed in B) data areas
  2859                          
  2860                          ;        * store end of data area code (0) at first byte after last song data area
  2861                          
  2862  03bd  3600                      LD      (HL),0;store end of data area code in byte 0 data area n + 1
  2863                          
  2864                          ;        * set the 4 channel data area pointers to a dummy, inactive data area
  2865                          
  2866  03bf  21e603                    LD      HL,DUMAREA;point HL to inactive byte below [after the RET]
  2867  03c2  221001                    LD      (PTR_TO_S_ON_0),HL;store addr DUMAREA at PTR_TO_S_ON_0
  2868  03c5  221201                    LD      (PTR_TO_S_ON_1),HL;store addr DUMAREA at PTR_TO_S_ON_1
  2869  03c8  221401                    LD      (PTR_TO_S_ON_2),HL;store addr DUMAREA at PTR_TO_S_ON_2
  2870  03cb  221601                    LD      (PTR_TO_S_ON_3),HL;store addr DUMAREA at PTR_TO_S_ON_3
  2871                          
  2872                          ;        * initialize SAVE_CTRL
  2873                          
  2874                          ;****   LD      A,0FFH                      ;note: this is only time MSN SAVE_CTRL will be non zero,
  2875                          ;****                                      ;Out uOS (loaded earlier)
  2876                          
  2877  03ce  321801                    LD      (SAVE_CTRL),A;thus ensuring PLAY_SONGS will output 1st real CTRL data
  2878                          __TURN_OFF_SOUND:
  2879                          ;*** ALL_OFF
  2880                          
  2881                          ;        * turn off all 4 sound generators
  2882                          
  2883  03d1  3a3000                    LD      A,(SOUNDPORT);Added uOS
  2884  03d4  4f                        LD      C,A;Added uOS
  2885  03d5  3e9f                      LD      A,OFF+SR1ATN;form off code for tone generator 1
  2886  03d7  ed79                      OUT     (C),A;send it out
  2887  03d9  3ebf                      LD      A,OFF+SR2ATN;form off code for tone generator 2
  2888  03db  ed79                      OUT     (C),A;send it out
  2889  03dd  3edf                      LD      A,OFF+SR3ATN;form off code for tone generator 3
  2890  03df  ed79                      OUT     (C),A;send it out
  2891  03e1  3eff                      LD      A,OFF+SRNATN;form off code for noise generator, N
  2892  03e3  ed79                      OUT     (C),A;send it out
  2893  03e5  c9                        RET
  2894                          
  2895  03e6  ff                DUMAREA: DEFB    INACTIVE
  2896                          
  2897                          ;        END INITSOU
  2898                          
  2899                          
  2900                          ;*****************************
  2901                          ;*        JUKE_BOX           *
  2902                          ;*****************************
  2903                          
  2904                          ;See Users' Manual for description
  2905                          ;SONGNO passed in B
  2906                          
  2907                          __PLAY_IT:
  2908                          JUKE_BOX:
  2909                          
  2910                          ;        * RET if song already in progress
  2911                          
  2912  03e7  c5                        PUSH    BC;save SONGNO on stack
  2913  03e8  cd8303                    CALL    PT_IX_TO_SxDATA;point IX to SONGNO's song data area
  2914  03eb  dd7e00                    LD      A,(IX+0);A := CH# [if any]   SONGNO [if any]
  2915  03ee  e63f                      AND     3FH;A := 0 0 SONGNO
  2916  03f0  c1                        POP     BC;B := SONGNO
  2917  03f1  b8                        CP      B;test if already in progress
  2918  03f2  c8                        RET     Z;if so, leave
  2919                          
  2920                          ;        * load first note and set NEXT_NOTE_PTR [thru LOAD_NEXT_NOTE]
  2921                          
  2922  03f3  dd7000                    LD      (IX+0),B;store SONGNO in byte 0
  2923  03f6  2b                        DEC     HL;HL left by PT_IX_TO_SxDATA pointing to MSB SxDATA
  2924  03f7  2b                        DEC     HL;entry in LST_OF_SND_ADDRS point HL to note list
  2925  03f8  56                        LD      D,(HL);starting addr entry in LST_OF_SND_ADDRS and save this
  2926  03f9  2b                        DEC     HL;addr in DE
  2927  03fa  5e                        LD      E,(HL);DE now has the initial value for NEXT_NOTE_PTR
  2928  03fb  dd7301                    LD      (IX+1),E;set NEXT_NOTE_PTR for first note in song
  2929  03fe  dd7202                    LD      (IX+2),D
  2930  0401  cdf204                    CALL    LOAD_NEXT_NOTE;load note. byte 0 := CH# SONGNO, set new NEXT_NOTE_PTR
  2931  0404  1874                      JR      UP_CH_DATA_PTRS;new song. so update channel data ptrs
  2932                          
  2933                          ;        END JUKEBOX
  2934                          
  2935                          
  2936                          ;*****************************
  2937                          ;*        PLAY_SONGS_        *
  2938                          ;*****************************
  2939                          
  2940                          ;        *** Sound chip register code EQUATES
  2941                          
  2942                          ;*** WHITE      EQU     00000100B           ;BIT2 = 1, white noise code
  2943                          ;*** PERIOD     EQU     00000000B           ;BIT2 = 0, periodic noise code
  2944                          ;*** NSRH1      EQU     00000000B           ;BIT0-1 Set for highest noise shift rate (N/512)
  2945                          ;*** NSRMED     EQU     00000001B           ;BIT0-1 Set for medium noise shift rate (N/1024)
  2946                          ;*** NSRLOW     EQU     00000010B           ;BIT0-1 Set for lowest noise shift rate (N/2048)
  2947                          ;*** NSRTG3     EQU     00000011B           ;BIT0-1 Set for shift from tone gen 3 output
  2948                          
  2949                          __SOUNDS:; [RECON] OCR 902/2998: exported implementation label restored.
  2950                          ;*** PLAY_SONGS_
  2951                          
  2952                          ;        * output CH1 attenuation and frequency
  2953                          
  2954  0406  3e9f                      LD      A,OFF+SR1ATN;format CH1 OFF byte into A
  2955  0408  0e90                      LD      C,SR1ATN;format MSN C for CH1 attenuation
  2956  040a  1680                      LD      D,SR1FRQ;format MSN D for CH1 frequency
  2957  040c  dd2a1201                  LD      IX,(PTR_TO_S_ON_1);point IX to byte 0 data area of song for CH1
  2958  0410  cd5604                    CALL    TONE_OUT
  2959                          
  2960                          ;        * output CH2 attenuation and frequency
  2961                          
  2962  0413  3ebf                      LD      A,OFF+SR2ATN;format CH2 OFF byte into A
  2963  0415  0eb0                      LD      C,SR2ATN;format MSN C for CH2 attenuation
  2964  0417  16a0                      LD      D,SR2FRQ;format MSN D for CH2 frequency
  2965  0419  dd2a1401                  LD      IX,(PTR_TO_S_ON_2);point IX to byte 0 data area of song for CH2
  2966  041d  cd5604                    CALL    TONE_OUT
  2967                          
  2968                          ;        * output CH3 attenuation and frequency
  2969                          
  2970  0420  3edf                      LD      A,OFF+SR3ATN;format CH3 OFF byte into A
  2971  0422  0ed0                      LD      C,SR3ATN;format MSN C for CH3 attenuation
  2972  0424  16c0                      LD      D,SR3FRQ;format MSN D for CH3 frequency
  2973  0426  dd2a1601                  LD      IX,(PTR_TO_S_ON_3);point IX to byte 0 data area of song for CH3
  2974  042a  cd5604                    CALL    TONE_OUT
  2975                          
  2976                          ;        * output CH0 [noise] ATN [and CTRL, if different from last time]
  2977                          
  2978  042d  3eff                      LD      A,OFF+SRNATN;format CH0 OFF byte into A
  2979  042f  0ef0                      LD      C,SRNATN;format MSN C for CH0 attenuation
  2980  0431  dd2a1001                  LD      IX,(PTR_TO_S_ON_0);point IX to byte 0 data area of song for CH0
  2981  0435  dd5e00                    LD      E,(IX+0);look for inactive code, OFFH
  2982  0438  1c                        INC     E;this sets Z flag if E = OFFH
  2983  0439  2005                      JR      NZ,L5;if PSW is zero song data area is inactive
  2984  043b  cd0d06                    CALL    OUT_TO_SOUND_PORT; turn off CH0
  2985  043e  1825                      JR      L6;SND_MANAGER
  2986                          
  2987                          ;        ELSE
  2988                          
  2989                          L5:
  2990  0440  cd2803                    CALL    UPAINCTRL;send out current ATN
  2991  0443  dd7e04                    LD      A,(IX+CTRL);LSN A = current CTRL data
  2992  0446  e60f                      AND     0FH;mask MSN
  2993  0448  211801                    LD      HL,SAVE_CTRL;point to last CTRL data sent
  2994  044b  be                        CP      (HL);compare
  2995  044c  2817                      JR      Z,L6;if PSW is zero CTRL has not changed (done)
  2996  044e  77                        LD      (HL),A;SAVE_CTRL = new CTRL data
  2997  044f  0ee0                      LD      C,SRNCTL;send new CTRL data
  2998  0451  cd2803                    CALL    UPAINCTRL
  2999  0454  180f                      JR      L6;SND_MANAGER
  3000                          
  3001                          ;        ENDIF
  3002                          ;        ENDIF
  3003                          
  3004                          TONE_OUT:
  3005  0456  dd5e00                    LD      E,(IX+0);look for inactive code, OFFH
  3006  0459  1c                        INC     E;this sets Z flag if E = OFFH
  3007  045a  2003                      JR      NZ,L7;if PSW is zero song data area is inactive
  3008                          ;****   CALL    OUT_TO_SOUND_PORT           ;turn off CHx
  3009                          ;****   JR      L8
  3010  045c  c30d06                    JP      OUT_TO_SOUND_PORT;turn off CHx
  3011                          
  3012                          ;        ELSE send out current ATN and FREQ
  3013                          
  3014                          L7:
  3015  045f  cd2803                    CALL    UPAINCTRL;send out attenuation
  3016  0462  c33903                    JP      UPFREQ;send out frequency
  3017                          ;****   CALL    UPFREQ                      ;send out frequency
  3018                          L8:
  3019                          ;****   RET
  3020                          ;        ENDIF
  3021                          ;*****************************
  3022                          ;*        SND_MANAGER        *
  3023                          ;*****************************
  3024                          
  3025                          ;See Users' Manual for description
  3026                          
  3027                          L6:
  3028                          SND_MANAGER:
  3029                          
  3030                          ;        * IX := addr of song #1 data area [S1DATA]
  3031                          
  3032  0465  0601                      LD      B,1;pt IX to byte 0 song data area for song # 1
  3033  0467  cd8303                    CALL    PT_IX_TO_SxDATA
  3034                          
  3035                          L1:;LOOP until end of song data areas
  3036  046a  3e00                      LD      A,ENOSDATA;check for end of song data areas
  3037  046c  ddbe00                    CP      (IX+0);set Z flag if inactive
  3038  046f  c8                        RET     Z;leave [Z set], if all data areas have been processed
  3039                          
  3040                          ;        * process active song data areas
  3041                          
  3042  0470  cdcd04                    CALL    PROCESS_DATA_AREA;update counters or call effect get next note
  3043                          
  3044                          ;        * point IX to byte 0 next song data area
  3045                          
  3046  0473  110a00                    LD      DE,10
  3047  0476  dd19                      ADD     IX,DE
  3048  0478  18f0                      JR      L1;REPEAT LOOP
  3049                          
  3050                          
  3051                          ;*****************************
  3052                          ;*        UP_CH_DATA_PTRS     *
  3053                          ;*****************************
  3054                          
  3055                          ;For each active data area, starting with S1DATA and proceeding in order, load
  3056                          ;the associated channel data area pointer [PTR_TO_S_ON_x] with the address of
  3057                          ;byte 0. This routine is called by JUKE_BOX, when a song starts and
  3058                          ;PROCESS_DATA_AREA when the channel using a data area has changed as a result of
  3059                          ;calling LOAD_NEXT_NOTE [this happens when a song finishes and when it switches
  3060                          ;back and forth between noise and tone notes].
  3061                          
  3062                          UP_CH_DATA_PTRS:
  3063  047a  dde5                      PUSH    IX;save curent IX
  3064  047c  21e603                    LD      HL,DUMAREA;set all 4 ch data ptrs to dummy inactive area
  3065  047f  221001                    LD      (PTR_TO_S_ON_0),HL
  3066  0482  221201                    LD      (PTR_TO_S_ON_1),HL
  3067  0485  221401                    LD      (PTR_TO_S_ON_2),HL
  3068  0488  221601                    LD      (PTR_TO_S_ON_3),HL
  3069  048b  0601                      LD      B,1;set IX to byte 0 S1DATA
  3070  048d  cd8303                    CALL    PT_IX_TO_SxDATA;RETs with IX addr byte 0 song 1
  3071                          
  3072                          L2:;LOOP until end of song data areas
  3073  0490  dd7e00                    LD      A,(IX+0);test for end of song data areas
  3074  0493  b7                        OR      A;**** CP      ENOSDATA
  3075  0494  281f                      JR      Z,DONE_SNDMAN;leave loop if all data areas checked
  3076                          
  3077                          
  3078                          
  3079  0496  3c                        INC     A;**** CP      INACTIVE     ;check for inactive data area: don't update ptr if so
  3080  0497  2815                      JR      Z,L9;if PSW is non-zero area is active: update channel data ptrs
  3081  0499  dd7e00                    LD      A,(IX+0);get CH# in A
  3082  049c  e6c0                      AND     0C0H;B7 - B6 in A = CH#
  3083  049e  07                        RLCA;form CH# * 2 in A, i.e., the offset from
  3084  049f  07                        RLCA;PTR_TO_S_ON_0 of the channel data area pointer
  3085  04a0  07                        RLCA;that points to channel CH#
  3086  04a1  5f                        LD      E,A;add offset to addr of PTR_TO_S_ON_0
  3087  04a2  1600                      LD      D,0
  3088  04a4  211001                    LD      HL,PTR_TO_S_ON_0
  3089  04a7  19                        ADD     HL,DE;HL points to proper channel data area pointer
  3090  04a8  dde5                      PUSH    IX;store this song data area's byte 0 addr there
  3091  04aa  d1                        POP     DE
  3092  04ab  73                        LD      (HL),E
  3093  04ac  23                        INC     HL
  3094  04ad  72                        LD      (HL),D
  3095                          
  3096                          ;        ENDIF
  3097                          
  3098                          ;        * point IX to byte 0 next song data area
  3099                          
  3100                          L9:
  3101  04ae  110a00                    LD      DE,10
  3102  04b1  dd19                      ADD     IX,DE
  3103  04b3  18db                      JR      L2;REPEAT LOOP
  3104                          
  3105                          DONE_SNDMAN:
  3106  04b5  dde1                      POP     IX;restore IX
  3107                          ;*** L12
  3108  04b7  c9                        RET
  3109                          
  3110                          
  3111                          ;*****************************
  3112                          ;*        LEAVE_EFFECT       *
  3113                          ;*****************************
  3114                          
  3115                          ;LEAVE_EFFECT, called by a special sound effect routine when it's finished,
  3116                          ;restores the SONGNO of the song to which the effect note belongs to B5 - B0 of
  3117                          ;byte 0 in the effect's data area, and loads bytes 1 and 2 with the address of
  3118                          ;the next note in the song.  The address of the 1 byte SONGNO (saved by the
  3119                          ;effect when first called) is passed in DE.  The 2 byte address of the next note
  3120                          ;in the song, also saved by the effect, is passed in HL.  IX is assumed to be
  3121                          ;pointing to byte 0 of the data area to which the song number is to be restored.
  3122                          ;Bits 7 and 6 of the saved SONGNO are ignored, and therefore may be used by the
  3123                          ;effect to store flag information during the course of the note.
  3124                          
  3125                          __EFFECT_OVER:
  3126                          ;*** LEAVE_EFFECT
  3127  04b8  dd7501                    LD      (IX+1),L;LSB NEXT_NOTE_PTR := LSB addr next note in song
  3128  04bb  dd7402                    LD      (IX+2),H;MSB NEXT_NOTE_PTR := MSB addr next note in song
  3129  04be  1a                        LD      A,(DE);A := x x SONGNO (i.e., the saved, original SONGNO)
  3130  04bf  e63f                      AND     03FH;A := 0 0 SONGNO
  3131  04c1  47                        LD      B,A;B := 0 0 SONGNO (B now = original SONGNO)
  3132  04c2  dd7e00                    LD      A,(IX+0);A := CH#   62 (all effect notes have SONGNO = 62)
  3133  04c5  e6c0                      AND     0C0H;A := CH# 0 0 0 0 0 0
  3134  04c7  b0                        OR      B;A := CH# SONGNO
  3135  04c8  dd7700                    LD      (IX+0),A;restore the song number
  3136  04cb  1816                      JR      EFXOVER
  3137                          
  3138                          
  3139                          ;*****************************
  3140                          ;*        PROCESS_DATA_AREA  *
  3141                          ;*****************************
  3142                          
  3143                          ;See Users' Manual for description
  3144                          ;Terminology: SFX = address of sound effect routine
  3145                          
  3146                          PROCESS_DATA_AREA:
  3147  04cd  cd9703                    CALL    AREA_SONG_IS;return area's SONGNO in A [and addr SFX in HL]
  3148  04d0  feff                      CP      INACTIVE;test for inactive code
  3149  04d2  c8                        RET     Z;RET, no processing if area inactive
  3150                          
  3151                          ;        * if special effect, call it to process the data area
  3152                          
  3153  04d3  fe3e                      CP      62;test for special sound effect
  3154  04d5  2005                      JR      NZ,L10;if PSW is zero data area used by sound effect
  3155  04d7  110700                    LD      DE,7;pt HL to SFX+7, starting adr of the effect's code
  3156  04da  19                        ADD     HL,DE
  3157  04db  e9                        JP      (HL);do 1 pass thru effect, RET from effect
  3158                          
  3159                          ;        ENDIF
  3160                          
  3161                          ;        * else process a non-effect note
  3162                          
  3163                          L10:
  3164  04dc  cdf702                    CALL    ATN_SWEEP;process atn sweep data, if any
  3165  04df  cdc702                    CALL    FREQ_SWEEP;proc frq sweep data, if any, & note dura timer s
  3166                          ;****   JR      NZ,L12                     ;if PSW is zero note is over
  3167  04e2  c0                        RET     NZ
  3168                          EFXOVER:
  3169  04e3  dd7e00                    LD      A,(IX+0);A := CH#   SONGNO this note
  3170  04e6  f5                        PUSH    AF;save on stack
  3171  04e7  cdf204                    CALL    LOAD_NEXT_NOTE;load data for next note
  3172  04ea  c1                        POP     BC;B := CH#   SONGNO previous note
  3173  04eb  dd7e00                    LD      A,(IX+0);A := CH#   SONGNO new note [may be inactive]
  3174  04ee  b8                        CP      B;check against new note's CH#   SONGNO
  3175                          ;****   JR      Z,L12                      ;if PSW is non-zero change to/from tone/efx/noise
  3176  04ef  c8                        RET     Z
  3177  04f0  1888                      JR      UP_CH_DATA_PTRS;to maintain data area priority system
  3178                          
  3179                          ;        ENDIF
  3180                          ;        END SNDMAN
  3181                          
  3182                          ;*****************************
  3183                          ;*        LOAD_NEXT_NOTE     *
  3184                          ;*****************************
  3185                          
  3186                          ;see Users' Manual for description
  3187                          ;SFX refers to the beginning address of a special sound effect routine
  3188                          
  3189                          LOAD_NEXT_NOTE:
  3190                          
  3191                          ;        * deactivate area, save SONGNO on stack
  3192                          
  3193  04f2  dd7e00                    LD      A,(IX+0);A := byte 0
  3194  04f5  e63f                      AND     00111111B;mask CH#, if any
  3195  04f7  f5                        PUSH    AF;save SONGNO on stack
  3196  04f8  dd3600ff                  LD      (IX+0),INACTIVE;deactivate area
  3197                          
  3198                          ;        * A := header new note
  3199                          
  3200  04fc  dd6e01                    LD      L,(IX+1);HL := addr new note in ROM
  3201  04ff  dd6602                    LD      H,(IX+2)
  3202  0502  7e                        LD      A,(HL);A := header new note
  3203                          
  3204                          ;        * save header of new note in song on stack and load its data CASE note type
  3205                          
  3206  0503  47                        LD      B,A;save header new note in B
  3207  0504  cb6f                      BIT     5,A;test for rest
  3208  0506  281c                      JR      Z,L13;if PSW is non-zero note is a rest
  3209                          
  3210                          ;*** REST
  3211  0508  c5                        PUSH    BC;save header on stack
  3212  0509  e61f                      AND     00011111B;mask all but duration bits
  3213                          
  3214                          ;        * set up NEXT_NOTE_PTR
  3215                          
  3216  050b  23                        INC     HL;HL = address of the header of the note after this note
  3217  050c  dd7501                    LD      (IX+1),L;store in NEXT_NOTE_PTR
  3218  050f  dd7402                    LD      (IX+2),H
  3219                          
  3220                          ;        * move this note's data and fill in bytes where necessary
  3221                          
  3222  0512  dd3604f0                  LD      (IX+ATN),0F0H;set atn off ; [RECON] OCR 3277: scan bytes are DD 36 04 F0.
  3223  0516  dd7705                    LD      (IX+NLEN),A;NLEN := 5 bit duration
  3224  0519  dd360700                  LD      (IX+FSTEP),0;indicate freq not to be swept
  3225  051d  dd360800                  LD      (IX+ASTEP),0;indicate atn not to be swept
  3226  0521  c3ec05                    JP      MODBO
  3227                          
  3228                          ;        ENDIF
  3229                          
  3230                          L13:
  3231  0524  cb67                      BIT     4,A;test for end
  3232  0526  280e                      JR      Z,L14;if PSW is non-zero end of song
  3233  0528  cb5f                      BIT     3,A;test for repeat
  3234  052a  2804                      JR      Z,ENDNOREP;if PSW is non-zero repeat song
  3235                          ;*** ENDREP
  3236  052c  c1                        POP     BC;B := SONGNO
  3237  052d  c3e703                    JP      JUKE_BOX;to reload 1st note of this song
  3238                          
  3239                          ;         RET                                 ;to PROCESS_DATA_AREA, don't save header ; [RECON] OCR 3294 is a commented historical instruction, not executable code.
  3240                          ;        ENDIF
  3241                          
  3242                          ENDNOREP:
  3243  0530  3eff                      LD      A,INACTIVE
  3244  0532  f5                        PUSH    AF;save inactive code to end song
  3245  0533  c3ec05                    JP      MODBO;to load byte 0
  3246                          
  3247                          ;        ENDIF
  3248                          ;        - test for special sound effect
  3249                          
  3250                          L14:
  3251  0536  e63c                      AND     00111100B;mask irrelevant bits
  3252  0538  fe04                      CP      00000100B;test for B5 - B2 = 0001
  3253  053a  2027                      JR      NZ,L15;if PSW is zero note is a special effect
  3254                          ;*** EFFECT
  3255  053c  fde1                      POP     IY;IY := SONGNO
  3256  053e  fde5                      PUSH    IY;put SONGNO back on stack
  3257  0540  c5                        PUSH    BC;save header on stack NEXT_NOTE_PTR := SFX, DE := SFX
  3258  0541  23                        INC     HL;pt HL to next byte [LSB addr SFX]
  3259  0542  5e                        LD      E,(HL);E := LSB SFX
  3260  0543  dd7301                    LD      (IX+1),E;put LSB of SFX in byte 1 of SxDATA [NEXT_NOTE_PTR]
  3261  0546  23                        INC     HL;pt HL to MSB SFX
  3262  0547  56                        LD      D,(HL);D := MSB SFX
  3263  0548  dd7202                    LD      (IX+2),D;put MSB SFX in byte 2 of SxDATA
  3264  054b  23                        INC     HL;point HL to next note [after this new note]
  3265  054c  fde5                      PUSH    IY;A := SONGNO
  3266  054e  f1                        POP     AF
  3267  054f  d5                        PUSH    DE;IY := SFX
  3268  0550  fde1                      POP     IY
  3269  0552  115805                    LD      DE,PASS1;create "CALL (IY)" with RET to PASS1 by storing
  3270  0555  d5                        PUSH    DE;PASS1 on the stack
  3271  0556  fde9                      JP      (IY);1st 7 bytes SFX will save addr next note & SONGNO
  3272                          PASS1:
  3273  0558  110700                    LD      DE,7;in same fashion, create a "CALL (IY+7)"
  3274  055b  fd19                      ADD     IY,DE;to allow SFX to load initial values
  3275  055d  11ec05                    LD      DE,MODBO;RET to MODBO
  3276  0560  d5                        PUSH    DE
  3277  0561  fde9                      JP      (IY)
  3278                          
  3279                          ;        ENDIF
  3280                          
  3281                          ;        - if here, note is type 0 - 3
  3282                          
  3283                          L15:
  3284  0563  c5                        PUSH    BC;save header on stack
  3285  0564  78                        LD      A,B;A := fresh copy header
  3286  0565  e603                      AND     00000011B;mask all but type number
  3287  0567  b7                        OR      A;test for type 0
  3288  0568  2020                      JR      NZ,L16;if PSW is zero note is type 0: fixed freq and atn
  3289                          
  3290                          ;*** TYPE0                         ;set up NEXT_NOTE_PTR
  3291  056a  23                        INC     HL;next note [after this new note] is 4 bytes away,
  3292  056b  23                        INC     HL;point HL to it
  3293  056c  23                        INC     HL
  3294  056d  23                        INC     HL
  3295  056e  dd7501                    LD      (IX+1),L;put addr in NEXT_NOTE_PTR
  3296  0571  dd7402                    LD      (IX+2),H
  3297                          
  3298                          ;        * move new note data and fill in bytes where necessary
  3299                          
  3300  0574  2b                        DEC     HL;point HL back to 1st ROM data to move, NLEN
  3301  0575  110500                    LD      DE,05;point DE to destination: bytes 5, 4, and 3
  3302  0578  cd0306                    CALL    DE_TO_DEST
  3303  057b  010300                    LD      BC,3;move 3 bytes
  3304  057e  edb8                      LDDR
  3305  0580  dd360700                  LD      (IX+FSTEP),0;set for no freq sweep
  3306  0584  dd360800                  LD      (IX+ASTEP),0;set for no atn sweep
  3307  0588  1862                      JR      MODBO
  3308                          
  3309                          ;        ENDIF
  3310                          
  3311                          L16:
  3312  058a  fe01                      CP      1;test for type 1
  3313  058c  201a                      JR      NZ,L17;if PSW is zero note is type 1: swept
  3314                          ; freq, fixed attenuation
  3315                          ;*** TYPE1                         ;set up NEXT_NOTE_PTR
  3316  058e  110600                    LD      DE,6;note after this note is 6 bytes away,
  3317  0591  19                        ADD     HL,DE;pt HL to it
  3318  0592  dd7501                    LD      (IX+1),L;store in NEXT_NOTE_PTR
  3319  0595  dd7402                    LD      (IX+2),H
  3320                          
  3321                          ;        * move new note data and fill in bytes where necessary
  3322                          
  3323  0598  2b                        DEC     HL;point HL back to 1st ROM data to move, FSTEP
  3324  0599  1c                        INC     E;E: point DE to destination: bytes 7 - 3
  3325  059a  cd0306                    CALL    DE_TO_DEST
  3326  059d  010500                    LD      BC,5;move 5 bytes
  3327  05a0  edb8                      LDDR
  3328  05a2  dd360800                  LD      (IX+ASTEP),0;set for no atn sweep
  3329  05a6  1844                      JR      MODBO
  3330                          
  3331                          ;        ENDIF
  3332                          
  3333                          L17:
  3334  05a8  fe02                      CP      2;test for type 2
  3335  05aa  2026                      JR      NZ,TYPE3;if PSW is zero note is type 2: fixed freq, swept attenuation
  3336                          ;*** TYPE2                         ;set up NEXT_NOTE_PTR
  3337  05ac  110600                    LD      DE,6;pt HL to note after this note, since it's 6 bytes away.
  3338  05af  19                        ADD     HL,DE;pt HL to it by adding 6
  3339  05b0  f1                        POP     AF;A := header this note [CH#   SONGNO]
  3340  05b1  f5                        PUSH    AF;put back on stack
  3341  05b2  e6c0                      AND     11000000B;mask SONGNO, leaving CH#
  3342  05b4  2001                      JR      NZ,L18;if PSW is zero this is a noise note, which is only 5 ROM bytes long
  3343  05b6  2b                        DEC     HL;so move HL back 1 byte
  3344                          
  3345                          ;        ENDIF
  3346                          
  3347                          L18:
  3348  05b7  dd7501                    LD      (IX+1),L;put addr in NEXT_NOTE_PTR
  3349  05ba  dd7402                    LD      (IX+2),H
  3350                          
  3351                          ;        * move new note data and fill in bytes where necessary
  3352                          
  3353  05bd  2b                        DEC     HL;point HL back to 1st ROM data to move, APS
  3354  05be  1e09                      LD      E,9;point DE to destination: bytes 9,8,5 - 3
  3355  05c0  cd0306                    CALL    DE_TO_DEST
  3356  05c3  010200                    LD      BC,2;move 2 bytes
  3357  05c6  edb8                      LDDR;when done, DE points to FSTEP, HL to ROM NLEN
  3358  05c8  af                        XOR     A
  3359  05c9  12                        LD      (DE),A;FSTEP := 0 for no freq sweep
  3360  05ca  1b                        DEC     DE;pt DE to RAM NLEN
  3361  05cb  1b                        DEC     DE
  3362  05cc  0e03                      LD      C,3;move last 3 ROM bytes if this is a noise note, garbage
  3363  05ce  edb8                      LDDR;will be loaded into byte 3, buts that's OK
  3364  05d0  181a                      JR      MODBO
  3365                          
  3366                          ;        ENDIF
  3367                          
  3368                          ;        if here, note is type 3: swept freq, swept attenuation
  3369                          
  3370                          TYPE3:;set up NEXT_NOTE_PTR
  3371  05d2  110800                    LD      DE,8;note after this note is 8 bytes away.
  3372  05d5  19                        ADD     HL,DE;pt HL to it
  3373  05d6  dd7501                    LD      (IX+1),L;put addr in NEXT_NOTE_PTR
  3374  05d9  dd7402                    LD      (IX+2),H
  3375                          
  3376                          ;        * move new note data and fill in bytes where necessary
  3377                          
  3378  05dc  2b                        DEC     HL;point HL back to 1st ROM data to move, APS
  3379  05dd  dde5                      PUSH    IX;point DE to destination: bytes 9 - 3
  3380  05df  fde1                      POP     IY;IY := addr byte 0 [and DE = 6]
  3381  05e1  1c                        INC     E;DE := 9
  3382  05e2  fd19                      ADD     IY,DE;IY := addr byte 9 [APS]
  3383  05e4  fde5                      PUSH    IY
  3384  05e6  d1                        POP     DE;DE := addr APS
  3385  05e7  010700                    LD      BC,7;move 7 bytes
  3386  05ea  edb8                      LDDR
  3387                          
  3388                          ;        * modify byte 0 basis header new note
  3389                          
  3390                          MODBO:
  3391  05ec  dde5                      PUSH    IX;pt HL to byte 0
  3392  05ee  e1                        POP     HL
  3393  05ef  f1                        POP     AF;A := header new note
  3394  05f0  c1                        POP     BC;B := SONGNO
  3395  05f1  feff                      CP      INACTIVE;test for inactive [song over, as detected above]
  3396  05f3  c8                        RET     Z
  3397  05f4  57                        LD      D,A;save header in D
  3398  05f5  e63f                      AND     3FH;Rid channel bits
  3399  05f7  fe04                      CP      04;Special effect
  3400  05f9  2002                      JR      NZ,L20_LOAD_NEX
  3401  05fb  063e                      LD      B,62
  3402                          
  3403                          L20_LOAD_NEX:
  3404  05fd  7a                        LD      A,D;restore A to header
  3405  05fe  e6c0                      AND     0C0H;A := CH# 0 0 0 0 0 0
  3406  0600  b0                        OR      B;A := new CH#   SONGNO
  3407  0601  77                        LD      (HL),A;store back in byte 0
  3408                          
  3409                          ;        ENDIF
  3410                          
  3411                          ;*** L19
  3412  0602  c9                        RET
  3413                          
  3414                          DE_TO_DEST:
  3415  0603  dde5                      PUSH    IX;DE passed = offset from byte 0, RETed w addr byte offset
  3416  0605  fde1                      POP     IY;IY := addr byte 0 [and DE = offset]
  3417  0607  fd19                      ADD     IY,DE;IY := addr byte 0 + offset
  3418  0609  fde5                      PUSH    IY
  3419  060b  d1                        POP     DE;DE := addr of destination byte in SxDATA
  3420  060c  c9                        RET
  3421                          
  3422                          ;        END LOADNEX
  3423                          
  3424                          ;--------------------------------------------------------------------
  3425                          ;
  3426                          ; Out_to_sound_port
  3427                          ;             input:   a=sound port data to output
  3428                          ;             register usage:  n.a.
  3429                          ;
  3430                          OUT_TO_SOUND_PORT:
  3431  060d  c5                        PUSH    BC;SAVE BC
  3432  060e  47                        LD      B,A;THE IDEA IS TO GET THE
  3433  060f  3a3000                    LD      A,(SOUNDPORT);INDIRECT PORT ADDRESSING
  3434  0612  4f                        LD      C,A;THRU THE PORT TABLE IN EOS
  3435  0613  ed41                      OUT     (C),B
  3436  0615  78                        LD      A,B
  3437  0616  c1                        POP     BC
  3438  0617  c9                        RET
  3439                          ;
  3440                          ;====================================================================
  3441                          ;====================================================================
  3442                          ;====================================================================
  3443                          ;
  3444                          
  3445                          ;GLB    __QUERY_FILE,__SET_FILE,__MAKE_FILE
  3446                          ;GLB    __FILE_QUERY
  3447                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  3448                          ;EXT    SCAN_FOR_FILE
  3449                          ;EXT    BLOCKS_REQ,USER_BUF,USER_NAME
  3450                          ;EXT    BUF_START,BUF_END
  3451                          ;EXT    STRCMP,BASECMP
  3452                          ;EXT    NEW_HOLE_SIZE,NEW_HOLE_START,HOLE_FILE_NAME
  3453                          ;EXT    EOS_YEAR,EOS_MONTH,EOS_DAY
  3454                          ;EXT    BLK_STRT_PTR,VOL_BLK_SZ      ;DLS(8/29/83)
  3455                          ;EXT    READ_BLOCK,WRITE_BLOCK_CHECK_IF_DIRECTORY
  3456                          ;EXT    DIR_BLOCK_NO,FOUND_AVAIL_ENT ; [RECON] Identifier repair: active OCR definition at 549 is FOUND_AVAIL_ENT.
  3457                          ;EXT    FILENAME_CMPS
  3458                          
  3459                          ;--------------------------------------------------------------------
  3460                          ;
  3461                          ; __QUERY_FILE -- Read the file's directory entry. (USES STRCMP FOR FILE NAME COMPARISIONS)
  3462                          ; __FILE_QUERY -- SAME AS ABOVE BUT SETS UP SCAN_FOR_FILE FOR BASE COMPARES ( USES BASECMP)
  3463                          ;
  3464                          ; CALLING PARAMETERS: Device number in A
  3465                          ;                     address of name string in DE
  3466                          ;                     address of buffer in HL
  3467                          ;
  3468                          ; EXIT PARAMETERS: if no errors -- Z = 1; A = 0; BCDE = file's start block;
  3469                          ;                  directory entry in caller's buffer
  3470                          ;                  if errors -- Z = 0; A = error code; DE = junk;
  3471                          ;                  caller's buffer undefined
  3472                          ;
  3473                          ;--------------------------------------------------------------------
  3474                          
  3475                          __FILE_QUERY:
  3476  0618  37                        SCF; THIS ENTRY DOES NOTHING MORE THAN SET CARRY FLAG
  3477  0619  1802                      JR      QUEER
  3478                          
  3479                          __QUERY_FILE:
  3480  061b  37                        SCF; THIS ENTRY CLEARS CARRY FLAG
  3481  061c  3f                        CCF
  3482                          QUEER:
  3483  061d  e5                        PUSH    HL;SAVE REG'S
  3484  061e  dde5                      PUSH    IX
  3485                          
  3486  0620  f5                        PUSH    AF
  3487                          
  3488  0621  3801                      JR      C,SET_UP_A; DID WE COME IN AT FILE_QUERY
  3489                          
  3490  0623  af                        XOR     A; USE STRCMP FOR FILE NAME COMPARE
  3491                          SET_UP_A:
  3492  0624  327800                    LD      (FILENAME_CMPS),A; 0 = COMPARE COMPLETE FILE NAME
  3493                          ; NOT 0 - COMPARE ONLY THE BASE
  3494  0627  f1                        POP     AF
  3495                          
  3496  0628  22a600                    LD      (USER_BUF),HL;SAVE USER'S DATA ADDRESS
  3497                          
  3498  062b  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);POINT TO SYSTEM'S FCB
  3499  062f  62                        LD      H,D;GET NAME POINTER IN HL
  3500  0630  6b                        LD      L,E
  3501  0631  cd0b0f                    CALL    SCAN_FOR_FILE;LOOK IN TH' 'RECTORY
  3502  0634  2017                      JR      NZ,Q_ERROR;BRANCH IF ERROR RETURNED
  3503                          
  3504  0636  d5                        PUSH    DE;SAVE START BLOCK OF FILE
  3505  0637  c5                        PUSH    BC
  3506                          
  3507  0638  ed5ba600                  LD      DE,(USER_BUF);GET BUFFER ADDRESS IN DE
  3508  063c  dd6e21                    LD      L,(IX+FCB_POINTER);GET ADDR OF ENTRY IN HL
  3509  063f  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3510  0642  011700                    LD      BC,DIR_ENT_LENGTH-3;SET BYTE COUNT TO LOAD ONLY VALID INFO THAT
  3511                          ;THAT WAS STORED ON THE DEVICE
  3512                          
  3513  0645  edb0                      LDIR;COPY DATA TO CALLER'S BUFFER
  3514                          
  3515  0647  c1                        POP     BC;GET FILE'S START BLOCK
  3516  0648  d1                        POP     DE
  3517                          
  3518  0649  af                        XOR     A;SHOW NO ERROR
  3519  064a  327800                    LD      (FILENAME_CMPS),A; DEFAULT FOR SCAN FOR FILE
  3520                          Q_ERROR:
  3521  064d  dde1                      POP     IX;RESTORE REG'S
  3522  064f  e1                        POP     HL
  3523  0650  c9                        RET
  3524                          
  3525                          ;--------------------------------------------------------------------
  3526                          ;
  3527                          ; __SET_FILE -- Re-write the file's directory entry.
  3528                          ;
  3529                          ; CALLING PARAMETERS: Device number in A
  3530                          ;                     address of name string in DE
  3531                          ;                     address of buffer in HL
  3532                          ;
  3533                          ; EXIT PARAMETERS: if no errors -- Z = 1; A = 0;
  3534                          ;                  directory entry updated
  3535                          ;                  if errors -- Z = 0; A = error code;
  3536                          ;                  directory entry unchanged
  3537                          ;
  3538                          ;--------------------------------------------------------------------
  3539                          
  3540                          __SET_FILE:
  3541  0651  c5                        PUSH    BC;SAVE REG'S
  3542  0652  d5                        PUSH    DE
  3543  0653  e5                        PUSH    HL
  3544  0654  dde5                      PUSH    IX
  3545  0656  22a600                    LD      (USER_BUF),HL;SAVE ADDR OF USER'S DATA
  3546                          
  3547  0659  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);POINT TO SYSTEM'S FCB
  3548                          
  3549  065d  62                        LD      H,D;GET STRING ADDRESS IN HL
  3550  065e  6b                        LD      L,E
  3551  065f  cd0b0f                    CALL    SCAN_FOR_FILE;GET THE DIR ENTRY
  3552  0662  2026                      JR      NZ,S_ERROR;BRANCH IF ERROR
  3553                          
  3554  0664  2aa600                    LD      HL,(USER_BUF);GET BUFFER ADDRESS
  3555  0667  dd5e21                    LD      E,(IX+FCB_POINTER);GET ENTRY ADDR IN DE
  3556  066a  dd5622                    LD      D,(IX+FCB_POINTER+1)
  3557  066d  011700                    LD      BC,DIR_ENT_LENGTH-3;SET BYTE COUNT
  3558  0670  edb0                      LDIR;COPY THEIR BUFFER TO BLOCK BUFFER
  3559                          
  3560                          TAPE_TIMED_OUT:
  3561  0672  dd7e17                    LD      A,(IX+FCB_DEVICE);SET DEVICE NUMBER
  3562  0675  2a9f00                    LD      HL,(FCB_DATA_ADDR);GET ADDR OF MY BUFFER
  3563  0678  dd5e19                    LD      E,(IX+FCB_BLOCK);GET BLOCK ADDRESS IN BCDE
  3564  067b  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3565  067e  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  3566  0681  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  3567  0684  cde611                    CALL    WRITE_BLOCK;RE-WRITE THE DIRECTORY BLOCK
  3568                          
  3569  0687  2001                      JR      NZ,WRITE_ERRORS
  3570  0689  af                        XOR     A;SHOW NO ERRORS
  3571                          
  3572                          WRITE_ERRORS:
  3573                          S_ERROR:
  3574                          
  3575  068a  dde1                      POP     IX;RESTORE REG'S
  3576  068c  e1                        POP     HL
  3577  068d  d1                        POP     DE
  3578  068e  c1                        POP     BC
  3579  068f  c9                        RET
  3580                          
  3581                          ;--------------------------------------------------------------------
  3582                          ;
  3583                          ; __MAKE_FILE: creates a file in the directory.
  3584                          ;
  3585                          ; ENTRY PARAMETERS: called with device ID in A; address of name
  3586                          ;                   string in HL; file size (in bytes) in BC DE.
  3587                          ;
  3588                          ; NOTE:  IF FILE SIZE = 0 (BC DE), THEN THE REMAINDER OF THE TAPE IS
  3589                          ;        ALLOCATED TO THE FILE
  3590                          ;
  3591                          ; EXIT PARAMETERS: CONDITION FLAGS
  3592                          ;                  Z  -   NO ERRORS
  3593                          ;                  NZ -   ERRORS
  3594                          ;                         A = ERROR CODE
  3595                          ;
  3596                          ;        ALL REGISTERS ARE PRESERVED EXCEPT AF
  3597                          ;
  3598                          ;--------------------------------------------------------------------
  3599                          
  3600                          FOUND_ENTRY     EQU     0; BIT INDICATING DELETED FILE FOUND FOR OVERLAYING
  3601                          
  3602                          __MAKE_FILE:
  3603  0690  fde5                      PUSH    IY;SAVE REGISTERS
  3604  0692  dde5                      PUSH    IX
  3605  0694  e5                        PUSH    HL
  3606  0695  d5                        PUSH    DE
  3607  0696  c5                        PUSH    BC
  3608                          
  3609  0697  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);POINT TO SYSTEM FCB
  3610  069b  dd361800                  LD      (IX+FCB_MODE),0; INIT IT IN CASE IT WAS SET
  3611                          
  3612  069f  dd7717                    LD      (IX+FCB_DEVICE),A;SAVE DEVICE NUMBER
  3613  06a2  22b000                    LD      (USER_NAME),HL;SAVE POINTER TO NAME
  3614                          
  3615  06a5  78                        LD      A,B; CHECK IF TO ALLOCATE REST OF TAPE
  3616  06a6  b1                        OR      C
  3617  06a7  200a                      JR      NZ,GOT_FILE_SIZE; NOPE, GOT SIZE
  3618                          
  3619  06a9  7b                        LD      A,E
  3620  06aa  b2                        OR      D
  3621  06ab  2006                      JR      NZ,GOT_FILE_SIZE
  3622  06ad  ddcb18ee                  SET     MODE_REMAINDER_BIT,(IX+FCB_MODE); FLAG IT
  3623                          
  3624  06b1  1820                      JR      SET_UP_DIR
  3625                          
  3626                          
  3627                          ; SINCE WE ARE CALLED WITH A BYTE COUNT, DIVIDE IT BY 1024
  3628                          ; (SHIFT RIGHT 10 BITS) TO GET A BLOCK COUNT.
  3629                          
  3630                          GOT_FILE_SIZE:
  3631  06b3  5a                        LD      E,D;DO A QUICK SHIFT BY 8
  3632  06b4  51                        LD      D,C
  3633  06b5  48                        LD      C,B
  3634  06b6  0600                      LD      B,0
  3635  06b8  cb39                      SRL     C;SHIFT ONE MORE
  3636  06ba  cb1a                      RR      D
  3637  06bc  cb1b                      RR      E
  3638  06be  cb39                      SRL     C;THEN ONE LAST TIME
  3639  06c0  cb1a                      RR      D
  3640  06c2  cb1b                      RR      E
  3641                          
  3642                          ; FOR THIS TO BE A LEGAL FILE SIZE, IT MUST FIT INTO DE.
  3643                          
  3644  06c4  79                        LD      A,C;CHECK FOR TOO BIG
  3645  06c5  b7                        OR      A
  3646  06c6  c29209                    JP      NZ,TOO_BIG;JUMP IF TOO BEEG, SENOR
  3647  06c9  13                        INC     DE;ROUND UP IN CASE THERE WAS A FRACTION
  3648  06ca  7b                        LD      A,E;CHECK FOR TOO BIG AGAIN
  3649  06cb  b2                        OR      D
  3650  06cc  ca9209                    JP      Z,TOO_BIG
  3651  06cf  ed53ac00                  LD      (BLOCKS_REQ),DE;ELSE SAVE THE BLOCK COUNT
  3652                          
  3653                          SET_UP_DIR:
  3654  06d3  110000                    LD      DE,0; ZERO OUT HI ADDRESS
  3655  06d6  ed53ae00                  LD      (BLOCKS_REQ+2),DE
  3656  06da  ed537900                  LD      (DIR_BLOCK_NO),DE
  3657  06de  af                        XOR     A
  3658  06df  327b00                    LD      (FOUND_AVAIL_ENT),A; [RECON] Identifier repair: operand bytes address FOUND_AVAIL_ENT at $FDDB.
  3659                          
  3660  06e2  dd361901                  LD      (IX+FCB_BLOCK),1;INIT NUMBER OF FIRST DIR BLOCK
  3661  06e6  dd771a                    LD      (IX+FCB_BLOCK+1),A; ZERO IT OUT
  3662  06e9  dd771b                    LD      (IX+FCB_BLOCK+2),A
  3663  06ec  dd771c                    LD      (IX+FCB_BLOCK+3),A
  3664                          
  3665  06ef  dd360d01                  LD      (IX+FCB_START_BLOCK),1;INIT NUMBER OF FIRST DIR BLOCK
  3666  06f3  dd770e                    LD      (IX+FCB_START_BLOCK+1),A
  3667  06f6  dd770f                    LD      (IX+FCB_START_BLOCK+2),A
  3668  06f9  dd7710                    LD      (IX+FCB_START_BLOCK+3),A
  3669                          
  3670  06fc  ed5b9f00                  LD      DE,(FCB_DATA_ADDR);INIT POINTER TO BUFFER
  3671  0700  dd7321                    LD      (IX+FCB_POINTER),E
  3672  0703  dd7222                    LD      (IX+FCB_POINTER+1),D
  3673                          
  3674  0706  ed53a800                  LD      (BUF_START),DE;ALSO INIT HERE WITH SAME
  3675  070a  210004                    LD      HL,1024;CALC ADDR OF END OF BUFFER TOO
  3676  070d  19                        ADD     HL,DE
  3677  070e  22aa00                    LD      (BUF_END),HL;AND SAVE IT
  3678                          
  3679                          ;THIS LABEL NOT USED IN THIS ROUTINE, NOT DECLARED GLOBAL
  3680                          ;REMOVED BECAUSE IT CONFLICTS WITH IDENTICAL LABEL ELSEWHERE
  3681                          ;READ_TIMEOUT:
  3682  0711  dd7e17                    LD      A,(IX+FCB_DEVICE);GET PARAMETERS FROM FCB
  3683  0714  dd6e21                    LD      L,(IX+FCB_POINTER)
  3684  0717  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3685  071a  dd5e19                    LD      E,(IX+FCB_BLOCK)
  3686  071d  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3687  0720  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  3688  0723  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  3689  0726  cd7b11                    CALL    READ_BLOCK;THEN READ THE FIRST BLOCK
  3690                          
  3691  0729  c28909                    JP      NZ,MAKE_ERROR;BRANCH IF ERROR
  3692                          
  3693                          SET_UP_FCB:
  3694  072c  fd2a9f00                  LD      IY,(FCB_DATA_ADDR);POINT     THE BUFFER
  3695                          ;
  3696  0730  fd7e0c                    LD      A,(IY+VOL_DIRSIZE);GET THE DIR SIZE BYTE
  3697  0733  e67f                      AND     7FH;ZERO THE PERM BIT
  3698                          ;       INC     A                       ;BECAUSE WE START IN BLOCK 1
  3699                          ;       DEC     A                       ;TO SOLVE PICKET FENCE PROBLEM
  3700  0735  dd771d                    LD      (IX+FCB_LAST_BLOCK),A;SET THE LAST BLOCK #
  3701  0738  dd361e00                  LD      (IX+FCB_LAST_BLOCK+1),0;OTHER BYTES WILL BE ZERO
  3702  073c  dd361f00                  LD      (IX+FCB_LAST_BLOCK+2),0
  3703  0740  dd362000                  LD      (IX+FCB_LAST_BLOCK+3),0
  3704                          
  3705  0744  cd3510                    CALL    CHECK_IF_DIRECTORY; CHECK IF DIRECTORY EXISTS
  3706  0747  c28909                    JP      NZ,MAKE_ERROR
  3707                          
  3708  074a  0626                      LD      B,ENT_PER_BLOCK-1;INIT ENTRY COUNT, ALLOW FOR VOL ID
  3709                          
  3710                          NEXT_ENT:
  3711  074c  dd6e21                    LD      L,(IX+FCB_POINTER);GET CURRENT POINTER
  3712  074f  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3713  0752  111a00                    LD      DE,DIR_ENT_LENGTH;GET LENGTH OF AN ENTRY
  3714  0755  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT ENTRY
  3715  0756  dd7521                    LD      (IX+FCB_POINTER),L;AND SAVE IT AGAIN
  3716  0759  dd7422                    LD      (IX+FCB_POINTER+1),H
  3717                          
  3718                          CHECK_ENT:
  3719  075c  dd6e21                    LD      L,(IX+FCB_POINTER);GET POINTER INTO IY THE LONG WAY
  3720  075f  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3721  0762  e5                        PUSH    HL
  3722  0763  fde1                      POP     IY;!!!
  3723                          
  3724  0765  fd7e0c                    LD      A,(IY+DIR_ATTR);GET THE ATTRIBUTE BYTE FOR THIS ENTRY
  3725  0768  4f                        LD      C,A;SAVE IT HERE FOR NOW
  3726  0769  cb47                      BIT     ATTR_HOLE_BIT,A;CHECK IF HOLE
  3727  076b  c20708                    JP      NZ,FOUND_HOLE;BRANCH IF IT'S A HOLE!!! <<------
  3728                          
  3729  076e  ddcb186e                  BIT     MODE_REMAINDER_BIT,(IX+FCB_MODE); DO WE ALLOCATE REST OF TAPE?
  3730  0772  2037                      JR      NZ,D_FILE;YUP. DON'T BOTHER CHECKING
  3731                          
  3732  0774  cb51                      BIT     ATTR_DEL_BIT,C;IS IT A DELETED FILE?
  3733  0776  2824                      JR      Z,ACTIVE_FILE;NOPE. AN ACTIVE ONE
  3734                          
  3735                          ;       LET'S LOOK FOR DELETED FILE TO USE
  3736                          
  3737  0778  fd6e11                    LD      L,(IY+DIR_MAX_LENGTH); GET ALLOCATED SIZE
  3738  077b  fd6612                    LD      H,(IY+DIR_MAX_LENGTH+1)
  3739                          
  3740  077e  ed5bac00                  LD      DE,(BLOCKS_REQ); MIN NO OF BLOCKS NEEDED
  3741  0782  b7                        OR      A;clear carry flag
  3742  0783  ed52                      SBC     HL,DE; WILL WE FIT?
  3743  0785  3824                      JR      C,D_FILE; NOPE. LOOK FOR ANOTHER ENTRY
  3744                          
  3745  0787  217b00                    LD      HL,FOUND_AVAIL_ENT; FLAG BYTE ; [RECON] Identifier repair: operand bytes address FOUND_AVAIL_ENT at $FDDB.
  3746  078a  cb46                      BIT     FOUND_ENTRY,(HL); DO WE ALREADY HAVE FIRST FIT?
  3747  078c  201d                      JR      NZ,D_FILE; YUP. DON'T EVEN CONSIDER THIS ONE
  3748                          
  3749  078e  cbc6                      SET     FOUND_ENTRY,(HL)
  3750  0790  dd5e19                    LD      E,(IX+FCB_BLOCK);GET BLOCK NO OF THIS DIRECTORY
  3751  0793  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3752                          
  3753  0796  ed537900                  LD      (DIR_BLOCK_NO),DE; SAVE IT
  3754  079a  180f                      JR      D_FILE
  3755                          
  3756                          
  3757                          ; IF THIS IS A REAL FILE, WE CAN SEE IF ITS NAME MATCHES THE
  3758                          ; ONE WE ARE ABOUT TO MAKE -- IT'S AN ERROR IF SO.
  3759                          
  3760                          ACTIVE_FILE:
  3761  079c  dd5e21                    LD      E,(IX+FCB_POINTER);POINT TO THIS ENTRY
  3762  079f  dd5622                    LD      D,(IX+FCB_POINTER+1)
  3763  07a2  2ab000                    LD      HL,(USER_NAME);POINT TO DESIRED NAME
  3764  07a5  cd0000                    CALL    BASECMP;COMPARE THE BASE OF THE FILENAMES
  3765  07a8  ca9609                    JP      Z,FILE_EXISTS;BRANCH IF THEY'RE THE SAME
  3766                          D_FILE:
  3767  07ab  109f                      DJNZ    NEXT_ENT;ELSE GO TO NEXT ENTRY (IF IT EXISTS)
  3768                          
  3769  07ad  2aa800                    LD      HL,(BUF_START);IF NOT RESET FCB FOR NEXT BLOCK
  3770  07b0  dd7521                    LD      (IX+FCB_POINTER),L
  3771  07b3  dd7422                    LD      (IX+FCB_POINTER+1),H
  3772  07b6  dd3419                    INC     (IX+FCB_BLOCK);INC THE BLOCK -- NO CARRY OUT
  3773                          
  3774                          ; DO 4-BYTE COMPARE OF FCB_BLOCK VS FCB_LAST_BLOCK TO SEE
  3775                          ; IF THERE'S MORE FILE LEFT.
  3776                          
  3777  07b9  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3);COMPARE MS BYTES
  3778  07bc  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  3779  07bf  dafd07                    JP      C,FULL_DIR;BRANCH IF BLOCK IS LARGER
  3780  07c2  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2);COMPARE NEXT BYTES
  3781  07c5  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  3782  07c8  dafd07                    JP      C,FULL_DIR;BRANCH IF BLOCK IS LARGER
  3783  07cb  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1);COMPARE NEXT BYTES
  3784  07ce  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  3785  07d1  dafd07                    JP      C,FULL_DIR;BRANCH IF BLOCK IS LARGER
  3786  07d4  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK+0);COMPARE LS BYTES
  3787  07d7  ddbe19                    CP      (IX+FCB_BLOCK+0)
  3788  07da  dafd07                    JP      C,FULL_DIR;BRANCH IF BLOCK IS LARGER
  3789                          ; IF WE FALL OUT, FCB_BLOCK <= FCB_LAST_BLOCK.
  3790                          DO_READ_AGAIN:
  3791                          
  3792  07dd  dd7e17                    LD      A,(IX+FCB_DEVICE);SET UP THE PARAMETERS
  3793  07e0  dd6e21                    LD      L,(IX+FCB_POINTER)
  3794  07e3  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3795  07e6  dd5e19                    LD      E,(IX+FCB_BLOCK)
  3796  07e9  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3797  07ec  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  3798  07ef  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  3799  07f2  cd7b11                    CALL    READ_BLOCK;AND READ THE NEXT BLOCK OF ENTRIES
  3800  07f5  c28909                    JP      NZ,MAKE_ERROR; NOPE, A REAL ERROR
  3801                          
  3802                          NO_TIMEOUT:
  3803  07f8  0627                      LD      B,ENT_PER_BLOCK;SET THE ENTRY COUNTER
  3804  07fa  c35c07                    JP      CHECK_ENT;AND GO CHECK THE NEW ENTRY
  3805                          
  3806                          FULL_DIR:
  3807  07fd  217b00                    LD      HL,FOUND_AVAIL_ENT; [RECON] Identifier repair: operand bytes address FOUND_AVAIL_ENT at $FDDB.
  3808  0800  cb46                      BIT     FOUND_ENTRY,(HL); HAVE WE FOUND AN ENTRY?
  3809  0802  ca9a09                    JP      Z,FULL_DIR_EXIT; NOPE, EXIT
  3810  0805  1807                      JR      USE_ENTRY; YUP, CREATE NEW ENTRY THERE
  3811                          
  3812                          ; ARRIVE HERE WHEN WE'VE FOUND THE HOLE ENTRY IN THE DIRECTORY.
  3813                          ; IY IS STILL POINTING TO THE ENTRY IN THE BUFFER.
  3814                          
  3815                          FOUND_HOLE:
  3816  0807  217b00                    LD      HL,FOUND_AVAIL_ENT; [RECON] Identifier repair: operand bytes address FOUND_AVAIL_ENT at $FDDB.
  3817  080a  cb46                      BIT     FOUND_ENTRY,(HL); HAVE WE FOUND A DELETED ENTRY WE COULD USE?
  3818  080c  2864                      JR      Z,USE_HOLE; NOPE, STICK IT IN THE END
  3819                          
  3820                          USE_ENTRY:
  3821  080e  cb86                      RES     FOUND_ENTRY,(HL); RESET FOR NEXT TIME
  3822                          
  3823  0810  dd6e19                    LD      L,(IX+FCB_BLOCK); GET THE CURRENT BLOCK
  3824  0813  dd661a                    LD      H,(IX+FCB_BLOCK+1)
  3825                          
  3826  0816  ed5b7900                  LD      DE,(DIR_BLOCK_NO); BLOCK NO WHERE WE HAVE ENTRY TO USE
  3827  081a  b7                        OR      A;clear carry flag
  3828  081b  ed52                      SBC     HL,DE; SAME BLOCK?
  3829                          
  3830  081d  2aa800                    LD      HL,(BUF_START); POINT TO START OF BLOCK
  3831  0820  dd7521                    LD      (IX+FCB_POINTER),L
  3832  0823  dd7422                    LD      (IX+FCB_POINTER+1),H
  3833                          
  3834  0826  2824                      JR      Z,GOT_BLOCK; YUP, DON'T NEED TO READ IN ANOTHER BLOCK
  3835                          
  3836  0828  dd7319                    LD      (IX+FCB_BLOCK),E; GET THIS BLOCK
  3837  082b  dd721a                    LD      (IX+FCB_BLOCK+1),D
  3838                          
  3839  082e  010000                    LD      BC,0
  3840  0831  dd7e17                    LD      A,(IX+FCB_DEVICE); DEVICE ID
  3841                          
  3842  0834  cd7b11                    CALL    READ_BLOCK
  3843  0837  c28909                    JP      NZ,MAKE_ERROR
  3844  083a  1810                      JR      GOT_BLOCK; READ IN NEW DIRECTORY
  3845                          
  3846                          NEXT_DIR:
  3847                          TOO_SMALL:
  3848  083c  dd6e21                    LD      L,(IX+FCB_POINTER); GET POINTER TO DIR ENTRY
  3849  083f  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3850                          
  3851  0842  111a00                    LD      DE,DIR_ENT_LENGTH; LENGTH OF ENTRY
  3852                          
  3853  0845  19                        ADD     HL,DE; POINT TO NEXT ENTRY
  3854                          
  3855  0846  dd7521                    LD      (IX+FCB_POINTER),L
  3856  0849  dd7422                    LD      (IX+FCB_POINTER+1),H
  3857                          
  3858                          GOT_BLOCK:
  3859  084c  e5                        PUSH    HL
  3860  084d  fde1                      POP     IY
  3861                          
  3862  084f  fdcb0c56                  BIT     ATTR_DEL_BIT,(IY+DIR_ATTR); IS IT DELETED?
  3863  0853  28e7                      JR      Z,NEXT_DIR; NOPE, LOOK FOR ANOTHER DELETED ENTRY
  3864                          
  3865  0855  fd6e11                    LD      L,(IY+DIR_MAX_LENGTH); GET ALLOCATED AMOUNT OF DELETED FILE
  3866  0858  fd6612                    LD      H,(IY+DIR_MAX_LENGTH+1)
  3867                          
  3868  085b  ed5bac00                  LD      DE,(BLOCKS_REQ); MIN AMOUNT NEEDED
  3869                          
  3870  085f  e5                        PUSH    HL
  3871  0860  b7                        OR      A;clear carry flag
  3872  0861  ed52                      SBC     HL,DE; WILL IT FIT?
  3873  0863  e1                        POP     HL
  3874                          
  3875  0864  38d6                      JR      C,TOO_SMALL; NOPE, TRY ANOTHER ONE
  3876                          
  3877  0866  22ac00                    LD      (BLOCKS_REQ),HL; FORCE ALLOCATED AMOUNT
  3878                          
  3879  0869  cdbf09                    CALL    LOAD_NEW_ENTRY_INFO
  3880                          
  3881  086c  c28909                    JP      NZ,MAKE_ERROR
  3882                          
  3883  086f  c37109                    JP      TIME_TO_WRITE
  3884                          
  3885                          ; COMPARE FCB_BLOCK TO FCB_LAST_BLOCK.  GO TO MORE_BLOCKS
  3886                          ; IF FCB_LAST_BLOCK > FCB_BLOCK.
  3887                          
  3888                          USE_HOLE:
  3889  0872  dd7e1c                    LD      A,(IX+FCB_BLOCK+3)
  3890  0875  ddbe20                    CP      (IX+FCB_LAST_BLOCK+3)
  3891  0878  381e                      JR      C,MORE_BLOCKS
  3892  087a  dd7e1b                    LD      A,(IX+FCB_BLOCK+2)
  3893  087d  ddbe1f                    CP      (IX+FCB_LAST_BLOCK+2)
  3894  0880  3816                      JR      C,MORE_BLOCKS
  3895  0882  dd7e1a                    LD      A,(IX+FCB_BLOCK+1)
  3896  0885  ddbe1e                    CP      (IX+FCB_LAST_BLOCK+1)
  3897  0888  380e                      JR      C,MORE_BLOCKS
  3898  088a  dd7e19                    LD      A,(IX+FCB_BLOCK)
  3899  088d  ddbe1d                    CP      (IX+FCB_LAST_BLOCK)
  3900  0890  3806                      JR      C,MORE_BLOCKS
  3901                          
  3902                          ; FALL THROUGH IF THIS IS THE LAST BLOCK OF THE FILE.
  3903                          
  3904  0892  78                        LD      A,B;LOOK AT ENTRY COUNTER
  3905  0893  fe01                      CP      1
  3906  0895  ca9e09                    JP      Z,TAPE_FULL;ERROR IF NO ENTRIES LEFT VACANT
  3907                          
  3908                          MORE_BLOCKS:
  3909  0898  fd6e11                    LD      L,(IY+DIR_MAX_LENGTH);GET THE SIZE OF THE HOLE
  3910  089b  fd6612                    LD      H,(IY+DIR_MAX_LENGTH+1)
  3911                          
  3912  089e  ddcb186e                  BIT     MODE_REMAINDER_BIT,(IX+FCB_MODE); NEED TO ALLOCATE REST OF TAPE?
  3913  08a2  280c                      JR      Z,CHECK_HOLE_SIZE; NOPE
  3914                          
  3915  08a4  7c                        LD      A,H; YUP. CHECK IF THERE ARE ANY BLOCKS LEFT
  3916  08a5  b5                        OR      L
  3917  08a6  ca9e09                    JP      Z,TAPE_FULL; TAPE FULL
  3918                          
  3919  08a9  22ac00                    LD      (BLOCKS_REQ),HL; NOT FULL. REQUEST REST OF TAPE
  3920  08ac  ddcb18ae                  RES     MODE_REMAINDER_BIT,(IX+FCB_MODE)
  3921                          
  3922                          CHECK_HOLE_SIZE:
  3923  08b0  ed5bac00                  LD      DE,(BLOCKS_REQ);GET THE REQUESTED SIZE
  3924  08b4  b7                        OR      A
  3925  08b5  ed52                      SBC     HL,DE;COMPARE THEM
  3926  08b7  da9e09                    JP      C,TAPE_FULL;BRANCH IF THE HOLE IS TOO SMALL
  3927  08ba  22ba00                    LD      (NEW_HOLE_SIZE),HL;ELSE SAVE THE RESULT
  3928                          
  3929                          
  3930                          ; ADD BLOCKS_REQ TO DIR_START_BLOCK TO FIND THE HOLE'S NEW
  3931                          ; START BLOCK.  NOTICE HOW STOOOPID THE Z80 IS WITH ADDITION!
  3932  08bd  21ac00                    LD      HL,BLOCKS_REQ;POINT TO THE NUMBER TO ADD
  3933  08c0  fd7e0d                    LD      A,(IY+DIR_START_BLOCK)
  3934  08c3  86                        ADD     A,(HL)
  3935  08c4  23                        INC     HL
  3936  08c5  32b600                    LD      (NEW_HOLE_START),A
  3937  08c8  fd7e0e                    LD      A,(IY+DIR_START_BLOCK+1)
  3938  08cb  8e                        ADC     A,(HL)
  3939  08cc  23                        INC     HL
  3940  08cd  32b700                    LD      (NEW_HOLE_START+1),A
  3941  08d0  fd7e0f                    LD      A,(IY+DIR_START_BLOCK+2)
  3942  08d3  8e                        ADC     A,(HL)
  3943  08d4  23                        INC     HL
  3944  08d5  32b800                    LD      (NEW_HOLE_START+2),A
  3945  08d8  fd7e10                    LD      A,(IY+DIR_START_BLOCK+3)
  3946  08db  8e                        ADC     A,(HL)
  3947  08dc  23                        INC     HL
  3948  08dd  32b900                    LD      (NEW_HOLE_START+3),A
  3949                          
  3950  08e0  c5                        PUSH    BC;SAVE ENTRY COUNT (IN B)
  3951                          
  3952  08e1  cdbf09                    CALL    LOAD_NEW_ENTRY_INFO
  3953                          
  3954  08e4  c1                        POP     BC;RESTORE ENTRY COUNT
  3955                          
  3956  08e5  c28909                    JP      NZ,MAKE_ERROR
  3957                          
  3958  08e8  dd6e21                    LD      L,(IX+FCB_POINTER);GET CURRENT POINTER
  3959                          
  3960                          
  3961  08eb  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3962  08ee  111a00                    LD      DE,DIR_ENT_LENGTH;GET LENGTH OF AN ENTRY
  3963  08f1  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT ENTRY
  3964  08f2  dd7521                    LD      (IX+FCB_POINTER),L;AND SAVE IT AGAIN
  3965  08f5  dd7422                    LD      (IX+FCB_POINTER+1),H
  3966                          
  3967  08f8  1044                      DJNZ    NOT_END;JUMP IF THERE ARE MORE ENTRIES
  3968                          
  3969                          ;THIS LABEL NOT USED IN THIS ROUTINE, NOT DECLARED GLOBAL
  3970                          ;REMOVED BECAUSE IT CONFLICTS WITH IDENTICAL LABEL ELSEWHERE
  3971                          ;WRITE_AGAIN:
  3972  08fa  dd7e17                    LD      A,(IX+FCB_DEVICE);GET PARAMETERS FROM FCB
  3973  08fd  2aa800                    LD      HL,(BUF_START)
  3974  0900  dd5e19                    LD      E,(IX+FCB_BLOCK)
  3975  0903  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3976  0906  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  3977  0909  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  3978                          
  3979  090c  cde611                    CALL    WRITE_BLOCK
  3980                          
  3981  090f  c28909                    JP      NZ,MAKE_ERROR; NOPE, A REAL LIVE ERROR
  3982                          
  3983                          
  3984                          RESET_THE_POINTER:
  3985  0912  2aa800                    LD      HL,(BUF_START);RESET THE POINTER
  3986  0915  dd7521                    LD      (IX+FCB_POINTER),L
  3987  0918  dd7422                    LD      (IX+FCB_POINTER+1),H
  3988                          
  3989  091b  dd3419                    INC     (IX+FCB_BLOCK);INC BLOCK -- NO CARRY OUT
  3990                          
  3991                          TIMEOUT_IN_READ:
  3992  091e  dd7e17                    LD      A,(IX+FCB_DEVICE);GET PARAMETERS FROM FCB
  3993  0921  dd6e21                    LD      L,(IX+FCB_POINTER)
  3994  0924  dd6622                    LD      H,(IX+FCB_POINTER+1)
  3995  0927  dd5e19                    LD      E,(IX+FCB_BLOCK)
  3996  092a  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  3997  092d  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  3998  0930  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  3999  0933  cd7b11                    CALL    READ_BLOCK;AND READ THE NEXT BLOCK
  4000                          
  4001  0936  2051                      JR      NZ,MAKE_ERROR; NOPE, ERROR!!!!!!
  4002                          
  4003                          
  4004  0938  dd6e21                    LD      L,(IX+FCB_POINTER);GET POINTER INTO IY THE LONG WAY
  4005  093b  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4006                          
  4007                          NOT_END:
  4008  093e  e5                        PUSH    HL
  4009  093f  fde1                      POP     IY;!!!!
  4010                          
  4011                          ;
  4012                          ; STILL TRYING TO CALC THE NEW START ADDR
  4013                          ;
  4014  0941  2aba00                    LD      HL,(NEW_HOLE_SIZE)
  4015  0944  fd7511                    LD      (IY+DIR_MAX_LENGTH),L; BLOCKS LEFT ON TAPE
  4016  0947  fd7412                    LD      (IY+DIR_MAX_LENGTH+1),H
  4017                          
  4018  094a  3ab600                    LD      A,(NEW_HOLE_START)
  4019  094d  fd770d                    LD      (IY+DIR_START_BLOCK),A
  4020  0950  3ab700                    LD      A,(NEW_HOLE_START+1)
  4021  0953  fd770e                    LD      (IY+DIR_START_BLOCK+1),A
  4022  0956  3ab800                    LD      A,(NEW_HOLE_START+2)
  4023  0959  fd770f                    LD      (IY+DIR_START_BLOCK+2),A
  4024  095c  3ab900                    LD      A,(NEW_HOLE_START+3)
  4025  095f  fd7710                    LD      (IY+DIR_START_BLOCK+3),A
  4026                          
  4027  0962  fd360c01                  LD      (IY+DIR_ATTR),ATTR_HOLE; SET HOLE UP
  4028                          
  4029  0966  fde5                      PUSH    IY
  4030  0968  d1                        POP     DE
  4031                          
  4032  0969  212814                    LD      HL,HOLE_FILE_NAME
  4033  096c  010c00                    LD      BC,12
  4034  096f  edb0                      LDIR
  4035                          
  4036                          TIME_TO_WRITE:
  4037  0971  dd7e17                    LD      A,(IX+FCB_DEVICE);GET PARAMETERS FROM FCB
  4038  0974  2aa800                    LD      HL,(BUF_START)
  4039  0977  dd5e19                    LD      E,(IX+FCB_BLOCK)
  4040  097a  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4041  097d  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4042  0980  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4043  0983  cde611                    CALL    WRITE_BLOCK;WRITE THE BLOCK OUT
  4044                          
  4045  0986  2001                      JR      NZ,MAKE_ERROR; IT'S A BOO BOO!!
  4046  0988  af                        XOR     A;SHOW NO ERROR
  4047                          
  4048                          LETS_GET_OUT:
  4049                          MAKE_ERROR:
  4050                          ;RESTORE THE REGISTERS
  4051  0989  b7                        OR      A
  4052  098a  c1                        POP     BC
  4053  098b  d1                        POP     DE
  4054  098c  e1                        POP     HL
  4055  098d  dde1                      POP     IX
  4056  098f  fde1                      POP     IY
  4057  0991  c9                        RET
  4058                          
  4059                          TOO_BIG:
  4060  0992  3e0b                      LD      A,TOO_BIG_ERR;SHOW AN ERROR
  4061  0994  18f3                      JR      MAKE_ERROR
  4062                          
  4063                          
  4064                          FILE_EXISTS:
  4065  0996  3e06                      LD      A,FILE_EXISTS_ERR
  4066  0998  18ef                      JR      MAKE_ERROR
  4067                          
  4068                          FULL_DIR_EXIT:
  4069  099a  3e0c                      LD      A,FULL_DIR_ERR
  4070  099c  18eb                      JR      MAKE_ERROR
  4071                          
  4072                          TAPE_FULL:
  4073  099e  3e0d                      LD      A,FULL_TAPE_ERR
  4074  09a0  18e7                      JR      MAKE_ERROR
  4075                          ;
  4076                          ;
  4077                          ; SUBROUTINE NAME: GET FILE NAME LENGTH
  4078                          ;
  4079                          ;   ENTRY: HL- POINTS TO TEXT STRING
  4080                          ;   EXIT:  Z=1=FOUND AND PROPER SIZE (1-12)
  4081                          ;          BC=BYTE COUNT
  4082                          ;          A=TRASHED
  4083                          ;
  4084                          ;          Z=0=ERROR
  4085                          ;          BC=TRASH
  4086                          ;          A=FILE_NAME_TOO_LONG
  4087                          ; DLS(8/28/83)
  4088                          ;
  4089                          GET_FILE_NM_LEN:
  4090  09a2  e5                        PUSH    HL;SAVE THE POINTER TO FILE NAME
  4091  09a3  060c                      LD      B,12;SCAN UP TO 12 BYTE
  4092  09a5  0e01                      LD      C,1;SET COUNT TO 1
  4093                          SRCH_LOOP:
  4094  09a7  7e                        LD      A,(HL);GET FN()
  4095  09a8  fe03                      CP      03;ETX
  4096  09aa  2809                      JR      Z,GOT_IT
  4097                          ;
  4098  09ac  0c                        INC     C
  4099  09ad  23                        INC     HL;ADVANCE POINTER TO FILE NAME STRING
  4100  09ae  10f7                      DJNZ    SRCH_LOOP
  4101                          ;
  4102                          ERR_GFN:
  4103  09b0  3e0e                      LD      A,FILE_NM_ERR
  4104  09b2  b7                        OR      A;SHOW ERROR
  4105  09b3  e1                        POP     HL
  4106  09b4  c9                        RET
  4107                          ;
  4108                          GOT_IT:
  4109  09b5  79                        LD      A,C
  4110  09b6  fe01                      CP      1;ETX ALONE IS NOT VALID
  4111  09b8  28f6                      JR      Z,ERR_GFN
  4112  09ba  0600                      LD      B,0
  4113  09bc  af                        XOR     A;SHOW OK
  4114  09bd  e1                        POP     HL
  4115  09be  c9                        RET
  4116                          
  4117                          
  4118                          
  4119                          LOAD_NEW_ENTRY_INFO:
  4120  09bf  fde5                      PUSH    IY;GET NAME ADDRESS INTO DE
  4121  09c1  d1                        POP     DE
  4122                          
  4123  09c2  2ab000                    LD      HL,(USER_NAME);GET USER'S STRING ADDRESS
  4124                          ;
  4125  09c5  cda209                    CALL    GET_FILE_NM_LEN; DLS(8/28/83)
  4126  09c8  c2ff09                    JP      NZ,MAKE_ERR_1
  4127                          ;
  4128  09cb  edb0                      LDIR;COPY USER'S NAME INTO DIR ENTRY
  4129                          
  4130  09cd  3e10                      LD      A,ATTR_USER;SET THE DEFAULT ATTRIBUTE
  4131  09cf  fd770c                    LD      (IY+DIR_ATTR),A
  4132                          
  4133  09d2  ed4bac00                  LD      BC,(BLOCKS_REQ);GET NEW FILE'S MAX SIZE
  4134  09d6  fd7111                    LD      (IY+DIR_MAX_LENGTH),C;PUT INTO DIR
  4135  09d9  fd7012                    LD      (IY+DIR_MAX_LENGTH+1),B
  4136                          
  4137                          
  4138  09dc  fd361301                  LD      (IY+DIR_USED_LENGTH),1;INIT COUNT OF BLOCKS USED
  4139  09e0  fd361400                  LD      (IY+DIR_USED_LENGTH+1),0
  4140                          
  4141  09e4  fd361500                  LD      (IY+DIR_LAST_COUNT),0;INIT BYTECOUNT IN LAST BLOCK
  4142  09e8  fd361600                  LD      (IY+DIR_LAST_COUNT+1),0
  4143                          
  4144  09ec  3a8000                    LD      A,(EOS_YEAR);INSERT THE DATE
  4145  09ef  fd7717                    LD      (IY+DIR_YEAR),A
  4146  09f2  3a8100                    LD      A,(EOS_MONTH)
  4147  09f5  fd7718                    LD      (IY+DIR_MONTH),A
  4148  09f8  3a8200                    LD      A,(EOS_DAY)
  4149  09fb  fd7719                    LD      (IY+DIR_DAY),A
  4150                          
  4151  09fe  af                        XOR     A
  4152                          
  4153                          MAKE_ERR_1:
  4154  09ff  c9                        RET
  4155                          
  4156                          ;
  4157                          ;===============================================================
  4158                          ;===============================================================
  4159                          ;===============================================================
  4160                          ;
  4161                          
  4162                          ;GLB    __OPEN_FILE,__CLOSE_FILE,__RESET_FILE
  4163                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  4164                          ;EXT    BUF_START,FMGR_DIR_ENT
  4165                          ;EXT    __QUERY_FILE,MODE_CHECK,READ_BLOCK,WRITE_BLOCK
  4166                          ;EXT    __SET_FILE
  4167                          ;EXT    FILE_NAME_ADDR
  4168                          
  4169                          ;----------------------------------------------------------------
  4170                          ;
  4171                          ; __OPEN_FILE -- Sets up an FCB for the caller to access a file.
  4172                          ;
  4173                          ; CALLING PARAMETERS: device number in A; address of name string
  4174                          ;                     in HL; mode in B.
  4175                          ;
  4176                          ; EXIT PARAMETERS: if no error -- Z = 1; A = file number
  4177                          ;                  if error -- Z = 0; A = error code; B = junk
  4178                          ;
  4179                          ;----------------------------------------------------------------
  4180                          
  4181                          ; NEXT_FCB CHANGED TO O_NEXT_FCB TO PREVENT CONFLICT WITH
  4182                          ; IDENTICAL LABEL ELSEWHERE
  4183                          
  4184                          __OPEN_FILE:
  4185  0a00  fde5                      PUSH    IY;SAVE REGISTERS
  4186  0a02  e5                        PUSH    HL
  4187  0a03  dde5                      PUSH    IX
  4188  0a05  d5                        PUSH    DE
  4189                          
  4190  0a06  f5                        PUSH    AF;SAVE DEVICE NUMBER
  4191  0a07  c5                        PUSH    BC;SAVE MODE
  4192                          
  4193                          ; FIRST, WE HAVE TO LOCATE A FREE FCB.
  4194  0a08  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);GET POINTER TO FIRST FCB'S HEAD
  4195  0a0c  112300                    LD      DE,FCB_LENGTH
  4196  0a0f  dd19                      ADD     IX,DE; SKIP OVER IT -- BELONGS TO SYSTEM
  4197                          
  4198  0a11  fd2a9f00                  LD      IY,(FCB_DATA_ADDR);GET POINTER TO FIRST FCB'S BODY
  4199  0a15  110004                    LD      DE,1024
  4200  0a18  fd19                      ADD     IY,DE; SKIP OVER IT TOO
  4201                          
  4202  0a1a  0601                      LD      B,1;SET FCB NUMBER
  4203                          O_NEXT_FCB:
  4204  0a1c  dd7e18                    LD      A,(IX+FCB_MODE);GET THE MODE BYTE FROM FCB
  4205  0a1f  b7                        OR      A;CHECK IT
  4206  0a20  281c                      JR      Z,GOT_ONE;BRANCH IF THIS ONE IS FREE
  4207                          
  4208  0a22  112300                    LD      DE,FCB_LENGTH;ELSE SKIP OVER IT
  4209  0a25  dd19                      ADD     IX,DE
  4210  0a27  110004                    LD      DE,1024
  4211  0a2a  fd19                      ADD     IY,DE
  4212                          
  4213  0a2c  04                        INC     B;INC THE FCB NUMBER
  4214  0a2d  78                        LD      A,B
  4215  0a2e  fe03                      CP      NUM_FCBS;ARE THERE MORE FCBS TO CHECK?
  4216  0a30  38ea                      JR      C,O_NEXT_FCB;LOOP UNTIL WE'VE SEEN THEM ALL
  4217                          NO_FCBS:
  4218  0a32  c1                        POP     BC;RESTORE MODE
  4219  0a33  f1                        POP     AF
  4220  0a34  d1                        POP     DE
  4221  0a35  dde1                      POP     IX
  4222  0a37  e1                        POP     HL
  4223  0a38  fde1                      POP     IY
  4224                          
  4225  0a3a  3e07                      LD      A,NO_FCB_ERR;SET THE ERROR CODE
  4226  0a3c  b7                        OR      A;SET THE CONDITIONS
  4227  0a3d  c9                        RET
  4228                          
  4229                          GOT_ONE:
  4230  0a3e  fd22a800                  LD      (BUF_START),IY;SAVE THE FCB BUFFER'S ADDRESS
  4231                          
  4232  0a42  f1                        POP     AF;GET THE MODE
  4233  0a43  dd7718                    LD      (IX+FCB_MODE),A;PUT IT INTO FCB
  4234  0a46  f1                        POP     AF;GET THE DEVICE
  4235  0a47  dd7717                    LD      (IX+FCB_DEVICE),A;PUT IT INTO FCB
  4236                          
  4237  0a4a  c5                        PUSH    BC;SAVE THE FCB NUMBER
  4238                          
  4239  0a4b  e5                        PUSH    HL
  4240  0a4c  d1                        POP     DE; ADDRESS OF NAME STRING
  4241                          
  4242  0a4d  dde5                      PUSH    IX;POINT TO FCB NAME (ASSUME OFFSET = 0)
  4243  0a4f  e1                        POP     HL
  4244  0a50  dd7e17                    LD      A,(IX+FCB_DEVICE);GET DEVICE NUMBER
  4245  0a53  cd1b06                    CALL    __QUERY_FILE;GET THE FILE'S DIR ENTRY
  4246  0a56  c2f80a                    JP      NZ,OP_ERR;BRANCH IF THERE WAS AN ERROR
  4247                          ;*** SET PARAMS ***
  4248  0a59  cdd910                    CALL    MODE_CHECK;SEE IF MODE MATCHES ATTRIBUTES
  4249  0a5c  c2f80a                    JP      NZ,OP_ERR;BRANCH IF NOT
  4250                          
  4251  0a5f  dd7e13                    LD      A,(IX+FCB_USED_LENGTH);CALC. & SET LAST BLOCK
  4252  0a62  dd860d                    ADD     A,(IX+FCB_FIRST_BLOCK)
  4253  0a65  dd771d                    LD      (IX+FCB_LAST_BLOCK),A
  4254  0a68  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4255  0a6b  dd8e14                    ADC     A,(IX+FCB_USED_LENGTH+1)
  4256  0a6e  dd771e                    LD      (IX+FCB_LAST_BLOCK+1),A
  4257  0a71  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4258  0a74  ce00                      ADC     A,0
  4259  0a76  dd771f                    LD      (IX+FCB_LAST_BLOCK+2),A
  4260  0a79  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4261  0a7c  ce00                      ADC     A,0
  4262  0a7e  dd7720                    LD      (IX+FCB_LAST_BLOCK+3),A
  4263                          
  4264  0a81  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK+0)
  4265  0a84  d601                      SUB     1
  4266  0a86  dd771d                    LD      (IX+FCB_LAST_BLOCK+0),A
  4267                          
  4268  0a89  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4269  0a8c  de00                      SBC     A,0
  4270  0a8e  dd771e                    LD      (IX+FCB_LAST_BLOCK+1),A
  4271                          
  4272  0a91  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4273  0a94  de00                      SBC     A,0
  4274  0a96  dd771f                    LD      (IX+FCB_LAST_BLOCK+2),A
  4275                          
  4276  0a99  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3)
  4277  0a9c  de00                      SBC     A,0
  4278  0a9e  dd7720                    LD      (IX+FCB_LAST_BLOCK+3),A
  4279                          
  4280  0aa1  ed5ba800                  LD      DE,(BUF_START);INIT BUFFER POINTER
  4281  0aa5  dd7321                    LD      (IX+FCB_POINTER),E
  4282  0aa8  dd7222                    LD      (IX+FCB_POINTER+1),D
  4283                          
  4284  0aab  dd7e0d                    LD      A,(IX+FCB_FIRST_BLOCK);SET BLOCK TO FIRST_BLOCK
  4285  0aae  dd7719                    LD      (IX+FCB_BLOCK),A
  4286  0ab1  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4287  0ab4  dd771a                    LD      (IX+FCB_BLOCK+1),A
  4288  0ab7  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4289  0aba  dd771b                    LD      (IX+FCB_BLOCK+2),A
  4290  0abd  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4291  0ac0  dd771c                    LD      (IX+FCB_BLOCK+3),A
  4292                          
  4293  0ac3  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE
  4294  0ac6  e607                      AND     MODE_MODE
  4295  0ac8  fe02                      CP      MODE_WRITE;IS IT WRITE MODE?
  4296  0aca  2827                      JR      Z,OPEN5;JUMP IF SO -- NO PRE-READ NECESSARY
  4297                          
  4298                          READ_TIMEOUT:
  4299                          ;       If FCB_USED_LENGTH = 1 (file size of one block)
  4300  0acc  af                        XOR     A;Load Acc with zero
  4301  0acd  ddbe14                    CP      (IX+FCB_USED_LENGTH+1);High order must be zero
  4302  0ad0  200a                      JR      NZ,NOT_SIZE_1;If not then past bitset
  4303  0ad2  3c                        INC     A;Inc Acc to a 1
  4304  0ad3  ddbe13                    CP      (IX+FCB_USED_LENGTH);Compare with low order
  4305  0ad6  2004                      JR      NZ,NOT_SIZE_1;If not equal then exit
  4306                          
  4307                          ;       Then set last block bit in mode
  4308  0ad8  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE);Set it
  4309                          ;       Endif
  4310                          NOT_SIZE_1:
  4311                          
  4312  0adc  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4313  0adf  2aa800                    LD      HL,(BUF_START);GET BUFFER ADDRESS
  4314  0ae2  dd5e19                    LD      E,(IX+FCB_BLOCK);GET BLOCK NUMBER
  4315  0ae5  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4316  0ae8  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4317  0aeb  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4318  0aee  cd7b11                    CALL    READ_BLOCK;READ THE FIRST BLOCK
  4319                          
  4320  0af1  2005                      JR      NZ,OP_ERR; IT'S AN ERROR
  4321                          
  4322                          OPEN5:
  4323  0af3  af                        XOR     A;SHOW NO ERROR
  4324  0af4  c1                        POP     BC;GET THE FILE NUMBER IN B
  4325  0af5  78                        LD      A,B
  4326                          
  4327  0af6  1805                      JR      REST_REGS
  4328                          ;       POP     DE                     ;RESTORE REGISTERS
  4329                          ;       POP     IX
  4330                          ;       POP     HL
  4331                          ;       POP     IY
  4332                          ;       RET
  4333                          
  4334                          OP_ERR:
  4335  0af8  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED;MAKE THE FCB UNUSED AGAIN
  4336                          
  4337  0afc  c1                        POP     BC;RESTORE REGISTERS
  4338                          REST_REGS:
  4339  0afd  d1                        POP     DE
  4340  0afe  dde1                      POP     IX
  4341  0b00  e1                        POP     HL
  4342  0b01  fde1                      POP     IY
  4343  0b03  c9                        RET
  4344                          
  4345                          ;----------------------------------------------------------------
  4346                          ;
  4347                          ; __CLOSE_FILE -- does the necessary clean-up and marks the FCB
  4348                          ;                 as unused.
  4349                          ;
  4350                          ; ENTRY PARAMETERS -- file number in A.
  4351                          ;
  4352                          ; EXIT PARAMETERS -- if no error -- Z = 1; A = 0
  4353                          ;                   if error -- Z = 0; A = error code
  4354                          ;
  4355                          ;----------------------------------------------------------------
  4356                          
  4357                          __CLOSE_FILE:
  4358  0b04  dde5                      PUSH    IX;SAVE REGISTERS
  4359  0b06  e5                        PUSH    HL
  4360  0b07  d5                        PUSH    DE
  4361  0b08  c5                        PUSH    BC
  4362                          
  4363  0b09  b7                        OR      A;CHECK FILE NUMBER
  4364  0b0a  2850                      JR      Z,C_ERROR;BRANCH IF ZERO
  4365  0b0c  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4366  0b0e  304c                      JR      NC,C_ERROR;BRANCH IF TOO LARGE
  4367                          
  4368  0b10  47                        LD      B,A;PUT IT INTO B
  4369  0b11  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4370  0b15  2a9f00                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4371                          CLOSE2:
  4372  0b18  112300                    LD      DE,FCB_LENGTH;SET OFFSET
  4373  0b1b  dd19                      ADD     IX,DE;ADVANCE POINTER TO NEXT FCB
  4374  0b1d  110004                    LD      DE,1024
  4375  0b20  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT BUFFER
  4376  0b21  10f5                      DJNZ    CLOSE2;UNTIL WE GET TO THE ONE WE WANT
  4377                          
  4378  0b23  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE BYTE
  4379  0b26  b7                        OR      A
  4380  0b27  2833                      JR      Z,C_ERROR;BRANCH IF FCB NOT IN USE
  4381                          
  4382  0b29  e640                      AND     MODE_DIRTY;ZERO UNWANTED BITS
  4383  0b2b  2825                      JR      Z,CLOSE3;BRANCH IF BUFFER NOT DIRTY
  4384                          
  4385  0b2d  dd221300                  LD      (FILE_NAME_ADDR),IX; POINTER TO FILE NAME IN FCB
  4386                          WRITE_TIMEOUT:
  4387  0b31  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4388  0b34  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4389  0b37  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4390  0b3a  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4391  0b3d  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4392                          ;HL STILL HAS ADDRESS OF BUFFER
  4393  0b40  cde611                    CALL    WRITE_BLOCK;FLUSH THE BLOCK TO TAPE
  4394  0b43  2020                      JR      NZ,C_ERROR2;BRANCH IF ERROR
  4395                          
  4396                          CLOSE4:
  4397  0b45  dd7e17                    LD      A,(IX+FCB_DEVICE); GET DEVICE ID
  4398  0b48  dde5                      PUSH    IX
  4399  0b4a  e1                        POP     HL
  4400  0b4b  ed5b1300                  LD      DE,(FILE_NAME_ADDR)
  4401                          
  4402  0b4f  cd5106                    CALL    __SET_FILE
  4403                          
  4404                          CLOSE3:
  4405  0b52  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED;MARK THE FCB EMPTY
  4406                          
  4407  0b56  c1                        POP     BC;RESTORE REGISTERS
  4408  0b57  d1                        POP     DE
  4409  0b58  e1                        POP     HL
  4410  0b59  dde1                      POP     IX
  4411  0b5b  c9                        RET
  4412                          C_ERROR:
  4413  0b5c  c1                        POP     BC;RESTORE REGISTERS
  4414  0b5d  d1                        POP     DE
  4415  0b5e  e1                        POP     HL
  4416  0b5f  dde1                      POP     IX
  4417  0b61  3e09                      LD      A,BAD_FNUM_ERR;SET THE ERROR
  4418  0b63  b7                        OR      A;SET THE CONDITIONS
  4419  0b64  c9                        RET
  4420                          C_ERROR2:
  4421  0b65  c1                        POP     BC;RESTORE REGISTERS
  4422  0b66  d1                        POP     DE
  4423  0b67  e1                        POP     HL
  4424  0b68  dde1                      POP     IX
  4425  0b6a  b7                        OR      A;SET CONDITIONS
  4426  0b6b  c9                        RET
  4427                          
  4428                          ;----------------------------------------------------------------
  4429                          ;
  4430                          ; __RESET_FILE -- rewinds the file back to the first byte.
  4431                          ;
  4432                          ; ENTRY PARAMETERS: file number in A
  4433                          ;
  4434                          ; EXIT PARAMETERS: no error -- Z = 1; A = 0
  4435                          ;                  if error -- Z = 0; A = error code
  4436                          ;
  4437                          ;----------------------------------------------------------------
  4438                          
  4439                          __RESET_FILE:
  4440  0b6c  dde5                      PUSH    IX;SAVE REGISTERS
  4441  0b6e  d5                        PUSH    DE
  4442  0b6f  c5                        PUSH    BC
  4443  0b70  e5                        PUSH    HL
  4444                          
  4445  0b71  b7                        OR      A;CHECK FILE NUMBER
  4446  0b72  ca070c                    JP      Z,R_ERROR;BRANCH IF ZERO
  4447  0b75  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4448  0b77  d2070c                    JP      NC,R_ERROR;BRANCH IF TOO LARGE
  4449                          
  4450  0b7a  47                        LD      B,A;PUT IT INTO B
  4451  0b7b  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4452  0b7f  2a9f00                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4453                          RES1:
  4454  0b82  112300                    LD      DE,FCB_LENGTH;SET OFFSET
  4455  0b85  dd19                      ADD     IX,DE;ADVANCE POINTER TO NEXT FCB
  4456  0b87  110004                    LD      DE,1024;SET BUFFER SIZE
  4457  0b8a  19                        ADD     HL,DE;ADVANCE POINTER TO NEXT BUFFER
  4458  0b8b  10f5                      DJNZ    RES1;UNTIL WE GET TO THE ONE WE WANT
  4459                          
  4460  0b8d  dd7e18                    LD      A,(IX+FCB_MODE);LOOK AT THE MODE BYTE
  4461  0b90  b7                        OR      A
  4462  0b91  2874                      JR      Z,R_ERROR;BRANCH IF FCB NOT IN USE
  4463                          
  4464  0b93  e640                      AND     MODE_DIRTY;ZERO UNWANTED BITS
  4465  0b95  2818                      JR      Z,RES2;BRANCH IF BUFFER NOT DIRTY
  4466                          
  4467                          TIMED_OUT:
  4468  0b97  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4469  0b9a  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4470  0b9d  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4471  0ba0  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4472  0ba3  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4473                          ;HL STILL HAS ADDRESS OF BUFFER
  4474  0ba6  cde611                    CALL    WRITE_BLOCK;FLUSH THE BLOCK TO TAPE
  4475  0ba9  2065                      JR      NZ,R_ERROR2;BRANCH IF ERROR
  4476                          
  4477                          RESET_BIT:
  4478  0bab  ddcb18b6                  RES     MODE_DIRTY_BIT,(IX+FCB_MODE);CLEAR THE DIRTY BIT
  4479                          RES2:
  4480  0baf  ddcb18be                  RES     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); BACK TO FIRST BLOCK
  4481  0bb3  dd7e0d                    LD      A,(IX+FCB_FIRST_BLOCK);SET BLOCK TO FIRST_BLOCK
  4482  0bb6  dd7719                    LD      (IX+FCB_BLOCK),A
  4483  0bb9  dd7e0e                    LD      A,(IX+FCB_FIRST_BLOCK+1)
  4484  0bbc  dd771a                    LD      (IX+FCB_BLOCK+1),A
  4485  0bbf  dd7e0f                    LD      A,(IX+FCB_FIRST_BLOCK+2)
  4486  0bc2  dd771b                    LD      (IX+FCB_BLOCK+2),A
  4487  0bc5  dd7e10                    LD      A,(IX+FCB_FIRST_BLOCK+3)
  4488  0bc8  dd771c                    LD      (IX+FCB_BLOCK+3),A
  4489                          
  4490  0bcb  dd7521                    LD      (IX+FCB_POINTER+0),L;reset pointer for new (first) block
  4491  0bce  dd7422                    LD      (IX+FCB_POINTER+1),H
  4492                          
  4493  0bd1  dd7e18                    LD      A,(IX+FCB_MODE);GET THE MODE AGAIN
  4494  0bd4  e607                      AND     MODE_MODE;LOOK AT MODE TYPE ONLY
  4495  0bd6  fe02                      CP      MODE_WRITE;ARE WE WRITING?
  4496  0bd8  2012                      JR      NZ,READ_IT;NOPE, NEED TO PRE-READ
  4497                          
  4498  0bda  dd361500                  LD      (IX+FCB_LAST_COUNT),0
  4499  0bde  dd361600                  LD      (IX+FCB_LAST_COUNT+1),0
  4500                          
  4501  0be2  dd361301                  LD      (IX+FCB_USED_LENGTH),1
  4502  0be6  dd361400                  LD      (IX+FCB_USED_LENGTH+1),0
  4503                          
  4504  0bea  1814                      JR      NO_READ
  4505                          
  4506                          READ_IT:
  4507  0bec  dd7e17                    LD      A,(IX+FCB_DEVICE);GET THE DEVICE NUMBER
  4508  0bef  dd5e19                    LD      E,(IX+FCB_BLOCK);GET THE BLOCK NUMBER
  4509  0bf2  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4510  0bf5  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4511  0bf8  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4512                          ;HL STILL HAS ADDRESS OF BUFFER
  4513  0bfb  cd7b11                    CALL    READ_BLOCK;READ THE FIRST BLOCK
  4514                          
  4515  0bfe  2010                      JR      NZ,R_ERROR2;BRANCH ON ERROR
  4516                          
  4517                          NO_READ:
  4518  0c00  e1                        POP     HL;RESTORE THE REGISTERS
  4519  0c01  c1                        POP     BC
  4520  0c02  d1                        POP     DE
  4521  0c03  dde1                      POP     IX
  4522  0c05  af                        XOR     A;SHOW NO ERROR
  4523  0c06  c9                        RET
  4524                          
  4525                          R_ERROR:
  4526  0c07  e1                        POP     HL;RESTORE THE REGISTERS
  4527  0c08  c1                        POP     BC
  4528  0c09  d1                        POP     DE
  4529  0c0a  dde1                      POP     IX
  4530  0c0c  3e09                      LD      A,BAD_FNUM_ERR;SHOW THE ERROR
  4531  0c0e  b7                        OR      A;SET CONDITIONS
  4532  0c0f  c9                        RET
  4533                          R_ERROR2:
  4534  0c10  e1                        POP     HL;RESTORE REGISTERS
  4535  0c11  c1                        POP     BC
  4536  0c12  d1                        POP     DE
  4537  0c13  dde1                      POP     IX
  4538  0c15  b7                        OR      A;SET CONDITION
  4539  0c16  c9                        RET

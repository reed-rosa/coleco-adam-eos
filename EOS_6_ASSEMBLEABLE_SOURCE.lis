  5364                          ;***************************************************************
  5365                          ;***************************************************************
  5366                          ;
  5367                          ;     CHECK_IF_DIRECTORY VERIFIES THE EXISTENCE OF A DIRECTORY
  5368                          ;             ON THE MEDIA IN THE DEVICE
  5369                          ;
  5370                          ;     INPUT:   IY  -  POINTS TO THE VOLUME ENTRY (FIRST ENTRY INTO THE DIRECTORY)
  5371                          ;
  5372                          ;     OUTPUT:  CONDITION FLAGS
  5373                          ;             Z  - DIRECTORY EXISTS
  5374                          ;             NZ - NO DIRECTORY
  5375                          ;                  A = ERROR CODE
  5376                          ;
  5377                          ;
  5378                          ;             ALL REGISTERS PRESERVED EXCEPT AF
  5379                          ;
  5380                          ;***************************************************************
  5381                          ;***************************************************************
  5382                          
  5383                          ;GLB    CHECK_IF_DIRECTORY
  5384                          ;EXT    DIRECTORY_CHECK
  5385                          
  5386                          CHECK_IF_DIRECTORY:
  5387  1035  fde5                      PUSH    IY
  5388  1037  c5                        PUSH    BC
  5389  1038  e5                        PUSH    HL
  5390                          
  5391  1039  21e713                    LD      HL,DIRECTORY_CHECK; 4 UNIQUE BYTES PLACE IN VOLUME ENTRY
  5392                          ; AT CREATION TIME (BYTES DEFINED IN EOS_MKDIR)
  5393                          
  5394  103c  0604                      LD      B,4; COMPARE 4 BYTES
  5395                          NEXT_CHECK:
  5396  103e  7e                        LD      A,(HL); GET THE FIRST UNIQUE BYTE
  5397  103f  fdbe0d                    CP      (IY+VOL_DIR_CHECK); SAME AS ON TAPE?
  5398  1042  200b                      JR      NZ,NOT_DIR; NOPE
  5399                          
  5400  1044  23                        INC     HL; YUP, CHECK NEXT BYTE
  5401  1045  fd23                      INC     IY
  5402  1047  10f5                      DJNZ    NEXT_CHECK
  5403                          
  5404  1049  af                        XOR     A; DIRECTORY EXISTS
  5405                          
  5406                          GET_OUT_HERE:
  5407  104a  e1                        POP     HL
  5408  104b  c1                        POP     BC
  5409  104c  fde1                      POP     IY
  5410                          
  5411  104e  c9                        RET
  5412                          
  5413                          NOT_DIR:
  5414  104f  3e18                      LD      A,NO_DIR_ERR
  5415  1051  18f7                      JR      GET_OUT_HERE
  5416                          
  5417                          ;---------------------------------------------------------------
  5418                          ;
  5419                          ; STRCMP -- compare two strings (file names).
  5420                          ;
  5421                          ; ENTRY PARAMETERS: address of name string in HL; address of
  5422                          ;                   name within dir entry in DE. NOTE: string
  5423                          ;                   pointed to by HL must be terminated with ETX.
  5424                          ;                   Maximum of NAME_LENGTH characters are compared.
  5425                          ;
  5426                          ; EXIT PARAMETERS:  Z = 1; A = 0 if match or
  5427                          ;                   Z = 0; A = error code if no match.
  5428                          ;
  5429                          ;---------------------------------------------------------------
  5430                          
  5431                          BASECMP: EQU     $+1; EXECUTES SCF (37H) - COMPARE ONLY THE BASE
  5432                          ; OF THE FILE NAME
  5433                          STRCMP:; "AND" INSTRUCTION CLEARS CARRY - COMPARE BASE &
  5434  1053  e637                      AND     037H; EXTENSION
  5435  1055  e5                        PUSH    HL; PRESERVE REG'S
  5436  1056  d5                        PUSH    DE
  5437  1057  c5                        PUSH    BC
  5438  1058  f5                        PUSH    AF; SAVE CARRY FLAGGING EXECUTED ABOVE
  5439                          
  5440  1059  060c                      LD      B,NAME_LENGTH; INIT MAX COUNT
  5441                          NEXT_CHAR:
  5442  105b  7e                        LD      A,(HL); GET CHAR FROM STRING
  5443  105c  fe03                      CP      ETX; HAVE WE REACHED END OF STRING?
  5444  105e  2817                      JR      Z,EOS; BRANCH IF YES
  5445  1060  1a                        LD      A,(DE); GET CHAR FROM DIR ENTRY
  5446  1061  be                        CP      (HL); COMPARE TO STRING
  5447  1062  2007                      JR      NZ,MATCHLESS; BRANCH IF DIFFERENT
  5448  1064  23                        INC     HL; ELSE INC. POINTERS
  5449  1065  13                        INC     DE
  5450  1066  10f3                      DJNZ    NEXT_CHAR; LOOP IF MORE CHARS TO LOOK AT
  5451  1068  c1                        POP     BC; POP AF INTO BC
  5452  1069  1812                      JR      MATCH; ALL 12 MATCH IF WE GET HERE!
  5453                          MATCHLESS:
  5454  106b  f1                        POP     AF; COMPARE BASE OR BASE&EXTENSION
  5455  106c  3014                      JR      NC,NO_MATCH; NEEDED TO COMPARE THE WHOLE FILE NAME
  5456                          ; ONLY COMPARE THE BASE
  5457  106e  23                        INC     HL; POINT TO NEXT CHAR OF NAME STRING
  5458  106f  13                        INC     DE; AND DIR ENTRY NAME
  5459  1070  7e                        LD      A,(HL)
  5460  1071  fe03                      CP      ETX; IS IT ETX?
  5461  1073  200d                      JR      NZ,NO_MATCH; NOPE, DOES NOT MATCH
  5462  1075  1801                      JR      AROUND_POP
  5463                          
  5464                          EOS:
  5465  1077  c1                        POP     BC; AF INTO BC TO PRESERVE AF
  5466                          AROUND_POP:
  5467  1078  1a                        LD      A,(DE); LOOK AT CHAR IN DIR ENTRY
  5468                          ; DLS(8/29/83) CHANGED SPACE TO ETX.
  5469  1079  fe03                      CP      ETX; END OF FILE NAME?
  5470  107b  2005                      JR      NZ,NO_MATCH; BRANCH IF NOT
  5471                          MATCH:
  5472  107d  c1                        POP     BC; RESTORE REG'S
  5473  107e  d1                        POP     DE
  5474  107f  e1                        POP     HL
  5475  1080  af                        XOR     A; SHOW THE MATCH
  5476  1081  c9                        RET
  5477                          NO_MATCH:
  5478  1082  c1                        POP     BC; RESTORE REG'S
  5479  1083  d1                        POP     DE
  5480  1084  e1                        POP     HL
  5481  1085  3e08                      LD      A,MATCH_ERR
  5482  1087  b7                        OR      A
  5483  1088  c9                        RET; RETURN WITH NZ CONDITION
  5484                          
  5485                          
  5486                          ;***************************************************************
  5487                          ;
  5488                          ;
  5489                          ; THIS ROUTINE CHECKS TO SEE IF THE FILENAME (POINTED TO BY HL)
  5490                          ; IS ALREADY OPEN AND EXIST IN THE FCB
  5491                          ;
  5492                          ;             INPUT:   HL        POINTER TO FILENAME (ETX TERMINATED)
  5493                          ;
  5494                          ;             OUTPUT:  CONDITION FLAGS
  5495                          ;                      NZ        NOT IN FCB (NOT OPENED)
  5496                          ;                                A = ERROR CODE
  5497                          ;                                HL = ORIGINAL POINTER TO FILENAME
  5498                          ;                      Z         IN FCB
  5499                          ;                                A = FILE NUMBER
  5500                          ;                                B = MODE
  5501                          ;                                HL = POINTER TO START OF FCB
  5502                          ;
  5503                          ;***************************************************************
  5504                          ;
  5505                          ; GET_OUT                  U_GET_OUT
  5506                          ; NEXT_FCB CHANGED TO U_NEXT_FCB TO PREVENT CONFLICT WITH
  5507                          ; IDENTICAL LABEL ELSEWHERE
  5508                          
  5509                          ;GLB    __CHECK_FCB
  5510                          ;EXT    FILE_NUMBR
  5511                          
  5512                          __CHECK_FCB:
  5513  1089  dde5                      PUSH    IX
  5514  108b  d5                        PUSH    DE
  5515                          ;       PUSH    BC
  5516  108c  e5                        PUSH    HL
  5517                          
  5518  108d  2a9d00                    LD      HL,(FCB_HEAD_ADDR)
  5519  1090  af                        XOR     A; ZERO OUT A
  5520                          U_NEXT_FCB:
  5521  1091  3c                        INC     A; CONTAINS THE FILE NUMBER
  5522  1092  327700                    LD      (FILE_NUMBR),A; (THE POSITION ON THE TAPE)
  5523                          
  5524  1095  112300                    LD      DE,FCB_LENGTH; NUMBER OF BYTES IN EACH FCB
  5525  1098  19                        ADD     HL,DE; POINT TO NEXT FCB ENTRY
  5526                          
  5527  1099  e5                        PUSH    HL
  5528  109a  dde1                      POP     IX; IX POINTS TO START OF FCB
  5529                          
  5530  109c  dd7e18                    LD      A,(IX+FCB_MODE); GET MODE
  5531  109f  e607                      AND     MODE_MODE
  5532  10a1  fe00                      CP      0; IT IS UNUSED?
  5533                          
  5534  10a3  2812                      JR      Z,END_FCB; YUP, LOOK AT NEXT FCB
  5535  10a5  eb                        EX      DE,HL; DE = POINTER TO FCB NAME STRING
  5536  10a6  e1                        POP     HL
  5537  10a7  e5                        PUSH    HL; HL = POINTER TO FILENAME TO SEARCH FOR
  5538                          
  5539                          
  5540  10a8  d5                        PUSH    DE; DE = POINTER TO FCB FILE NAME
  5541                          
  5542  10a9  010c00                    LD      BC,NAME_LENGTH; NO. OF CHARACTERS IN NAME
  5543                          ; HL = FILE NAME STRING
  5544                          NEXT_CHAR1:
  5545  10ac  1a                        LD      A,(DE); DE = FCB FILE NAME
  5546  10ad  fe03                      CP      ETX; IS IT ETX?
  5547                          
  5548  10af  2813                      JR      Z,ITS_ETX1; YUP
  5549                          
  5550  10b1  eda1                      CPI; DO CHARS MATCH ((HL) = A)?
  5551                          
  5552  10b3  13                        INC     DE
  5553  10b4  28f6                      JR      Z,NEXT_CHAR1; YUP,CHECK NEXT CHAR OF FILE NAME
  5554                          
  5555  10b6  e1                        POP     HL; pointer to FCB
  5556                          END_FCB:
  5557  10b7  3a7700                    LD      A,(FILE_NUMBR); ARE WE AT 2ND FILE(FCB)?
  5558  10ba  fe02                      CP      NUM_FCBS-1; NO. OF FCB'S - SYSTEM FCB
  5559                          
  5560  10bc  20d3                      JR      NZ,U_NEXT_FCB; NOPE, NOT YET,
  5561                          
  5562                          NO_MATCH1:
  5563  10be  e1                        POP     HL; HL = ORIGINAL POINTER TO FILE NAME
  5564                          
  5565  10bf  3e05                      LD      A,NO_FILE_ERR; NO MATCH FOUND
  5566  10c1  b7                        OR      A
  5567  10c2  1811                      JR      GET_OUT_ERR
  5568                          
  5569                          ITS_ETX1:
  5570  10c4  7e                        LD      A,(HL); GET ASCII CHAR
  5571  10c5  fe03                      CP      ETX; IS IT ETX?
  5572  10c7  e1                        POP     HL; *pointer to FCB
  5573  10c8  20f4                      JR      NZ,NO_MATCH1; NOPE
  5574                          
  5575                          ;       PUSH    HL                       ; copy pointer to FCB so can index to mode
  5576                          ;       POP     IX
  5577                          
  5578  10ca  dd7e18                    LD      A,(IX+FCB_MODE); GET MODE THIS FILE WAS ORIGINALLY
  5579  10cd  e607                      AND     MODE_MODE; OPENED FOR AND MASK OFF FLAG BITS
  5580  10cf  47                        LD      B,A; PASS IT BACK IN B
  5581                          
  5582  10d0  af                        XOR     A; INDICATE Z CONDITION
  5583  10d1  3a7700                    LD      A,(FILE_NUMBR); GET FILE NUMBER
  5584                          
  5585                          U_GET_OUT:
  5586  10d4  d1                        POP     DE; *Clear off pointer to name
  5587                          ;       POP     BC
  5588                          GET_OUT_ERR:
  5589  10d5  d1                        POP     DE
  5590  10d6  dde1                      POP     IX
  5591                          
  5592  10d8  c9                        RET
  5593                          
  5594                          
  5595                          ;---------------------------------------------------------------
  5596                          ;
  5597                          ; MODE_CHECK: sees if an attribute byte matches a permission request.
  5598                          ;
  5599                          ; ENTRY PARAMETERS: IX- FCB POINTER
  5600                          ;                   HL- DIR ENTRY
  5601                          ; EXIT PARAMETERS:   Z=1=OK
  5602                          ;                    Z=0=NO WAY
  5603                          ;                    A=TRASH
  5604                          ;                    IX AND HL PRESERVED
  5605                          ; DLS(8/30/83)
  5606                          ;---------------------------------------------------------------
  5607                          
  5608                          ; OK CHANGED TO U_OK TO PREVENT CONFLICT WITH IDENTICAL
  5609                          ;LABEL ELSEWHERE
  5610                          
  5611                          ;MODE_CHECK:
  5612                          __MODE_CHECK:; [RECON] OCR 5675-5676 prints two coincident labels; exported implementation label restored.
  5613                          MODE_CHECK: ; [RECON] Preserved coincident historical local label from OCR 5675-5676.
  5614                          
  5615  10d9  fde5                      PUSH    IY; SAVE REG IY
  5616  10db  e5                        PUSH    HL; SAVE DIR ENTRY
  5617  10dc  dd7e18                    LD      A,(IX+FCB_MODE); GET THE MODE THE USER PASSED IN
  5618                          ;
  5619                          ; RANGE CHECK THIS REQUEST
  5620                          ;
  5621  10df  e607                      AND     MODE_MODE; AND OFF TEST BITS
  5622  10e1  fe00                      CP      0; MAKE SURE HE'S IN RANGE
  5623  10e3  281f                      JR      Z,RANGE_NONO
  5624  10e5  fe05                      CP      MODE_MAX+1
  5625  10e7  301b                      JR      NC,RANGE_NONO
  5626                          ;
  5627  10e9  210000                    LD      HL,ATTRIB_TBL; INDEX INTO THE MASK TABLE
  5628  10ec  85                        ADD     A,L
  5629  10ed  6f                        LD      L,A
  5630  10ee  3001                      JR      NC,ADJUST
  5631  10f0  24                        INC     H
  5632                          ADJUST:
  5633  10f1  fde1                      POP     IY; GET THE DIR ENTRY POINTER INTO IY
  5634  10f3  fde5                      PUSH    IY
  5635  10f5  fd7e0c                    LD      A,(IY+DIR_ATTR); GRAB HIS ATTRIBUTE BYTE
  5636  10f8  a6                        AND     (HL); COMPARE IT TO THE USER'S REQUEST
  5637  10f9  2005                      JR      NZ,PROTECT_FAULT
  5638                          U_OK:
  5639  10fb  e1                        POP     HL
  5640  10fc  fde1                      POP     IY
  5641  10fe  af                        XOR     A; INDICATE ALL IS WELL
  5642  10ff  c9                        RET
  5643                          PROTECT_FAULT:
  5644  1100  3e14                      LD      A,PRT_ERR
  5645  1102  1802                      JR      PROTECT
  5646                          RANGE_NONO:
  5647  1104  3e11                      LD      A,RANGE_ERR
  5648                          PROTECT:
  5649  1106  e1                        POP     HL
  5650  1107  fde1                      POP     IY
  5651  1109  b7                        OR      A; INDICATE ERROR
  5652  110a  c9                        RET
  5653                          ATTRIB_TBL     EQU     $-1
  5654  110b  20                        DEFB    ATTR_READ_PROT
  5655  110c  40                        DEFB    ATTR_WRITE_PROT
  5656  110d  80                        DEFB    ATTR_PERMANENT
  5657  110e  02                        DEFB    ATTR_EXECUTE
  5658                          
  5659                          
  5660                          
  5661                          ;***************************************************************
  5662                          ;******************** EOS_RENAME_FILE ***************************
  5663                          ;
  5664                          ; ON ENTRY:   A  = DEVICE NUMBER (8=TAPE1)
  5665                          ;             DE = POINTER TO OLD FILENAME
  5666                          ;             HL = POINTER TO NEW FILENAME
  5667                          ;
  5668                          ; ON EXIT:    Z = 1, FILE RENAMED.  A = 0
  5669                          ;             Z = 0, FILE NOT RENAMED. A = ERROR CODE
  5670                          ;
  5671                          
  5672                          ;GLB    __RENAME_FILE
  5673                          
  5674                          __RENAME_FILE:
  5675  110f  c5                        PUSH    BC
  5676  1110  f5                        PUSH    AF; AF = DEVICE ID
  5677  1111  d5                        PUSH    DE; DE = POINTER TO OLD FILENAME
  5678  1112  e5                        PUSH    HL; HL = POINTER TO NEW FILENAME
  5679  1113  eb                        EX      DE,HL; FIRST CHECK IF A FILE EXIST W/NEW FILE NAME
  5680  1114  214000                    LD      HL,QUERY_BUFFER
  5681  1117  cd1b06                    CALL    __QUERY_FILE
  5682  111a  282c                      JR      Z,NOT_RENAMED; YUP, THE NEW FILE NAME ALREADY EXISTS
  5683  111c  e1                        POP     HL
  5684  111d  d1                        POP     DE
  5685  111e  f1                        POP     AF
  5686  111f  f5                        PUSH    AF
  5687  1120  d5                        PUSH    DE
  5688  1121  e5                        PUSH    HL
  5689                          
  5690  1122  214000                    LD      HL,QUERY_BUFFER
  5691  1125  cd1b06                    CALL    __QUERY_FILE; NOW CHECK IF OLD FILE EXISTS
  5692  1128  201e                      JR      NZ,NOT_RENAMED; NOPE
  5693  112a  114000                    LD      DE,QUERY_BUFFER; DE = DESTINATION
  5694  112d  e1                        POP     HL; HL = PTR TO NEW FILENAME
  5695  112e  e5                        PUSH    HL
  5696  112f  010c00                    LD      BC,12; NUMBER OF BYTES TO REPLACE
  5697  1132  edb0                      LDIR
  5698  1134  e1                        POP     HL
  5699  1135  d1                        POP     DE; DE = POINTER TO OLD FILENAME
  5700  1136  f1                        POP     AF; A = DEVICE ID
  5701  1137  f5                        PUSH    AF
  5702  1138  d5                        PUSH    DE; RESTORE STACK
  5703  1139  e5                        PUSH    HL
  5704  113a  214000                    LD      HL,QUERY_BUFFER
  5705  113d  cd5106                    CALL    __SET_FILE; CHANGE FILENAME
  5706  1140  2006                      JR      NZ,NOT_RENAMED
  5707  1142  af                        XOR     A; GOOD RETURN
  5708  1143  e1                        POP     HL
  5709  1144  d1                        POP     DE
  5710  1145  c1                        POP     BC; REALLY AF BUT NEED TO PRESERVE FLAGS FOR RET
  5711  1146  c1                        POP     BC
  5712  1147  c9                        RET
  5713                          NOT_RENAMED:
  5714                          ;         LD      A,RENAME_ERR             ; ERROR RETURN ; [RECON] OCR 5778 is commented; production preserves the error already in A.
  5715  1148  b7                        OR      A

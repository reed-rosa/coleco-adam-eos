  6052                          ;
  6053                          ;***************************************************************
  6054                          ;***************************************************************
  6055                          
  6056                          ;GLB    __TRIM_FILE
  6057                          
  6058                          ;EXT    FCB_BUFFER
  6059                          ;EXT    NEW_HOLE_SIZE
  6060                          ;EXT    HOLE_FILE_NAME

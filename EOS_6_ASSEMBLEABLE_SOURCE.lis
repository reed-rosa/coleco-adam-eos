  6228                          ;***************************************************************
  6229                          ;
  6230                          ;     __INIT_TP_DIR INITIALIZES THE TAPE DIRECTORY
  6231                          ;
  6232                          ;     INPUT:  A       DEVICE ID
  6233                          ;                     LOW NIBBLE - DEVICE ADDRESS
  6234                          ;                     HI NIBBLE  - SECONDARY DEVICE ID
  6235                          ;
  6236                          ;             C       NUMBER OF SECTORS IN DIRECTORY
  6237                          ;             DE      NUMBER OF SECTORS ON DEVICE
  6238                          ;
  6239                          ;             HL      POINTER TO ASCII ETX TERMINATED STRING
  6240                          ;                     ( VOLUME ID) (SHOULD BE BLANK-PADDED IF
  6241                          ;                     LESS THAN 12 CHARACTERS)
  6242                          ;     OUTPUT:
  6243                          ;             CONDITION FLAGS
  6244                          ;             Z       NO ERROR
  6245                          ;             NZ      ERROR
  6246                          ;                     A = ERROR CODE
  6247                          ;
  6248                          ;***************************************************************
  6249                          
  6250                          ;GLB    __INIT_TAPE_DIR
  6251                          ;GLB    HOLE_FILE_NAME
  6252                          ;GLB    DIRECTORY_CHECK
  6253                          
  6254                          ;EXT    SECTOR_NO
  6255                          ;EXT    DEVICE_ID
  6256                          ;EXT    FCB_DATA_ADDR
  6257                          ;EXT    SECTORS_TO_INIT
  6258                          ;EXT    WRITE_BLOCK
  6259                          
  6260                          __INIT_TAPE_DIR:
  6261                          
  6262  1323  fde5                      PUSH    IY
  6263  1325  c5                        PUSH    BC
  6264  1326  d5                        PUSH    DE
  6265  1327  e5                        PUSH    HL
  6266                          
  6267  1328  321200                    LD      (DEVICE_ID),A; SAVE THE DEVICE ID
  6268                          
  6269  132b  79                        LD      A,C
  6270  132c  322600                    LD      (SECTORS_TO_INIT),A; NO OF SECTORS TO INITIALIZE
  6271                          
  6272  132f  e5                        PUSH    HL
  6273                          
  6274  1330  cdaf13                    CALL    ZERO_OUT_BUFFER; ZERO OUT THE 1K BUFFER
  6275                          
  6276  1333  21da13                    LD      HL,INITIAL_DIRECTORY; POINTER TO INITIAL SETUP
  6277  1336  ed5b9f00                  LD      DE,(FCB_DATA_ADDR); ADDRESS OF 1K BUFFER
  6278  133a  016800                    LD      BC,DIR_ENT_LENGTH*3+VOL_DES_LENGTH; # BYTES TO MOVE INTO BUFFER ; [RECON] OCR 6348: scan bytes are 01 68 00.
  6279  133d  edb0                      LDIR
  6280                          
  6281  133f  e1                        POP     HL; GET ADDR OF ETX TERMINATED ASCII STRING
  6282                          
  6283  1340  ed5b9f00                  LD      DE,(FCB_DATA_ADDR); GET ADDRESS OF 1K BUFFER
  6284  1344  060c                      LD      B,12; MAX OF 12 BYTES IN STRING
  6285                          
  6286                          LOAD_DIR:
  6287  1346  7e                        LD      A,(HL); GET ASCII CHAR OF VOLUME ID
  6288  1347  fe03                      CP      ETX; IS IT ETX?
  6289                          
  6290  1349  2808                      JR      Z,ITS_AN_ETX; YUP
  6291                          
  6292  134b  12                        LD      (DE),A; NOPE,PUT IN THE 1K BUFFER
  6293                          
  6294  134c  23                        INC     HL
  6295  134d  13                        INC     DE
  6296                          
  6297  134e  10f6                      DJNZ    LOAD_DIR
  6298                          
  6299  1350  3e03                      LD      A,ETX
  6300  1352  1b                        DEC     DE
  6301                          
  6302                          ITS_AN_ETX:
  6303  1353  12                        LD      (DE),A; ETX TERMINATED DIRECTORY NAME
  6304  1354  fd2a9f00                  LD      IY,(FCB_DATA_ADDR); POINTER TO 1K BUFFER
  6305                          
  6306  1358  3a2600                    LD      A,(SECTORS_TO_INIT); GET THE NO OF SECTORS TO INITIALIZE
  6307  135b  f680                      OR      080H; SET HI BIT
  6308  135d  fd770c                    LD      (IY+VOL_DIRSIZE),A; SAVE IN FIRST BYTE OF BUFFER
  6309                          
  6310  1360  e1                        POP     HL
  6311  1361  d1                        POP     DE
  6312  1362  c1                        POP     BC
  6313                          
  6314  1363  c5                        PUSH    BC
  6315  1364  d5                        PUSH    DE
  6316  1365  e5                        PUSH    HL
  6317                          
  6318  1366  fd7311                    LD      (IY+VOL_SIZE+0),E
  6319  1369  fd7212                    LD      (IY+VOL_SIZE+1),D
  6320                          
  6321  136c  d5                        PUSH    DE; GET TO FIRST DIR ENTRY
  6322  136d  114e00                    LD      DE,VOL_DES_LENGTH+DIR_ENT_LENGTH*2; POINT TO FIRST FILE ENTRY ; [RECON] OCR 6392: scan bytes are 11 4E 00.
  6323  1370  fd19                      ADD     IY,DE
  6324  1372  d1                        POP     DE
  6325                          
  6326  1373  fd71f7                    LD      (IY+DIR_MAX_LENGTH-DIR_ENT_LENGTH),C; BLOCKS ALLOCATED FOR DIRECTORY
  6327  1376  fd71f9                    LD      (IY+DIR_USED_LENGTH-DIR_ENT_LENGTH),C; MAKE USED BLOCKS AS LARGE AS POSSIBLE
  6328                          
  6329  1379  0c                        INC     C; FIRST "FILE" STARTS AFTER
  6330  137a  fd710d                    LD      (IY+DIR_START_BLOCK),C; LAST SECTOR OF DIR
  6331                          
  6332  137d  0600                      LD      B,0; WANT BC = # SECTORS USED
  6333                          ; (# DIR SECT + 1 TO COVER
  6334                          ; SECT 0)
  6335                          
  6336  137f  eb                        EX      DE,HL; HL = # SECTORS ON DEVICE
  6337  1380  b7                        OR      A; CLEAR CARRY
  6338  1381  ed42                      SBC     HL,BC; HL = # SECTORS LEFT FOR FILES ?????
  6339                          
  6340  1383  fd7511                    LD      (IY+DIR_MAX_LENGTH+0),L
  6341  1386  fd7412                    LD      (IY+DIR_MAX_LENGTH+1),H
  6342                          
  6343  1389  3e01                      LD      A,1; FIRST SECTOR
  6344  138b  322700                    LD      (SECTOR_NO),A
  6345                          
  6346  138e  cdc513                    CALL    WRITE_1_BLOCK; WRITE BLOCK TO TAPE
  6347                          
  6348  1391  2016                      JR      NZ,WE_GOT_ERRORS; CAME BACK WITH ERROR
  6349                          
  6350  1393  3a2600                    LD      A,(SECTORS_TO_INIT); GET NO OF SECTORS TO INITIALIZE
  6351                          
  6352  1396  47                        LD      B,A
  6353  1397  05                        DEC     B; ONE LESS BECAUSE ONE WAS JUST INITIALIZED
  6354                          
  6355  1398  280e                      JR      Z,NO_SECTORS_TO_INIT; WAS ONLY ONE TO INIT
  6356                          
  6357  139a  cdaf13                    CALL    ZERO_OUT_BUFFER; CLEAR 1K BUFFER
  6358                          
  6359                          SECT_INIT_LOOP:
  6360  139d  212700                    LD      HL,SECTOR_NO; SECTOR NO.
  6361  13a0  34                        INC     (HL); NEXT SECTOR
  6362                          
  6363  13a1  cdc513                    CALL    WRITE_1_BLOCK; WRITE BLOCK OF ZEROS OUT
  6364  13a4  2003                      JR      NZ,WE_GOT_ERRORS; GOT A ERROR IN WRITE
  6365                          
  6366  13a6  10f5                      DJNZ    SECT_INIT_LOOP
  6367                          
  6368                          NO_SECTORS_TO_INIT:
  6369                          
  6370  13a8  af                        XOR     A; ZERO CONDITION
  6371                          
  6372                          WE_GOT_ERRORS:
  6373                          
  6374  13a9  e1                        POP     HL
  6375  13aa  d1                        POP     DE
  6376  13ab  c1                        POP     BC
  6377  13ac  fde1                      POP     IY
  6378                          
  6379  13ae  c9                        RET
  6380                          
  6381                          
  6382                          
  6383                          ZERO_OUT_BUFFER:
  6384                          
  6385  13af  c5                        PUSH    BC
  6386  13b0  d5                        PUSH    DE
  6387  13b1  e5                        PUSH    HL
  6388                          
  6389  13b2  2a9f00                    LD      HL,(FCB_DATA_ADDR); POINTER TO 1K BUFFER
  6390  13b5  ed5b9f00                  LD      DE,(FCB_DATA_ADDR)
  6391  13b9  13                        INC     DE
  6392  13ba  01ff03                    LD      BC,1023
  6393                          
  6394  13bd  3600                      LD      (HL),0; ZERO IT OUT
  6395                          
  6396  13bf  edb0                      LDIR
  6397                          
  6398  13c1  e1                        POP     HL
  6399  13c2  d1                        POP     DE
  6400  13c3  c1                        POP     BC
  6401                          
  6402  13c4  c9                        RET
  6403                          
  6404                          
  6405                          WRITE_1_BLOCK:
  6406  13c5  c5                        PUSH    BC
  6407                          
  6408  13c6  2a9f00                    LD      HL,(FCB_DATA_ADDR); ADDRESS OF 1K BUFFER
  6409  13c9  3a2700                    LD      A,(SECTOR_NO); GET SECTOR NUMBER
  6410  13cc  5f                        LD      E,A
  6411  13cd  1600                      LD      D,0
  6412  13cf  010000                    LD      BC,0
  6413                          
  6414  13d2  3a1200                    LD      A,(DEVICE_ID)
  6415                          
  6416  13d5  cde611                    CALL    WRITE_BLOCK; WRITE IT OUT
  6417                          
  6418  13d8  c1                        POP     BC
  6419                          
  6420  13d9  c9                        RET
  6421                          
  6422                          

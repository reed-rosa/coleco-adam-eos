  5770                          ;***************************************************************
  5771                          ;***************************************************************
  5772                          ;
  5773                          ;
  5774                          ;     READ_BLOCK:
  5775                          ;             1)  READS 1 BLOCK OFF OF SPECIFIED DEVICE
  5776                          ;             2)  REQUESTS FOR THE STATUS
  5777                          ;             3)  AND SENDS ANOTHER READ TO THE DEVICE
  5778                          ;
  5779                          ;     INPUT:  SAME AS FOR __RD_1_BLOCK
  5780                          ;             A       DEVICE ID
  5781                          ;                     LOW NIBBLE - DEVICE ADDRESS
  5782                          ;                     HI NIBBLE  - SECONDARY DEVICE ID
  5783                          ;
  5784                          ;             HL      DESTINATION IN RAM
  5785                          ;
  5786                          ;             REGISTER PAIR  BC DE
  5787                          ;                            SECTOR NUMBER ON DEVICE
  5788                          ;
  5789                          ;
  5790                          ;     OUTPUT: CONDITION FLAGS
  5791                          ;                     Z:  NO ERRORS
  5792                          ;                    NZ:  ERROR OCCURED
  5793                          ;                         A - ERROR CODE
  5794                          ;
  5795                          ;     ALL REGISTERS ARE PRESERVED EXCEPT FOR AF
  5796                          ;
  5797                          ;***************************************************************
  5798                          ;***************************************************************
  5799                          
  5800                          __READ_BLOCK:
  5801                          READ_BLOCK:
  5802  117b  c5                        PUSH    BC
  5803  117c  d5                        PUSH    DE
  5804  117d  e5                        PUSH    HL
  5805  117e  dde5                      PUSH    IX
  5806  1180  fde5                      PUSH    IY
  5807  1182  f5                        PUSH    AF
  5808                          
  5809  1183  3e02                      LD      A,ERROR_RETRY; RETRY COUNT FOR ERRORS
  5810  1185  327600                    LD      (RETRY_COUNT),A
  5811                          READ_LOOP:
  5812  1188  f1                        POP     AF; GET DEVICE ID BACK IN A
  5813  1189  f5                        PUSH    AF
  5814                          
  5815  118a  cd9e1a                    CALL    __RD_1_BLOCK
  5816                          
  5817  118d  280e                      JR      Z,NO_READ_ERRORS; READ WENT OK
  5818                          
  5819  118f  fe9b                      CP      TIMEOUT; WAS IT A TIMEOUT?
  5820                          
  5821  1191  280a                      JR      Z,NO_READ_ERRORS; YUP,
  5822                          
  5823  1193  e5                        PUSH    HL
  5824  1194  217600                    LD      HL,RETRY_COUNT
  5825  1197  35                        DEC     (HL); DEC THE NO OF RETRY'S LEFT
  5826  1198  e1                        POP     HL
  5827  1199  283f                      JR      Z,READ_ERROR; NO RETRY'S LEFT
  5828  119b  18eb                      JR      READ_LOOP; TRY AGAIN
  5829                          
  5830                          NO_READ_ERRORS:
  5831  119d  0602                      LD      B,ERROR_RETRY; NUMBER OF TIMES TO RETRY
  5832                          
  5833                          RETRY_FOR_ERRORS:
  5834  119f  f1                        POP     AF; RESTORE DEVICE ID
  5835  11a0  f5                        PUSH    AF
  5836                          
  5837  11a1  cd7314                    CALL    __REQUEST_STATUS; GET STATUS
  5838                          
  5839  11a4  2808                      JR      Z,READ_COMMAND_COMPLETED; READ ALL DONE
  5840                          
  5841  11a6  fe9b                      CP      TIMEOUT; WAS IT A TIMEOUT?
  5842  11a8  28f5                      JR      Z,RETRY_FOR_ERRORS; NOT A REAL ERROR, DON'T NEED TO DEC COUNTER ; [RECON] Identifier repair: branch targets printed label RETRY_FOR_ERRORS at OCR 5899.
  5843                          
  5844  11aa  10f3                      DJNZ    RETRY_FOR_ERRORS; IT'S A REAL ERROR, TRY AGAIN ; [RECON] Identifier repair: branch targets printed label RETRY_FOR_ERRORS at OCR 5899.
  5845                          
  5846  11ac  182c                      JR      READ_ERROR; CAN'T GET STATUS, GET OUT
  5847                          
  5848                          READ_COMMAND_COMPLETED:
  5849  11ae  f1                        POP     AF; RESTORE DEVICE ID
  5850  11af  f5                        PUSH    AF
  5851                          
  5852  11b0  cd2512                    CALL    GET_STATUS_FLAG; GET THE STATUS FOR THE PROPER
  5853                          ; DEVICE IN THE A REGISTER
  5854                          
  5855  11b3  fe00                      CP      0; ANY ERRORS WITH DRIVE?
  5856                          
  5857  11b5  2023                      JR      NZ,READ_ERROR; YUP
  5858                          
  5859  11b7  3e02                      LD      A,ERROR_RETRY
  5860  11b9  327600                    LD      (RETRY_COUNT),A
  5861                          
  5862  11bc  f1                        POP     AF
  5863  11bd  fde1                      POP     IY
  5864  11bf  dde1                      POP     IX
  5865  11c1  e1                        POP     HL
  5866  11c2  d1                        POP     DE
  5867  11c3  c1                        POP     BC
  5868  11c4  c5                        PUSH    BC
  5869                          _2ND_READ:
  5870  11c5  f5                        PUSH    AF
  5871                          
  5872  11c6  cd9e1a                    CALL    __RD_1_BLOCK; SEND ANOTHER READ COMMAND
  5873  11c9  280c                      JR      Z,NO_ERRORS
  5874  11cb  e5                        PUSH    HL
  5875  11cc  217600                    LD      HL,RETRY_COUNT
  5876  11cf  35                        DEC     (HL); THE NO OF RETRY'S
  5877  11d0  e1                        POP     HL
  5878  11d1  2803                      JR      Z,RETRY_LIMIT_REACHED; NO RETRY'S LEFT ; [RECON] Uncertain listing/ROM discrepancy: bytes 28 03 target local cleanup at $F1D6.
  5879  11d3  f1                        POP     AF
  5880                          
  5881  11d4  18ef                      JR      _2ND_READ; GO TRY AGAIN
  5882                          
  5883                          RETRY_LIMIT_REACHED: ; [RECON] ROM branch at $F1D0 targets this cleanup at $F1D6; printed target is unresolved.
  5884  11d6  b7                        OR      A; NZ CONDITION
  5885                          NO_ERRORS:

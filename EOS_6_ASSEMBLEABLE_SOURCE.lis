  7038                          ;****************************************************************
  7039                          ;
  7040                          ;       __END_PR_CH    CALLS __END_PR_BUFF TO CHECK THE DCB STATUS BYTE AND
  7041                          ;       RETURNS THE RESULT TO THE CALLER
  7042                          ;
  7043                          ;       INPUT:  NONE
  7044                          ;
  7045                          ;       OUTPUT: CONDITION FLAGS
  7046                          ;               C:      COMMAND COMPLETED
  7047                          ;               NC:     COMMAND NOT COMPLETED
  7048                          ;               Z:      NO ERRORS OCCURED
  7049                          ;               NZ:     ERRORS
  7050                          ;                       A = ERROR CODE
  7051                          ;
  7052                          ;       ALL     REGISTERS ARE PRESERVED

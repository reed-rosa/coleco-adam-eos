  7238                          ;                        Rev History
  7239                          ;                        Rev   Date        Name       Change
  7240                          ;                        18    30sept400p  RPD        extracted RAM areas and put into EOS_COMM
  7241                          ;                        17    21Sept83_1440 JKL      take out stuff that EOS does not need. put CR back to normal
  7242                          ;                                                     take out flashing cursor
  7243                          ;                        16    19Sept83_1730 JKL      CR now does a clear to EOL and LF
  7244                          ;                        15    18Sept83_1800 JKL      CR now does a CLEAR to EOL
  7245                          ;                        14    15Sept83_1600 JKL      added routine to flash cursor
  7246                          ;                        13    15Sept83    JKL        XOR cursor with char that is under. take out print screen
  7247                          ;                        12    14Sept83    JKL        include print screen
  7248                          ;                        11    14Sept83    JKL        return cursor position in DE
  7249                          ;                        10    06Sept83    JKL        added routine to return cursor position in window
  7250                          ;                        9     05Sept83    JKL        fix for SHIFT LOCK back space. to be removed later
  7251                          ;                        8     04Sept83    JKL        added delete char and shift left
  7252                          ;                        7     04Sept83    JKL        added insert blank, made LINEBUFFER_ 33 chars long
  7253                          ;                        6     03Sept83    JKL        INIT will set cursor pos
  7254                          ;                        5     03Sept83    JKL        Added return cursor pos routine
  7255                          ;                        4     01Sept83    JKL        Fixes and speedups, Major rewrite
  7256                          ;                        3     27Aug83     RPD        new case implementation (jump table)
  7257                          ;                        2     27Aug83     RPD        added scroll
  7258                          ;                        1     26Aug83     RPD        moved to EOS. contains window and XY logic
  7259                          ;                        0     26Aug83     RPD        copied from old EOS. uses WRITE and READ VRAM
  7260                          ;                        - - - - - - - - - - - - -
  7261                          
  7262                          ;
  7263                          ;External Routines
  7264                          ;
  7265                          ;EXT    WRITE_VRAM       ;OS-7
  7266                          ;EXT    READ_VRAM        ;OS-7
  7267                          ;
  7268                          ;External data structures used
  7269                          ;
  7270                          ;EXT    OLDCHAR_
  7271                          ;EXT    X_MIN
  7272                          ;EXT    X_MAX
  7273                          ;EXT    Y_MIN
  7274                          ;EXT    Y_MAX
  7275                          ;EXT    LINEBUFFER_
  7276                          ;EXT    NUM_LINES
  7277                          ;EXT    NUM_COLUMNS
  7278                          ;EXT    UPPER_LEFT
  7279                          ;EXT    PTRN_NAME_TBL
  7280                          ;EXT    CURSOR
  7281                          
  7282                          
  7283                          ;
  7284                          ;Local Equates
  7285                          ;
  7286                          LF              EQU     0AH
  7287                          FF              EQU     0CH
  7288                          BS              EQU     08H
  7289                          CR              EQU     0DH
  7290                          CLR_TO_EOL      EQU     16H
  7291                          CLR_TO_EOS      EQU     18H; [RECON] OCR 7363: scan value column is <0018>.
  7292                          GOTO_XY_CHAR    EQU     1CH
  7293                          HOME            EQU     80H
  7294                          UP              EQU     0A0H
  7295                          RIGHT           EQU     0A1H
  7296                          DOWN            EQU     0A2H
  7297                          LEFT            EQU     0A3H
  7298                          CURSOR_CHAR     EQU     05FH;Char to emit as cursor
  7299                          BLANKING_CHAR   EQU     020H;Char used when scrolling to fill screen ; [RECON] OCR 7371: scan value column is <0020> (space).
  7300                          CURSOR_X        EQU     CURSOR+1
  7301                          
  7302                          
  7303                          ;
  7304                          ;__CONS_INIT
  7305                          ;
  7306                          ;       Sets up the window sizes for the CONSOLE_OUT routine
  7307                          ;
  7308                          ;Input parameters:
  7309                          ; B - number of columns in the window - 1, 0..31
  7310                          ; C - number of lines in the window - 1, 0..23
  7311                          ; D - Absolute (0 based) X coord of upper left corner of window, 0..31
  7312                          ; E - Absolute (0 based) Y coord of upper left corner of window, 0..23
  7313                          ; HL - Pattern Name Table (PNT) starting address
  7314                          ;
  7315                          ;NOTE- User must initialize the VDP
  7316                          ;
  7317                          ;GLB    __CONS_INIT
  7318                          __CONS_INIT:
  7319  15dc  04                        INC     B;Adjust for old calling convention
  7320  15dd  0c                        INC     C
  7321  15de  ed433f01                  LD      (NUM_LINES),BC;Set num lines, cols in window
  7322  15e2  ed534101                  LD      (UPPER_LEFT),DE;Set upper left corner of window
  7323  15e6  ed534501                  LD      (CURSOR),DE
  7324  15ea  224301                    LD      (PTRN_NAME_TBL),HL;Save address of Pattern name table
  7325                          
  7326  15ed  7a                        LD      A,D;Calc min/max coords of window
  7327  15ee  321a01                    LD      (X_MIN),A
  7328  15f1  80                        ADD     A,B
  7329  15f2  3d                        DEC     A
  7330  15f3  321b01                    LD      (X_MAX),A
  7331  15f6  7b                        LD      A,E
  7332  15f7  321c01                    LD      (Y_MIN),A
  7333  15fa  81                        ADD     A,C
  7334  15fb  3d                        DEC     A
  7335  15fc  321d01                    LD      (Y_MAX),A
  7336                          
  7337  15ff  3e20                      LD      A,BLANKING_CHAR
  7338  1601  321901                    LD      (OLDCHAR_),A
  7339  1604  3e5f                      LD      A,CURSOR_CHAR
  7340  1606  cdda17                    CALL    PUT_CHAR_ON_SCREEN
  7341                          
  7342  1609  c9                        RET
  7343                          
  7344                          ;
  7345                          ;__CONS_OUT  - This entry point will check special chars such as
  7346                          ;              Carriage Return and performs their normal functions
  7347                          ;              all other, printable, chars are put onto the screen
  7348                          ;
  7349                          ;__CONS_DISP - This entry point will put all chars onto the screen
  7350                          ;              no matter what, no checking is done for control chars
  7351                          ;
  7352                          ;
  7353                          ;Input Parameters:
  7354                          ; A - character to emit
  7355                          ;
  7356                          ; optionally
  7357                          ; E - Y location to goto (must be in window)
  7358                          ; D - X location to goto (must be in window)
  7359                          ;
  7360                          ;
  7361                          ; Saves all registers
  7362                          ;
  7363                          ;GLB    __CONS_OUT
  7364                          ;GLB    __CONS_DISP
  7365                          __CONS_OUT:
  7366  160a  f5                        PUSH    AF
  7367  160b  c5                        PUSH    BC
  7368  160c  e5                        PUSH    HL
  7369  160d  dde5                      PUSH    IX
  7370  160f  fde5                      PUSH    IY
  7371  1611  d5                        PUSH    DE;This may contain the X-Y coord of goto xy
  7372                          
  7373  1612  210e18                    LD      HL,SPECIAL_CHARS
  7374  1615  010c00                    LD      BC,NUM_SPCL_CHARS
  7375  1618  edb1                      CPIR
  7376  161a  2013                      JR      NZ,NOT_SPECIAL
  7377                          
  7378  161c  211a18                    LD      HL,SPCL_VECTOR_TBL
  7379  161f  09                        ADD     HL,BC
  7380  1620  09                        ADD     HL,BC
  7381                          
  7382  1621  47                        LD      B,A;Save char in B
  7383                          
  7384  1622  7e                        LD      A,(HL)
  7385  1623  23                        INC     HL
  7386  1624  66                        LD      H,(HL)
  7387  1625  6f                        LD      L,A
  7388  1626  e9                        JP      (HL);Vector to special char handler
  7389                          
  7390                          __CONS_DISP:
  7391  1627  f5                        PUSH    AF
  7392  1628  c5                        PUSH    BC
  7393  1629  e5                        PUSH    HL
  7394  162a  dde5                      PUSH    IX
  7395  162c  fde5                      PUSH    IY
  7396  162e  d5                        PUSH    DE
  7397                          NOT_SPECIAL:
  7398  162f  cdda17                    CALL    PUT_CHAR_ON_SCREEN;Display char where cursor is at
  7399  1632  2a4501                    LD      HL,(CURSOR)
  7400  1635  24                        INC     H;Move cursor to right (+1)
  7401  1636  3a1b01                    LD      A,(X_MAX); but check for going out of
  7402  1639  bc                        CP      H; the window
  7403  163a  3014                      JR      NC,SAVE_CURSOR;If taken then stayed in window
  7404  163c  3a1a01                    LD      A,(X_MIN);Went out of window so set X
  7405  163f  67                        LD      H,A; to left edge
  7406  1640  2c                        INC     L; and move down one line
  7407  1641  3a1d01                    LD      A,(Y_MAX); but check to see if still
  7408  1644  bd                        CP      L; in the window
  7409  1645  3009                      JR      NC,SAVE_CURSOR
  7410  1647  2d                        DEC     L; Put back into window
  7411  1648  e5                        PUSH    HL
  7412  1649  cded17                    CALL    GET_CHAR_UNDER_CURSOR
  7413  164c  cd9417                    CALL    SCROLL_UP
  7414  164f  e1                        POP     HL
  7415                          
  7416  1650  224501            SAVE_CURSOR: LD      (CURSOR),HL
  7417  1653  cdf017            NEW_CURSOR: CALL    GET_CHAR_UNDER
  7418                          PUT_CURSOR_ON:
  7419  1656  3e5f                      LD      A,CURSOR_CHAR
  7420  1658  cdda17                    CALL    PUT_CHAR_ON_SCREEN
  7421                          
  7422  165b  d1                EXIT: POP     DE
  7423  165c  fde1                      POP     IY
  7424  165e  dde1                      POP     IX
  7425  1660  e1                        POP     HL
  7426  1661  c1                        POP     BC
  7427  1662  f1                        POP     AF
  7428  1663  c9                        RET
  7429                          
  7430                          ;
  7431                          ;Special Character Handlers
  7432                          ;
  7433                          
  7434                          ; RETURN_WITH_ERASE - moves cursor to right edge of window on current line
  7435                          ;                     after clearing to end of line
  7436                          ;
  7437                          RETURN_WITH_ERASE:
  7438                          ;         CALL    ERASE_THIS_LINE ; [RECON] OCR 7510 is commented in the scan.
  7439  1664  cdd717            RETURN: CALL    PUT_OLD_ON_SCREEN;Display char cursor was hiding
  7440  1667  3a1a01                    LD      A,(X_MIN)
  7441  166a  320000                    LD      (CURSOR_X),A
  7442  166d  2a4501                    LD      HL,(CURSOR)
  7443  1670  c35316                    JP      NEW_CURSOR
  7444                          
  7445                          ;
  7446                          ; MOVE_UP - Moves the cursor up if not at top of window
  7447                          ;
  7448                          MOVE_UP:
  7449  1673  2a4501                    LD      HL,(CURSOR)
  7450  1676  3a1c01                    LD      A,(Y_MIN)
  7451  1679  bd                        CP      L
  7452  167a  28df                      JR      Z,EXIT;Forget request
  7453  167c  2d                        DEC     L;Move up
  7454                          
  7455  167d  cdd717            RESTORE_OLD: CALL    PUT_OLD_ON_SCREEN;Display char cursor was hiding
  7456  1680  c35016                    JP      SAVE_CURSOR;Display cursor in new spot
  7457                          
  7458                          ;
  7459                          ; MOVE_DOWN - Moves the cursor down if will stay in window, except
  7460                          ;             if used by linefeed when the screen is scrolled
  7461                          ;
  7462                          MOVE_DOWN:
  7463                          
  7464  1683  2a4501                    LD      HL,(CURSOR)
  7465  1686  3a1d01                    LD      A,(Y_MAX);See if at bottom of window
  7466  1689  bd                        CP      L
  7467  168a  2804                      JR      Z,SCROLL_POSSIBLE
  7468  168c  2c                        INC     L;Move down
  7469  168d  c37d16                    JP      RESTORE_OLD
  7470                          ;
  7471  1690  3e0a              SCROLL_POSSIBLE: LD      A,LF;See if linefeed, and if it is
  7472  1692  b8                        CP      B; then scroll up. else leave
  7473  1693  20c6                      JR      NZ,EXIT; cursor and screen as is
  7474  1695  cd9417                    CALL    SCROLL_UP
  7475  1698  2a4501                    LD      HL,(CURSOR)
  7476  169b  c35316                    JP      NEW_CURSOR
  7477                          
  7478                          ;
  7479                          ; MOVE_RIGHT - Moves the cursor to the right, and if at window's
  7480                          ;              edge will move down a line to the left edge, unless
  7481                          ;              at the lower right corner of the window in which case
  7482                          ;              nothing is down
  7483                          ;
  7484                          MOVE_RIGHT:
  7485  169e  2a4501                    LD      HL,(CURSOR)
  7486  16a1  3a1b01                    LD      A,(X_MAX)
  7487  16a4  bc                        CP      H
  7488  16a5  2804                      JR      Z,TRY_MOVE_DOWN
  7489  16a7  24                        INC     H;Move to right
  7490  16a8  c37d16                    JP      RESTORE_OLD
  7491                          ;
  7492  16ab  3a1d01            TRY_MOVE_DOWN: LD      A,(Y_MAX)
  7493  16ae  bd                        CP      L
  7494  16af  28aa                      JR      Z,EXIT;At bottom of window so abort
  7495  16b1  2c                        INC     L
  7496  16b2  3a1a01                    LD      A,(X_MIN)
  7497  16b5  67                        LD      H,A
  7498  16b6  c37d16                    JP      RESTORE_OLD
  7499                          
  7500                          ;
  7501                          ; MOVE_LEFT - Moves the cursor to the left and if at left edge of
  7502                          ;             window will move up a line an to right edge if not
  7503                          ;             at upper left corner of window
  7504                          ;
  7505  16b9  2a4501            MOVE_LEFT: LD      HL,(CURSOR)
  7506  16bc  3a1a01                    LD      A,(X_MIN)
  7507  16bf  bc                        CP      H
  7508  16c0  2804                      JR      Z,TRY_SCROLL_UP
  7509  16c2  25                        DEC     H;Move to left
  7510  16c3  c37d16                    JP      RESTORE_OLD
  7511                          ;
  7512  16c6  3a1c01            TRY_SCROLL_UP: LD      A,(Y_MIN)
  7513  16c9  bd                        CP      L
  7514  16ca  288f                      JR      Z,EXIT;Abort if at upper left corner
  7515  16cc  2d                        DEC     L
  7516  16cd  3a1b01                    LD      A,(X_MAX)
  7517  16d0  67                        LD      H,A
  7518  16d1  c37d16                    JP      RESTORE_OLD
  7519                          
  7520                          ;
  7521                          ; MOVE_HOME - Moves cursor to the upper left corner of the window
  7522                          ;
  7523                          
  7524                          ; FORM_FEED - Clears the screen and puts the cursor at the upper left
  7525                          ;             corner of the window
  7526                          FORM_FEED:
  7527  16d4  3a3f01                    LD      A,(NUM_LINES)
  7528  16d7  47                        LD      B,A
  7529  16d8  2a4101                    LD      HL,(UPPER_LEFT)
  7530                          
  7531  16db  cd4c17                    CALL    BLANK_SCREEN
  7532                          
  7533  16de  3e20                      LD      A,BLANKING_CHAR
  7534  16e0  321901                    LD      (OLDCHAR_),A
  7535                          
  7536  16e3  cdd717            MOVE_HOME: CALL    PUT_OLD_ON_SCREEN;Needed only for MOVE_HOME not FORM_FEED
  7537  16e6  2a4101                    LD      HL,(UPPER_LEFT)
  7538  16e9  c35016                    JP      SAVE_CURSOR
  7539                          
  7540                          ;
  7541                          ; ERASE_TO_EOL - From cursor position fills rest of line
  7542                          ;                with BLANKING_CHAR, to end of window only
  7543                          ;                Will blank char under cursor always.
  7544                          ;
  7545                          ERASE_TO_EOL:
  7546  16ec  cd6617                    CALL    ERASE_THIS_LINE
  7547  16ef  c35616                    JP      PUT_CURSOR_ON
  7548                          
  7549                          ;
  7550                          ; ERASE_TO_EOS - Will erase the screen (window) from the current
  7551                          ;                cursor position to the end of the window. The
  7552                          ;                cursor position is also blanked.
  7553                          ;
  7554                          ;
  7555                          ERASE_TO_EOS:
  7556  16f2  cd6617                    CALL    ERASE_THIS_LINE;Erase to end of current line
  7557  16f5  2a4501                    LD      HL,(CURSOR)
  7558  16f8  2c                        INC     L;Move down
  7559  16f9  3a1c01                    LD      A,(Y_MIN)
  7560  16fc  4f                        LD      C,A
  7561  16fd  3a3f01                    LD      A,(NUM_LINES)
  7562  1700  81                        ADD     A,C
  7563  1701  95                        SUB     L;Number of lines left to blank
  7564  1702  ca5616                    JP      Z,PUT_CURSOR_ON
  7565  1705  47                        LD      B,A
  7566  1706  3a1a01                    LD      A,(X_MIN)
  7567  1709  67                        LD      H,A
  7568  170a  cd4c17                    CALL    BLANK_SCREEN
  7569  170d  c35616                    JP      PUT_CURSOR_ON
  7570                          
  7571                          ;
  7572                          ; GOTO_XY - Puts cursor to desired X-Y coord if in window
  7573                          ;
  7574                          ;Input Parameters:
  7575                          ; D - X location
  7576                          ; E - Y location
  7577                          ;
  7578                          GOTO_XY:
  7579  1710  3a1a01                    LD      A,(X_MIN)
  7580  1713  ba                        CP      D
  7581  1714  2803                      JR      Z,CHK_X_WITH_MAX
  7582  1716  d25b16                    JP      NC,EXIT
  7583  1719  3a1b01            CHK_X_WITH_MAX: LD      A,(X_MAX)
  7584  171c  ba                        CP      D
  7585  171d  2803                      JR      Z,CHK_Y_COORD
  7586  171f  da5b16                    JP      C,EXIT
  7587  1722  3a1c01            CHK_Y_COORD: LD      A,(Y_MIN)
  7588  1725  bb                        CP      E
  7589  1726  2803                      JR      Z,CHK_Y_WITH_MAX
  7590  1728  d25b16                    JP      NC,EXIT
  7591  172b  3a1d01            CHK_Y_WITH_MAX: LD      A,(Y_MAX)
  7592  172e  bb                        CP      E
  7593  172f  2803                      JR      Z,SET_CURSOR
  7594  1731  da5b16                    JP      C,EXIT
  7595  1734  eb                SET_CURSOR: EX      DE,HL
  7596  1735  c37d16                    JP      RESTORE_OLD
  7597                          
  7598                          ;
  7599                          ;Internal Subroutines
  7600                          ;
  7601                          
  7602                          ; Subroutine
  7603                          ; BLANK_PORTION - Fills LINEBUFFER_ with number of chars in B
  7604                          ;                 from where HL points
  7605                          ;
  7606                          ; Input Parameters:
  7607                          ; HL - Pointer into LINEBUFFER
  7608                          ; B  - Number of the BLANKING_CHAR's to stuff in
  7609                          ;
  7610                          ; A is destroyed
  7611                          ;
  7612                          BLANK_PORTION:
  7613  1738  e5                        PUSH    HL
  7614  1739  c5                        PUSH    BC
  7615  173a  1807                      JR      BLANK_REST
  7616                          
  7617                          ;
  7618                          ; Subroutine
  7619                          ; BLANKS        - Fills LINEBUFFER_ with 32 BLANKING_CHAR's
  7620                          ;
  7621                          ; A is destroyed
  7622                          ;
  7623                          BLANKS:
  7624  173c  e5                        PUSH    HL
  7625  173d  c5                        PUSH    BC
  7626  173e  211e01                    LD      HL,LINEBUFFER_
  7627  1741  0620                      LD      B,32
  7628  1743  3e20              BLANK_REST: LD      A,BLANKING_CHAR
  7629  1745  77                BLANK_FILL: LD      (HL),A
  7630  1746  23                        INC     HL
  7631  1747  10fc                      DJNZ    BLANK_FILL
  7632  1749  c1                        POP     BC
  7633  174a  e1                        POP     HL
  7634  174b  c9                        RET
  7635                          
  7636                          ;
  7637                          ; Subroutine
  7638                          ; BLANK_SCREEN  - Will blank a given number of lines on the screen
  7639                          ;
  7640                          ; Input Parameters:
  7641                          ; B  - Number of lines to blank
  7642                          ; HL - Absolute X-Y coords of start position of 1st line to blank
  7643                          ;
  7644                          ; Destroys C, A, DE
  7645                          ; User must reset cursor
  7646                          ;
  7647                          BLANK_SCREEN:
  7648  174c  cd3c17                    CALL    BLANKS;Fill buffer with BLANKING_CHAR
  7649  174f  3a4001                    LD      A,(NUM_COLUMNS)
  7650  1752  4f                        LD      C,A
  7651                          
  7652  1753  c5                BLNK_SCRN_LOOP: PUSH    BC
  7653  1754  e5                        PUSH    HL;Save X-Y coord of line
  7654  1755  cdfc17                    CALL    CONVERT_XY
  7655  1758  0600                      LD      B,00H;C has number of bytes to read
  7656  175a  211e01                    LD      HL,LINEBUFFER_
  7657  175d  cdea00                    CALL    WRITE_VRAM
  7658  1760  e1                        POP     HL
  7659  1761  2c                        INC     L;To next line below
  7660  1762  c1                        POP     BC
  7661  1763  10ee                      DJNZ    BLNK_SCRN_LOOP
  7662  1765  c9                        RET
  7663                          
  7664                          ;
  7665                          ; Subroutine
  7666                          ; ERASE_THIS_LINE - This routine will erase the current line
  7667                          ;                   from the cursor position to the right edge
  7668                          ;                   of the window, the char under the cursor is
  7669                          ;                   also blanked.
  7670                          ;
  7671                          ;Input Parameters:
  7672                          ; None
  7673                          ;
  7674                          ; Destroys all registers
  7675                          ; Sets OLDCHAR_ to BLANKING_CHAR
  7676                          ;
  7677                          ERASE_THIS_LINE:
  7678  1766  cd7917                    CALL    READ_FROM_CURSOR_TO_EOL
  7679  1769  e5                        PUSH    HL
  7680  176a  c5                        PUSH    BC
  7681  176b  41                        LD      B,C
  7682  176c  cd3817                    CALL    BLANK_PORTION
  7683  176f  c1                        POP     BC
  7684  1770  e1                        POP     HL
  7685                          
  7686  1771  3e20                      LD      A,BLANKING_CHAR
  7687  1773  321901                    LD      (OLDCHAR_),A
  7688                          
  7689  1776  c3ea00                    JP      WRITE_VRAM;Write line with blanks, return thru WRITE_VRAM
  7690                          
  7691                          ;
  7692                          ;Subroutine
  7693                          ;READ_FROM_CURSOR_TO_EOL - reads the line on screen from the
  7694                          ;                          cursor position to the right edge of the
  7695                          ;                          screen
  7696                          ;
  7697                          ;Input Parameters:
  7698                          ; None
  7699                          ;
  7700                          ;Returns:
  7701                          ; BC - number of chars read
  7702                          ; HL - address of LINEBUFFER_
  7703                          ; DE - VRAM address of place cursor is
  7704                          ;
  7705                          READ_FROM_CURSOR_TO_EOL:
  7706  1779  2a4501                    LD      HL,(CURSOR)
  7707  177c  3a1b01                    LD      A,(X_MAX)
  7708  177f  3c                        INC     A;Calc # chars to read
  7709  1780  94                        SUB     H
  7710  1781  4f                        LD      C,A
  7711  1782  cdfc17                    CALL    CONVERT_XY
  7712  1785  211e01                    LD      HL,LINEBUFFER_
  7713  1788  0600                      LD      B,00H
  7714  178a  c5                        PUSH    BC
  7715  178b  e5                        PUSH    HL
  7716  178c  d5                        PUSH    DE
  7717  178d  cded00                    CALL    READ_VRAM
  7718  1790  d1                        POP     DE
  7719  1791  e1                        POP     HL
  7720  1792  c1                        POP     BC
  7721  1793  c9                        RET
  7722                          ;:
  7723                          ;:
  7724                          ;:Subroutine
  7725                          ;: SCROLL_UP     - Scrolls the entire window up 1 line and puts a line
  7726                          ;:                 of BLANKING_CHAR's on the last line
  7727                          ;:
  7728                          ;:   Caller must restore cursor to screen
  7729                          ;:
  7730                          SCROLL_UP:
  7731  1794  cdd717                            CALL    PUT_OLD_ON_SCREEN
  7732  1797  2a4101                            LD      HL,(UPPER_LEFT)
  7733  179a  e5                                PUSH    HL
  7734  179b  cdfc17                            CALL    CONVERT_XY
  7735  179e  e1                                POP     HL
  7736  179f  3a3f01                            LD      A,(NUM_LINES)
  7737  17a2  47                                LD      B,A
  7738  17a3  05                                DEC     B
  7739                          ;:
  7740  17a4  c5                SCROLL_LOOP: PUSH    BC;Save number of remaining lines
  7741  17a5  d5                                PUSH    DE;Save next write location
  7742  17a6  2c                                INC     L;Point to next line below
  7743  17a7  e5                                PUSH    HL
  7744  17a8  cdfc17                            CALL    CONVERT_XY
  7745  17ab  d5                                PUSH    DE;Save address of this read
  7746  17ac  3a4001                            LD      A,(NUM_COLUMNS)
  7747  17af  4f                                LD      C,A
  7748  17b0  0600                              LD      B,00H
  7749  17b2  c5                                PUSH    BC;Save number of chars in line
  7750  17b3  211e01                            LD      HL,LINEBUFFER_
  7751  17b6  cded00                            CALL    READ_VRAM
  7752  17b9  c1                                POP     BC;Get number of bytes that were read
  7753  17ba  d1                                POP     DE;Get address of last read
  7754  17bb  e1                                POP     HL;Get X-Y coords
  7755  17bc  e3                                EX      (SP),HL;Swap prev read address with X-Y coords
  7756  17bd  eb                                EX      DE,HL;Swap last read with previous address
  7757  17be  e5                                PUSH    HL;  and save previous
  7758  17bf  211e01                            LD      HL,LINEBUFFER_
  7759  17c2  cdea00                            CALL    WRITE_VRAM;Write line one line up
  7760  17c5  d1                                POP     DE;Get address of next write
  7761  17c6  e1                                POP     HL;Get starting X-Y of last read
  7762  17c7  c1                                POP     BC
  7763  17c8  10da                              DJNZ    SCROLL_LOOP
  7764                          ;:
  7765  17ca  cd3c17                            CALL    BLANKS
  7766  17cd  211e01                            LD      HL,LINEBUFFER_; [RECON] Identifier repair: scan operand and active RAM symbol include the trailing underscore.
  7767  17d0  3a4001                            LD      A,(NUM_COLUMNS)
  7768  17d3  4f                                LD      C,A;B is 0 from DJNZ
  7769  17d4  c3ea00                            JP      WRITE_VRAM;Return thru WRITE_VRAM
  7770                          
  7771                          ;:
  7772                          ;: Subroutines
  7773                          ;: PUT_OLD_ON_SCREEN  - This entry point puts the char that the
  7774                          ;:                      cursor was on back onto the screen
  7775                          ;:
  7776                          ;: PUT_CHAR_ON_SCREEN - This entry point will put the char in A
  7777                          ;:                      onto the screen where the cursor currently is
  7778                          ;:
  7779                          ;:
  7780                          PUT_OLD_ON_SCREEN:
  7781  17d7  3a1901                            LD      A,(OLDCHAR_)
  7782                          ;:
  7783                          PUT_CHAR_ON_SCREEN:
  7784  17da  e5                                PUSH    HL
  7785  17db  2a4501                            LD      HL,(CURSOR);Get location to put char
  7786  17de  cdfc17                            CALL    CONVERT_XY;Convert to a VRAM address
  7787  17e1  211e01                            LD      HL,LINEBUFFER_
  7788  17e4  77                                LD      (HL),A
  7789  17e5  010100                            LD      BC,0001H
  7790  17e8  cdea00                            CALL    WRITE_VRAM
  7791  17eb  e1                                POP     HL
  7792  17ec  c9                                RET
  7793                          ;:
  7794                          ;:
  7795                          ;: Subroutine
  7796                          ;: GET_CHAR_UNDER_CURSOR - This entry loads HL from CURSOR before
  7797                          ;:                         falling into GET_CHAR_UNDER
  7798                          ;:
  7799                          ;: GET_CHAR_UNDER - Reads the char where the cursor will go
  7800                          ;:                  and saves it in the variable OLDCHAR_
  7801                          ;:
  7802                          ;:Input Parameters:
  7803                          ;: HL - Cursor position
  7804                          ;:
  7805                          ;: Destroys - HL, BC, DE, A
  7806                          ;:
  7807                          GET_CHAR_UNDER_CURSOR:
  7808  17ed  2a4501                            LD      HL,(CURSOR)
  7809                          ;:
  7810                          GET_CHAR_UNDER:
  7811  17f0  cdfc17                            CALL    CONVERT_XY
  7812  17f3  010100                            LD      BC,0001H
  7813  17f6  211901                            LD      HL,OLDCHAR_
  7814  17f9  c3ed00                            JP      READ_VRAM;Return thru READ_VRAM
  7815                          
  7816                          ;:
  7817                          ;: Subroutine
  7818                          ;:
  7819                          ;: CONVERT_XY - Converts X-Y coordinates on the screen to a
  7820                          ;:              VRAM address for that char position
  7821                          ;:              Calculates ((( Y * 32) + X ) + base of pattern name table
  7822                          ;:              to yield the absolute address in VRAM of the char
  7823                          ;:
  7824                          ;:Input Parameters:
  7825                          ;: H - X coord
  7826                          ;: L - Y coord
  7827                          ;:
  7828                          Returns:
  7829                          ;: DE - VRAM address
  7830                          ;: HL - Address of Pattern Name Table (side effect)
  7831                          ;: No Others are altered
  7832                          ;:
  7833                          CONVERT_XY:
  7834  17fc  5c                                LD      E,H;Save X coord
  7835  17fd  2600                              LD      H,00H
  7836  17ff  29                                ADD     HL,HL;Calc Y coord * 32
  7837  1800  29                                ADD     HL,HL
  7838  1801  29                                ADD     HL,HL
  7839  1802  29                                ADD     HL,HL
  7840  1803  29                                ADD     HL,HL
  7841  1804  1600                              LD      D,00H
  7842  1806  19                                ADD     HL,DE;Add in X coord
  7843  1807  ed5b4301                          LD      DE,(PTRN_NAME_TBL)
  7844  180b  19                                ADD     HL,DE
  7845  180c  eb                                EX      DE,HL
  7846  180d  c9                                RET
  7847                          
  7848                          ;:
  7849                          ;: This is a table of chars that perform some function rather
  7850                          ;: than being printed out to the screen as is. There is a
  7851                          ;: jump table that is associated with this table, but NOTE that
  7852                          ;: it has its entrys in reverse order of this table. It would
  7853                          ;: be best to add to the end of this table and to the beginning
  7854                          ;: of the jump table.
  7855                          ;:
  7856                          SPECIAL_CHARS:
  7857  180e  08                                DEFB    BS
  7858  180f  0d                                DEFB    CR
  7859  1810  0a                                DEFB    LF
  7860  1811  0c                                DEFB    FF
  7861  1812  80                                DEFB    HOME
  7862  1813  16                                DEFB    CLR_TO_EOL
  7863  1814  18                                DEFB    CLR_TO_EOS
  7864  1815  1c                                DEFB    GOTO_XY_CHAR
  7865  1816  a0                                DEFB    UP
  7866  1817  a2                                DEFB    DOWN
  7867  1818  a3                                DEFB    LEFT
  7868  1819  a1                                DEFB    RIGHT
  7869                          ;:
  7870                          NUM_SPCL_CHARS EQU $-SPECIAL_CHARS
  7871                          ;:
  7872                          
  7873                          ;:
  7874                          ;:NOTE - This table is in the reverse order of the chars so
  7875                          ;:       any additions to the end of the chars goes at the top
  7876                          ;:       of this table
  7877                          ;:
  7878                          SPCL_VECTOR_TBL:
  7879  181a  9e16                              DEFW    MOVE_RIGHT
  7880  181c  b916                              DEFW    MOVE_LEFT
  7881  181e  8316                              DEFW    MOVE_DOWN
  7882  1820  7316                              DEFW    MOVE_UP
  7883  1822  1017                              DEFW    GOTO_XY
  7884  1824  f216                              DEFW    ERASE_TO_EOS
  7885  1826  ec16                              DEFW    ERASE_TO_EOL
  7886  1828  e316                              DEFW    MOVE_HOME
  7887  182a  d416                              DEFW    FORM_FEED
  7888  182c  8316                              DEFW    MOVE_DOWN
  7889  182e  6416                              DEFW    RETURN
  7890  1830  b916                              DEFW    MOVE_LEFT
  7891                          ;:
  7892                          ;:
  7893                          ;: CODE FROM HERE TO END OF CONS_OUT WAS INSERTED AFTER THE
  7894                          ;: REV. 06 ROM WAS BURNED AND HAS BEEN COMMENTED OUT TO MAINTAIN
  7895                          ;: COMPATIBILITY WITH THAT ROM.
  7896                          ;:
  7897                          ;               END
  7898                          ;       SKIP
  7899                          ;;
  7900                          ;; RETURN_CURSOR  -  Will return the current cursor position
  7901                          ;;                   to the caller.  It is in absolute screen
  7902                          ;;                   coordinates (0 based).
  7903                          ;;
  7904                          ;;Input Parameters:
  7905                          ;; None
  7906                          ;;
  7907                          ;;Returns:
  7908                          ;; D - X coord of cursor, absolute based on upper left of screen not window
  7909                          ;; E - Y coord of cursor
  7910                          ;;
  7911                          ;               GLB     RETURN_CURSOR
  7912                          ;RETURN_CURSOR:
  7913                          ;               LD      DE,(CURSOR)
  7914                          ;               RET
  7915                          ;       SKIP
  7916                          ;;
  7917                          ;; RETURN_RELATIVE_CURSOR - Returns the current cursor position relative
  7918                          ;;                          to the window.  0,0 will be returned for the
  7919                          ;;                          upper left corner of the window.
  7920                          ;;
  7921                          ;;Input Parameters:
  7922                          ;; NONE
  7923                          ;;
  7924                          ;;Returns:
  7925                          ;; D - X cursor position relative to window
  7926                          ;; E - Y cursor position relative to window
  7927                          ;;
  7928                          ;; Destroys A
  7929                          ;;
  7930                          ;
  7931                          ;               GLB     RETURN_RELATIVE_CURSOR
  7932                          ;
  7933                          ;RETURN_RELATIVE_CURSOR:
  7934                          ;               LD      DE,(CURSOR)     ;get absolute position
  7935                          ;               LD      A,(X_MIN)
  7936                          ;               NEG
  7937                          ;               ADD     A,D
  7938                          ;               LD      D,A
  7939                          ;               LD      A,(Y_MIN)
  7940                          ;               NEG
  7941                          ;               ADD     A,E
  7942                          ;               LD      E,A
  7943                          ;               RET
  7944                          ;;

  5893  11dc  fde1                      POP     IY
  5894  11de  dde1                      POP     IX
  5895  11e0  e1                        POP     HL
  5896  11e1  d1                        POP     DE
  5897  11e2  c1                        POP     BC
  5898                          
  5899  11e3  3e16                      LD      A,DEVICE_DEPD_ERR; INDICATE ERROR, LET APPL. HANDLE IT
  5900                          
  5901  11e5  c9                        RET

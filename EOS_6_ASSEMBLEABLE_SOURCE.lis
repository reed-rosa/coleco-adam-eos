  7054                          ;****************************************************************
  7055                          
  7056                          ;GLB    __END_PR_CH
  7057                          __END_PR_CH:
  7058  157c  cdb815                    CALL    __END_PR_BUFF
  7059                          
  7060  157f  c9                        RET
  7061                          
  7062                          
  7063                          
  7064                          ;***************************************************************
  7065                          ; __START_PR_BUFF ALLOWS THE CALLER TO PRINT AN ASCII ETX-TERMINATED STRING
  7066                          ;        INPUT:   HL ==>  ADDRESS OF ETX-TERMINATED STRING
  7067                          ;        OUTPUT:  CONDITION FLAGS
  7068                          ;                 Z :    NO ERROR
  7069                          ;                 NZ:    ERROR OCCURED
  7070                          ;                        A ==>  ERROR CODE
  7071                          ;
  7072                          ;***************************************************************
  7073                          
  7074                          ;GLB    __START_PR_BUFF
  7075                          
  7076                          ;EXT    __START_WR_CH_DEV
  7077                          
  7078                          __START_PR_BUFF:
  7079  1580  c5                        PUSH    BC
  7080  1581  d5                        PUSH    DE
  7081  1582  e5                        PUSH    HL
  7082  1583  fde5                      PUSH    IY
  7083                          
  7084  1585  3e02                      LD      A,PRINTER_ID; WANT THE PRINTERS DCB
  7085  1587  cd4614                    CALL    __FIND_DCB; GET THE DEVICE'S DCB
  7086                          
  7087  158a  2026                      JR      NZ,NO_DCB_FOUND1; THERE WAS A PROBLEM FINDING THE DCB
  7088                          
  7089  158c  cd9614                    CALL    CHK_IF_INACTIVE
  7090  158f  20c7                      JR      NZ,PRTR_DCB_ACTIVE; [RECON] Identifier repair: scan's trailing mark is not part of the label.
  7091                          
  7092  1591  010000                    LD      BC,0; CHARACTER COUNT
  7093  1594  5d                        LD      E,L; SAVE THE STRING
  7094  1595  54                        LD      D,H; DE=HL= PTR TO UNPRINTED STRING
  7095                          
  7096                          GET_NEXT_ASCII2:
  7097  1596  3e03                      LD      A,ETX
  7098  1598  be                        CP      (HL); IS IT AN ETX?
  7099  1599  280f                      JR      Z,ITS_ETX2; YES
  7100                          
  7101                          ; NO
  7102  159b  23                        INC     HL; POINT TO NEXT CHARACTER
  7103  159c  0c                        INC     C; INC COUNT
  7104  159d  79                        LD      A,C; HAVE WE LOOKED AT 16 BYTES?
  7105  159e  fe10                      CP      16
  7106  15a0  20f4                      JR      NZ,GET_NEXT_ASCII2; YES
  7107                          ;                                       DE = PTR TO UNPRINTED STRNG, DE=PTR TO UNPRNTED+16
  7108  15a2  eb                        EX      DE,HL; HL = PTR TO UNPRINTED STRNG, DE=PTR TO UNPRNTED+16
  7109  15a3  3e02                      LD      A,PRINTER_ID
  7110  15a5  cdc21b                    CALL    __START_WR_CH_DEV
  7111                          
  7112  15a8  1808                      JR      WRITE_CMND_SENT
  7113                          
  7114                          ITS_ETX2:
  7115  15aa  eb                        EX      DE,HL
  7116  15ab  af                        XOR     A; ZERO OUT A
  7117  15ac  b9                        CP      C; WAS THE FIRST CHARACTER CHECKED
  7118                          ; AN ETX?
  7119                          
  7120  15ad  3e02                      LD      A,PRINTER_ID; WILL WRITE TO THE PRINTER
  7121  15af  c4c21b                    CALL    NZ,__START_WR_CH_DEV; NOPE, WRITE CHARACTER
  7122                          ; IS PASSED BACK TO CALLER
  7123                          NO_DCB_FOUND1:
  7124                          WRITE_CMND_SENT:
  7125                          
  7126  15b2  fde1                      POP     IY
  7127  15b4  e1                        POP     HL
  7128  15b5  d1                        POP     DE
  7129  15b6  c1                        POP     BC
  7130                          
  7131  15b7  c9                        RET
  7132                          
  7133                          
  7134                          
  7135                          
  7136                          ;***************************************************************
  7137                          ;
  7138                          ; __END_PR_BUFF CHECKS THE DCB COMM/STATUS BYTE AND RETURNS THE RESULT
  7139                          ; OF THE CHECK
  7140                          ;
  7141                          ;        INPUT:   NONE
  7142                          ;
  7143                          ;        OUTPUT:  CONDITION FLAGS
  7144                          ;                 C:     COMMAND COMPLETED
  7145                          ;                 NC:    COMMAND NOT COMPLETED
  7146                          ;                 Z:     NO ERRORS OCCURED
  7147                          ;                 NZ:    ERRORS
  7148                          ;                        A = ERROR CODE
  7149                          ;
  7150                          ;        ALL      REGISTERS ARE PRESERVED
  7151                          ;
  7152                          ;***************************************************************
  7153                          
  7154                          ;GLB    __END_PR_BUFF
  7155                          ;EXT    __END_WR_CH_DEV
  7156                          
  7157                          __END_PR_BUFF:
  7158                          
  7159  15b8  fde5                      PUSH    IY
  7160                          
  7161  15ba  3e02                      LD      A,PRINTER_ID
  7162  15bc  cd4614                    CALL    __FIND_DCB
  7163  15bf  cde11b                    CALL    __END_WR_CH_DEV; CHECK STATUS BYTE
  7164                          
  7165  15c2  300b                      JR      NC,CMND_NOT_PROCESSED; COMMAND NOT COMPLETED
  7166                          
  7167  15c4  2809                      JR      Z,FINISHED_WO_ERROR; COMMAND COMPLETED, NO ERROR
  7168                          
  7169  15c6  fe86                      CP      PR_NAK; WAS IT A NAK?
  7170                          
  7171  15c8  2005                      JR      NZ,NOT_PR_NAK; NOPE, MUST BE AN ERROR
  7172                          
  7173  15ca  fd360003                  LD      (IY+D_COM_STAT),DCB_WR; SEND ANOTHER WRITE COMMAND
  7174                          
  7175  15ce  b7                        OR      A; CLEAR CARRY TO INDICATE COMMAND
  7176                          ; HAS NOT BEEN FINISHED
  7177                          
  7178                          NOT_PR_NAK:
  7179                          CMND_NOT_PROCESSED:
  7180                          FINISHED_WO_ERROR:
  7181                          
  7182  15cf  fde1                      POP     IY
  7183                          
  7184  15d1  c9                        RET
  7185                          
  7186                          

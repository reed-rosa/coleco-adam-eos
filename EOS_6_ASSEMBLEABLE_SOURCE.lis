  4541                          ;===============================================================
  4542                          ;===============================================================
  4543                          ;===============================================================
  4544                          ;
  4545                          
  4546                          
  4547                          ;Packed some code to allow room for
  4548                          
  4549                          ;GLB    __READ_FILE,__WRITE_FILE
  4550                          ;EXT    BUF_START,BUF_END,USER_BUF,BYTES_REQ,BYTES_TO_GO
  4551                          ;EXT    FNUM
  4552                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  4553                          ;EXT    READ_BLOCK,WRITE_BLOCK
  4554                          ;EXT    MODE_CHECK
  4555                          
  4556                          ;----------------------------------------------------------------
  4557                          ;
  4558                          ; __READ_FILE -- read some data from a file into the user's buffer.
  4559                          ;
  4560                          ; ENTRY PARAMETERS: device number in A; buffer address in HL;
  4561                          ;                   desired number of bytes in BC.
  4562                          ;
  4563                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  4564                          ;                  if errors -- Z = 0; A = error code;
  4565                          ;                  BC = number of bytes transferred
  4566                          ;
  4567                          ;----------------------------------------------------------------
  4568                          
  4569                          ; GET_OUT CHANGED TO R_GET_OUT TO PREVENT CONFLICT WITH
  4570                          ; IDENTICAL LABEL ELSEWHERE
  4571                          
  4572                          __READ_FILE:
  4573  0c17  c5                        PUSH    BC;SAVE REGISTERS
  4574  0c18  d5                        PUSH    DE
  4575  0c19  e5                        PUSH    HL
  4576  0c1a  dde5                      PUSH    IX
  4577                          
  4578  0c1c  22a600                    LD      (USER_BUF),HL;SAVE USER'S BUFFER ADDRESS
  4579  0c1f  ed43a200                  LD      (BYTES_REQ),BC;SAVE REQUESTED COUNT
  4580  0c23  32a100                    LD      (FNUM),A;SAVE FILE NUMBER
  4581  0c26  ed43a400                  LD      (BYTES_TO_GO),BC;INIT COUNTER (COUNTS DOWN)
  4582                          
  4583  0c2a  b7                        OR      A;CHECK FILE NUMBER
  4584  0c2b  ca7f0d                    JP      Z,READ_ERR2;BRANCH IF ZERO
  4585  0c2e  fe03                      CP      NUM_FCBS;CHECK FOR MAX RANGE
  4586  0c30  d27f0d                    JP      NC,READ_ERR2;BRANCH IF TOO LARGE
  4587                          
  4588  0c33  47                        LD      B,A;PUT IT INTO B
  4589  0c34  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR);GET ADDRESS OF 0TH FCB
  4590  0c38  2a9f00                    LD      HL,(FCB_DATA_ADDR);GET ADDRESS OF 0TH BUFFER
  4591                          READ1:
  4592  0c3b  112300                    LD      DE,FCB_LENGTH;ADVANCE POINTER TO NEXT FCB
  4593  0c3e  dd19                      ADD     IX,DE
  4594  0c40  110004                    LD      DE,1024;ADVANCE POINTER TO NEXT BUFFER
  4595  0c43  19                        ADD     HL,DE
  4596  0c44  10f5                      DJNZ    READ1;UNTIL WE GET TO THE ONE WE WANT
  4597                          
  4598  0c46  22a800                    LD      (BUF_START),HL;SAVE ADDRESS OF MY BUFFER
  4599  0c49  19                        ADD     HL,DE;POINT HL PAST END OF MY BUFFER
  4600  0c4a  22aa00                    LD      (BUF_END),HL;SAVE IT TOO
  4601                          
  4602                          ;*** CHECK FOR MODE ***
  4603  0c4d  dde5                      PUSH    IX
  4604  0c4f  e1                        POP     HL
  4605                          
  4606  0c50  cdd910                    CALL    MODE_CHECK;SEE IF THE MODE IS OK
  4607  0c53  c2810d                    JP      NZ,READ_ERR1;BRANCH IF NOT
  4608                          
  4609                          READ3:
  4610  0c56  ddcb187e                  BIT     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE);LOOK AT LAST BLOCK BIT
  4611  0c5a  c22b0d                    JP      NZ,READ_LAST;BRANCH IF THIS IS THE LAST FILE BLOCK
  4612                          
  4613  0c5d  2aaa00                    LD      HL,(BUF_END);GET END ADDRESS OF BUFFER
  4614  0c60  dd5e21                    LD      E,(IX+FCB_POINTER);GET POINTER INTO BUFFER
  4615  0c63  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4616  0c66  b7                        OR      A
  4617  0c67  ed52                      SBC     HL,DE;CALC. BYTES LEFT IN BUFFER
  4618  0c69  2825                      JR      Z,_O_BYTES_LEFT2
  4619                          
  4620  0c6b  44                        LD      B,H;SAVE BYTES LEFT IN CASE WE NEED IT
  4621  0c6c  4d                        LD      C,L
  4622                          
  4623  0c6d  ed5ba400                  LD      DE,(BYTES_TO_GO);GET BYTES LEFT TO SEND
  4624  0c71  b7                        OR      A
  4625  0c72  ed52                      SBC     HL,DE;COMPARE TO WHAT WE HAVE
  4626  0c74  d2ea0c                    JP      NC,ENOUGH;BRANCH IF WE HAVE ENOUGH DATA HERE
  4627                          
  4628                          ; IF WE FALL THROUGH HERE, WE KNOW WE WILL HAVE TO GET ANOTHER
  4629                          ; BLOCK AFTER THIS ONE.  FIRST, LET'S TRANSFER WHAT WE HAVE.
  4630                          
  4631  0c77  2aa400                    LD      HL,(BYTES_TO_GO);UPDATE NUMBER OF BYTES TO GO
  4632  0c7a  b7                        OR      A
  4633  0c7b  ed42                      SBC     HL,BC;SUBTRACT NUM OF BYTES WE ARE SENDING HERE
  4634  0c7d  22a400                    LD      (BYTES_TO_GO),HL
  4635                          
  4636  0c80  dd6e21                    LD      L,(IX+FCB_POINTER);POINT INTO MY BUFFER
  4637  0c83  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4638  0c86  ed5ba600                  LD      DE,(USER_BUF);POINT INTO THE CALLER'S BUFFER
  4639                          ;BC HAS COUNT FROM ABOVE
  4640  0c8a  edb0                      LDIR;GIVE WHAT WE HAVE
  4641                          
  4642  0c8c  ed53a600                  LD      (USER_BUF),DE;POINT TO NEXT SPOT
  4643                          
  4644                          _O_BYTES_LEFT2:
  4645  0c90  2aa800                    LD      HL,(BUF_START);RESET THE POINTER
  4646  0c93  dd7521                    LD      (IX+FCB_POINTER),L
  4647  0c96  dd7422                    LD      (IX+FCB_POINTER+1),H
  4648                          
  4649  0c99  dd3419                    INC     (IX+FCB_BLOCK);INC THE BLOCK NUMBER
  4650  0c9c  200d                      JR      NZ,READ4;BRANCH IF NO CARRY OUT
  4651  0c9e  dd341a                    INC     (IX+FCB_BLOCK+1)
  4652  0ca1  2008                      JR      NZ,READ4
  4653  0ca3  dd341b                    INC     (IX+FCB_BLOCK+2)
  4654  0ca6  2003                      JR      NZ,READ4
  4655  0ca8  dd341c                    INC     (IX+FCB_BLOCK+3)
  4656                          
  4657                          READ4:
  4658                          
  4659  0cab  dd7e17                    LD      A,(IX+FCB_DEVICE);DEVICE ID
  4660  0cae  2aa800                    LD      HL,(BUF_START); GET ADDRESS OF USERS BUFFER
  4661  0cb1  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4662  0cb4  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4663  0cb7  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4664  0cba  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4665                          
  4666  0cbd  cd7b11                    CALL    READ_BLOCK; READ THE NEXT BLOCK
  4667                          
  4668  0cc0  c2810d                    JP      NZ,READ_ERR1; BRANCH IF ERROR
  4669                          
  4670                          NOT_TAPE1:
  4671  0cc3  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3); SEE IF THIS IS THE LAST BLOCK
  4672  0cc6  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  4673  0cc9  201c                      JR      NZ,JP_TO_READ3; BRANCH IF NOT
  4674  0ccb  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4675  0cce  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  4676  0cd1  2014                      JR      NZ,JP_TO_READ3
  4677  0cd3  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4678  0cd6  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  4679  0cd9  200c                      JR      NZ,JP_TO_READ3
  4680  0cdb  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  4681  0cde  ddbe19                    CP      (IX+FCB_BLOCK)
  4682  0ce1  2004                      JR      NZ,JP_TO_READ3
  4683  0ce3  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); ELSE SET THE LAST BLOCK BIT
  4684                          JP_TO_READ3:
  4685  0ce7  c3560c                    JP      READ3; AND DEAL WITH THE NEXT BLOCK
  4686                          
  4687                          ; ARRIVE HERE IF THIS BLOCK CONTAINS ENOUGH BYTES TO SATISFY
  4688                          ; THIS CALL.
  4689                          
  4690                          ENOUGH:
  4691  0cea  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3); SEE IF THIS IS THE LAST BLOCK
  4692  0ced  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  4693  0cf0  2018                      JR      NZ,READ_LAST1; BRANCH IF NOT
  4694  0cf2  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  4695  0cf5  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  4696  0cf8  2010                      JR      NZ,READ_LAST1
  4697  0cfa  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  4698  0cfd  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  4699  0d00  2008                      JR      NZ,READ_LAST1
  4700  0d02  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  4701  0d05  ddbe19                    CP      (IX+FCB_BLOCK)
  4702  0d08  281d                      JR      Z,LAST_BLOCK
  4703                          
  4704                          READ_LAST1:
  4705  0d0a  ed4ba400                  LD      BC,(BYTES_TO_GO); GET BYTE COUNT TO MOVE
  4706                          
  4707                          
  4708  0d0e  dd6e21                    LD      L,(IX+FCB_POINTER); POINT INTO MY BUFFER
  4709  0d11  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4710  0d14  ed5ba600                  LD      DE,(USER_BUF); POINT TO THE USER'S BUFFER
  4711  0d18  edb0                      LDIR; MOVE THE DATA
  4712                          
  4713  0d1a  dd7521                    LD      (IX+FCB_POINTER),L; UPDATE MY POINTER
  4714  0d1d  dd7422                    LD      (IX+FCB_POINTER+1),H
  4715                          
  4716                          
  4717  0d20  dde1                      POP     IX; RESTORE REGISTERS
  4718  0d22  e1                        POP     HL
  4719  0d23  d1                        POP     DE
  4720  0d24  c1                        POP     BC
  4721  0d25  af                        XOR     A; SHOW NO ERROR
  4722  0d26  c9                        RET
  4723                          
  4724                          ; ARRIVE HERE IF THIS IS THE LAST BLOCK OF THE FILE.
  4725                          LAST_BLOCK:
  4726  0d27  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE)
  4727                          
  4728                          READ_LAST:
  4729  0d2b  2aa800                    LD      HL,(BUF_START); POINT TO MY BUFFER
  4730  0d2e  dd5e15                    LD      E,(IX+FCB_LAST_COUNT); GET # BYTES IN IT
  4731  0d31  dd5616                    LD      D,(IX+FCB_LAST_COUNT+1)
  4732  0d34  19                        ADD     HL,DE; CALC ADDR OF LAST BYTE + 1
  4733  0d35  dd5e21                    LD      E,(IX+FCB_POINTER); GET CURRENT POINTER
  4734  0d38  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4735  0d3b  b7                        OR      A; CLEAR CARRY
  4736  0d3c  ed52                      SBC     HL,DE; CALC # BYTES LEFT IN BUFFER
  4737  0d3e  44                        LD      B,H; SAVE IT IN CASE IT'S NEEDED
  4738  0d3f  4d                        LD      C,L
  4739  0d40  282a                      JR      Z,_0_BYTES_LEFT
  4740                          
  4741  0d42  ed5ba400                  LD      DE,(BYTES_TO_GO); GET REQUESTED COUNT
  4742  0d46  b7                        OR      A; CLEAR CARRY (UGLY Z80)
  4743  0d47  ed52                      SBC     HL,DE; SEE IF WE HAVE ENOUGH BYTES
  4744  0d49  30bf                      JR      NC,READ_LAST1; BRANCH IF SO -- NO SWEAT
  4745                          
  4746  0d4b  2aa400                    LD      HL,(BYTES_TO_GO); UPDATE NUMBER OF BYTES TO GO
  4747  0d4e  b7                        OR      A
  4748  0d4f  ed42                      SBC     HL,BC; SUBTRACT NUM OF BYTES WE ARE SENDING HERE
  4749  0d51  22a400                    LD      (BYTES_TO_GO),HL
  4750                          
  4751  0d54  dd6e21                    LD      L,(IX+FCB_POINTER); GET POINTER TO MY BUFFER
  4752  0d57  dd6622                    LD      H,(IX+FCB_POINTER+1)
  4753  0d5a  ed5ba600                  LD      DE,(USER_BUF); GET POINTER TO USER'S BUFFER
  4754                          ; BC HAS COUNT FROM ABOVE
  4755  0d5e  edb0                      LDIR; MOVE WHAT WE HAVE TO USER
  4756                          
  4757  0d60  2aa200                    LD      HL,(BYTES_REQ); GET # BYTES REQUESTED
  4758  0d63  ed4ba400                  LD      BC,(BYTES_TO_GO); GET # BYTES WE DIDN'T DO
  4759  0d67  b7                        OR      A
  4760  0d68  ed42                      SBC     HL,BC; CALC. # OF BYTES WE DID DO
  4761  0d6a  44                        LD      B,H; PUT IT INTO BC
  4762  0d6b  4d                        LD      C,L
  4763                          
  4764                          _0_BYTES_LEFT:
  4765  0d6c  3e0a                      LD      A,EOF_ERR; SHOW AN ERROR
  4766                          R_GET_OUT:
  4767  0d6e  dde1                      POP     IX; RESTORE REGISTERS
  4768  0d70  e1                        POP     HL
  4769  0d71  d1                        POP     DE
  4770  0d72  33                        INC     SP; DISCARD OLD BC
  4771  0d73  33                        INC     SP
  4772                          
  4773  0d74  b7                        OR      A
  4774  0d75  c9                        RET
  4775                          
  4776                          RQ_STAT_ERR:
  4777  0d76  dde1                      POP     IX
  4778  0d78  e1                        POP     HL
  4779  0d79  d1                        POP     DE
  4780  0d7a  c1                        POP     BC
  4781                          
  4782  0d7b  3e15                      LD      A,RQ_TP_STAT_ERR
  4783  0d7d  b7                        OR      A
  4784  0d7e  c9                        RET
  4785                          
  4786                          READ_ERR2:
  4787  0d7f  3e09                      LD      A,BAD_FNUM_ERR
  4788                          
  4789                          READ_ERR1:
  4790  0d81  2aa200                    LD      HL,(BYTES_REQ); GET # BYTES REQUESTED
  4791  0d84  ed4ba400                  LD      BC,(BYTES_TO_GO); GET # BYTES WE DIDN'T DO
  4792  0d88  b7                        OR      A
  4793  0d89  ed42                      SBC     HL,BC; CALC. # OF BYTES WE DID DO
  4794  0d8b  44                        LD      B,H; PUT IT INTO BC
  4795  0d8c  4d                        LD      C,L
  4796                          
  4797  0d8d  18df                      JR      R_GET_OUT
  4798                          
  4799                          ;       POP     IX                         ; RESTORE REGISTERS
  4800                          ;       POP     HL
  4801                          ;       POP     DE
  4802                          ;       INC     SP                         ; DISCARD OLD BC
  4803                          ;       INC     SP
  4804                          ;       OR      A                          ; SET CONDITION CODES
  4805                          ;       RET
  4806                          
  4807                          ;READ_ERR2
  4808                          ;       LD      HL,(BYTES_REQ)             ; GET # BYTES REQUESTED
  4809                          ;       LD      BC,(BYTES_TO_GO)           ; GET # BYTES WE DIDN'T DO
  4810                          ;       OR      A
  4811                          ;       SBC     HL,BC                      ; CALC. # OF BYTES WE DID DO
  4812                          ;       LD      B,H                        ; PUT IT INTO BC
  4813                          ;       LD      C,L
  4814                          ;
  4815                          ;       POP     IX                         ; RESTORE REGISTERS
  4816                          ;       POP     HL
  4817                          ;       POP     DE
  4818                          ;       INC     SP                         ; DISCARD OLD BC
  4819                          ;       INC     SP
  4820                          ;       LD      A,BAD_FNUM_ERR             ; SET THE ERROR CODE
  4821                          ;       OR      A                          ; SET CONDITIONS
  4822                          ;       RET
  4823                          
  4824                          ;-----------------------------------------------------------------------
  4825                          ;
  4826                          ; __WRITE_FILE -- write some bytes to a file.
  4827                          ;
  4828                          ; ENTRY PARAMETERS: file number in A; byte count in BC; pointer
  4829                          ;                   to data in HL.
  4830                          ;
  4831                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  4832                          ;                  if errors -- Z = 0; A = error code
  4833                          ;
  4834                          ;-----------------------------------------------------------------------
  4835                          
  4836                          __WRITE_FILE:
  4837  0d8f  c5                        PUSH    BC; SAVE REGISTERS
  4838  0d90  d5                        PUSH    DE
  4839  0d91  e5                        PUSH    HL
  4840  0d92  dde5                      PUSH    IX
  4841                          
  4842  0d94  22a600                    LD      (USER_BUF),HL; SAVE USER'S BUFFER ADDRESS
  4843  0d97  ed43a200                  LD      (BYTES_REQ),BC; SAVE REQUESTED COUNT
  4844  0d9b  32a100                    LD      (FNUM),A; SAVE FILE NUMBER
  4845  0d9e  ed43a400                  LD      (BYTES_TO_GO),BC; INIT COUNTER (COUNTS DOWN)
  4846                          
  4847  0da2  b7                        OR      A; CHECK FILE NUMBER
  4848  0da3  cabc0e                    JP      Z,WRITE_ERR2; BRANCH IF ZERO
  4849  0da6  fe03                      CP      NUM_FCBS; CHECK FOR MAX RANGE
  4850  0da8  d2bc0e                    JP      NC,WRITE_ERR2; BRANCH IF TOO LARGE
  4851                          
  4852  0dab  47                        LD      B,A; PUT IT INTO B
  4853  0dac  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR); GET ADDRESS OF 0TH FCB
  4854  0db0  112300                    LD      DE,FCB_LENGTH; SET OFFSET
  4855                          WRITE1:
  4856  0db3  dd19                      ADD     IX,DE; ADVANCE POINTER TO NEXT FCB
  4857  0db5  10fc                      DJNZ    WRITE1; UNTIL WE GET TO THE ONE WE WANT
  4858                          
  4859  0db7  47                        LD      B,A; POINT HL AT MY BUFFER
  4860  0db8  110004                    LD      DE,1024
  4861  0dbb  2a9f00                    LD      HL,(FCB_DATA_ADDR)
  4862                          WRITE2:
  4863  0dbe  19                        ADD     HL,DE
  4864  0dbf  10fd                      DJNZ    WRITE2
  4865                          
  4866  0dc1  22a800                    LD      (BUF_START),HL; SAVE ADDRESS OF MY BUFFER
  4867  0dc4  19                        ADD     HL,DE; POINT HL PAST END OF MY BUFFER
  4868  0dc5  22aa00                    LD      (BUF_END),HL; SAVE IT TOO
  4869                          
  4870                          ; *** CHECK FOR MODE ***
  4871  0dc8  dde5                      PUSH    IX
  4872  0dca  e1                        POP     HL
  4873                          
  4874  0dcb  cdd910                    CALL    MODE_CHECK
  4875  0dce  c2be0e                    JP      NZ,WRITE_ERR1; JUMP IF WRONG MODE
  4876                          
  4877                          WRITE3:
  4878  0dd1  dd7e14                    LD      A,(IX+FCB_USED_LENGTH+1)
  4879  0dd4  ddbe12                    CP      (IX+FCB_MAX_LENGTH+1)
  4880  0dd7  380c                      JR      C,SET_UP
  4881  0dd9  dd7e13                    LD      A,(IX+FCB_USED_LENGTH+0)
  4882  0ddc  ddbe11                    CP      (IX+FCB_MAX_LENGTH)
  4883  0ddf  3804                      JR      C,SET_UP
  4884                          
  4885  0de1  ddcb18fe                  SET     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE)
  4886                          SET_UP:
  4887  0de5  2aaa00                    LD      HL,(BUF_END); GET LAST ADDR + 1 OF BUFFER
  4888  0de8  dd5e21                    LD      E,(IX+FCB_POINTER); GET CURRENT POINTER
  4889  0deb  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4890  0dee  b7                        OR      A; CLEAR CARRY
  4891  0def  ed52                      SBC     HL,DE; CALC. ROOM LEFT IN BUFFER
  4892  0df1  44                        LD      B,H; SAVE IT IN CASE WE NEED IT
  4893  0df2  4d                        LD      C,L
  4894  0df3  ed5ba400                  LD      DE,(BYTES_TO_GO); GET BYTES LEFT TO TRANSFER
  4895  0df7  b7                        OR      A
  4896  0df8  ed52                      SBC     HL,DE; SEE IF WE HAVE ROOM FOR IT ALL
  4897  0dfa  d2930e                    JP      NC,ROOM_OK; BRANCH IF YES
  4898                          
  4899                          ; WE FALL THROUGH HERE IF THE NUMBER OF BYTES TO BE WRITTEN
  4900                          ; IS MORE THAN THE SPACE WE HAVE IN THE CURRENT BLOCK.
  4901                          ; FILL THE BLOCK. WRITE IT OUT. THEN DECIDE WHAT TO DO.
  4902                          
  4903  0dfd  78                        LD      A,B; CHECK IF ANY BYTES AVAILABLE
  4904  0dfe  b1                        OR      C
  4905  0dff  281b                      JR      Z,CHECK_LAST_BLOCK; NOPE. EMPTY BUFFER FIRST
  4906                          
  4907  0e01  2aa400                    LD      HL,(BYTES_TO_GO); GET THE COUNT
  4908  0e04  b7                        OR      A
  4909  0e05  ed42                      SBC     HL,BC; SUB THE ROOM IN BUFFER TO UPDATE IT
  4910  0e07  22a400                    LD      (BYTES_TO_GO),HL
  4911                          
  4912  0e0a  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO BUFFER
  4913  0e0d  dd5622                    LD      D,(IX+FCB_POINTER+1)
  4914  0e10  2aa600                    LD      HL,(USER_BUF); GET POINTER TO USER DATA
  4915                          ; BC STILL HAS COUNT FROM ABOVE
  4916  0e13  edb0                      LDIR; MOVE DATA INTO THE BUFFER
  4917                          
  4918  0e15  22a600                    LD      (USER_BUF),HL; SAVE WHERE WE LEFT OFF
  4919                          
  4920                          
  4921  0e18  ddcb18f6                  SET     MODE_DIRTY_BIT,(IX+FCB_MODE); SET THE DIRTY BIT
  4922                          
  4923                          CHECK_LAST_BLOCK:
  4924  0e1c  ddcb187e                  BIT     MODE_LAST_BLOCK_BIT,(IX+FCB_MODE); CHECK FOR LAST BLOCK
  4925  0e20  2809                      JR      Z,MORE_FILE; JUMP IF THIS ISN'T LAST BLOCK
  4926                          
  4927                          ; IF THIS IS THE LAST BLOCK (AND IT'S NOW FULL) THERE'S NOTHING
  4928                          ; MORE WE CAN DO.  WE LEAVE THE DATA IN PLACE (IT WILL GET
  4929                          ; FLUSHED WHEN THE FILE IS CLOSED) AND REPORT AN EOF ERROR,
  4930                          ; MEANING THAT WE COULDN'T WRITE ALL THE DATA.
  4931                          
  4932  0e22  dde1                      POP     IX; RESTORE REGISTERS
  4933  0e24  e1                        POP     HL
  4934  0e25  d1                        POP     DE
  4935  0e26  c1                        POP     BC
  4936  0e27  3e0a                      LD      A,EOF_ERR; SHOW THE ERROR
  4937  0e29  b7                        OR      A; SET CONDITIONS
  4938  0e2a  c9                        RET
  4939                          
  4940                          ; WE COME HERE IF WE HAVE A FULL BUFFER AND THERE'S MORE
  4941                          ; DATA TO WRITE AND THERE ARE MORE BLOCKS TO THE FILE.
  4942                          
  4943                          MORE_FILE:
  4944  0e2b  dd3413                    INC     (IX+FCB_USED_LENGTH); INCREMENT SECTORS WRITTEN TO
  4945  0e2e  2003                      JR      NZ,MORE_FILE1
  4946  0e30  dd3414                    INC     (IX+FCB_USED_LENGTH+1)
  4947                          MORE_FILE1:
  4948  0e33  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4949  0e36  2aa800                    LD      HL,(BUF_START); GET BUFFER ADDRESS
  4950  0e39  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4951  0e3c  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4952  0e3f  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4953  0e42  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4954  0e45  cde611                    CALL    WRITE_BLOCK; WRITE OUT THE FULL BLOCK
  4955                          
  4956  0e48  c2be0e                    JP      NZ,WRITE_ERR1; BRANCH IF ERROR
  4957                          
  4958                          CLEAR_DIRTY_BIT:
  4959  0e4b  ddcb18b6                  RES     MODE_DIRTY_BIT,(IX+FCB_MODE); CLEAR THE DIRTY BIT
  4960  0e4f  2aa800                    LD      HL,(BUF_START); RESET THE BUFFER POINTER
  4961  0e52  dd7521                    LD      (IX+FCB_POINTER),L
  4962  0e55  dd7422                    LD      (IX+FCB_POINTER+1),H
  4963                          
  4964  0e58  dd361500                  LD      (IX+FCB_LAST_COUNT),0
  4965  0e5c  dd361600                  LD      (IX+FCB_LAST_COUNT+1),0
  4966                          
  4967  0e60  dd3419                    INC     (IX+FCB_BLOCK); INC THE BLOCK NUMBER
  4968  0e63  200d                      JR      NZ,WRITE4; BRANCH IF NO CARRY OUT
  4969  0e65  dd341a                    INC     (IX+FCB_BLOCK+1)
  4970  0e68  2008                      JR      NZ,WRITE4
  4971  0e6a  dd341b                    INC     (IX+FCB_BLOCK+2)
  4972  0e6d  2003                      JR      NZ,WRITE4
  4973  0e6f  dd341c                    INC     (IX+FCB_BLOCK+3)
  4974                          
  4975                          WRITE4:
  4976  0e72  dd7e18                    LD      A,(IX+FCB_MODE); LOOK AT THE MODE BYTE
  4977  0e75  e607                      AND     MODE_MODE; GET RID OF EXTRA BITS
  4978  0e77  fe03                      CP      MODE_UPDATE; DO WE HAVE TO PRE-READ THE NEXT BLOCK?
  4979  0e79  c2d10d                    JP      NZ,WRITE3; LOOP TO TOP IF NOT
  4980                          
  4981                          WRITE_AGAIN:
  4982  0e7c  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  4983  0e7f  2aa800                    LD      HL,(BUF_START); GET BUFFER ADDRESS
  4984  0e82  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  4985  0e85  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  4986  0e88  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  4987  0e8b  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  4988  0e8e  cd7b11                    CALL    READ_BLOCK; PRE-READ THE NEXT FILE BLOCK
  4989                          
  4990  0e91  202b                      JR      NZ,WRITE_ERR1; BRANCH IF ERROR
  4991                          
  4992                          
  4993                          ; ARRIVE HERE IF THE DATA BEING WRITTEN WILL NOT FILL THE BUFFER.
  4994                          ; EVERYTHING IS VERY EASY -- JUST COPY IT FROM USER'S ADDRESS
  4995                          ; INTO THE BUFFER AND GO AWAY.
  4996                          
  4997                          ROOM_OK:
  4998  0e93  ed4ba400                  LD      BC,(BYTES_TO_GO); GET THE BYTE COUNT
  4999  0e97  dd6e15                    LD      L,(IX+FCB_LAST_COUNT)
  5000  0e9a  dd6616                    LD      H,(IX+FCB_LAST_COUNT+1)
  5001  0e9d  09                        ADD     HL,BC
  5002  0e9e  dd7515                    LD      (IX+FCB_LAST_COUNT),L
  5003  0ea1  dd7416                    LD      (IX+FCB_LAST_COUNT+1),H
  5004  0ea4  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO BUFFER
  5005  0ea7  dd5622                    LD      D,(IX+FCB_POINTER+1)
  5006  0eaa  2aa600                    LD      HL,(USER_BUF); GET POINTER TO USER'S DATA
  5007  0ead  edb0                      LDIR; MOVE THE DATA
  5008                          
  5009  0eaf  dd7321                    LD      (IX+FCB_POINTER),E; UPDATE THE POINTER
  5010  0eb2  dd7222                    LD      (IX+FCB_POINTER+1),D
  5011  0eb5  ddcb18f6                  SET     MODE_DIRTY_BIT,(IX+FCB_MODE); SET THE DIRTY BIT
  5012                          
  5013                          ROOM1_OK:
  5014  0eb9  af                        XOR     A
  5015  0eba  1803                      JR      PAST_WRITE_ERR
  5016                          WRITE_ERR2:
  5017  0ebc  3e09                      LD      A,BAD_FNUM_ERR
  5018                          WRITE_ERR1:
  5019  0ebe  b7                        OR      A
  5020                          PAST_WRITE_ERR:
  5021  0ebf  dde1                      POP     IX; RESTORE REGISTERS
  5022  0ec1  e1                        POP     HL
  5023  0ec2  d1                        POP     DE
  5024  0ec3  c1                        POP     BC
  5025  0ec4  c9                        RET
  5026                          ;WRITE_ERR1
  5027                          ;       POP     IX                         ; RESTORE REGISTERS
  5028                          ;       POP     HL
  5029                          ;       POP     DE
  5030                          ;       POP     BC
  5031                          ;       OR      A                          ; SET CONDITIONS
  5032                          ;       RET
  5033                          ;WRITE_ERR2
  5034                          ;       POP     IX                         ; RESTORE REGISTERS
  5035                          ;       POP     HL
  5036                          ;       POP     DE
  5037                          ;       POP     BC
  5038                          ;       LD      A,BAD_FNUM_ERR             ; SHOW AN ERROR
  5039                          ;       OR      A                          ; SET CONDITIONS
  5040                          ;       RET
  5041                          
  5042                          ;=======================================================================
  5043                          ;=======================================================================
  5044                          ;=======================================================================
  5045                          ;
  5046                          
  5047                          
  5048                          ;GLB    __SET_DATE,__GET_DATE
  5049                          ;EXT    EOS_YEAR,EOS_MONTH,EOS_DAY
  5050                          
  5051                          
  5052                          ;-----------------------------------------------------------------------
  5053                          ;
  5054                          ; __SET_DATE -- Set the current date.
  5055                          ;
  5056                          ; ENTRY PARAMETERS: B = day (1..31)
  5057                          ;                   C = month (1..12)
  5058                          ;                   D = year (83..99)
  5059                          ;
  5060                          ; EXIT PARAMETERS: none
  5061                          ;
  5062                          ;-----------------------------------------------------------------------
  5063                          
  5064                          __SET_DATE:
  5065  0ec5  f5                        PUSH    AF; SAVE THE CURRENT A
  5066                          
  5067  0ec6  78                        LD      A,B; STORE THE DAY
  5068  0ec7  328200                    LD      (EOS_DAY),A
  5069  0eca  79                        LD      A,C; STORE THE MONTH
  5070  0ecb  328100                    LD      (EOS_MONTH),A
  5071  0ece  7a                        LD      A,D; STORE THE YEAR
  5072  0ecf  328000                    LD      (EOS_YEAR),A
  5073                          
  5074  0ed2  f1                        POP     AF; RESTORE A
  5075  0ed3  c9                        RET
  5076                          
  5077                          ;-----------------------------------------------------------------------
  5078                          ;
  5079                          ; __GET_DATE -- Reads the current date.
  5080                          ;
  5081                          ; ENTRY PARAMETERS: none
  5082                          ;
  5083                          ; EXIT PARAMETERS: no errors -- Z = 1; A = 0
  5084                          ;                  B = day
  5085                          ;                  C = month
  5086                          ;                  D = year
  5087                          ;
  5088                          ;                  error (date never set) -- Z = 0; A = error code
  5089                          ;                  B = 0
  5090                          ;                  C = 0
  5091                          ;                  D = 0
  5092                          ;
  5093                          ;-----------------------------------------------------------------------
  5094                          
  5095                          __GET_DATE:
  5096  0ed4  3a8200                    LD      A,(EOS_DAY)
  5097  0ed7  47                        LD      B,A; GET THE DAY
  5098  0ed8  3a8100                    LD      A,(EOS_MONTH)
  5099  0edb  4f                        LD      C,A; GET THE MONTH
  5100  0edc  3a8000                    LD      A,(EOS_YEAR)
  5101  0edf  57                        LD      D,A; GET THE YEAR
  5102                          
  5103  0ee0  b0                        OR      B
  5104  0ee1  b1                        OR      C; CHECK FOR ALL = 0
  5105  0ee2  2802                      JR      Z,GET_ERROR; BRANCH IF ERROR
  5106  0ee4  af                        XOR     A; SHOW NO ERROR
  5107  0ee5  c9                        RET
  5108                          
  5109                          GET_ERROR:
  5110  0ee6  3e04                      LD      A,NO_DATE_ERR; SHOW AN ERROR OCCURRED
  5111  0ee8  b7                        OR      A; CLEAR Z FLAG
  5112  0ee9  c9                        RET
  5113                          ;
  5114                          ;=======================================================================
  5115                          ;=======================================================================
  5116                          ;=======================================================================
  5117                          ;
  5118                          
  5119                          
  5120                          ;
  5121                          ; Rev. 1   07oct515p  RPD  made __DELETE_FILE check for protected file
  5122                          ;
  5123                          
  5124                          ;GLB    __FMGR_INIT,SCAN_FOR_FILE,STRCMP,MODE_CHECK
  5125                          ;GLB    READ_BLOCK,WRITE_BLOCK,BASECMP,__WRITE_BLOCK
  5126                          ;GLB    __MODE_CHECK,__READ_BLOCK,SCAN_FOR_FILE
  5127                          ;EXT    __RD_1_BLOCK,__WR_1_BLOCK,__REQUEST_STATUS
  5128                          ;EXT    __QUERY_FILE,__SET_FILE
  5129                          ;EXT    QUERY_BUFFER,FILENAME_CMPS
  5130                          ;EXT    FCB_HEAD_ADDR,FCB_DATA_ADDR
  5131                          ;EXT    USER_NAME,BUF_START
  5132                          ;EXT    RETRY_COUNT
  5133                          ;EXT    FILE_COUNT,MOD_FILE_COUNT
  5134                          
  5135                          
  5136                          ;-----------------------------------------------------------------------
  5137                          ;
  5138                          ; __FMGR_INIT: sets up everything to start with.
  5139                          ;
  5140                          ; ENTRY PARAMETERS: DE contains address to place FCB buffers.
  5141                          ;                   and HL contains address to place FCB headers.
  5142                          ;
  5143                          ; EXIT PARAMETERS: none.
  5144                          ;
  5145                          ;-----------------------------------------------------------------------
  5146                          
  5147                          __FMGR_INIT:
  5148  0eea  ed539f00                  LD      (FCB_DATA_ADDR),DE; SAVE BUFFER ADDRESS
  5149  0eee  229d00                    LD      (FCB_HEAD_ADDR),HL; SAVE HEADER ADDRESS
  5150                          
  5151  0ef1  c5                        PUSH    BC; SAVE REGISTERS
  5152  0ef2  d5                        PUSH    DE
  5153  0ef3  dde5                      PUSH    IX
  5154                          
  5155  0ef5  0603                      LD      B,NUM_FCBS; SET TO # FCBS
  5156  0ef7  112300                    LD      DE,FCB_LENGTH; SET FOR ADDITION
  5157  0efa  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR); GET ADDR OF 0TH FCB
  5158                          
  5159                          INIT_LOOP:
  5160  0efe  dd361800                  LD      (IX+FCB_MODE),MODE_UNUSED; SHOW THE FCB IS EMPTY
  5161  0f02  dd19                      ADD     IX,DE; ADVANCE POINTER TO NEXT FCB
  5162  0f04  10f8                      DJNZ    INIT_LOOP; LOOP FOR ALL FCBS
  5163                          
  5164  0f06  dde1                      POP     IX; RESTORE REGISTERS
  5165  0f08  d1                        POP     DE
  5166  0f09  c1                        POP     BC
  5167  0f0a  c9                        RET
  5168                          
  5169                          ;-----------------------------------------------------------------------
  5170                          ;
  5171                          ; SCAN_FOR_FILE -- Look in the directory for a file name.
  5172                          ;                  Reads each block of the directory into a buffer
  5173                          ;                  (in the system's FCB) and scans through for a
  5174                          ;                  match with the caller's string.
  5175                          ;
  5176                          ; ENTRY PARAMETERS: address of name string in HL; device # in A
  5177                          ;                   ASSUMES FILENAME_CMP SET UP FOR FILE COMPARES
  5178                          ;                   0 - USE STRCMP .  NOT 0 - USE BASECMP  FOR FILE NAME COMPARISONS
  5179                          ;
  5180                          ; EXIT PARAMETERS: if match found -- Z = 1; A = 0; file's start
  5181                          ;                  block in BCDE; directory block left in buffer.
  5182                          ;                  address of entry left in FCB_POINTER.
  5183                          ;
  5184                          ;                  if no match found -- Z = 0; A = error code;
  5185                          ;                  BCDE = junk; other stuff = junk.
  5186                          ;
  5187                          ;-----------------------------------------------------------------------
  5188                          
  5189                          __SCAN_FOR_FILE:
  5190                          SCAN_FOR_FILE:
  5191  0f0b  e5                        PUSH    HL; SAVE REGISTERS
  5192  0f0c  dde5                      PUSH    IX
  5193  0f0e  fde5                      PUSH    IY
  5194                          
  5195  0f10  22b000                    LD      (USER_NAME),HL; SAVE USER'S STRING ADDRESS
  5196                          
  5197  0f13  dd2a9d00                  LD      IX,(FCB_HEAD_ADDR); GET ADDRESS OF SYSTEM'S FCB
  5198                          
  5199                          ; First, set up as much of the FCB as we can.
  5200  0f17  dd7717                    LD      (IX+FCB_DEVICE),A; SET THE DEVICE ADDRESS PASSED TO US
  5201                          
  5202  0f1a  dd361901                  LD      (IX+FCB_BLOCK),1; SET BLOCK TO 1
  5203  0f1e  dd361a00                  LD      (IX+FCB_BLOCK+1),0
  5204  0f22  dd361b00                  LD      (IX+FCB_BLOCK+2),0
  5205  0f26  dd361c00                  LD      (IX+FCB_BLOCK+3),0
  5206                          
  5207  0f2a  ed5b9f00                  LD      DE,(FCB_DATA_ADDR); SET BUFFER ADDRESS
  5208  0f2e  dd7321                    LD      (IX+FCB_POINTER),E
  5209  0f31  dd7222                    LD      (IX+FCB_POINTER+1),D
  5210                          
  5211                          RD_TIMEOUT:
  5212  0f34  217400                    LD      HL,FILE_COUNT
  5213  0f37  3600                      LD      (HL),0
  5214                          
  5215  0f39  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  5216  0f3c  2a9f00                    LD      HL,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5217  0f3f  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  5218  0f42  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  5219  0f45  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  5220  0f48  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  5221  0f4b  cd7b11                    CALL    READ_BLOCK; READ FIRST BLOCK OF DIRECTORY
  5222  0f4e  c22610                    JP      NZ,SCAN_ERROR; BRANCH IF ERROR
  5223                          
  5224                          GET_BUFF_ADDR:
  5225                          
  5226  0f51  e5                        PUSH    HL; GET BUFFER ADDRESS INTO IY TOO
  5227  0f52  fde1                      POP     IY
  5228                          
  5229  0f54  fd7e0c                    LD      A,(IY+VOL_DIRSIZE); GET THE DIRECTORY SIZE
  5230  0f57  e67f                      AND     07FH; ZERO PERM BIT
  5231                          ;       INC     A                           ; ADD 1 'CAUSE WE START IN BLOCK 1
  5232                          ;       DEC     A                           ; SUB 1 'CAUSE OF PICKET FENCE PROBLEM
  5233  0f59  dd771d                    LD      (IX+FCB_LAST_BLOCK),A; SET LAST BLOCK IN FCB
  5234  0f5c  dd361e00                  LD      (IX+FCB_LAST_BLOCK+1),0; (ALL MSBYTES WILL BE 0)
  5235  0f60  dd361f00                  LD      (IX+FCB_LAST_BLOCK+2),0
  5236  0f64  dd362000                  LD      (IX+FCB_LAST_BLOCK+3),0
  5237                          
  5238  0f68  cd3510                    CALL    CHECK_IF_DIRECTORY; CHECK IF DIRECTORY EXIST
  5239  0f6b  c22610                    JP      NZ,SCAN_ERROR
  5240                          
  5241  0f6e  dd7e21                    LD      A,(IX+FCB_POINTER); ADVANCE POINTER TO NEXT ENTRY
  5242  0f71  c61a                      ADD     A,DIR_ENT_LENGTH
  5243  0f73  dd7721                    LD      (IX+FCB_POINTER),A
  5244  0f76  dd7e22                    LD      A,(IX+FCB_POINTER+1)
  5245  0f79  ce00                      ADC     A,0
  5246  0f7b  dd7722                    LD      (IX+FCB_POINTER+1),A
  5247                          
  5248  0f7e  217400                    LD      HL,FILE_COUNT
  5249  0f81  34                        INC     (HL)
  5250                          
  5251  0f82  0626                      LD      B,ENT_PER_BLOCK-1; SET DIR ENTRY COUNT FOR FIRST BLOCK
  5252  0f84  184b                      JR      SCAN2; JUMP INTO THE LOOP
  5253                          
  5254                          SCAN1:
  5255  0f86  dd3419                    INC     (IX+FCB_BLOCK); INC THE BLOCK NUMBER
  5256                          ; WE CAN ASSUME THERE'S NO CARRY OUT
  5257                          
  5258                          ; SEE IF THERE IS MORE DIRECTORY: I.E. IS FCB_BLOCK > FCB_LAST_BLOCK?
  5259                          ; IF TRUE. GO TO NO_ENT.
  5260                          
  5261  0f89  dd7e20                    LD      A,(IX+FCB_LAST_BLOCK+3)
  5262  0f8c  ddbe1c                    CP      (IX+FCB_BLOCK+3)
  5263  0f8f  da2c10                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5264  0f92  dd7e1f                    LD      A,(IX+FCB_LAST_BLOCK+2)
  5265  0f95  ddbe1b                    CP      (IX+FCB_BLOCK+2)
  5266  0f98  da2c10                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5267  0f9b  dd7e1e                    LD      A,(IX+FCB_LAST_BLOCK+1)
  5268  0f9e  ddbe1a                    CP      (IX+FCB_BLOCK+1)
  5269  0fa1  da2c10                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5270  0fa4  dd7e1d                    LD      A,(IX+FCB_LAST_BLOCK)
  5271  0fa7  ddbe19                    CP      (IX+FCB_BLOCK)
  5272  0faa  da2c10                    JP      C,NO_ENT; BRANCH IF NO MORE DIRECTORY
  5273                          
  5274                          RD_TIMEOUT1:
  5275  0fad  dd7e17                    LD      A,(IX+FCB_DEVICE); GET THE DEVICE NUMBER
  5276  0fb0  2a9f00                    LD      HL,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5277  0fb3  dd5e19                    LD      E,(IX+FCB_BLOCK); GET BLOCK NUMBER
  5278  0fb6  dd561a                    LD      D,(IX+FCB_BLOCK+1)
  5279  0fb9  dd4e1b                    LD      C,(IX+FCB_BLOCK+2)
  5280  0fbc  dd461c                    LD      B,(IX+FCB_BLOCK+3)
  5281  0fbf  cd7b11                    CALL    READ_BLOCK; READ THE NEXT BLOCK
  5282  0fc2  c22610                    JP      NZ,SCAN_ERROR; BRANCH IF ERROR
  5283                          
  5284                          GET_BUFF_ADDR1:
  5285                          
  5286                          
  5287  0fc5  ed5b9f00                  LD      DE,(FCB_DATA_ADDR); GET BUFFER ADDRESS
  5288  0fc9  dd7321                    LD      (IX+FCB_POINTER),E; PUT IT INTO THE FCB
  5289  0fcc  dd7222                    LD      (IX+FCB_POINTER+1),D
  5290                          
  5291  0fcf  0627                      LD      B,ENT_PER_BLOCK; SET ENTRY COUNT
  5292                          
  5293                          SCAN2:
  5294  0fd1  217400                    LD      HL,FILE_COUNT
  5295  0fd4  34                        INC     (HL)
  5296                          
  5297  0fd5  dd5e21                    LD      E,(IX+FCB_POINTER); GET POINTER INTO DE
  5298  0fd8  dd5622                    LD      D,(IX+FCB_POINTER+1)
  5299                          
  5300  0fdb  2e0c                      LD      L,DIR_ATTR; OFFSET (FOR ATTR) INTO DIR ENTRY
  5301  0fdd  2600                      LD      H,0; NOT USED
  5302  0fdf  19                        ADD     HL,DE; SET UP HL TO POINT TO IT
  5303  0fe0  cb46                      BIT     ATTR_HOLE_BIT,(HL); IS IT THE HOLE?
  5304  0fe2  2048                      JR      NZ,NO_ENT; YUP. DON'T BOTHER SEARCHING ANY MORE
  5305  0fe4  cb56                      BIT     ATTR_DEL_BIT,(HL); IS THIS FILE DELETED?
  5306  0fe6  2013                      JR      NZ,FILE_DELETED; YUP. DON'T EVEN BOTHER CHECK FILE NAMES
  5307                          
  5308  0fe8  2ab000                    LD      HL,(USER_NAME)
  5309                          
  5310  0feb  3a7800                    LD      A,(FILENAME_CMPS)
  5311  0fee  b7                        OR      A; IS IT ZERO?
  5312  0fef  2805                      JR      Z,FULL_FILENAME; YUP. COMPARE THE FULL FILE NAME
  5313  0ff1  cd0000                    CALL    BASECMP; NOPE. COMPARE JUST THE BASE
  5314  0ff4  1803                      JR      ERROR_CHECK
  5315                          FULL_FILENAME:
  5316  0ff6  cd5310                    CALL    STRCMP; COMPARE THE FULL FILE NAME (BASE PLUS EXTENSION)
  5317                          ERROR_CHECK:
  5318  0ff9  2815                      JR      Z,SCAN3; BRANCH IF YES
  5319                          
  5320                          FILE_DELETED:
  5321  0ffb  dd7e21                    LD      A,(IX+FCB_POINTER); ADVANCE POINTER TO NEXT ENTRY
  5322  0ffe  c61a                      ADD     A,DIR_ENT_LENGTH
  5323  1000  dd7721                    LD      (IX+FCB_POINTER),A
  5324  1003  dd7e22                    LD      A,(IX+FCB_POINTER+1)
  5325  1006  ce00                      ADC     A,0
  5326  1008  dd7722                    LD      (IX+FCB_POINTER+1),A
  5327                          
  5328  100b  10c4                      DJNZ    SCAN2; LOOP IF MORE ENTRIES TO CHECK IN THIS BLOCK
  5329                          
  5330  100d  c3860f                    JP      SCAN1; ELSE GET NEXT BLOCK
  5331                          
  5332                          SCAN3:
  5333  1010  d5                        PUSH    DE; GET DIR ENTRY PTR INTO IY
  5334  1011  fde1                      POP     IY
  5335                          
  5336  1013  fd5e0d                    LD      E,(IY+DIR_START_BLOCK+0)
  5337  1016  fd560e                    LD      D,(IY+DIR_START_BLOCK+1)
  5338  1019  fd4e0f                    LD      C,(IY+DIR_START_BLOCK+2)
  5339  101c  fd4610                    LD      B,(IY+DIR_START_BLOCK+3)
  5340                          
  5341  101f  fde1                      POP     IY; RESTORE REGISTERS
  5342  1021  dde1                      POP     IX
  5343  1023  e1                        POP     HL
  5344  1024  af                        XOR     A; SHOW NO ERROR
  5345  1025  c9                        RET
  5346                          
  5347                          SCAN_ERROR:
  5348  1026  fde1                      POP     IY; RESTORE REGISTERS
  5349  1028  dde1                      POP     IX
  5350  102a  e1                        POP     HL
  5351  102b  c9                        RET
  5352                          
  5353                          NO_ENT:
  5354  102c  fde1                      POP     IY; RESTORE REGISTERS
  5355  102e  dde1                      POP     IX
  5356  1030  e1                        POP     HL
  5357  1031  3e05                      LD      A,NO_FILE_ERR
  5358  1033  b7                        OR      A
  5359  1034  c9                        RET
  5360                          

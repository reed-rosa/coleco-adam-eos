  8187                          ;
  8188                          
  8189                          
  8190                          ; ENTRY:        __HARD_INIT
  8191                          ; NEEDS:        NOTHING
  8192                          ; RETURNS:      DEFAULT PCB ADDRESS SET UP FOR USE ((CURRENT_PCB) = PCB)
  8193                          ;               HARD RESET APPLIED TO NETWORK
  8194                          ;               NETWORK MASTER NODE IN SYNC WITH Z80
  8195                          ;               1 DCB ALLOTTED FOR EACH DEVICE ANSWERING A STATUS REQUEST
  8196                          ;               CORRECTLY
  8197                          ;               MASTER NODE SCANNING EACH OF THESE DCB'S FOR WORK TO DO
  8198                          
  8199                          ;GLB    __HARD_INIT
  8200                          
  8201                          ;EXT    CURRENT_PCB
  8202                          ;EXT    PCB
  8203                          
  8204                          __HARD_INIT:
  8205  18f6  c5                        PUSH    BC; SAVE BC
  8206  18f7  d5                        PUSH    DE;      DE
  8207  18f8  e5                        PUSH    HL;      HL
  8208  18f9  fde5                      PUSH    IY;      IY
  8209                          
  8210  18fb  210000                    LD      HL,PCB; INIT OUR IDEA OF CURRENT_PCB
  8211  18fe  221000                    LD      (CURRENT_PCB),HL
  8212                          
  8213  1901  cd4b19                    CALL    __HARD_RESET_NET; HARD RESET NETWORK
  8214                          
  8215  1904  cd5f19                    CALL    __DLY_AFT_HRD_RES; GOOD DELAY AFTER HARD
  8216                          ; NET RESET
  8217                          
  8218  1907  210000                    LD      HL,PCB; ZERO OUT PCB/DCB'S
  8219  190a  110100                    LD      DE,PCB+1
  8220                          ;         LD      BC,P_SIZE+(15*D_SIZE)-1 ; [RECON] OCR 8293 is commented; OCR 8294 is the active full-size clear.
  8221  190d  013f01                    LD      BC,P_SIZE+(15*D_SIZE); this byte count will zero out PCB, DCB'S and the reserved byte
  8222  1910  3600                      LD      (HL),0
  8223  1912  edb0                      LDIR
  8224                          
  8225                          REPEAT_SYNC1:
  8226  1914  cd7019                    CALL    __SYNC
  8227  1917  20fb                      JR      NZ,REPEAT_SYNC1
  8228                          
  8229  1919  cdcb19                    CALL    __SCAN_ACTIVE; FIND ALL THE ACTIVE DEVICES ON THE NET
  8230                          
  8231  191c  fde1                      POP     IY; RESTORE IY
  8232  191e  e1                        POP     HL;         HL
  8233  191f  d1                        POP     DE;         DE
  8234  1920  c1                        POP     BC;         BC
  8235                          
  8236  1921  c9                        RET
  8237                          
  8238                          ;
  8239                          ; ENTRY:        __SOFT_INIT
  8240                          ; NEEDS:        HL = PCB ADDRESS SET UP FOR USE
  8241                          ; RETURNS:      (CURRENT_PCB) = HL
  8242                          ;               HARD RESET APPLIED TO NETWORK
  8243                          ;               NETWORK MASTER NODE IN SYNC WITH Z80
  8244                          ;               1 DCB ALLOTTED FOR EACH DEVICE ANSWERING A STATUS REQUEST
  8245                          ;               CORRECTLY
  8246                          ;               MASTER NODE SCANNING EACH OF THESE DCB'S FOR WORK TO DO
  8247                          
  8248                          ;GLB    __SOFT_INIT
  8249                          
  8250                          __SOFT_INIT:
  8251  1922  c5                        PUSH    BC; SAVE BC
  8252  1923  d5                        PUSH    DE;      DE
  8253  1924  e5                        PUSH    HL;      HL
  8254  1925  fde5                      PUSH    IY;      IY
  8255                          
  8256  1927  221000                    LD      (CURRENT_PCB),HL; ESTABLISH CURRENT_PCB ADDR
  8257                          
  8258  192a  cd4b19                    CALL    __HARD_RESET_NET; HARD RESET NETWORK
  8259                          
  8260  192d  cd5f19                    CALL    __DLY_AFT_HRD_RES
  8261                          
  8262  1930  2a1000                    LD      HL,(CURRENT_PCB); ZERO OUT PCB/DCB'S
  8263  1933  5d                        LD      E,L
  8264  1934  54                        LD      D,H
  8265  1935  13                        INC     DE
  8266  1936  013e01                    LD      BC,P_SIZE+(15*D_SIZE)-1
  8267  1939  3600                      LD      (HL),0
  8268  193b  edb0                      LDIR
  8269                          
  8270                          REPEAT_SYNC2:
  8271  193d  cd7019                    CALL    __SYNC
  8272  1940  20fb                      JR      NZ,REPEAT_SYNC2
  8273                          
  8274  1942  cdcb19                    CALL    __SCAN_ACTIVE; FIND ALL THE ACTIVE DEVICES ON THE NET
  8275                          
  8276  1945  fde1                      POP     IY; RESTORE IY
  8277  1947  e1                        POP     HL;         HL
  8278  1948  d1                        POP     DE;         DE
  8279  1949  c1                        POP     BC;         BC
  8280                          
  8281  194a  c9                        RET
  8282                          
  8283                          
  8284                          ; ENTRY:        __HARD_RESET_NET
  8285                          ; NEEDS:        NOTHING
  8286                          ; RETURNS:      HARD RESET APPLIED TO NETWORK
  8287                          
  8288                          NET_DELAY_COUNT EQU     0
  8289                          
  8290                          ;GLB    __HARD_RESET_NET
  8291                          
  8292                          __HARD_RESET_NET:
  8293                          ;EXT    NET_RESET_PORT
  8294  194b  3a2900                    LD      A,(NET_RESET_PORT)
  8295  194e  4f                        LD      C,A
  8296  194f  3e0f                      LD      A,0FH; RESET NETWORK
  8297  1951  ed79                      OUT     (C),A
  8298                          
  8299  1953  3e00                      LD      A,NET_DELAY_COUNT; DELAY (***** PROBABLY TOO LONG)
  8300                          
  8301                          NET_RES_DELAY:
  8302  1955  00                        NOP
  8303  1956  00                        NOP
  8304  1957  00                        NOP
  8305  1958  3d                        DEC     A
  8306  1959  20fa                      JR      NZ,NET_RES_DELAY
  8307                          
  8308  195b  af                        XOR     A; HELLLLLLLLOOOOOOO NETWORK .....
  8309  195c  ed79                      OUT     (C),A
  8310                          
  8311  195e  c9                        RET
  8312                          
  8313                          
  8314                          ;GLB    __DLY_AFT_HRD_RES
  8315                          
  8316                          __DLY_AFT_HRD_RES:
  8317  195f  c5                        PUSH    BC
  8318  1960  d5                        PUSH    DE
  8319                          
  8320  1961  0601                      LD      B,1
  8321                          
  8322                          LOOP8:
  8323  1963  110100                    LD      DE,0001H
  8324                          
  8325                          LOOP7:
  8326  1966  1b                        DEC     DE
  8327  1967  7a                        LD      A,D
  8328  1968  b3                        OR      E
  8329  1969  20fb                      JR      NZ,LOOP7
  8330                          
  8331  196b  10f6                      DJNZ    LOOP8
  8332                          
  8333  196d  d1                        POP     DE
  8334  196e  c1                        POP     BC
  8335                          
  8336  196f  c9                        RET
  8337                          
  8338                          
  8339                          ; ENTRY:        __SYNC
  8340                          ; NEEDS:        (CURRENT_PCB) SET TO ADDRESS OF CURRENTLY OPERATING PCB
  8341                          ; RETURNS:      NETWORK MASTER NODE IN SYNC WITH Z80
  8342                          ;               NUMBER OF DCB'S = 0 (SO MASTER NODE IS NOT SCANNING
  8343                          ;               ANY DCB'S - SO A __SCAN_ACTIVE NEEDS TO BE DONE
  8344                          ;               TO ESTABLISH DCB'S)
  8345                          
  8346                          SYNC_DELAY_DE EQU 0
  8347                          SYNC_DELAY_B  EQU 2
  8348                          
  8349                          ;GLB    __SYNC
  8350                          
  8351                          __SYNC:
  8352  1970  fde5                      PUSH    IY; SAVE IY
  8353  1972  e5                        PUSH    HL;      HL
  8354  1973  c5                        PUSH    BC
  8355  1974  d5                        PUSH    DE
  8356                          
  8357  1975  fd2a1000                  LD      IY,(CURRENT_PCB); CURRENT PCB
  8358                          
  8359  1979  fd360300                  LD      (IY+P_NUM_DCBS),0; 0 DCB'S
  8360                          
  8361  197d  fd360001                  LD      (IY+P_COM_STAT),PCB_SYNC1; START SYNC WITH FIRST
  8362                          ; BYTE
  8363                          
  8364  1981  110000                    LD      DE,SYNC_DELAY_DE
  8365  1984  0602                      LD      B,SYNC_DELAY_B
  8366                          
  8367                          LOOP1:
  8368  1986  1b                        DEC     DE
  8369  1987  7a                        LD      A,D
  8370  1988  b3                        OR      E
  8371  1989  200a                      JR      NZ,NOT_TIME1
  8372                          
  8373  198b  110000                    LD      DE,SYNC_DELAY_DE
  8374                          
  8375  198e  1005                      DJNZ    NOT_TIME1
  8376                          
  8377  1990  3e12                      LD      A,CANT_SYNC1
  8378  1992  b7                        OR      A; ERROR
  8379                          
  8380  1993  1830                      JR      END_SYNC
  8381                          
  8382                          NOT_TIME1:
  8383  1995  fd7e00                    LD      A,(IY+P_COM_STAT); DID MASTER NODE ACKNOWLEDGE ?
  8384  1998  fe81                      CP      PCB_SYNC1_ACK
  8385  199a  20ea                      JR      NZ,LOOP1; ***** NEED PROTECTION HERE
  8386                          
  8387  199c  fd360002                  LD      (IY+P_COM_STAT),PCB_SYNC2; CONTINUE SYNC WITH
  8388                          ; SECOND BYTE
  8389                          
  8390  19a0  110000                    LD      DE,SYNC_DELAY_DE
  8391  19a3  0602                      LD      B,SYNC_DELAY_B
  8392                          
  8393                          LOOP2:
  8394  19a5  1b                        DEC     DE
  8395  19a6  7a                        LD      A,D
  8396  19a7  b3                        OR      E
  8397  19a8  200a                      JR      NZ,NOT_TIME2
  8398                          
  8399  19aa  110000                    LD      DE,SYNC_DELAY_DE
  8400                          
  8401  19ad  1005                      DJNZ    NOT_TIME2
  8402                          
  8403  19af  3e13                      LD      A,CANT_SYNC2
  8404  19b1  b7                        OR      A; ERROR
  8405                          
  8406  19b2  1811                      JR      END_SYNC
  8407                          
  8408                          NOT_TIME2:
  8409  19b4  fd7e00                    LD      A,(IY+P_COM_STAT); DID MASTER NODE ACKNOWLEDGE ?
  8410  19b7  fe82                      CP      PCB_SYNC2_ACK
  8411  19b9  20ea                      JR      NZ,LOOP2; ***** NEED PROTECTION HERE
  8412                          
  8413  19bb  fde5                      PUSH    IY; GET PCB ADDR INTO HL
  8414  19bd  e1                        POP     HL
  8415                          
  8416  19be  fd7501                    LD      (IY+P_REL_ADDR_LO),L; IN CASE SOMEONE ACCIDENTALLY DOES
  8417  19c1  fd7402                    LD      (IY+P_REL_ADDR_HI),H; A PCB RELOCATION COMMAND -
  8418                          ; IT WILL RELOCATE TO THIS SPOT
  8419                          
  8420  19c4  af                        XOR     A; NO ERROR
  8421                          
  8422                          END_SYNC:
  8423  19c5  d1                        POP     DE
  8424  19c6  c1                        POP     BC
  8425  19c7  e1                        POP     HL; RESTORE HL
  8426  19c8  fde1                      POP     IY;         IY
  8427                          
  8428  19ca  c9                        RET
  8429                          
  8430                          
  8431                          ; ENTRY:        __SCAN_ACTIVE
  8432                          ; NEEDS:        (CURRENT_PCB) SET TO CURRENTLY OPERATING PCB
  8433                          ; RETURNS:      1 DCB ALLOTTED FOR EACH DEVICE ANSWERING A STATUS REQUEST
  8434                          ;               CORRECTLY
  8435                          ;               MASTER NODE SCANNING EACH OF THESE DCB'S FOR WORK TO DO
  8436                          
  8437                          ;GLB    __SCAN_ACTIVE
  8438                          
  8439                          __SCAN_ACTIVE:
  8440  19cb  c5                        PUSH    BC; SAVE BC
  8441  19cc  d5                        PUSH    DE;      DE
  8442  19cd  e5                        PUSH    HL;      HL
  8443  19ce  fde5                      PUSH    IY;      IY
  8444  19d0  dde5                      PUSH    IX;      IX
  8445                          
  8446  19d2  2a1000                    LD      HL,(CURRENT_PCB); ZERO OUT DCB'S
  8447  19d5  110400                    LD      DE,P_SIZE; POINT TO DCB'S
  8448  19d8  19                        ADD     HL,DE
  8449  19d9  5d                        LD      E,L; WANT DE = (CURRENT_PCB)+P_SIZE+1
  8450  19da  54                        LD      D,H
  8451  19db  13                        INC     DE
  8452  19dc  013a01                    LD      BC,(15*D_SIZE)-1
  8453  19df  3600                      LD      (HL),0
  8454  19e1  edb0                      LDIR
  8455                          
  8456  19e3  fd2a1000                  LD      IY,(CURRENT_PCB); FIND START ADDR OF DCB'S
  8457  19e7  110400                    LD      DE,P_SIZE
  8458  19ea  fd19                      ADD     IY,DE
  8459                          
  8460  19ec  dd2a1000                  LD      IX,(CURRENT_PCB); IX = (CURRENT_PCB)
  8461  19f0  dd360301                  LD      (IX+P_NUM_DCBS),1; NEED AT LEAST 1 ACTIVE DCB
  8462                          ; TO START CHECKING
  8463                          
  8464  19f4  3e01                      LD      A,1; START WITH DEV ADDR 1
  8465                          
  8466                          LOOP3:
  8467  19f6  f5                        PUSH    AF; SAVE CURRENT DEVICE ADDR
  8468                          
  8469  19f7  fd7710                    LD      (IY+D_DEV_ADDR),A; SELECT A NEW ADDRESS
  8470                          
  8471  19fa  fd360001                  LD      (IY+D_COM_STAT),DCB_STATUS; ISSUE A REQUEST FOR STATUS
  8472                          
  8473                          LOOP4:
  8474  19fe  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); IO DONE ?
  8475  1a02  28fa                      JR      Z,LOOP4; ***** NEED PROTECTION HERE
  8476                          
  8477  1a04  fd7e00                    LD      A,(IY+D_COM_STAT); CHECK IF VALID RESPONSE
  8478  1a07  fe80                      CP      CMND_FIN_STATUS
  8479  1a09  280b                      JR      Z,RECVD_VALID_STAT; YES INDEED ...
  8480                          
  8481  1a0b  f1                        POP     AF; TRY NEXT DEVICE ADDR
  8482                          
  8483  1a0c  3c                        INC     A
  8484  1a0d  fe10                      CP      MAX_DEV_ADDR+1; PAST LAST VALID ADDR ?
  8485  1a0f  20e5                      JR      NZ,LOOP3; NOPE - NEW ADDR
  8486                          
  8487  1a11  dd3503                    DEC     (IX+P_NUM_DCBS); DON'T NEED LAST DCB WE USED
  8488                          
  8489  1a14  1811                      JR      END_S_A; ALL DONE
  8490                          
  8491                          RECVD_VALID_STAT:
  8492  1a16  dd3403                    INC     (IX+P_NUM_DCBS)
  8493                          
  8494  1a19  111500                    LD      DE,D_SIZE; ADVANCE TO NEXT DCB
  8495  1a1c  fd19                      ADD     IY,DE
  8496                          
  8497  1a1e  f1                        POP     AF; ADVANCE TO NEXT NET ADDR
  8498                          
  8499  1a1f  3c                        INC     A
  8500  1a20  fe10                      CP      MAX_DEV_ADDR+1; NO MORE ?
  8501  1a22  20d2                      JR      NZ,LOOP3; MORE TO CHECK
  8502                          
  8503  1a24  dd3503                    DEC     (IX+P_NUM_DCBS); DON'T NEED LAST DCB WE USED
  8504                          
  8505                          END_S_A:
  8506  1a27  dde1                      POP     IX; RESTORE IX
  8507  1a29  fde1                      POP     IY;         IY
  8508  1a2b  e1                        POP     HL;         HL
  8509  1a2c  d1                        POP     DE;         DE
  8510  1a2d  c1                        POP     BC;         BC
  8511                          
  8512  1a2e  c9                        RET
  8513                          
  8514                          
  8515                          ; ENTRY:        __RELOC_PCB
  8516                          ; NEEDS:        (CURRENT_PCB) SET TO CURRENTLY OPERATING PCB
  8517                          ;               HL = ADDRESS OF WHERE PCB SHOULD BE RELOCATED TO
  8518                          ; RETURNS:      PCB RELOCATED AS REQUESTED
  8519                          ;               (CURRENT_PCB) UPDATED TO REFLECT NEW ADDRESS
  8520                          
  8521                          ;GLB    __RELOC_PCB
  8522                          
  8523                          __RELOC_PCB:
  8524  1a2f  fde5                      PUSH    IY
  8525                          
  8526  1a31  fd2a1000                  LD      IY,(CURRENT_PCB); IY = ADDRESS OF CURRENT PCB
  8527                          
  8528  1a35  fd7501                    LD      (IY+P_REL_ADDR_LO),L; PLACE ADDR OF NEW PCB IN PLACE
  8529  1a38  fd7402                    LD      (IY+P_REL_ADDR_HI),H
  8530                          
  8531  1a3b  fd360003                  LD      (IY+P_COM_STAT),PCB_SNA; TELL MASTER TO SET NEW PCB ADDRESS
  8532                          
  8533                          LOOP5:
  8534  1a3f  fd7e00                    LD      A,(IY+P_COM_STAT); CHECK FOR OPERATION COMPLETE
  8535  1a42  fe83                      CP      PCB_SNA_ACK; ***** NEED PROTECTION HERE
  8536  1a44  20f9                      JR      NZ,LOOP5; NOPE
  8537                          
  8538  1a46  221000                    LD      (CURRENT_PCB),HL; REMEMBER WHERE PCB IS (PLEASE...)
  8539                          
  8540  1a49  fde1                      POP     IY
  8541                          
  8542  1a4b  c9                        RET
  8543                          
  8544                          
  8545                          ; ENTRY:        __GET_PCB_ADDR
  8546                          
  8547                          ;GLB    __GET_PCB_ADDR
  8548                          
  8549                          __GET_PCB_ADDR:
  8550  1a4c  fd2a1000                  LD      IY,(CURRENT_PCB); ADDRESS OF PCB
  8551                          
  8552  1a50  c9                        RET
  8553                          
  8554                          
  8555                          ;GLB    __SOFT_RES_KBD,__SOFT_RES_PR,__SOFT_RES_TAPE
  8556                          
  8557                          ;EXT    __FIND_DCB,CHK_IF_INACTIVE
  8558                          
  8559                          __SOFT_RES_KBD:
  8560  1a51  3e01                      LD      A,KEYBOARD_ID; RESET KBD
  8561  1a53  1808                      JR      __SOFT_RES_DEV
  8562                          
  8563                          __SOFT_RES_PR:
  8564  1a55  3e02                      LD      A,PRINTER_ID; RESET PRINTER
  8565  1a57  1804                      JR      __SOFT_RES_DEV
  8566                          
  8567                          __SOFT_RES_TAPE:
  8568  1a59  3e08                      LD      A,TAPE_ID; RESET TAPE
  8569  1a5b  1800                      JR      __SOFT_RES_DEV
  8570                          
  8571                          ;GLB    __SOFT_RES_DEV
  8572                          
  8573                          __SOFT_RES_DEV:
  8574  1a5d  fde5                      PUSH    IY; SAVE IY
  8575                          
  8576  1a5f  cd4614                    CALL    __FIND_DCB; FIND APPROPRIATE DEVICE
  8577  1a62  2014                      JR      NZ,NO_DCB_FOUND; BAD DEVICE I.D.
  8578                          
  8579  1a64  cd9614                    CALL    CHK_IF_INACTIVE; IS DEVICE IDLE?
  8580  1a67  200f                      JR      NZ,ACTIVE_DCB; NOPE ... OOPS ...
  8581                          
  8582  1a69  fd360002                  LD      (IY+D_COM_STAT),DCB_RESET; SOFT RESET DEVICE
  8583                          
  8584                          DCB_CMND_LOOP:
  8585  1a6d  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); WAS COMMAND COMPLETE?
  8586  1a71  28fa                      JR      Z,DCB_CMND_LOOP; NOPE, CHECK AGAIN
  8587                          
  8588  1a73  fd7e00                    LD      A,(IY+D_COM_STAT); YUP
  8589  1a76  fe80                      CP      CMND_FIN_STATUS
  8590                          
  8591                          ACTIVE_DCB:
  8592                          NO_DCB_FOUND:
  8593  1a78  fde1                      POP     IY
  8594                          
  8595  1a7a  c9                        RET
  8596                          
  8597                          
  8598                          ; READ DCB RETURN CODE (FIRST BYTE OF DCB)
  8599                          
  8600                          ;GLB    __RD_KBD_RET_CODE,__RD_PR_RET_CODE,__RD_TAPE_RET_CODE
  8601                          
  8602                          __RD_KBD_RET_CODE:
  8603  1a7b  3e01                      LD      A,KEYBOARD_ID; RESET KBD
  8604  1a7d  1808                      JR      __RD_RET_CODE
  8605                          
  8606                          __RD_PR_RET_CODE:
  8607  1a7f  3e02                      LD      A,PRINTER_ID; RESET PRINTER
  8608  1a81  1804                      JR      __RD_RET_CODE
  8609                          
  8610                          __RD_TAPE_RET_CODE:
  8611  1a83  3e08                      LD      A,TAPE_ID; RESET TAPE
  8612  1a85  1800                      JR      __RD_RET_CODE
  8613                          
  8614                          ;GLB    __RD_RET_CODE
  8615                          
  8616                          __RD_RET_CODE:
  8617  1a87  fde5                      PUSH    IY; SAVE IY
  8618                          
  8619  1a89  cd4614                    CALL    __FIND_DCB; FIND APPROPRIATE DEVICE
  8620  1a8c  2003                      JR      NZ,NO_DCB_FOUND2; BAD DEVICE I.D.
  8621                          ; Z CONDITION CODE PRESENT
  8622                          
  8623                          
  8624  1a8e  fd7e00                    LD      A,(IY+D_COM_STAT); COMMAND/STATUS BYTE FROM DCB
  8625                          
  8626                          NO_DCB_FOUND2:
  8627  1a91  fde1                      POP     IY
  8628                          
  8629  1a93  c9                        RET
  8630                          
  8631                          ;WP             EQU     02000H                  ; WHERE TO GO TO START WP
  8632                          WP              EQU     00100H; WHERE TO GO TO START WP
  8633                          ;GLB    __GOTO_WP
  8634                          ;EXT    MEM_CNFGOO
  8635                          ;EXT    SWITCH_MEM
  8636                          __GOTO_WP:
  8637  1a94  3a1800                    LD      A,(MEM_CNFGOO);get configuration byte for 32K ROM and 32 RAM
  8638  1a97  cde400                    CALL    SWITCH_MEM
  8639                          
  8640                          ;WP_CODE_START  EQU     2000H
  8641                          ;WP_SIZE        EQU     3*8+1024
  8642                          ;WP_DEST        EQU     8000H
  8643                          ;       LD      A,0                         ; BANK SWITCH IN THE BOOT ROMS
  8644                          ;       OUT     (7FH),A                     ; (I HOPE)
  8645                          ;
  8646                          ;       LD      HL,WP_CODE_START            ; WHERE DOES WP SIT IN BOOT ROMS
  8647                          ;       LD      DE,WP_DEST                  ; WHERE WP GOES
  8648                          ;       LD      BC,WP_SIZE                  ; HOW BIG WP IS
  8649                          ;       LDIR                                ; MOVE WP INTO PLACE
  8650                          ;
  8651                          ;       LD      A,3                         ; BANK SWITCH IN OS_7
  8652                          ;       OUT     (7FH),A                     ; (I KNOW)
  8653                          ;
  8654  1a9a  c30001                    JP      WP; GOTO WP
  8655                          
  8656                          ;GLB    __READ_EOS
  8657                          
  8658                          __READ_EOS:
  8659  1a9d  c9                        RET
  8660                          ;
  8661                          ;       CODE FROM HERE TO END OF EOS_UTIL WAS INSERTED AFTER THE
  8662                          ;       REV. 06 ROM WAS BURNED.  IT HAS BEEN COMMENTED OUT TO MAINTAIN
  8663                          ;       COMPATIBILITY WITH THAT ROM
  8664                          ;
  8665                          ;       END
  8666                          ;
  8667                          ;
  8668                          ;EOS_CODE_START EQU 00800H
  8669                          ;EOS_SIZE       EQU 02000H+800H
  8670                          ;EOS_DEST       EQU 0E000H+800H
  8671                          ;
  8672                          ;       LD      A,0                         ; BANK SWITCH IN THE BOOT ROMS
  8673                          ;       OUT     (7FH),A                     ; (I HOPE)
  8674                          ;
  8675                          ;       LD      HL,EOS_CODE_START           ; WHERE DOES EOS SIT IN BOOT ROMS
  8676                          ;       LD      DE,EOS_DEST                 ; WHERE EOS GOES
  8677                          ;       LD      BC,EOS_SIZE                 ; HOW BIG EOS IS
  8678                          ;       LDIR                                ; MOVE EOS INTO PLACE
  8679                          ;
  8680                          ;       LD      A,3                         ; BANK SWITCH IN OS_7
  8681                          ;       OUT     (7FH),A                     ; (I KNOW)
  8682                          ;
  8683                          ;       RET                                 ; EOS IS IN
  8684                          ;;
  8685                          ;;===============================================================
  8686                          ;;===============================================================
  8687                          ;;===============================================================
  8688                          ;;
  8689                          ; REV 0                  8/24/83  V/D
  8690                          ;***************************************************************
  8691                          ;
  8692                          ;       __RD_1_BLOCK WILL READ ONE BLOCK OF DATA FROM A BLOCK DEVICE
  8693                          ;       TO A LOCATION SPECIFIED BY REGISTER HL
  8694                          ;
  8695                          ;       INPUT:  A         DEVICE ID
  8696                          ;                         LOW NIBBLE - DEVICE ADDRESS
  8697                          ;                         HI NIBBLE  - SECONDARY DEVICE ID
  8698                          ;
  8699                          ;               HL        DESTINATION ADDRESS IN RAM
  8700                          ;
  8701                          ;               REGISTER PAIR.
  8702                          ;                         BC DE       - SECTOR NUMBER ON DEVICE
  8703                          ;
  8704                          ;       THE TRANSFER BYTE COUNT IS DEFINED BY "DCB_MAX_MESS_LEN" WHICH
  8705                          ;       IS FOUND IN THE DEVICE DCB.
  8706                          ;
  8707                          ;       OUTPUT:
  8708                          ;               CONDITION BITS:
  8709                          ;                         Z: NO ERRORS
  8710                          ;                         NZ: ERRORS OCCURED
  8711                          ;                             A - ERROR CODE
  8712                          ;
  8713                          ;       ALL REGISTERS ARE PRESERVED
  8714                          ;
  8715                          ;***************************************************************
  8716                          
  8717                          ;GLB    __RD_1_BLOCK
  8718                          ;EXT    __FIND_DCB
  8719                          ;EXT    CHK_IF_INACTIVE
  8720                          
  8721                          __RD_1_BLOCK:
  8722  1a9e  fde5                      PUSH    IY
  8723                          
  8724  1aa0  f5                        PUSH    AF; SAVE DEVICE ID
  8725                          
  8726  1aa1  cdc61a                    CALL    __START_RD_1_BLOCK
  8727                          
  8728  1aa4  2007                      JR      NZ,ERROR_WITH_DCB
  8729                          
  8730                          RD_NOT_COMPLETED:
  8731  1aa6  f1                        POP     AF; GET DEVICE ID
  8732  1aa7  f5                        PUSH    AF; SAVE IT AGAIN
  8733                          
  8734  1aa8  cde21a                    CALL    __END_RD_1_BLOCK; LOOK FOR STATUS
  8735                          
  8736  1aab  30f9                      JR      NC,RD_NOT_COMPLETED; COMMAND NOT COMPLETED, CHECK STATUS AGAIN
  8737                          
  8738                          ERROR_WITH_DCB:
  8739  1aad  fde1                      POP     IY; REALLY IS AF BUT NEED TO SAVE IF AN ERROR
  8740                          
  8741  1aaf  fde1                      POP     IY
  8742                          
  8743  1ab1  c9                        RET
  8744                          ;***************************************************************
  8745                          ;
  8746                          ;       __WR_1_BLOCK WILL WRITE ONE BLOCK OF DATA TO A BLOCK DRIVER
  8747                          ;       FORM A LOCATION SPECIFIED BY REGISTER HL
  8748                          ;
  8749                          ;       INPUT:
  8750                          ;               A         DEVICE ID
  8751                          ;                         LOW NIBBLE - DEVICE ADDRESS
  8752                          ;                         HI NIBBLE  - SECONDARY DEVICE ID
  8753                          ;
  8754                          ;               HL        SOURCE ADDRESS IN RAM
  8755                          ;
  8756                          ;               REGISTER PAIR:
  8757                          ;                         BC DE   - SECTOR NUMBER ON DEVICE
  8758                          ;
  8759                          ;       THE TRANSFER BYTE COUNT IS DEFINED BY "DCB_MAX_MESS_LEN"
  8760                          ;       WHICH IS FOUND IN THE DEVICE DCB
  8761                          ;
  8762                          ;       OUTPUT:
  8763                          ;               CONDITION BITS:
  8764                          ;                         Z:  NO ERRORS
  8765                          ;                         NZ: ERRORS OCCURED
  8766                          ;                             A - ERROR CODE
  8767                          ;
  8768                          ;       ALL REGISTERS  ARE PRESERVED
  8769                          ;
  8770                          ;***************************************************************
  8771                          
  8772                          ;GLB    __WR_1_BLOCK
  8773                          
  8774                          __WR_1_BLOCK:
  8775  1ab2  fde5                      PUSH    IY
  8776                          
  8777  1ab4  f5                        PUSH    AF; SAVE DEVICE ID
  8778                          
  8779  1ab5  cdff1a                    CALL    __START_WR_1_BLOCK
  8780                          
  8781  1ab8  2007                      JR      NZ,ERROR_WITH_DCB2; DCB NOT FOUND OR NOT IDLE
  8782                          
  8783                          WR_NOT_COMPLETED:
  8784  1aba  f1                        POP     AF; GET DEVICE ID
  8785                          
  8786  1abb  f5                        PUSH    AF
  8787                          
  8788  1abc  cd1b1b                    CALL    __END_WR_1_BLOCK
  8789                          
  8790  1abf  30f9                      JR      NC,WR_NOT_COMPLETED; COMMAND NOT COMPLETED,CHECK STATUS AGAIN
  8791                          
  8792                          ERROR_WITH_DCB2:
  8793  1ac1  fde1                      POP     IY; IS REALLY AF BUT NEED TO PRESERVE A REG IN CASE OF ERRORS
  8794                          
  8795  1ac3  fde1                      POP     IY
  8796                          
  8797  1ac5  c9                        RET
  8798                          ;***************************************************************
  8799                          ;
  8800                          ;       __START_RD_1_BLOCK WILL SEND A READ COMMAND TO READ A BLOCK
  8801                          ;       OF DATA FROM A BLOCK DEVICE TO A BUFFER SPECIFIED BY REGISTER HL
  8802                          ;
  8803                          ;       INPUT:  A         DEVICE ID
  8804                          ;                         LOW NIBBLE  - DEVICE ADDRESS
  8805                          ;                         HI NIBBLE   - SECONDARY DEVICE ID
  8806                          ;
  8807                          ;               HL        DESTINATION ADDRESS IN RAM
  8808                          ;
  8809                          ;               REGISTER PAIR:
  8810                          ;                         BC DE       - SECTOR NUMBER ON DEVICE
  8811                          ;
  8812                          ;       THE TRANSFER BYTE COUNT IS DEFINED BY "DCB_MAX_MESS_LEN" WHICH
  8813                          ;       IS FOUND IN THE DEVICE DCB.
  8814                          ;
  8815                          ;       OUTPUT:
  8816                          ;               CONDITION BITS:
  8817                          ;                         Z:  NO ERRORS
  8818                          ;                         NZ: ERRORS OCCURED
  8819                          ;                             A - ERROR CODE
  8820                          ;
  8821                          ;       ALL REGISTERS ARE PRESERVED
  8822                          ;
  8823                          ;***************************************************************
  8824                          
  8825                          ;
  8826                          ;NO_DCB_FOUND1 CHANGED TO BLK_NO_CB_FOUND1 TO AVOID CONFLICT
  8827                          ;WITH IDENTICAL LABEL ELSEWHERE
  8828                          ;GLB    __START_RD_1_BLOCK
  8829                          
  8830                          __START_RD_1_BLOCK:
  8831  1ac6  c5                        PUSH    BC
  8832  1ac7  d5                        PUSH    DE
  8833  1ac8  e5                        PUSH    HL
  8834  1ac9  fde5                      PUSH    IY
  8835                          
  8836  1acb  cd4614                    CALL    __FIND_DCB
  8837                          
  8838  1ace  200c                      JR      NZ,B_NO_DCB_FOUND1; COULD NOT FIND DCB FOR THIS DEVICE
  8839                          
  8840  1ad0  cd9614                    CALL    CHK_IF_INACTIVE; IS DEVICE IDLE?
  8841  1ad3  2007                      JR      NZ,ACTIVE_DCB1; NOPE, GET OUT
  8842                          
  8843  1ad5  cd381b                    CALL    PREP_DCB; SET UP THE DCB FOR READ
  8844                          
  8845  1ad8  fd360004                  LD      (IY+D_COM_STAT),DCB_RD; SEND READ COMMAND
  8846                          
  8847                          ACTIVE_DCB1:
  8848                          B_NO_DCB_FOUND1:
  8849  1adc  fde1                      POP     IY
  8850  1ade  e1                        POP     HL
  8851  1adf  d1                        POP     DE
  8852  1ae0  c1                        POP     BC
  8853                          
  8854  1ae1  c9                        RET
  8855                          
  8856                          ;***************************************************************
  8857                          ;
  8858                          ;       __END_RD_1_BLOCK CHECKS THE STATUS AFTER A __START_RD_1_BLOCK
  8859                          ;       IS EXECUTED
  8860                          ;
  8861                          ;       INPUT:  A       DEVICE ID
  8862                          ;                       LOW NIBBLE - DEVICE ADDRESS
  8863                          ;                       HI NIBBLE  - SECONDARY DEVICE ID
  8864                          ;
  8865                          ;       OUTPUT: CONDITION FLAGS
  8866                          ;               C:  OPERATION COMPLETED
  8867                          ;               NC: OPERATION NOT COMPLETED
  8868                          ;               Z:  NO ERRORS
  8869                          ;               NZ: ERRORS
  8870                          ;                   A = ERROR CODE
  8871                          ;
  8872                          ;       ALL REGISTERS ARE SAVED
  8873                          ;
  8874                          ;***************************************************************
  8875                          
  8876                          ;GLB    __END_RD_1_BLOCK
  8877                          ;EXT    CHK_IF_IDLE
  8878                          
  8879                          __END_RD_1_BLOCK:
  8880  1ae2  fde5                      PUSH    IY
  8881                          
  8882  1ae4  cd4614                    CALL    __FIND_DCB
  8883                          
  8884  1ae7  37                        SCF; SET CARRY FLAG TO INDICATE OPERATION COMPLETED
  8885                          
  8886  1ae8  2012                      JR      NZ,NO_DCB_FOUND5; NO DCB FOUND
  8887                          
  8888  1aea  cdae14                    CALL    CHK_IF_IDLE; IS DEVICE IDLE?
  8889                          
  8890  1aed  200d                      JR      NZ,DCB_IS_IDLE5
  8891                          
  8892  1aef  b7                        OR      A; CLEAR CARRY FLAG
  8893  1af0  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); WAS COMMAND COMPLETE?
  8894  1af4  2806                      JR      Z,COMMAND_NOT_COMPLETED; NOPE,
  8895                          
  8896                          
  8897  1af6  fd7e00                    LD      A,(IY+D_COM_STAT); GET STATUS OF LAST OPERATION
  8898                          
  8899  1af9  fe80                      CP      CMND_FIN_STATUS; ANY ERRORS?
  8900  1afb  37                        SCF; INDICATE COMMAND COMPLETED
  8901                          ; CONDITION FLAGS: IF NO ERRORS:  C,Z
  8902                          ;                  IF ERRORS:     C,NZ  A=ERROR CODE
  8903                          
  8904                          DCB_IS_IDLE5:
  8905                          NO_DCB_FOUND5:
  8906                          COMMAND_COMPLETED:
  8907                          COMMAND_NOT_COMPLETED:
  8908  1afc  fde1                      POP     IY
  8909                          
  8910  1afe  c9                        RET
  8911                          
  8912                          ;***************************************************************
  8913                          ;
  8914                          ;       __START_WR_1_BLOCK WILL SEND A WRITE COMMAND TO WRITE A BLOCK
  8915                          ;       OF DATA TO A BLOCK DEVICE FROM A LOCATION SPECIFIED BY REGISTER HL
  8916                          ;
  8917                          ;       INPUT:
  8918                          ;               A         DEVICE ID
  8919                          ;                         LOW NIBBLE  - DEVICE ADDRESS
  8920                          ;                         HI NIBBLE   - SECONDARY DEVICE ID
  8921                          ;
  8922                          ;               HL        SOURCE ADDRESS IN RAM
  8923                          ;
  8924                          ;               REGISTER PAIR:
  8925                          ;                         BC DE   - SECTOR NUMBER ON DEVICE
  8926                          ;
  8927                          ;
  8928                          ;       THE TRANSFER BYTE COUNT IS DEFINED BY "DCB_MAX_MESS_LEN"
  8929                          ;       WHICH IS FOUND IN THE DEVICE DCB
  8930                          ;
  8931                          ;       OUTPUT:
  8932                          ;               CONDITION BITS:
  8933                          ;                         Z:  NO ERRORS
  8934                          ;                         NZ: ERRORS OCCURED
  8935                          ;                             A - ERROR CODE
  8936                          ;
  8937                          ;       ALL REGISTERS ARE PRESERVED
  8938                          ;
  8939                          ;***************************************************************
  8940                          
  8941                          ;NO_DCB_FOUND3 CHANGED TO B_NO_DCB_FOUND3 TO AVOID CONFLICT WITH
  8942                          ;IDENTICAL LABEL ELSEWHERE
  8943                          
  8944                          ;GLB    __START_WR_1_BLOCK
  8945                          
  8946                          __START_WR_1_BLOCK:
  8947  1aff  c5                        PUSH    BC
  8948  1b00  d5                        PUSH    DE
  8949  1b01  e5                        PUSH    HL
  8950  1b02  fde5                      PUSH    IY
  8951                          
  8952  1b04  cd4614                    CALL    __FIND_DCB
  8953                          
  8954  1b07  200c                      JR      NZ,B_NO_DCB_FOUND3; NO DCB FOUND
  8955                          
  8956  1b09  cd9614                    CALL    CHK_IF_INACTIVE; IS DEVICE ACTIVE?
  8957  1b0c  2007                      JR      NZ,ACTIVE_DCB3; NOPE, GET OUT
  8958                          
  8959  1b0e  cd381b                    CALL    PREP_DCB; SET UP DCB FOR WRITE
  8960                          
  8961  1b11  fd360003                  LD      (IY+D_COM_STAT),DCB_WR; SEND WRITE COMMAND
  8962                          
  8963                          B_NO_DCB_FOUND3:
  8964                          ACTIVE_DCB3:
  8965  1b15  fde1                      POP     IY
  8966  1b17  e1                        POP     HL
  8967  1b18  d1                        POP     DE
  8968  1b19  c1                        POP     BC
  8969                          
  8970  1b1a  c9                        RET
  8971                          
  8972                          ;***************************************************************
  8973                          ;
  8974                          ;       __END_WR_1_BLOCK WILL CHECK THE STATUS OF THE LAST OPERATION
  8975                          ;       EXECUTED
  8976                          ;
  8977                          ;       INPUT:
  8978                          ;               A         DEVICE ID
  8979                          ;                         LOW NIBBLE  - DEVICE ADDRESS
  8980                          ;                         HI NIBBLE   - SECONDARY DEVICE ID
  8981                          ;
  8982                          ;       OUTPUT:
  8983                          ;               CONDITION FLAGS
  8984                          ;                         C        OPERATION COMPLETED
  8985                          ;                         NC       OPERATION NOT COMPLETED
  8986                          ;                         Z        NO ERRORS
  8987                          ;                         NZ       ERRORS
  8988                          ;                                  A - ERROR CODE
  8989                          ;
  8990                          ;       ALL REGISTERS ARE PRESERVED
  8991                          ;
  8992                          ;***************************************************************
  8993                          
  8994                          ;NO_DCB_FOUND4              B_NO_DCB_FOUND4
  8995                          ;DCB_IS_IDLE4 CHANGED TO BLK_DCB_IS_IDLE4 TO AVOID CONFLICT WITH
  8996                          ;IDENTICAL LABEL ELSEWHERE
  8997                          
  8998                          ;GLB    __END_WR_1_BLOCK
  8999                          
  9000                          __END_WR_1_BLOCK:
  9001  1b1b  fde5                      PUSH    IY
  9002                          
  9003  1b1d  cd4614                    CALL    __FIND_DCB
  9004                          
  9005  1b20  37                        SCF
  9006  1b21  2012                      JR      NZ,B_NO_DCB_FOUND4; CONDITION FLAGS: C,NZ  A=ERROR CODE
  9007                          
  9008  1b23  cdae14                    CALL    CHK_IF_IDLE; IS DEVICE IDLE?
  9009  1b26  200d                      JR      NZ,BLK_DCB_IS_IDLE4; YUP
  9010                          
  9011  1b28  b7                        OR      A; RESET CARRY FLAG
  9012                          
  9013  1b29  fdcb007e                  BIT     CMND_COMPLETE_BIT,(IY+D_COM_STAT); WAS COMMAND COMPLETE?
  9014  1b2d  2806                      JR      Z,CMND_NOT_COMPLETED; NOPE,
  9015                          
  9016  1b2f  fd7e00                    LD      A,(IY+D_COM_STAT); YUP
  9017                          
  9018                          
  9019  1b32  fe80                      CP      CMND_FIN_STATUS; ANY ERRORS?
  9020  1b34  37                        SCF; INDICATE COMMAND COMPLETED
  9021                          ; CONDITION FLAGS: IF NO ERRORS:  C,Z
  9022                          ;                  IF ERRORS:     C,NZ, A=ERROR CODE
  9023                          
  9024                          
  9025                          BLK_DCB_IS_IDLE4:
  9026                          B_NO_DCB_FOUND4:
  9027                          CMND_COMPLETED:
  9028                          CMND_NOT_COMPLETED:
  9029  1b35  fde1                      POP     IY
  9030  1b37  c9                        RET
  9031                          ;***************************************************************
  9032                          ;
  9033                          ;       PREP_DCB LOADS THE DCB BUFFER WITH THE PROPER VALUES FOR
  9034                          ;       A READ OR WRITE COMMAND
  9035                          ;
  9036                          ;       INPUT:
  9037                          ;               IY      START OF SPECIFIC DCB
  9038                          ;               HL      ADDRESS OF RAM DESTINATION(READ)/SOURCE(WRITE)
  9039                          ;
  9040                          ;               BC DE   DEVICE SECTOR NUMBER
  9041                          ;
  9042                          ;       OUTPUT: NONE
  9043                          ;
  9044                          ;***************************************************************
  9045                          
  9046                          PREP_DCB:
  9047  1b38  f5                        PUSH    AF
  9048                          
  9049  1b39  cb3f                      SRL     A; EXTRACT SECONDARY DEVICE ID
  9050  1b3b  cb3f                      SRL     A
  9051  1b3d  cb3f                      SRL     A
  9052  1b3f  cb3f                      SRL     A
  9053                          
  9054  1b41  fd7709                    LD      (IY+D_SEC_DEV_ID),A; .... AND PLACE IN DCB
  9055  1b44  fd7e11                    LD      A,(IY+D_MAX_MSG_LN_LO); GET BLOCK LENGTH AND PLACE ....
  9056  1b47  fd7703                    LD      (IY+D_BUF_LEN_LO),A; .... IT IN BUFFER LENGTH ....
  9057  1b4a  fd7e12                    LD      A,(IY+D_MAX_MSG_LN_HI); .... FOR READ
  9058  1b4d  fd7704                    LD      (IY+D_BUF_LEN_HI),A
  9059                          
  9060  1b50  fd7305                    LD      (IY+D_SECT_NUM),E; LOAD UP A 4 BYTE SECTOR....
  9061  1b53  fd7206                    LD      (IY+D_SECT_NUM+1),D; .... NUMBER FROM REGISTERS....
  9062  1b56  fd7107                    LD      (IY+D_SECT_NUM+2),C; .... PAIR BC DE
  9063  1b59  fd7008                    LD      (IY+D_SECT_NUM+3),B
  9064                          
  9065  1b5c  fd7501                    LD      (IY+D_BUF_ADR_LO),L; ADDRESS OF SOURCE/DESTINATION
  9066  1b5f  fd7402                    LD      (IY+D_BUF_ADR_HI),H; .... IN RAM
  9067                          
  9068  1b62  f1                        POP     AF
  9069  1b63  c9                        RET
  9070                          ;
  9071                          ;===============================================================
  9072                          ;===============================================================
  9073                          ;===============================================================
  9074                          ;
  9075                          
  9076                          
  9077                          ;REV 0                  (V/D  8-24-83)
  9078                          
  9079                          ;EXT    DEVICE_ID
  9080                          
  9081                          ;***************************************************************
  9082                          ; THIS ROUTINE WILL INITIATE A READ COMMAND ON A CHARACTER DEVICE.  THE
  9083                          ; ROUTINE WILL WAIT FOR THE COMMAND TO BE COMPLETED.  IF THE COMMAND
  9084                          ; COMPLETED WITH NO ERRORS, THEN THE FLAG WILL BE ZERO.  IF THERE
  9085                          ; WERE ERRORS THEN THE FLAG WILL BE NON-ZERO.
  9086                          ;       INPUT:  A ==>   DEVICE ID
  9087                          ;               DE =>   DESTINATION ADDRESS
  9088                          ;               BC =>   NUMBER OF BYTES TO READ
  9089                          ;       OUTPUT:
  9090                          ;               CONDITION FLAGS
  9091                          ;                         Z :     NO ERROR
  9092                          ;                         A ==>   KEY READ
  9093                          ;                         NZ:     ERROR OCCURED
  9094                          ;                         A ===>  ERROR CODE
  9095                          ;***************************************************************
  9096                          
  9097                                  GLOBAL  __RD_CH_DEV
  9098                          ;EXT    __FIND_DCB
  9099                          
  9100                          __RD_CH_DEV:
  9101  1b64  321200                    LD      (DEVICE_ID),A; SAVE DEVICE ID
  9102                          
  9103  1b67  cd861b                    CALL    __START_RD_CH_DEV
  9104  1b6a  2008                      JR      NZ,GOOD_BYE
  9105                          
  9106                          RD_DEV_LOOP:
  9107  1b6c  3a1200                    LD      A,(DEVICE_ID); RESTOR THE DEVICE ID
  9108  1b6f  cda51b                    CALL    __END_RD_CH_DEV
  9109  1b72  30f8                      JR      NC,RD_DEV_LOOP
  9110                          
  9111                          GOOD_BYE:
  9112  1b74  c9                        RET
  9113                          
  9114                          ;***************************************************************
  9115                          ; WRITE CHAR DEV ALLOWS THE CALLER TO SEND A PRINT COMMAND BY SPECIFYING
  9116                          ; THE BUFFER OF THE STRING AND THE NUMBER OF BYTES TO PRINT.
  9117                          ;       INPUT:  A ==>   DEVICE ID
  9118                          ;               BC =>   NUMBER OF BYTES TO WRITE
  9119                          ;               HL =>   SOURCE OF DATA
  9120                          ;       OUTPUT:
  9121                          ;               CONDITION FLAGS
  9122                          ;                         Z :     NO ERRORS
  9123                          ;                         NZ:     ERROR OCCURED
  9124                          ;                         A ===>  ERROR CODE
  9125                          ;***************************************************************
  9126                          
  9127                                  GLOBAL  __WR_CH_DEV
  9128                          
  9129                          __WR_CH_DEV:
  9130  1b75  321200                    LD      (DEVICE_ID),A
  9131                          
  9132  1b78  cdc21b                    CALL    __START_WR_CH_DEV
  9133  1b7b  2008                      JR      NZ,SO_LONG
  9134                          
  9135                          DCB_WRITE_LOOP:
  9136  1b7d  3a1200                    LD      A,(DEVICE_ID); RESTORE THE ID FOR USE IN THE CALL
  9137  1b80  cde11b                    CALL    __END_WR_CH_DEV
  9138  1b83  30f8                      JR      NC,DCB_WRITE_LOOP
  9139                          
  9140                          SO_LONG:
  9141  1b85  c9                        RET
  9142                          
  9143                          
  9144                          ;***************************************************************
  9145                          ; THIS ROUTINE IS RESPONSIBLE FOR SETTING UP A DEVICE DCB TO DO A READ.
  9146                          ; THE LAST THING DONE IN THIS ROUTINE IS TO ISSUE THE COMMAND TO READ
  9147                          ; A KEY FROM THE KEYBOARD.
  9148                          ;       INPUT:  A  ===> CONTAINS THE DEVICE ID
  9149                          ;               DE ===> DESTINATION ADDRESS
  9150                          ;               BC ===> NUMBER OF BYTES TO READ
  9151                          ;       OUTPUT: CONDITION FLAGS
  9152                          ;               Z:      THE READ DATA FROM KEYBOARD COMMAND HAS BEEN SENT
  9153                          ;               NZ:     ERROR OCCURED
  9154                          ;                       A ===>  ERROR CODE
  9155                          ;***************************************************************
  9156                          
  9157                          ;GLB    __START_RD_CH_DEV
  9158                          ;EXT    CHK_IF_INACTIVE
  9159                          
  9160                          __START_RD_CH_DEV:
  9161  1b86  fde5                      PUSH    IY
  9162  1b88  cd4614                    CALL    __FIND_DCB; FIND THE DCB
  9163                          
  9164  1b8b  2015                      JR      NZ,NO_DCB_DEFINED
  9165                          

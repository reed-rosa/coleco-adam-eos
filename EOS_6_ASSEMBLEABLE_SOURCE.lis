  5947  11f0  f5                        PUSH    AF
  5948                          
  5949  11f1  cdb21a                    CALL    __WR_1_BLOCK
  5950                          
  5951  11f4  280e                      JR      Z,NO_WRITE_ERRORS; NO ERRORS
  5952                          
  5953  11f6  fe9b                      CP      TIMEOUT
  5954                          
  5955  11f8  280a                      JR      Z,NO_WRITE_ERRORS; ERROR OCCURED IN TRANSMISSION
  5956                          
  5957  11fa  e5                        PUSH    HL
  5958  11fb  217600                    LD      HL,RETRY_COUNT
  5959  11fe  35                        DEC     (HL)
  5960  11ff  e1                        POP     HL
  5961  1200  281c                      JR      Z,WRITE_ERROR
  5962                          
  5963  1202  18eb                      JR      TRY_WRITE_AGAIN
  5964                          

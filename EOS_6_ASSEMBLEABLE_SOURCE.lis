  6079  1258  dd5614                    LD      D,(IX+FCB_USED_LENGTH+1); GET THE NO OF USED BLOCKS
  6080                          
  6081  125b  dd6e11                    LD      L,(IX+FCB_MAX_LENGTH)
  6082  125e  dd6612                    LD      H,(IX+FCB_MAX_LENGTH+1); GET THE NO ALLOCATED
  6083                          

  7977                          ;**********************************************************************
  7978                          ;                                                                     *
  7979                          ;  MODULE NAME:                                                       *
  7980                          ;                                                                     *
  7981                          ;    EOS_START                                                        *
  7982                          ;                                                                     *
  7983                          ;  INPUTS:                                                            *
  7984                          ;                                                                     *
  7985                          ;    NONE                                                             *
  7986                          ;                                                                     *
  7987                          ;  FUNCTION(S):                                                       *
  7988                          ;      0. SET STACK.                                                   *
  7989                          ;      1. TO BANK SELECT OS7 AND 24K RAM.                              *
  7990                          ;      2. CALL INIT_EOS TO ALLOW THE 1) THE Z80/6801 SYNCH_UP,         *
  7991                          ;         POLL FOR NET DEVICES AND ESTABLISH DCB'S.                   *
  7992                          ;      3. CHECK FOR THE PRESENCE OF A TAPE. IF PRESENT THEN            *
  7993                          ;         LOAD IN A COLD_START LOADER AND EXECUTE FROM THERE.          *
  7994                          ;      4. IF NO TAPE, THEN BRING UP THE ROM RESIDENT WORD              *
  7995                          ;         PROCESSOR BY JUMPING TO OS7.                                  *
  7996                          ;                                                                     *
  7997                          ;  OUTPUTS:                                                           *
  7998                          ;                                                                     *
  7999                          ;    DEVICE ADDR _ REG B                                               *
  8000                          ;                                                                     *
  8001                          ;  CALLS:                                                             *
  8002                          ;                                                                     *
  8003                          ;    EOS_INIT                                                         *
  8004                          ;    EOS_QUERY_DEVICE                                                 *
  8005                          ;    EOS_READ_BLOCK                                                    *
  8006                          ;                                                                     *
  8007                          ;  CALLED BY:                                                         *
  8008                          ;                                                                     *
  8009                          ;    INVOKED BY EOS_BOOT                                               *
  8010                          ;                                                                     *
  8011                          ;  NOTES:                                                             *
  8012                          ;                                                                     *
  8013                          ;    NONE.                                                            *
  8014                          ;                                                                     *
  8015                          ;**********************************************************************
  8016                          
  8017                          
  8018                          ;:
  8019                          ;: external routines used
  8020                          ;:
  8021                          ;EXT    _FIND_DCB
  8022                          ;EXT    _REQUEST_STATUS
  8023                          ;EXT    _HARD_INIT
  8024                          ;EXT    _RD_1_BLOCK
  8025                          ;EXT    _FMGR_INIT
  8026                          ;EXT    _GOTO_WP
  8027                          ;EXT    FILL_VRAM
  8028                          ;EXT    TURN_OFF_SOUND
  8029                          ;EXT    SWITCH_MEM
  8030                          ;EXT    PORT_COLLECTION
  8031                          ;:
  8032                          ;: external data structures used
  8033                          ;:
  8034                          ;EXT    REV_NUM
  8035                          ;EXT    CLEAR_RAM_START
  8036                          ;EXT    CLEAR_RAM_SIZE
  8037                          ;EXT    EOS_STACK
  8038                          ;EXT    DEFAULT_BT_DEV
  8039                          ;EXT    MEM_CNFGO1 ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8040                          ;EXT    MEM_CNFGO3 ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8041                          ;:
  8042                          ;: local equates
  8043                          ;:
  8044                          EOS_REV         EQU     005H;current EOS revision number
  8045                          ;--NOTE-- this is actually rev.
  8046                          ;06 but to match the production ROM
  8047                          ;which was labeled rev. 05 we fudge
  8048                          ;just a bit (two bits actually)
  8049                          
  8050                          COLD_START_ADDR EQU     0C800H
  8051                          DSK4            EQU     4
  8052                          DSK5            EQU     5
  8053                          ONE_BLOCK       EQU     1
  8054                          BLOCK_ZERO      EQU     0
  8055                          
  8056                          
  8057                          ;GLB    _EOS_START
  8058                          __EOS_START:; [RECON] OCR 8129 exports __EOS_START; scan loses underscores in the label image.
  8059  1832  31f800                            LD      SP,EOS_STACK; SET THE STACK
  8060                          
  8061  1835  014701                            LD      BC,CLEAR_RAM_SIZE; clear EOS ram
  8062  1838  110100                            LD      DE,CLEAR_RAM_START+1
  8063  183b  210000                            LD      HL,CLEAR_RAM_START
  8064  183e  af                                XOR     A
  8065  183f  77                                LD      (HL),A
  8066  1840  edb0                              LDIR
  8067                          
  8068  1842  3e05                              LD      A,EOS_REV; init REV_NUM
  8069  1844  320000                            LD      (REV_NUM),A
  8070                          
  8071  1847  cde100                            CALL    PORT_COLLECTION; collect the port addresses from OS7
  8072                          
  8073  184a  cd2301                            CALL    TURN_OFF_SOUND; KILL SOUNDS
  8074                          
  8075  184d  3e00                              LD      A,0; CLEAR VRAM
  8076  184f  210000                            LD      HL,0
  8077  1852  110040                            LD      DE,16*1024
  8078  1855  cdf600                            CALL    FILL_VRAM
  8079                          
  8080  1858  3a1900                            LD      A,(MEM_CNFGO1);get the data for configuration 1 (64K RAM) ; [RECON] Identifier repair: restore letter-O configuration-table symbol.
  8081  185b  cde400                            CALL    SWITCH_MEM;select this configuration
  8082                          ;:
  8083                          ;: EOS_INIT WILL PERFORM THE 6801/Z80 SYNCH_UP, PERFORM A ROLL_CALL
  8084                          ;: POLL ON THE NET, AND ESTABLISH THE DCB'S
  8085                          ;:
  8086  185e  cdf618                            CALL    __HARD_INIT; [RECON] OCR 8158 bytes CD F6 F8 call the implementation directly.
  8087                          ;:
  8088                          ;: setup the FCB's
  8089                          
  8090  1861  1100d4                            LD      DE,THREE1K_BLKS; START ADDRESS OF THREE 1K BLOCKS
  8091  1864  2190d3                            LD      HL,FCB_S; START ADDRESS OF 3 FCB BLOCKS
  8092  1867  cdea0e                            CALL    __FMGR_INIT; TELL THE FILE MANAGER ; [RECON] OCR 8164 bytes CD EA EE call the implementation directly.
  8093                          
  8094                          ;:
  8095                          ;:     CHECK FOR BOOT LOADER IN ANY MASS STORAGE DEVICE
  8096                          ;:
  8097  186a  3e08                              LD      A,TAPE_ID;set the default boot device to tape
  8098  186c  320f00                            LD      (DEFAULT_BT_DEV),A
  8099                          
  8100  186f  3e04                              LD      A,DSK4;check for DISK 4 device active
  8101  1871  cd7314                            CALL    __REQUEST_STATUS; [RECON] OCR 8173 bytes CD 73 F4 call the implementation directly.
  8102  1874  2010                              JR      NZ,CHK_D5
  8103                          
  8104  1876  3e04                              LD      A,DSK4
  8105  1878  cd4614                            CALL    __FIND_DCB; [RECON] OCR 8177 bytes CD 46 F4 call the implementation directly.
  8106  187b  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8107  187e  e60f                              AND     0FH
  8108  1880  fe03                              CP      3
  8109  1882  3e04                              LD      A,DSK4
  8110  1884  3842                              JR      C,DEV1_OK
  8111                          
  8112  1886  3e05              CHK_D5: LD      A,DSK5;check for DISK 5 device active
  8113  1888  cd7314                            CALL    __REQUEST_STATUS; [RECON] OCR 8185 bytes CD 73 F4 call the implementation directly.
  8114  188b  2010                              JR      NZ,CHK_TAPE
  8115                          
  8116  188d  3e05                              LD      A,DSK5
  8117  188f  cd4614                            CALL    __FIND_DCB; [RECON] OCR 8189 bytes CD 46 F4 call the implementation directly.
  8118  1892  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8119  1895  e60f                              AND     0FH
  8120  1897  fe03                              CP      3
  8121  1899  3e05                              LD      A,DSK5
  8122  189b  382b                              JR      C,DEV1_OK
  8123                          CHK_TAPE:
  8124  189d  3e08                              LD      A,TAPE_ID;check if TAPE device active
  8125  189f  cd7314                            CALL    __REQUEST_STATUS; [RECON] OCR 8197 bytes CD 73 F4 call the implementation directly.
  8126  18a2  201e                              JR      NZ,CALL_WP
  8127                          
  8128  18a4  3e08                              LD      A,TAPE_ID
  8129  18a6  cd4614                            CALL    __FIND_DCB; [RECON] OCR 8201 bytes CD 46 F4 call the implementation directly.
  8130  18a9  fd7e14                            LD      A,(IY+D_STATUS_FLAGS)
  8131  18ac  f5                                PUSH    AF
  8132  18ad  e60f                              AND     0FH
  8133  18af  fe03                              CP      3
  8134  18b1  3812                              JR      C,DEV0_OK
  8135                          
  8136  18b3  f1                                POP     AF
  8137  18b4  cb3f                              SRL     A
  8138  18b6  cb3f                              SRL     A
  8139  18b8  cb3f                              SRL     A
  8140  18ba  cb3f                              SRL     A
  8141  18bc  fe03                              CP      3
  8142  18be  3e18                              LD      A,TAPE_ID+10H
  8143  18c0  3806                              JR      C,DEV1_OK
  8144                          
  8145                          CALL_WP:;devices disk 4, 5 and tape are not active
  8146                          ;                 LD      A,(MEM_CNFGO3)          ;get the data for configuration 3 (8K OS7 and 56K RAM) ; [RECON] OCR 8218 is commented in the scan.
  8147                          ;                 CALL    SWITCH_MEM              ;select this configuration ; [RECON] OCR 8219 is commented in the scan.
  8148  18c2  c3b700                            JP      _GOTO_WP;default to ALPHA
  8149                          DEV0_OK:
  8150  18c5  f1                                POP     AF
  8151  18c6  3e08                              LD      A,TAPE_ID
  8152                          DEV1_OK:
  8153  18c8  320f00                            LD      (DEFAULT_BT_DEV),A
  8154                          READ_AGAIN:
  8155  18cb  2100c8                            LD      HL,COLD_START_ADDR
  8156  18ce  010000                            LD      BC,0
  8157  18d1  3a0f00                            LD      A,(DEFAULT_BT_DEV)
  8158  18d4  110000                            LD      DE,BLOCK_ZERO
  8159  18d7  cd9e1a                            CALL    __RD_1_BLOCK; [RECON] OCR 8231 bytes CD 9E FA call the implementation directly.
  8160  18da  caef18                            JP      Z,GO_TO_TAPECODE
  8161  18dd  4f                                LD      C,A
  8162  18de  3a0f00                            LD      A,(DEFAULT_BT_DEV)
  8163  18e1  e60f                              AND     0FH
  8164  18e3  fe08                              CP      TAPE_ID
  8165  18e5  20e4                              JR      NZ,READ_AGAIN
  8166  18e7  79                                LD      A,C
  8167  18e8  fe9b                              CP      TIMEOUT
  8168  18ea  28df                              JR      Z,READ_AGAIN
  8169  18ec  c3c218                            JP      CALL_WP
  8170                          GO_TO_TAPECODE:
  8171                          
  8172  18ef  3a0f00                            LD      A,(DEFAULT_BT_DEV)
  8173  18f2  47                                LD      B,A
  8174  18f3  c300c8                            JP      COLD_START_ADDR

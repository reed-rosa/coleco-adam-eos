  6465                          
  6466                          ; NAME "REV 1 - RPD"
  6467                          ;
  6468                          ;       RETURN ERROR CODES UNTIL THESE ROUTINES ARE WRITTEN
  6469                          ;
  6470                          ;       10/12/83  VSB
  6471                          ;       10/14/83  RPD changed __EOS_4 to __CV_A
  6472                          ;
  6473                          
  6474                          ;GLB    __POSIT_FILE,__EOS_1,__EOS_2,__EOS_3,__CV_A
  6475                          __POSIT_FILE:
  6476                          __EOS_1:
  6477                          __EOS_2:
  6478                          __EOS_3:
  6479                          __CV_A:
  6480  1442  3e17                      LD      A,PROG_NON_EXIST; SIGNIFY PROGRAM DOES NOT EXIST
  6481  1444  b7                        OR      A; NZ CONDITION
  6482  1445  c9                        RET
  6483                          ;

  5723                          ;
  5724                          ;***************************************************************
  5725                          ;******************** EOS_DELETE_FILE ***************************
  5726                          ;
  5727                          ; ON ENTRY:   A  = DEVICE NUMBER (8=TAPE1)
  5728                          ;             HL = POINTER TO FILENAME
  5729                          ;
  5730                          ; ON EXIT:    Z = 1, FILE DELETED. A = 0
  5731                          ;             Z = 0, FILE NOT DELETED. A = ERROR CODE
  5732                          ;
  5733                          
  5734                          ;GLB    __DELETE_FILE
  5735                          
  5736                          __DELETE_FILE:
  5737  114e  d5                        PUSH    DE
  5738  114f  e5                        PUSH    HL; HL = POINTER TO FILENAME
  5739  1150  f5                        PUSH    AF; A = DEVICE ID
  5740  1151  eb                        EX      DE,HL; DE = POINTER TO FILENAME
  5741  1152  214000                    LD      HL,QUERY_BUFFER; HL = POINTER TO BUFFER
  5742  1155  cd1b06                    CALL    __QUERY_FILE
  5743  1158  201d                      JR      NZ,OTHER_ERR
  5744  115a  3a4c00                    LD      A,(QUERY_BUFFER+FCB_ATTR); GET ATTRIBUTE BYTE
  5745  115d  cb7f                      BIT     7,A; see if permanent protected
  5746  115f  2013                      JR      NZ,NOT_DELETED
  5747  1161  f604                      OR      ATTR_DELETED; SET "DELETED" BIT
  5748  1163  324c00                    LD      (QUERY_BUFFER+FCB_ATTR),A
  5749  1166  f1                        POP     AF; DEVICE ID
  5750  1167  d1                        POP     DE; GET FILENAME POINTER
  5751  1168  d5                        PUSH    DE
  5752  1169  f5                        PUSH    AF
  5753  116a  cd5106                    CALL    __SET_FILE
  5754  116d  2008                      JR      NZ,OTHER_ERR
  5755  116f  af                        XOR     A; GOOD RETURN
  5756  1170  e1                        POP     HL; REALLY AF BUT PRESERVE NEW AF
  5757  1171  e1                        POP     HL
  5758  1172  d1                        POP     DE
  5759  1173  c9                        RET
  5760                          NOT_DELETED:
  5761  1174  3e10                      LD      A,DELETE_ERR; ERROR RETURN
  5762  1176  b7                        OR      A
  5763                          OTHER_ERR:
  5764  1177  e1                        POP     HL; REALLY AF BUT PRESERVE ERR CONDITION
  5765  1178  e1                        POP     HL
  5766  1179  d1                        POP     DE
  5767  117a  c9                        RET
